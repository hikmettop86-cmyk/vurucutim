{
  "name": "vurucutim",
  "version": "0.1.88",
  "description": "VurucuTim - RSS to YouTube Shorts (Electron wrapper)",
  "main": "main.js",
  "author": "hikmettop86-cmyk",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "fetch-python": "node scripts/fetch-python-embed.js",
    "fetch-node": "node scripts/fetch-node-portable.js",
    "sync-version": "node scripts/sync-version.js",
    "prebuild": "npm run sync-version && npm run fetch-python && npm run fetch-node",
    "build": "electron-builder --win --x64 --config build/electron-builder.yml",
    "publish": "electron-builder --win --x64 --config build/electron-builder.yml --publish always"
  },
  "dependencies": {
    "electron-log": "^5.1.5",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
