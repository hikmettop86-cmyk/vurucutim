# Vurucu TIM — Ayar Dosyasi Sablonu
# Kopyala: copy config\settings.yaml.example config\settings.yaml
# Sonra ffmpeg/claude path'lerini duzenle (Windows icin tam yol gir).
#
# Ornek tam yollar (PATH'e eklenmemisse):
#   ffmpeg_path: C:\ffmpeg\bin\ffmpeg.exe
#   claude_cli_path: C:\Users\KULLANICI\AppData\Roaming\npm\claude.cmd

# ffmpeg calistirilebilir dosyasinin yolu.
# "ffmpeg" PATH'deyse bu sekilde birak; degilse tam yolu gir.
ffmpeg_path: ffmpeg

# Claude Code CLI calistirilebilir dosyasinin yolu.
# "claude" PATH'deyse bu sekilde birak; degilse tam yolu gir.
claude_cli_path: claude

# Playwright tarayicisi (chromium onerilir, degistirme)
playwright_browser: chromium

# Web panel ayarlari
web:
  host: 127.0.0.1
  port: 5005

# Benzer/tekrar icerikleri filtrelemek icin esik degeri (0.0-1.0)
fuzzy_dedup_threshold: 0.85

# Log seviyesi: DEBUG, INFO, WARNING, ERROR
log_level: INFO

# Claude model secimi (degistirme gerek yok)
claude_models:
  dna: opus      # Kanal DNA olusturma — Opus kullanir (~30-60s)
  default: haiku # Skoring + diger islemler — Haiku kullanir (hizli + ucuz)
  script: sonnet # Script yazimi — Sonnet kullanir (Haiku basliklarda klise/yanlis caption uretiyordu)

# Trend detection: trend olan bir konu icin scorer puanini yukseltir.
# enabled=false ise tum trend kanal ayarlari yok sayilir.
# default_sources: Channel kendi 'sources' override etmedikce bu kullanilir.
#   google_daily = Google Daily Trends RSS (ucretsiz, dakika icinde guncel)
#   youtube      = YouTube Trending (videos.list chart=mostPopular)
#                  -- secrets.yaml'a youtube_api_key gerektirir
# refresh_minutes: Scheduler cron araligi (default 60dk).
# cache_max_age_minutes: Pipeline'in cache'i 'taze' sayma esigi (default 90dk).
trends:
  enabled: true
  refresh_minutes: 60
  default_sources: [google_daily, youtube]
  cache_max_age_minutes: 90
