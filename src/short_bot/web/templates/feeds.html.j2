{% extends "base.html.j2" %}
{% block title %}Vurucu TİM — RSS Havuzu{% endblock %}
{% block content %}
<h1 class="font-serif text-3xl font-bold mb-6">RSS Havuzu</h1>
<div style="display:flex;gap:16px">
  <div style="width:220px">
    <form method="post" action="{{ url_for('feeds.add') }}">
      <input type="url" name="url" placeholder="https://site.com/rss" required>
      <button type="submit">+ Feed Ekle</button>
    </form>
    <ul style="list-style:none;padding:0">
    {% for f in feeds %}
      <li>
        <a href="#" hx-get="{{ url_for('feeds.items', feed_id=f.id) }}"
           hx-target="#feed-items" hx-swap="innerHTML">{{ f.title }}</a>
        <div style="font-size:11px;opacity:.6;word-break:break-all">{{ f.url }}</div>
        <form method="post" action="{{ url_for('feeds.delete', feed_id=f.id) }}"
              style="display:inline">
          <button type="submit">×</button>
        </form>
      </li>
    {% endfor %}
    </ul>
  </div>
  <div id="feed-items" style="flex:1">
    <p class="label">Soldan bir feed seç.</p>
  </div>
</div>
{% endblock %}
