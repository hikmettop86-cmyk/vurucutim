{% extends "base.html.j2" %}
{% block title %}Vurucu TİM — Ayarlar{% endblock %}
{% block content %}
<h1 class="font-serif text-3xl font-bold mb-6">Ayarlar</h1>

<form method="POST" class="grid grid-cols-2 gap-6">
  <div class="space-y-4">
    <h2 class="font-serif text-lg font-bold">Yollar / İkililer</h2>

    <label class="block">
      <span class="text-xs text-claude-muted uppercase">FFmpeg path</span>
      <input type="text" name="ffmpeg_path" value="{{ data.ffmpeg_path }}"
             class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 font-mono text-sm text-claude-text">
    </label>
    <label class="block">
      <span class="text-xs text-claude-muted uppercase">Claude CLI path</span>
      <input type="text" name="claude_cli_path" value="{{ data.claude_cli_path }}"
             class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 font-mono text-sm text-claude-text">
    </label>
    <label class="block">
      <span class="text-xs text-claude-muted uppercase">Playwright browser</span>
      <select name="playwright_browser"
              class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
        {% for b in ["chromium", "firefox", "webkit"] %}
          <option value="{{ b }}" {% if data.playwright_browser == b %}selected{% endif %}>{{ b }}</option>
        {% endfor %}
      </select>
    </label>

    <h2 class="font-serif text-lg font-bold mt-6 border-t border-claude-border pt-4">Pipeline</h2>
    <label class="block">
      <span class="text-xs text-claude-muted uppercase">Fuzzy dedup eşiği (0.0–1.0)</span>
      <input type="number" step="0.05" min="0" max="1" name="fuzzy_dedup_threshold"
             value="{{ data.fuzzy_dedup_threshold }}"
             class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
    </label>
    <label class="block">
      <span class="text-xs text-claude-muted uppercase">Log level</span>
      <select name="log_level"
              class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
        {% for lv in ["DEBUG", "INFO", "WARNING", "ERROR"] %}
          <option value="{{ lv }}" {% if data.log_level == lv %}selected{% endif %}>{{ lv }}</option>
        {% endfor %}
      </select>
    </label>

    <h2 class="font-serif text-lg font-bold mt-6 border-t border-claude-border pt-4">Web</h2>
    <div class="grid grid-cols-2 gap-3">
      <label class="block">
        <span class="text-xs text-claude-muted uppercase">Host</span>
        <input type="text" name="web_host" value="{{ data.web.host }}"
               class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 font-mono text-sm text-claude-text">
      </label>
      <label class="block">
        <span class="text-xs text-claude-muted uppercase">Port</span>
        <input type="number" name="web_port" value="{{ data.web.port }}"
               class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 font-mono text-sm text-claude-text">
      </label>
    </div>

    <h2 class="font-serif text-lg font-bold mt-6 border-t border-claude-border pt-4">Claude Modelleri</h2>
    <div class="grid grid-cols-3 gap-3">
      <label class="block">
        <span class="text-xs text-claude-muted uppercase">DNA üretimi</span>
        <select name="model_dna"
                class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          {% for m in ["opus", "sonnet", "haiku"] %}
            <option value="{{ m }}" {% if data.claude_models.dna == m %}selected{% endif %}>{{ m }}</option>
          {% endfor %}
        </select>
      </label>
      <label class="block">
        <span class="text-xs text-claude-muted uppercase">Varsayılan (skor)</span>
        <select name="model_default"
                class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          {% for m in ["opus", "sonnet", "haiku"] %}
            <option value="{{ m }}" {% if data.claude_models.default == m %}selected{% endif %}>{{ m }}</option>
          {% endfor %}
        </select>
      </label>
      <label class="block">
        <span class="text-xs text-claude-muted uppercase">Script yazımı</span>
        <select name="model_script"
                class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          {% for m in ["opus", "sonnet", "haiku"] %}
            <option value="{{ m }}" {% if data.claude_models.script == m %}selected{% endif %}>{{ m }}</option>
          {% endfor %}
        </select>
      </label>
    </div>

    <h2 class="font-serif text-lg font-bold mt-6 border-t border-claude-border pt-4">AI Kaynağı</h2>
    <div class="bg-claude-surface border border-claude-border rounded-lg p-4 space-y-3">
      <label class="block">
        <span class="text-xs text-claude-muted uppercase">Kaynak</span>
        <select name="ai_backend" id="ai_backend"
                class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          <option value="claude_cli" {% if ai_backend == 'claude_cli' %}selected{% endif %}>Claude CLI (mevcut)</option>
          <option value="openrouter" {% if ai_backend == 'openrouter' %}selected{% endif %}>OpenRouter</option>
        </select>
      </label>

      <div id="openrouter_box" {% if ai_backend != 'openrouter' %}style="display:none"{% endif %}>
        <div class="bg-claude-surface-alt border border-claude-border rounded-lg p-3 space-y-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">OpenRouter API Key
              {% if openrouter_key_set %}<span class="normal-case text-claude-muted">(mevcut: {{ openrouter_key_masked }})</span>{% endif %}
            </span>
            <input type="password" name="openrouter_api_key" placeholder="sk-or-v1-..."
                   autocomplete="new-password"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg text-sm w-full mt-1 text-claude-text">
          </label>
          <label class="text-xs flex items-center gap-1 text-claude-muted">
            <input type="checkbox" name="openrouter_api_key_clear" value="1"> Key'i temizle
          </label>

          {% for role, title in [('dna','DNA / tasarım'), ('default','Skorlama / varsayılan'), ('script','Script / metin'), ('vision','Görsel doğrulama')] %}
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">{{ title }}</span>
            <select name="or_model_{{ role }}" class="or-model-select bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
              {% for group in openrouter_catalog.groups %}
              <optgroup label="{{ group.label }}">
                {% for m in group.models %}
                {% if role != 'vision' or m.vision %}
                <option value="{{ m.id }}" {% if openrouter_models.get(role) == m.id %}selected{% endif %}>{{ m.label }}</option>
                {% endif %}
                {% endfor %}
              </optgroup>
              {% endfor %}
              <option value="__custom__">Özel…</option>
            </select>
            <input type="text" name="or_model_{{ role }}_custom" class="or-custom bg-claude-surface border border-claude-border px-3 py-2 rounded-lg text-sm w-full mt-1 text-claude-text" placeholder="örn. x-ai/grok-2" style="display:none">
          </label>
          {% endfor %}
        </div>
      </div>
    </div>

    <script>
      (function () {
        var sel = document.getElementById('ai_backend');
        var box = document.getElementById('openrouter_box');
        if (sel) sel.addEventListener('change', function () {
          box.style.display = (sel.value === 'openrouter') ? '' : 'none';
        });
        document.querySelectorAll('.or-model-select').forEach(function (s) {
          var custom = s.parentElement.querySelector('.or-custom');
          function sync() { custom.style.display = (s.value === '__custom__') ? '' : 'none'; }
          s.addEventListener('change', sync); sync();
        });
      })();
    </script>

    <h2 class="font-serif text-lg font-bold mt-6 border-t border-claude-border pt-4">Pexels API</h2>
    <div class="bg-claude-surface border border-claude-border rounded-lg p-4">
      {% if pexels_key_set %}
        <div class="flex items-center gap-3">
          <span class="font-mono text-sm">{{ pexels_key_masked }}</span>
          <label class="text-xs flex items-center gap-1 text-claude-muted">
            <input type="checkbox" name="pexels_api_key_clear" value="1"> Sil
          </label>
        </div>
        <input type="password" name="pexels_api_key" placeholder="Yeni key gir (değiştir)"
               class="bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm w-full mt-2 text-claude-text">
      {% else %}
        <input type="password" name="pexels_api_key" value="" placeholder="Pexels API key"
               class="bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm w-full text-claude-text">
        <div class="text-xs text-claude-muted mt-1">
          pexels.com/api kayıt → key al → buraya yapıştır. Key git'e yazılmaz.
        </div>
      {% endif %}
    </div>

    <h2 class="font-serif text-lg font-bold mt-6 border-t border-claude-border pt-4">OpenAI API Key</h2>
    {% if openai_key_set %}
    <div class="mb-3 text-xs">
      <form method="POST" action="/system/backfill-embeddings"
            onsubmit="return confirm('Son 14 gün üretilen shortlar için tekrar-uretim filtresi (Claude başlık embedding) hesaplanacak. ~30 saniye sürer. Devam?');"
            class="inline">
        <button type="submit"
                class="bg-claude-surface-alt hover:bg-claude-surface border border-claude-border px-3 py-1.5 rounded text-claude-text">
          🔄 Tekrar-üretim filtresi: geçmiş shortlar için backfill
        </button>
      </form>
      <span class="text-claude-muted ml-2">
        Yeni dedup katmanı için (v0.1.68+). İdempotent — birden fazla çalıştırmak güvenli.
      </span>
    </div>
    {% endif %}
    <div class="bg-claude-surface border border-claude-border rounded-lg p-4">
      {% if openai_key_set %}
        <div class="flex items-center gap-3">
          <span class="font-mono text-sm">{{ openai_key_masked }}</span>
          <label class="text-xs flex items-center gap-1 text-claude-muted">
            <input type="checkbox" name="openai_api_key_clear" value="1"> Sil
          </label>
        </div>
        <input type="password" name="openai_api_key" placeholder="Yeni key gir (değiştir)"
               autocomplete="new-password"
               class="bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm w-full mt-2 text-claude-text">
      {% else %}
        <input type="password" name="openai_api_key" value="" placeholder="sk-..."
               autocomplete="new-password"
               class="bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm w-full text-claude-text">
        <div class="text-xs text-claude-muted mt-1">
          Dinamik DNA özelliği için gereklidir (text-embedding-3-small). Boş bırak ve 'Sil' kutusunu işaretle → mevcut anahtarı sil.
        </div>
      {% endif %}
    </div>

    <h2 class="font-serif text-lg font-bold mt-6 border-t border-claude-border pt-4">YouTube Data API Key</h2>
    <div class="bg-claude-surface border border-claude-border rounded-lg p-4">
      {% if youtube_key_set %}
        <div class="flex items-center gap-3">
          <span class="font-mono text-sm">{{ youtube_key_masked }}</span>
          <label class="text-xs flex items-center gap-1 text-claude-muted">
            <input type="checkbox" name="youtube_api_key_clear" value="1"> Sil
          </label>
        </div>
        <input type="password" name="youtube_api_key" placeholder="Yeni key gir (değiştir)"
               autocomplete="new-password"
               class="bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm w-full mt-2 text-claude-text">
      {% else %}
        <input type="password" name="youtube_api_key" value="" placeholder="AIza..."
               autocomplete="new-password"
               class="bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm w-full text-claude-text">
        <div class="text-xs text-claude-muted mt-1">
          <b>Trend Detection</b> için gereklidir (YouTube Trending verileri). console.cloud.google.com → YouTube Data API v3 → API key oluştur → buraya yapıştır.
          Kanal OAuth credentials'larınız bundan ayrıdır; bu key sadece public "most popular" sorguları için kullanılır (~1 quota/saat).
        </div>
      {% endif %}
    </div>

    <h2 class="font-serif text-lg font-bold mt-6 border-t border-claude-border pt-4">Trend Detection</h2>
    <div class="bg-claude-surface border border-claude-border rounded-lg p-4 space-y-3">
      <label class="flex items-center gap-2 text-sm">
        <input type="checkbox" name="trends_enabled" value="1"
               {% if data.trends and data.trends.enabled %}checked{% endif %}>
        Etkin (genel anahtar; kanal başına ayrıca aç/kapat)
      </label>
      <div class="grid grid-cols-2 gap-3">
        <label class="block">
          <span class="text-xs text-claude-muted uppercase">Cron yenileme aralığı (dk)</span>
          <input type="number" name="trends_refresh_minutes" min="10" max="360"
                 value="{{ (data.trends.refresh_minutes if data.trends and data.trends.refresh_minutes else 60) }}"
                 class="bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
        </label>
        <label class="block">
          <span class="text-xs text-claude-muted uppercase">Cache geçerliliği (dk)</span>
          <input type="number" name="trends_cache_max_age_minutes" min="30" max="720"
                 value="{{ (data.trends.cache_max_age_minutes if data.trends and data.trends.cache_max_age_minutes else 90) }}"
                 class="bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
        </label>
      </div>
      <div>
        <span class="text-xs text-claude-muted uppercase block mb-1">Varsayılan kaynaklar</span>
        <div class="flex gap-4">
          {% set _srcs = (data.trends.default_sources if data.trends else ['google_daily', 'youtube']) %}
          <label class="text-sm flex items-center gap-2">
            <input type="checkbox" name="trends_src_google_daily" value="1"
                   {% if 'google_daily' in _srcs %}checked{% endif %}>
            Google Daily Trends
          </label>
          <label class="text-sm flex items-center gap-2">
            <input type="checkbox" name="trends_src_youtube" value="1"
                   {% if 'youtube' in _srcs %}checked{% endif %}>
            YouTube Trending
            {% if not youtube_key_set %}<span class="text-amber-600 text-xs">(API key gerekli)</span>{% endif %}
          </label>
        </div>
      </div>
      <div class="text-xs text-claude-muted">
        Kanalın trend boost ayarları kanal düzenleme sayfasındaki "İçerik" sekmesindedir. Kanal bazında bu varsayılan kaynaklar override edilebilir.
      </div>
    </div>

    <button type="submit" class="bg-claude-accent hover:bg-claude-accent-hover text-white px-4 py-2 rounded-lg font-semibold mt-6 w-full">
      Kaydet
    </button>
    <p class="text-xs text-claude-muted">
      Not: web host/port değişikliği panel restart gerektirir.
    </p>
  </div>

  <div>
    <h2 class="font-serif text-lg font-bold mb-4">Yol Bilgileri (read-only)</h2>
    <table class="w-full text-xs border border-claude-border rounded-lg overflow-hidden">
      <tbody>
        {% for label, p in paths.items() %}
        <tr class="border-b border-claude-border">
          <td class="p-2 bg-claude-surface text-claude-muted whitespace-nowrap">{{ label }}</td>
          <td class="p-2 font-mono break-all">{{ p }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</form>
{% endblock %}
