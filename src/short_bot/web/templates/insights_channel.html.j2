{% extends "base.html.j2" %}
{% block title %}İçgörüler — {{ cfg.name }}{% endblock %}
{% block content %}

<div class="flex items-center justify-between mb-6">
  <div>
    <div class="text-xs text-claude-muted uppercase">
      <a href="/insights" class="hover:underline">← İçgörüler</a>
    </div>
    <h1 class="font-serif text-3xl font-bold mt-1">{{ cfg.name }}</h1>
    <p class="text-sm text-claude-muted">
      Son <span class="font-mono">{{ insights.lookback_days }}</span> gün ·
      <span class="font-mono">{{ insights.upload_count }}</span> upload ·
      <span class="font-mono">{{ insights.sample_size }}</span> stats var
      {% if insights._meta and insights._meta.computed_at %}
        · hesaplandı <span class="font-mono">{{ insights._meta.computed_at[:16].replace('T',' ') }}</span>
      {% endif %}
    </p>
  </div>
  <form method="POST" action="/insights/{{ cfg.slug }}/refresh">
    <button type="submit"
            class="bg-claude-accent hover:bg-claude-accent-hover text-white px-4 py-2 rounded-lg text-sm font-semibold">
      ⟳ Şimdi yenile
    </button>
  </form>
</div>

{% if insights.stats_age_warning %}
<div class="bg-amber-50 border border-amber-300 text-amber-900 rounded-xl p-4 mb-4 text-sm">
  ⚠ Henüz hiçbir upload için YouTube Analytics verisi yok. YT 48-72 saat
  gecikmeyle stats sunar; ilk run'lardan sonra biraz beklemek gerekir.
</div>
{% elif insights.sample_size < 5 %}
<div class="bg-blue-50 border border-blue-300 text-blue-900 rounded-xl p-4 mb-4 text-sm">
  ℹ Sample size <span class="font-mono">{{ insights.sample_size }}</span> —
  scorer prompt'una hint enjeksiyonu için <b>en az 5</b> gerekir.
  Daha fazla upload + 72 saat sonra otomatik aktif olur.
</div>
{% else %}
<div class="bg-green-50 border border-green-300 text-green-900 rounded-xl p-4 mb-4 text-sm">
  ✓ İçgörüler scorer prompt'una <b>aktif olarak enjekte ediliyor</b>.
  Aşağıdaki kalıplar bu kanalın haber seçimini şekillendirir.
</div>
{% endif %}

{# ── Top View Examples ──────────────────────────────────────────────── #}
{% if insights.top_view_examples %}
<div class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
  <div class="px-5 py-3 border-b border-claude-border flex items-center justify-between">
    <h2 class="font-serif text-lg font-semibold">🏆 En çok görüntülenenler</h2>
    <span class="text-xs text-claude-muted">view sayısına göre sıralı</span>
  </div>
  <table class="w-full text-sm">
    <thead class="bg-claude-surface text-xs uppercase text-claude-muted">
      <tr>
        <th class="text-right px-5 py-2 w-24">Views</th>
        <th class="text-right px-5 py-2 w-20">Watch%</th>
        <th class="text-right px-5 py-2 w-16">Yaş</th>
        <th class="text-left  px-5 py-2 w-32">Kategori</th>
        <th class="text-left  px-5 py-2 w-24">Mood</th>
        <th class="text-left  px-5 py-2">Başlık</th>
      </tr>
    </thead>
    <tbody>
      {% for s in insights.top_view_examples %}
      <tr class="border-t border-claude-border/40">
        <td class="px-5 py-2 text-right font-mono font-semibold">{{ s.views }}</td>
        <td class="px-5 py-2 text-right font-mono {% if s.watch_pct >= 100 %}text-green-700 font-semibold{% endif %}">
          {% if s.watch_pct > 0 %}{{ '%.0f'|format(s.watch_pct) }}%{% else %}<span class="text-claude-muted">—</span>{% endif %}
        </td>
        <td class="px-5 py-2 text-right font-mono text-xs text-claude-muted">{{ s.age_days }}g</td>
        <td class="px-5 py-2 text-xs">{{ s.category }}</td>
        <td class="px-5 py-2 text-xs">
          {% if s.mood == 'breaking' %}<span class="bg-red-100 text-red-800 px-1.5 py-0.5 rounded">{{ s.mood }}</span>
          {% elif s.mood == 'upbeat' %}<span class="bg-green-100 text-green-800 px-1.5 py-0.5 rounded">{{ s.mood }}</span>
          {% else %}<span class="bg-gray-100 text-gray-800 px-1.5 py-0.5 rounded">{{ s.mood }}</span>{% endif %}
        </td>
        <td class="px-5 py-2">{{ s.title[:80] }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{# ── Watch% Leaders ─────────────────────────────────────────────────── #}
{% if insights.watch_pct_leaders %}
<div class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
  <div class="px-5 py-3 border-b border-claude-border">
    <h2 class="font-serif text-lg font-semibold">🎯 İzleyicinin tekrar oynattığı başlıklar</h2>
    <p class="text-xs text-claude-muted">
      Watch% > 100 = izleyici videoyu loop'ta tekrar oynatmış. En güçlü engagement sinyali.
    </p>
  </div>
  <table class="w-full text-sm">
    <thead class="bg-claude-surface text-xs uppercase text-claude-muted">
      <tr>
        <th class="text-right px-5 py-2 w-24">Watch%</th>
        <th class="text-right px-5 py-2 w-24">Views</th>
        <th class="text-left  px-5 py-2 w-32">Kategori</th>
        <th class="text-left  px-5 py-2">Başlık</th>
      </tr>
    </thead>
    <tbody>
      {% for s in insights.watch_pct_leaders %}
      <tr class="border-t border-claude-border/40">
        <td class="px-5 py-2 text-right font-mono font-bold text-green-700">{{ '%.0f'|format(s.watch_pct) }}%</td>
        <td class="px-5 py-2 text-right font-mono">{{ s.views }}</td>
        <td class="px-5 py-2 text-xs">{{ s.category }}</td>
        <td class="px-5 py-2">{{ s.title[:80] }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

{# ── Categories ─────────────────────────────────────────────────────── #}
<div class="grid grid-cols-2 gap-4 mb-4">
  {% if insights.top_categories %}
  <div class="bg-white border border-claude-border rounded-xl shadow-soft">
    <div class="px-5 py-3 border-b border-claude-border">
      <h2 class="font-serif text-lg font-semibold">📊 Kategoriler</h2>
      <p class="text-xs text-claude-muted">n≥2 olan kategoriler, total view sırasında</p>
    </div>
    <table class="w-full text-sm">
      <thead class="bg-claude-surface text-xs uppercase text-claude-muted">
        <tr>
          <th class="text-left  px-5 py-2">Kategori</th>
          <th class="text-right px-5 py-2 w-12">n</th>
          <th class="text-right px-5 py-2 w-20">avg view</th>
          <th class="text-right px-5 py-2 w-20">avg %watch</th>
        </tr>
      </thead>
      <tbody>
        {% for c in insights.top_categories %}
        <tr class="border-t border-claude-border/40">
          <td class="px-5 py-2 text-xs">{{ c.category }}</td>
          <td class="px-5 py-2 text-right font-mono">{{ c.n }}</td>
          <td class="px-5 py-2 text-right font-mono">{{ '%.0f'|format(c.avg_views) }}</td>
          <td class="px-5 py-2 text-right font-mono">{{ '%.0f'|format(c.avg_watch_pct) }}%</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% if insights.top_moods %}
  <div class="bg-white border border-claude-border rounded-xl shadow-soft">
    <div class="px-5 py-3 border-b border-claude-border">
      <h2 class="font-serif text-lg font-semibold">🎭 Mood'lar</h2>
      <p class="text-xs text-claude-muted">avg view'a göre sıralı</p>
    </div>
    <table class="w-full text-sm">
      <thead class="bg-claude-surface text-xs uppercase text-claude-muted">
        <tr>
          <th class="text-left  px-5 py-2">Mood</th>
          <th class="text-right px-5 py-2 w-12">n</th>
          <th class="text-right px-5 py-2 w-20">avg view</th>
          <th class="text-right px-5 py-2 w-20">avg %watch</th>
        </tr>
      </thead>
      <tbody>
        {% for m in insights.top_moods %}
        <tr class="border-t border-claude-border/40">
          <td class="px-5 py-2 text-xs">
            {% if m.mood == 'breaking' %}<span class="bg-red-100 text-red-800 px-1.5 py-0.5 rounded">{{ m.mood }}</span>
            {% elif m.mood == 'upbeat' %}<span class="bg-green-100 text-green-800 px-1.5 py-0.5 rounded">{{ m.mood }}</span>
            {% else %}<span class="bg-gray-100 text-gray-800 px-1.5 py-0.5 rounded">{{ m.mood }}</span>{% endif %}
          </td>
          <td class="px-5 py-2 text-right font-mono">{{ m.n }}</td>
          <td class="px-5 py-2 text-right font-mono">{{ '%.0f'|format(m.avg_views) }}</td>
          <td class="px-5 py-2 text-right font-mono">{{ '%.0f'|format(m.avg_watch_pct) }}%</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</div>

{# ── Bottom (cautionary) ─────────────────────────────────────────────── #}
{% if insights.bottom_examples %}
<details class="bg-claude-surface border border-claude-border rounded-xl">
  <summary class="px-5 py-3 cursor-pointer font-medium text-sm">
    En düşük performans örnekleri ({{ insights.bottom_examples|length }})
  </summary>
  <table class="w-full text-sm">
    <tbody>
      {% for s in insights.bottom_examples %}
      <tr class="border-t border-claude-border/40">
        <td class="px-5 py-2 text-right font-mono w-24 text-claude-muted">{{ s.views }}v</td>
        <td class="px-5 py-2 w-32 text-xs">{{ s.category }}</td>
        <td class="px-5 py-2">{{ s.title[:80] }}</td>
        <td class="px-5 py-2 text-right text-xs text-claude-muted w-16">{{ s.age_days }}g</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</details>
{% endif %}

{% endblock %}
