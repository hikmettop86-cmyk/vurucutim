{% extends "base.html.j2" %}
{% block title %}Vurucu TİM — {{ s.title }}{% endblock %}
{% block content %}
<a href="/shorts" class="text-claude-muted hover:text-claude-text text-sm">← Shorts</a>
<div class="flex flex-col gap-3 mt-2 mb-1">
  <h1 class="font-serif text-3xl font-bold break-words line-clamp-2" title="{{ s.title }}">{{ s.title }}</h1>
  <div class="flex flex-wrap gap-2">
    <a href="{{ s.file_url }}" download
       class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm text-claude-text">
      ↓ İndir
    </a>
    <button x-data x-on:click="navigator.clipboard.writeText(window.location.origin + '{{ s.file_url }}'); $el.textContent = 'Kopyalandı ✓'; setTimeout(() => $el.textContent = '⎘ URL kopyala', 2000)"
            class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm text-claude-text">
      ⎘ URL kopyala
    </button>
    <form method="POST" action="/shorts/{{ s.id }}/delete" class="inline"
          onsubmit="return confirm('Bu short silinsin mi?')">
      <button type="submit"
              class="bg-claude-error hover:bg-red-700 text-white px-3 py-2 rounded-lg text-sm">
        Sil
      </button>
    </form>
    {% if yt_upload and yt_upload.status == 'success' %}
      <a href="{{ yt_upload.video_url }}" target="_blank"
         class="bg-claude-success/10 ring-1 ring-claude-success/30 text-claude-success px-3 py-2 rounded-lg text-sm">
        ▶ YouTube ({{ yt_upload.video_id }})
      </a>
    {% else %}
      <div class="flex flex-col gap-1">
        <form method="POST" action="/shorts/{{ s.id }}/upload-youtube" class="inline"
              onsubmit="return confirm('Bu shortu YouTube\'a yükle?');">
          <button class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm text-claude-text {% if not yt_connected %}opacity-50 cursor-not-allowed{% endif %}"
                  {% if not yt_connected %}disabled title="Önce kanal edit sayfasından YouTube bağla"{% endif %}>
            ↑ YouTube'a Yükle
          </button>
        </form>
        {% if yt_upload and yt_upload.status == 'failed' %}
          <div class="text-xs text-claude-error">Son deneme başarısız: {{ yt_upload.error[:80] }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>
<div class="text-claude-muted text-sm mb-6">
  {{ s.channel }} · {{ s.created_at.strftime('%d %b %Y, %H:%M') }} · {{ s.duration_s }}s · render {{ s.render_ms }}ms
</div>

{% if yt_video_stats %}
  {% set v = yt_video_stats[0] %}
  <div class="bg-claude-surface border border-claude-border rounded-lg p-4 mt-4 mb-4">
    <div class="text-xs text-claude-muted uppercase tracking-wider mb-2">YouTube performansı</div>
    <div class="grid grid-cols-3 gap-4 text-sm">
      <div>
        <div class="text-[10px] text-claude-muted uppercase">İzlenme</div>
        <div class="font-bold text-lg">{{ "{:,}".format(v.views).replace(',', '.') }}</div>
      </div>
      <div>
        <div class="text-[10px] text-claude-muted uppercase">Beğeni</div>
        <div class="font-bold text-lg">{{ v.likes }}</div>
      </div>
      <div>
        <div class="text-[10px] text-claude-muted uppercase">Yorum</div>
        <div class="font-bold text-lg">{{ v.comments }}</div>
      </div>
      <div>
        <div class="text-[10px] text-claude-muted uppercase">İzleme dakikası (7g)</div>
        <div class="font-bold text-lg">{{ "%.1f"|format(v.watch_time_min) }}</div>
      </div>
      <div>
        <div class="text-[10px] text-claude-muted uppercase">Ort. izleme süresi</div>
        <div class="font-bold text-lg">{{ "%.0f"|format(v.avg_view_duration_s) }}s</div>
      </div>
    </div>
    <div class="text-[10px] text-claude-subtle mt-2">
      Snapshot: {{ v.snapshot_date }} · Kümülatif istatistikler.
    </div>
  </div>
{% endif %}

<div class="grid grid-cols-3 gap-6">
  <div class="col-span-1">
    <video controls class="w-full bg-black rounded-lg">
      <source src="{{ s.file_url }}" type="video/mp4">
    </video>
  </div>
  <div class="col-span-2 space-y-3">
    <div class="bg-claude-surface border border-claude-border rounded-lg p-4">
      <div class="text-xs text-claude-muted uppercase tracking-wider mb-1">Dosya</div>
      <div class="font-mono text-xs">{{ s.file_path }}</div>
    </div>
    <div class="bg-claude-surface border border-claude-border rounded-lg p-4">
      <div class="text-xs text-claude-muted uppercase tracking-wider mb-1">RSS GUID</div>
      <div class="font-mono text-xs break-all">{{ s.rss_item_guid }}</div>
    </div>
    <div class="bg-claude-surface border border-claude-border rounded-lg p-4">
      <div class="text-xs text-claude-muted uppercase tracking-wider mb-1">Script JSON</div>
      <pre class="text-xs whitespace-pre-wrap">{{ s.script_json }}</pre>
    </div>
  </div>
</div>
{% endblock %}
