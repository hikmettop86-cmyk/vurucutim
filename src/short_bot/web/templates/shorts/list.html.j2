{% extends "base.html.j2" %}
{% block title %}Vurucu TİM — Shorts{% endblock %}
{% block content %}
<div class="flex justify-between items-center mb-6">
  <h1 class="font-serif text-3xl font-bold">Shorts</h1>
  <form method="POST" action="/shorts/delete-all"
        onsubmit="return confirmBulkDelete(this);"
        class="flex items-center gap-2">
    <input type="hidden" name="channel" value="{{ channel }}">
    <input type="hidden" name="q" value="{{ q }}">
    <input type="hidden" name="since" value="{{ since }}">
    <input type="hidden" name="youtube" value="{{ youtube }}">
    <button type="submit"
            class="text-xs px-3 py-1.5 rounded-lg bg-claude-error-soft border border-claude-error/30 text-claude-error hover:bg-claude-error-soft transition-colors"
            title="Filtreye uyan tüm shortları sil (geri alınamaz)">
      🗑 Tümünü sil
    </button>
  </form>
</div>
<script>
/* SÜZGEÇLER EKRANDAN OKUNUR, gizli alanlardan DEĞİL.
   Kusur: süzgeç kutuları HTMX ile yalnız ızgarayı tazeliyor; adres çubuğu
   (hx-push-url yok) ve dolayısıyla sunucudan gelen gizli alanlar hiç
   değişmiyordu. Kullanıcı "galatasaray"a süzüp ızgarada 10 video
   görürken bu düğme BÜTÜN kanalları siliyordu — düğmenin kendi
   ipucu ise "Filtreye uyan tüm shortları sil" diyordu.
   Çözüm: gönderimden ÖNCE ekrandaki değerler gizli alanlara yazılır. */
const BULK_ALANLAR = ['channel', 'q', 'since', 'youtube'];

function suzgecDegeri(ad) {
  const el = document.querySelector(`[name="${ad}"]:not([type=hidden])`);
  return el ? (el.value || '').trim() : '';
}

function bulkAlanlariEsitle(form) {
  const params = new URLSearchParams();
  for (const ad of BULK_ALANLAR) {
    const deger = suzgecDegeri(ad);
    const gizli = form.querySelector(`input[type=hidden][name="${ad}"]`);
    if (gizli) gizli.value = deger;
    if (deger) params.set(ad, deger);
  }
  return params;
}

async function confirmBulkDelete(form) {
  const params = bulkAlanlariEsitle(form);
  let count = null;
  try {
    const r = await fetch('/shorts/count?' + params.toString());
    const j = await r.json();
    count = j.count;
  } catch (e) { /* ağ hatası — sayısız sor */ }
  const suzuluyor = params.toString() !== '';
  const kapsam = suzuluyor
    ? 'filtreye uyan (' + [...params].map(([k, v]) => k + '=' + v).join(', ') + ')'
    : 'TÜM kanallardaki TÜM';
  const msg = count !== null
    ? `${count} adet ${kapsam} short silinecek. Devam edilsin mi?`
    : `${kapsam} shortlar silinecek. Devam edilsin mi?`;
  return confirm(msg);
}
</script>

<div class="flex gap-3 mb-3 items-center">
  <input type="text" name="q" value="{{ q }}" placeholder="Başlık ara..."
         class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg text-sm flex-1 text-claude-text placeholder:text-claude-muted"
         hx-get="/shorts/grid" hx-target="#grid" hx-trigger="keyup changed delay:300ms"
         hx-include="[name='channel'], [name='since'], [name='youtube']">
  <select name="channel" class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg text-sm text-claude-text"
          hx-get="/shorts/grid" hx-target="#grid" hx-trigger="change"
          hx-include="[name='q'], [name='since'], [name='youtube']">
    <option value="">Tüm kanallar</option>
    {% for c in all_channels %}
      <option value="{{ c.slug }}" {% if channel == c.slug %}selected{% endif %}>{{ c.slug }}</option>
    {% endfor %}
  </select>
  <select name="since" class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg text-sm text-claude-text"
          hx-get="/shorts/grid" hx-target="#grid" hx-trigger="change"
          hx-include="[name='q'], [name='channel'], [name='youtube']">
    <option value="">Tüm zaman</option>
    <option value="1h" {% if since == '1h' %}selected{% endif %}>Son 1 saat</option>
    <option value="today" {% if since == 'today' %}selected{% endif %}>Bugün</option>
    <option value="week" {% if since == 'week' %}selected{% endif %}>Son 7 gün</option>
  </select>
  <select name="youtube" class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg text-sm text-claude-text"
          hx-get="/shorts/grid" hx-target="#grid" hx-trigger="change"
          hx-include="[name='q'], [name='channel'], [name='since']">
    <option value="">YT: hepsi</option>
    <option value="yes" {% if youtube == 'yes' %}selected{% endif %}>YT yüklü</option>
    <option value="no" {% if youtube == 'no' %}selected{% endif %}>YT yüklenmedi</option>
  </select>
</div>

{% if channel or q or since or youtube %}
<div class="flex flex-wrap gap-2 mb-4 items-center text-xs">
  <span class="text-claude-muted">Aktif filtre:</span>
  {% if channel %}<span class="bg-claude-surface border border-claude-border px-2 py-0.5 rounded">kanal={{ channel }}</span>{% endif %}
  {% if q %}<span class="bg-claude-surface border border-claude-border px-2 py-0.5 rounded">arama="{{ q }}"</span>{% endif %}
  {% if since %}<span class="bg-claude-surface border border-claude-border px-2 py-0.5 rounded">{{ {'1h':'son 1 saat','today':'bugün','week':'son 7 gün'}[since] }}</span>{% endif %}
  {% if youtube %}<span class="bg-claude-surface border border-claude-border px-2 py-0.5 rounded">YT {{ 'yüklü' if youtube == 'yes' else 'yüklenmedi' }}</span>{% endif %}
  <a href="/shorts" class="text-claude-muted hover:text-claude-text underline ml-1">temizle</a>
</div>
{% endif %}

<div id="grid">
  {% include "_partials/shorts_grid.html.j2" %}
</div>
{% endblock %}
