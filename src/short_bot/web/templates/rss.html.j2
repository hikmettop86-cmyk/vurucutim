{% extends "base.html.j2" %}
{% block title %}short-bot — RSS{% endblock %}
{% block content %}
<h1 class="text-3xl font-bold mb-4">RSS taraması (son 24s)</h1>

<table class="w-full text-xs">
  <thead class="bg-slate-800">
    <tr class="text-left">
      <th class="p-2">Skor</th>
      <th class="p-2">Başlık</th>
      <th class="p-2">Kaynak</th>
      <th class="p-2">Kanal</th>
      <th class="p-2">Saat</th>
      <th class="p-2">Durum</th>
    </tr>
  </thead>
  <tbody>
    {% for it in items %}
    <tr class="border-b border-slate-800 hover:bg-slate-800/50">
      <td class="p-2 font-bold {% if it.score and it.score >= 8 %}text-green-400{% elif it.score and it.score >= 6 %}text-yellow-400{% else %}text-slate-500{% endif %}">
        {{ '%.1f'|format(it.score) if it.score else '—' }}
      </td>
      <td class="p-2">{{ it.title }}</td>
      <td class="p-2 text-slate-400">{{ it.source or '—' }}</td>
      <td class="p-2 text-slate-400">{{ it.channel }}</td>
      <td class="p-2 text-slate-400">{{ it.fetched_at.strftime('%H:%M') }}</td>
      <td class="p-2">
        {% if it.status == 'selected' %}
          <span class="bg-green-700 text-white px-2 py-0.5 rounded text-[10px] uppercase">selected</span>
        {% elif it.status == 'below_threshold' %}
          <span class="text-slate-500">below threshold</span>
        {% elif it.status == 'duplicate' %}
          <span class="text-red-400">duplicate</span>
        {% else %}
          <span class="text-slate-500">{{ it.status or '—' }}</span>
        {% endif %}
      </td>
    </tr>
    {% else %}
    <tr><td colspan="6" class="p-8 text-center text-slate-500">Son 24 saatte RSS item yok.</td></tr>
    {% endfor %}
  </tbody>
</table>
{% endblock %}
