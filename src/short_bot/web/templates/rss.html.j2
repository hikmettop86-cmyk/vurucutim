{% extends "base.html.j2" %}
{% block title %}short-bot — RSS{% endblock %}
{% block content %}
<h1 class="font-serif text-3xl font-bold mb-6">RSS taraması (son 24s)</h1>

<table class="w-full text-xs border border-claude-border rounded-lg overflow-hidden">
  <thead class="bg-claude-surface">
    <tr class="text-left">
      <th class="p-3">Skor</th>
      <th class="p-3">Başlık</th>
      <th class="p-3">Kaynak</th>
      <th class="p-3">Kanal</th>
      <th class="p-3">Saat</th>
      <th class="p-3">Durum</th>
    </tr>
  </thead>
  <tbody>
    {% for it in items %}
    <tr class="border-b border-claude-border hover:bg-claude-surface-alt">
      <td class="p-3 font-bold {% if it.score and it.score >= 8 %}text-claude-success{% elif it.score and it.score >= 6 %}text-yellow-600{% else %}text-claude-muted{% endif %}">
        {{ '%.1f'|format(it.score) if it.score else '—' }}
      </td>
      <td class="p-3">{{ it.title }}</td>
      <td class="p-3 text-claude-muted">{{ it.source or '—' }}</td>
      <td class="p-3 text-claude-muted">{{ it.channel }}</td>
      <td class="p-3 text-claude-muted">{{ it.fetched_at.strftime('%H:%M') }}</td>
      <td class="p-3">
        {% if it.status == 'selected' %}
          <span class="bg-claude-success text-white px-2 py-0.5 rounded text-[10px] uppercase">selected</span>
        {% elif it.status == 'below_threshold' %}
          <span class="text-claude-muted">below threshold</span>
        {% elif it.status == 'duplicate' %}
          <span class="bg-claude-error text-white px-2 py-0.5 rounded text-[10px] uppercase">duplicate</span>
        {% else %}
          <span class="text-claude-muted">{{ it.status or '—' }}</span>
        {% endif %}
      </td>
    </tr>
    {% else %}
    <tr><td colspan="6" class="p-8 text-center text-claude-muted">Son 24 saatte RSS item yok.</td></tr>
    {% endfor %}
  </tbody>
</table>
{% endblock %}
