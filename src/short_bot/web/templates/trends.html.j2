{% extends "base.html.j2" %}
{% block title %}Vurucu TIM — Trendler{% endblock %}
{% block content %}

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="font-serif text-3xl font-bold">Trendler</h1>
    <p class="text-sm text-claude-muted mt-1">
      Pipeline scorer'a bonus puan veren aktif trend listesi.
      {% if settings_enabled %}
        <span class="inline-block bg-green-700 text-green-100 px-2 py-0.5 rounded text-xs ml-2">AKTIF</span>
      {% else %}
        <span class="inline-block bg-amber-700 text-amber-100 px-2 py-0.5 rounded text-xs ml-2">KAPALI</span>
        <a href="/settings" class="underline ml-1">Ayarlardan ac</a>
      {% endif %}
    </p>
  </div>
  <form method="POST" action="/trends/refresh">
    <button type="submit"
            class="bg-claude-accent hover:bg-claude-accent-hover text-white px-4 py-2 rounded-lg text-sm font-semibold"
            {% if not settings_enabled or not regions %}disabled style="opacity:0.5;cursor:not-allowed"{% endif %}>
      ⟳ Simdi yenile
    </button>
  </form>
</div>

<div class="bg-white border border-claude-border rounded-xl shadow-soft p-5 mb-6">
  <div class="grid grid-cols-3 gap-4 text-sm">
    <div>
      <div class="text-xs uppercase text-claude-muted">Otomatik yenileme</div>
      <div class="font-mono font-semibold">{{ refresh_minutes }} dk</div>
    </div>
    <div>
      <div class="text-xs uppercase text-claude-muted">Cache tazelik esigi</div>
      <div class="font-mono font-semibold">{{ '%.0f'|format(cache_max_age_minutes) }} dk</div>
    </div>
    <div>
      <div class="text-xs uppercase text-claude-muted">Aktif bolge sayisi</div>
      <div class="font-mono font-semibold">{{ regions|length }}</div>
    </div>
  </div>
</div>

{# ── Cache snapshot per region ─────────────────────────────────────────── #}
{% if regions %}
  {% for r in regions %}
  <div class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
    <div class="px-5 py-3 border-b border-claude-border flex items-center justify-between">
      <h2 class="font-serif text-lg font-semibold">
        Bolge: <span class="font-mono">{{ r.region }}</span>
        <span class="text-xs font-sans text-claude-muted ml-2">
          aranan kaynaklar: {{ r.sources_wanted|join(', ') }}
        </span>
      </h2>
      {% if r.cache %}
        <div class="text-xs text-claude-muted">
          {{ r.cache.items|length }} terim ·
          fetched {{ '%.0f'|format(r.cache.age_minutes()) }} dk once ·
          kaynaklar: <span class="font-mono">{{ r.cache.sources|join(', ') }}</span>
          {% if r.cache.is_fresh(cache_max_age_minutes) %}
            <span class="bg-green-700 text-green-100 px-1.5 py-0.5 rounded ml-2">taze</span>
          {% else %}
            <span class="bg-amber-700 text-amber-100 px-1.5 py-0.5 rounded ml-2">eski</span>
          {% endif %}
        </div>
      {% else %}
        <div class="text-xs text-amber-700">cache yok — yenile butonuna bas</div>
      {% endif %}
    </div>
    {% if r.cache and r.cache.items %}
    <table class="w-full text-sm">
      <thead class="bg-claude-surface">
        <tr class="text-xs uppercase text-claude-muted">
          <th class="text-left px-5 py-2 w-16">#</th>
          <th class="text-left px-5 py-2">Terim</th>
          <th class="text-left px-5 py-2 w-24">Kaynak</th>
          <th class="text-right px-5 py-2 w-24">Skor</th>
        </tr>
      </thead>
      <tbody>
        {% for it in r.cache.items[:25] %}
        <tr class="border-t border-claude-border/40">
          <td class="px-5 py-2 font-mono text-claude-muted">{{ it.rank }}</td>
          <td class="px-5 py-2">{{ it.term }}</td>
          <td class="px-5 py-2 font-mono text-xs">
            {% if it.source == 'google_daily' %}
              <span class="bg-blue-100 text-blue-800 px-1.5 py-0.5 rounded">google</span>
            {% elif it.source == 'youtube' %}
              <span class="bg-red-100 text-red-800 px-1.5 py-0.5 rounded">youtube</span>
            {% else %}{{ it.source }}{% endif %}
          </td>
          <td class="px-5 py-2 font-mono text-right">{{ '%.2f'|format(it.score) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </div>
  {% endfor %}
{% else %}
  <div class="bg-claude-surface border border-claude-border rounded-xl p-6 text-center text-claude-muted">
    Hicbir kanalda <span class="font-mono">trend_boost.enabled=true</span> yok.
    <a href="/channels" class="underline">Bir kanal sec</a>
    ve "Icerik" tabinda Trend Boost karti uzerinden ac.
  </div>
{% endif %}

{# ── Channel coverage table ───────────────────────────────────────────── #}
<div class="bg-white border border-claude-border rounded-xl shadow-soft mt-6">
  <div class="px-5 py-3 border-b border-claude-border">
    <h2 class="font-serif text-lg font-semibold">Kanal kapsam</h2>
    <p class="text-xs text-claude-muted">Hangi kanalda trend boost acik, hangi bolge/kaynak okuyor.</p>
  </div>
  <table class="w-full text-sm">
    <thead class="bg-claude-surface">
      <tr class="text-xs uppercase text-claude-muted">
        <th class="text-left px-5 py-2">Kanal</th>
        <th class="text-left px-5 py-2 w-20">Dil</th>
        <th class="text-left px-5 py-2 w-24">Bolge</th>
        <th class="text-left px-5 py-2">Boost</th>
        <th class="text-left px-5 py-2">Kaynaklar</th>
        <th class="text-right px-5 py-2 w-24">Max</th>
      </tr>
    </thead>
    <tbody>
      {% for ch in channels %}
      <tr class="border-t border-claude-border/40 {% if not ch.enabled %}opacity-50{% endif %}">
        <td class="px-5 py-2">
          <a href="/channels/{{ ch.slug }}/edit#icerik" class="font-medium hover:underline">{{ ch.name }}</a>
          <div class="text-xs text-claude-muted font-mono">{{ ch.slug }}</div>
        </td>
        <td class="px-5 py-2 font-mono">{{ ch.language }}</td>
        <td class="px-5 py-2 font-mono">{{ ch.tb_region }}</td>
        <td class="px-5 py-2">
          {% if ch.tb_enabled %}
            <span class="bg-green-700 text-green-100 px-2 py-0.5 rounded text-xs">aktif</span>
          {% else %}
            <span class="text-claude-muted text-xs">—</span>
          {% endif %}
        </td>
        <td class="px-5 py-2 text-xs font-mono">
          {% if ch.tb_sources %}{{ ch.tb_sources|join(', ') }}{% else %}—{% endif %}
        </td>
        <td class="px-5 py-2 text-right font-mono">
          {% if ch.tb_max_boost %}+{{ '%.1f'|format(ch.tb_max_boost) }}{% else %}—{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% endblock %}
