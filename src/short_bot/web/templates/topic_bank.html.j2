{% extends "base.html.j2" %}
{% block title %}Konu Bankası — {{ channel.name }}{% endblock %}

{# Kısa sayı: 38.268.892 okunmaz, "38,3 M" okunur. Kanıt metriği olduğu için göz
   bir bakışta kavramalı. Binde BOŞLUKLU "B" — "98B" bin mi milyar mı belirsizdi. #}
{% macro kisa(n) %}
  {%- if n >= 1000000 -%}{{ ('%.1f'|format(n / 1000000))|replace('.', ',') }} M
  {%- elif n >= 1000 -%}{{ ('%.1f'|format(n / 1000))|replace('.', ',') }} B
  {%- else -%}{{ n }}{%- endif -%}
{% endmacro %}

{% block content %}
<div class="max-w-5xl mx-auto p-6">

  <div class="flex items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-claude-text">Konu Bankası</h1>
      <p class="text-sm text-claude-muted mt-1">
        {{ channel.name }} · nişinde patlamış videolardan damıtılmış
        <span class="text-claude-text font-medium">{{ rows|length }} kanıtlanmış konu</span>.
        Üretilen konu listeden düşer, bir daha üretilmez.
      </p>
    </div>
    <div class="flex items-center gap-2 flex-shrink-0">
      {# Konu damıtması eskiden sistemin EN UCUZ modelinde koşuyordu ve bankanın %85'i
         çöp oldu (ölçüldü); bazıları bilimsel olarak YANLIŞTI. Yeni konular üretim
         anında doğrulanıyor — bu düğme ESKİ kayıtları temizler. #}
      {% if rows %}
      <form method="post" action="/channels/{{ slug }}/topic-bank/audit"
            onsubmit="return confirm('Bankadaki {{ rows|length }} aktif konu Sonnet 5 ile denetlenecek. İçi boş, vaat eden ya da bilimsel olarak YANLIŞ olanlar REDDEDİLECEK. Devam edilsin mi?')">
        <button class="px-4 py-2 rounded-lg bg-white border border-claude-border
                       text-sm font-semibold text-claude-text hover:bg-claude-surface-alt">
          Bankayı denetle</button>
      </form>
      {% endif %}
      <form method="post" action="/channels/{{ slug }}/topic-bank/refresh">
        <button class="px-4 py-2 rounded-lg bg-claude-accent hover:opacity-90 text-white
                       text-sm font-semibold shadow-sm">Yenile</button>
      </form>
    </div>
  </div>

  {% with messages = get_flashed_messages() %}
    {% for m in messages %}
      <div class="mb-4 px-4 py-3 rounded-lg bg-claude-surface border border-claude-border
                  text-sm text-claude-text">{{ m }}</div>
    {% endfor %}
  {% endwith %}

  {# SU SEVİYESİ. Otomasyon günde ~2-3 konu tüketiyor; banka kuruyunca üretim DURMAZ
     ama SESSİZCE BOZULUR (seri durur, konular LLM'in uydurmasına kalır). #}
  {% if low_water and rows|length < low_water %}
  <div class="mb-6 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-sm
              text-red-700">
    <b>⚠ Banka azaldı — {{ rows|length }} konu kaldı.</b>
    Sistem 4 saatte bir otomatik doldurmaya çalışıyor. Yine de azalıyorsa nişin
    arama havuzu tükeniyor demektir; en güçlü çare <b>referans kanal eklemek</b>
    (aşağıda) — o kanalların kendi patlamalarını madenler, aramaya hiç gerek kalmaz.
  </div>
  {% endif %}

  <details class="mb-6 rounded-lg border border-claude-border bg-claude-surface"
           {% if channel.reference_channels %}open{% endif %}>
    <summary class="px-4 py-3 text-sm font-semibold text-claude-text cursor-pointer select-none">
      Referans kanallar
      <span class="text-claude-muted font-normal">({{ channel.reference_channels|length }}) — opsiyonel</span>
    </summary>
    <form method="post" action="/channels/{{ slug }}/topic-bank/refs" class="px-4 pb-4">
      <textarea name="reference_channels" rows="3"
                placeholder="https://www.youtube.com/@KanalAdi (her satıra bir kanal)"
                class="w-full bg-white border border-claude-border rounded-lg px-3 py-2
                       text-sm font-mono text-claude-text">{{ channel.reference_channels|join('\n') }}</textarea>
      <p class="text-xs text-claude-muted mt-2">Senin formatını yapan rakip/örnek kanallar.
        Yenile'de önce bunların kendi ortalamasına göre patlayan shorts'ları madenlenir
        (format ve kitle garantili); yeterse arama atlanır.</p>
      <button class="mt-3 px-3 py-1.5 rounded-lg bg-white border border-claude-border
                     text-xs font-semibold text-claude-text hover:bg-claude-surface-alt">
        Kaydet</button>
    </form>
  </details>

  {% if not rows %}
    <div class="rounded-xl border border-dashed border-claude-border bg-claude-surface
                px-6 py-12 text-center">
      <p class="text-claude-text font-medium">Banka boş</p>
      <p class="text-sm text-claude-muted mt-1">
        "Yenile" ile nişindeki patlamış videolardan konu madenle. Birkaç dakika sürer.
      </p>
    </div>
  {% else %}
    <div class="space-y-3">
    {% for r in rows %}
      {# PATLAMA KATSAYISI kanıtın özüdür: 38M izlenme 98B abonelik bir kanaldan
         geldiyse video kanalın kendi boyutunu ~390 KAT aşmış demektir. Ham izlenme
         sayısı bunu göstermez — büyük kanalda 38M sıradan olabilir. #}
      {% set kat = (r.views // r.subs) if r.subs else 0 %}
      <article class="rounded-xl border border-claude-border bg-white p-5
                      hover:border-claude-accent/40 transition-colors">
        <div class="flex items-start gap-5">
          <div class="flex-1 min-w-0">
            <p class="text-claude-text leading-snug">{{ r.topic }}</p>

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mt-3 text-xs">
              {# KAYNAK: kanıtlı mı, üretilmiş mi? Kanıtsız bir konuyu kanıtlı sanmak
                 sessiz bir yanılgıdır. #}
              {% if r.source == 'llm' %}
              <span class="px-2 py-0.5 rounded-md bg-claude-surface-alt text-claude-muted
                           font-semibold" title="YouTube kanıtı yok — model kendi bilgisiyle üretti">
                model önerisi</span>
              {% elif r.source == 'reference' %}
              <span class="px-2 py-0.5 rounded-md bg-claude-accent/10 text-claude-accent
                           font-semibold" title="Referans kanalın kendi patlaması — format ve kitle kanıtlı">
                referans kanal</span>
              {% endif %}
              {% if kat >= 10 %}
              <span class="px-2 py-0.5 rounded-md bg-claude-accent/10 text-claude-accent
                           font-semibold">{{ kat }}× patlama</span>
              {% endif %}
              {# Kanıtsız konuda izlenme/abone YOK — "0 izlenme" yazmak yanıltıcı olur. #}
              {% if r.views %}
              <span class="text-claude-muted">
                <span class="text-claude-text font-medium">{{ kisa(r.views) }}</span> izlenme
              </span>
              <span class="text-claude-muted">
                <span class="text-claude-text font-medium">{{ kisa(r.subs) }}</span> abone kanal
              </span>
              {% endif %}
              {% if r.hook_pattern %}
              <span class="px-2 py-0.5 rounded-md bg-claude-surface-alt text-claude-muted">
                {{ r.hook_pattern }}</span>
              {% endif %}
            </div>

            {% if r.source_title %}
            <p class="text-xs text-claude-muted mt-2 truncate" title="{{ r.source_title }}">
              kaynak: {{ r.source_title }}</p>
            {% endif %}
          </div>

          <div class="flex flex-col items-stretch gap-2 flex-shrink-0">
            {# Konuyu KULLANICI seçer: normal üretimde başlığı LLM seçer. Üretime
               verilen konu ANINDA 'used' işaretlenir ve listeden düşer. #}
            <form method="post" action="/channels/{{ slug }}/topic-bank/{{ r.id }}/produce"
                  onsubmit="return confirm('Bu konudan video üretilsin mi? (~10 dk)')">
              <button class="w-full px-4 py-2 rounded-lg bg-claude-accent hover:opacity-90
                             text-white text-sm font-semibold whitespace-nowrap">
                Bu konudan üret</button>
            </form>
            <form method="post" action="/channels/{{ slug }}/topic-bank/{{ r.id }}/reject">
              <button class="w-full px-4 py-1.5 rounded-lg text-xs text-claude-muted
                             hover:text-claude-accent">Reddet</button>
            </form>
          </div>
        </div>
      </article>
    {% endfor %}
    </div>
  {% endif %}
</div>
{% endblock %}
