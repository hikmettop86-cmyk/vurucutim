{% extends "base.html.j2" %}
{% block title %}Konu Bankası — {{ channel.name }}{% endblock %}
{% block content %}
<div class="max-w-4xl mx-auto p-6">
  <h1 class="text-2xl font-bold mb-1">🎯 Konu Bankası — {{ channel.name }}</h1>
  <p class="text-sm opacity-70 mb-4">Nişte patlamış videolardan damıtılmış
    kanıtlanmış konular. Üretim bunlardan ilham alır; kullanılan işaretlenir.</p>

  <form method="post" action="/channels/{{ slug }}/topic-bank/refresh" class="mb-4">
    <button class="px-4 py-2 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white text-sm font-semibold">
      🔄 Yenile (YouTube)</button>
  </form>

  {% with messages = get_flashed_messages() %}
    {% for m in messages %}
      <div class="mb-3 p-3 rounded-lg bg-cyan-900/40 text-sm">{{ m }}</div>
    {% endfor %}
  {% endwith %}

  {% if not rows %}
    <p class="opacity-60 text-sm">Banka boş — "Yenile (YouTube)" ile doldurun.
      Sorgu birkaç dakika sürebilir.</p>
  {% else %}
  <table class="w-full text-sm">
    <thead>
      <tr class="text-left text-xs uppercase opacity-50">
        <th class="py-2">Konu</th><th>Durum</th><th></th>
      </tr>
    </thead>
    <tbody>
    {% for r in rows %}
      <tr class="border-b border-white/10 align-top {{ 'opacity-40' if r.status != 'active' }}">
        <td class="py-2 pr-3">{{ r.topic }}
          <div class="text-xs opacity-60 mt-0.5">
            {% if r.source_title %}{{ r.source_title }} — {% endif %}
            {{ '{:,}'.format(r.views) }} izlenme / {{ '{:,}'.format(r.subs) }} abone
            {% if r.hook_pattern %} · {{ r.hook_pattern }}{% endif %}
          </div>
        </td>
        <td class="py-2 text-xs whitespace-nowrap">
          {% if r.status == 'active' %}<span class="text-emerald-400">aktif</span>
          {% elif r.status == 'used' %}<span class="text-cyan-400">kullanıldı</span>
          {% else %}<span class="text-red-400">reddedildi</span>{% endif %}
        </td>
        <td class="py-2 text-right">
          {% if r.status == 'active' %}
          <form method="post" action="/channels/{{ slug }}/topic-bank/{{ r.id }}/reject">
            <button class="text-xs text-red-400 hover:text-red-300">Reddet</button>
          </form>
          {% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
</div>
{% endblock %}
