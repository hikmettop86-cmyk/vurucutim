{# Canlı Gündem tablosu — HTMX ile yenilenir. Bağlam: region, rows, channels, cache_age #}
<div class="flex items-center justify-between text-xs text-claude-muted mb-2">
  <span>{{ rows|length }} trend · hacim sıralı ·
    {% if cache_age is none %}önbellek yok{% elif cache_age < 1 %}az önce güncellendi{% else %}{{ '%.0f'|format(cache_age) }} dk önce güncellendi{% endif %}</span>
  <span>{% for c in channels %}<span class="ml-2 px-2 py-0.5 rounded bg-claude-surface border border-claude-border">{{ c.name }}{% if c.label != c.name %} · {{ c.label }}{% endif %}</span>{% endfor %}</span>
</div>
<div class="bg-claude-surface border border-claude-border rounded-xl overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-claude-surface-alt text-xs text-claude-muted uppercase tracking-wide">
      <tr>
        <th class="p-3 text-left w-10">#</th>
        <th class="p-3 text-right w-28">Arama</th>
        <th class="p-3 text-left">Haber</th>
        <th class="p-3 text-left w-40">Başlangıç</th>
        <th class="p-3 text-left w-64">Üret</th>
      </tr>
    </thead>
    <tbody>
      {% for r in rows %}
      <tr class="border-t border-claude-border/60 hover:bg-claude-surface-alt/60 align-top">
        <td class="p-3 text-claude-muted">{{ loop.index }}</td>
        <td class="p-3 text-right">
          <div class="font-semibold">{% if r.volume >= 1000 %}{{ (r.volume // 1000) }}B+{% else %}{{ r.volume }}{% endif %}</div>
          {% if r.growth %}<div class="text-[11px] text-green-700">↑ {{ r.growth|replace('+', '') }}</div>{% endif %}
        </td>
        <td class="p-3">
          <div class="flex gap-3">
            {% if r.thumb %}<img src="{{ r.thumb }}" alt="" class="w-16 h-12 object-cover rounded flex-shrink-0" loading="lazy">{% endif %}
            <div class="min-w-0">
              <a href="{{ r.link }}" target="_blank" rel="noopener" class="font-semibold hover:underline">{{ r.title }}</a>
              <div class="text-[11px] text-claude-muted mt-0.5">
                {{ r.source }}{% if r.extra %} · +{{ r.extra }} kaynak daha{% endif %}
                {% if r.others %} · <span title="{{ r.others|e }}">diğer başlıklar</span>{% endif %}
              </div>
              {% if r.related %}
              <div class="mt-1 flex flex-wrap gap-1">
                {% for k in r.related.split(',') %}{% if k.strip() %}<span class="text-[10px] px-1.5 py-0.5 rounded bg-claude-surface-alt border border-claude-border text-claude-muted">{{ k.strip() }}</span>{% endif %}{% endfor %}
              </div>
              {% endif %}
            </div>
          </div>
        </td>
        <td class="p-3 text-claude-muted text-xs">
          {% if r.age_h is not none %}{% if r.age_h < 1 %}{{ (r.age_h * 60)|int }} dk önce{% else %}{{ r.age_h|int }} sa önce{% endif %}{% else %}—{% endif %}
        </td>
        <td class="p-3">
          <div class="flex flex-wrap gap-1">
            {% for c in channels %}
            {% if c.slug in r.produced %}
              <span class="px-2 py-1 rounded text-xs bg-green-50 border border-green-200 text-green-700" title="{{ c.name }} bu haberi zaten üretti">✓ {{ c.label }}</span>
            {% else %}
              <form method="post" action="/gundem/produce" class="inline">
                <input type="hidden" name="region" value="{{ region }}">
                <input type="hidden" name="channel_slug" value="{{ c.slug }}">
                <input type="hidden" name="guid" value="{{ r.guid }}">
                <button type="submit"
                        class="px-2 py-1 rounded text-xs border {% if c.format == 'yorum' %}bg-red-600 text-white border-red-600 hover:bg-red-700{% else %}bg-claude-surface border-claude-border hover:bg-claude-surface-alt{% endif %}"
                        title="{{ c.name }}">{% if c.format == 'yorum' %}🎙️{% else %}▶{% endif %} {{ c.label }}</button>
              </form>
            {% endif %}
            {% endfor %}
          </div>
        </td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="p-8 text-center text-claude-muted">Trend listesi boş — "Şimdi yenile" dene.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
