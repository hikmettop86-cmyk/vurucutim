{% extends "base.html.j2" %}
{% block title %}Vurucu TİM — Yeni kanal{% endblock %}
{% block content %}
{# Kanallar sayfasındaki ÜÇ ayrı düğmenin (+Yeni Kanal, +Kürate, +Gündem Yorum)
   yerine tek giriş. Format ÖNCE seçilir çünkü format, sohbette hangi kararların
   verileceğini belirler: kürate kanalda "Trends bölgesi" diye bir şey yok,
   kart kanalda "subreddit" yok. #}
<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <a href="/channels" class="text-claude-muted hover:text-claude-text text-sm">← Kanallar</a>
    <h1 class="font-serif font-bold mt-1">Yeni kanal</h1>
    <p class="text-claude-muted mt-1">Ne üreteceğini seç. Gerisini konuşarak hallederiz.</p>
  </div>

  <form method="get" class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="format-form">
    {% for key, spec in formats.items() %}
    <button type="submit" formaction="/channels/new/{{ key }}"
            class="text-left bg-white border border-claude-border rounded-xl p-4 shadow-soft
                   hover:border-claude-accent hover:shadow-card transition-all flex flex-col gap-2">
      <span class="flex items-center gap-2.5">
        <span class="w-9 h-9 rounded-lg bg-claude-surface-alt grid place-items-center text-lg
                     text-claude-muted flex-none">{{ spec.glyph }}</span>
        <span>
          <span class="block font-semibold text-[15px] leading-tight">{{ spec.label }}</span>
          <span class="block text-xs text-claude-subtle">{{ spec.subtitle }}</span>
        </span>
      </span>
      {# O formatta ÇALIŞAN kanalların slug'ları: soyut format adı yerine
         tanıdık örnek. Hiç yoksa dürüstçe söylenir. #}
      <span class="flex flex-wrap gap-1.5 pt-2 border-t border-claude-border w-full">
        {% for s in ornek.get(key, [])[:3] %}
        <span class="font-mono text-[11px] bg-claude-surface px-2 py-0.5 rounded">{{ s }}</span>
        {% endfor %}
        {% if ornek.get(key, [])|length > 3 %}
        <span class="text-[11px] text-claude-subtle">+{{ ornek[key]|length - 3 }}</span>
        {% elif not ornek.get(key) %}
        <span class="text-[11px] text-claude-subtle">bu formatta kanalın yok</span>
        {% endif %}
      </span>
    </button>
    {% endfor %}

    <label class="sm:col-span-2 flex items-center gap-3 bg-claude-surface border border-claude-border
                  rounded-xl px-4 py-3 text-sm">
      <span class="text-claude-muted whitespace-nowrap">Yayın dili</span>
      <select name="dil" class="bg-white border border-claude-border rounded-lg px-3 py-1.5 text-sm">
        {% for kod, ad in LANGUAGES %}
        <option value="{{ kod }}" {% if kod == 'tr' %}selected{% endif %}>{{ ad }}</option>
        {% endfor %}
      </select>
      {# Dil kurulumda belirlenir ve sonradan DEĞİŞTİRİLEMEZ: DNA, dil paketi,
         ses seçimi ve konu bankası ona göre kurulur. #}
      <span class="text-[11px] text-claude-subtle">Sonradan değiştirilemez — DNA, ses ve konu bankası buna göre kurulur.</span>
    </label>
  </form>

  {# NİŞ BULUCU AYRI BİR İŞ, sohbetin yerine geçmediği için burada duruyor:
     sohbet ne istediğini bilen kullanıcıyı hızlandırır, ajan ise YouTube
     outlier verisiyle nişi DOĞRULAR. Bu sayfa açılana kadar ajan menüden
     hiç erişilemiyordu. #}
  <div class="mt-4 bg-claude-surface border border-claude-border rounded-xl px-4 py-3.5
              flex items-center justify-between gap-4 flex-wrap">
    <div class="min-w-0">
      <div class="text-sm font-semibold">Ne kuracağını bilmiyor musun?</div>
      <div class="text-xs text-claude-muted mt-0.5">
        Niş bulucu, adayları YouTube verisiyle doğrular — kanıtsız öneri vermez.
        Plan hazırlamak birkaç dakika sürer.
      </div>
    </div>
    <a href="/channels/agent"
       class="bg-white border border-claude-border-strong hover:border-claude-accent
              hover:text-claude-accent px-4 py-2 rounded-lg text-sm font-semibold whitespace-nowrap">
      Niş bulucu →
    </a>
  </div>
</div>
{% endblock %}
