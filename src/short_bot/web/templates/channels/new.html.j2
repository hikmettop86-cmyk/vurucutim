{% extends "base.html.j2" %}
{% block title %}short-bot — Yeni Kanal{% endblock %}
{% block content %}
<a href="/channels" class="text-slate-400 hover:text-white text-sm">&larr; Kanallar</a>
<h1 class="text-3xl font-bold mt-2 mb-6">+ Yeni Kanal</h1>

<div class="grid grid-cols-2 gap-6">
  <form id="wizard-form" hx-post="/channels/new/generate" hx-target="#preview" hx-indicator="#loading"
        class="space-y-3">
    <h2 class="text-lg font-bold">Temel Bilgi</h2>

    <label class="block">
      <span class="text-xs text-slate-400 uppercase">Kanal &#304;sim</span>
      <input type="text" name="name" required
             class="bg-slate-800 px-3 py-2 rounded w-full mt-1 text-sm">
    </label>

    <label class="block">
      <span class="text-xs text-slate-400 uppercase">Dil</span>
      <select name="language" class="bg-slate-800 px-3 py-2 rounded w-full mt-1 text-sm">
        <option value="tr">Türkçe</option>
        <option value="en">English</option>
        <option value="de">Deutsch</option>
        <option value="es">Español</option>
        <option value="fr">Français</option>
      </select>
    </label>

    <label class="block">
      <span class="text-xs text-slate-400 uppercase">Keywords (virgülle)</span>
      <input type="text" name="keywords" required
             placeholder="Bundesliga, Bayern, Champions League"
             class="bg-slate-800 px-3 py-2 rounded w-full mt-1 text-sm">
    </label>

    <label class="block">
      <span class="text-xs text-slate-400 uppercase">Konu ipucu (opsiyonel)</span>
      <input type="text" name="topic_hint"
             class="bg-slate-800 px-3 py-2 rounded w-full mt-1 text-sm">
    </label>

    <label class="block">
      <span class="text-xs text-slate-400 uppercase">Hedef kitle (opsiyonel)</span>
      <input type="text" name="target_audience"
             class="bg-slate-800 px-3 py-2 rounded w-full mt-1 text-sm">
    </label>

    <button type="submit" class="bg-red-600 hover:bg-red-700 px-4 py-2 rounded font-semibold mt-4 w-full">
      DNA Üret (Opus, ~30-60s)
    </button>
    <div id="loading" class="htmx-indicator text-blue-400 text-sm">
      Opus düşünüyor...
    </div>
  </form>

  <div>
    <h2 class="text-lg font-bold mb-3">Canlı Önizleme</h2>
    <div id="preview" class="bg-slate-950 rounded-lg p-4 text-slate-500 text-center text-sm aspect-[9/16] flex items-center justify-center">
      Önce DNA üret &rarr;
    </div>
  </div>
</div>
{% endblock %}
