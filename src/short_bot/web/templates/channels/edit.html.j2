{% extends "base.html.j2" %}
{% block title %}Vurucu TİM — {{ c.slug }}{% endblock %}
{% block content %}

{# ── Sticky action bar ──────────────────────────────────────────────────── #}
<div class="sticky top-[60px] z-10 bg-claude-bg/95 backdrop-blur border-b border-claude-border py-3 mb-6 -mx-6 px-6">
  <div class="flex justify-between items-center">
    <div>
      <a href="/channels" class="text-claude-muted hover:text-claude-text text-sm">← Kanallar</a>
      <h1 class="font-serif text-2xl font-bold mt-1">{{ c.name }}</h1>
      <div class="text-claude-muted text-xs">
        {{ c.slug }} · {{ c.language }} · {{ c.template }}
        {% if c.dna %}<span class="bg-claude-success text-white px-2 py-0.5 rounded-lg text-xs ml-2">DNA</span>{% endif %}
      </div>
    </div>
    <div class="flex gap-2">
      <button hx-post="/shorts/run-now"
              hx-vals='{"slug": "{{ c.slug }}"}'
              hx-swap="none"
              class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm">
        ▶ Şimdi üret
      </button>
      {% if c.content_source == 'generator' %}
      <button hx-post="/channels/{{ c.slug }}/generator-test"
              hx-target="#generator-test-result"
              hx-swap="innerHTML"
              class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm">
        🧪 Test örnek üret
      </button>
      {% endif %}
      {% if c.dna %}
      <form method="POST" action="/channels/{{ c.slug }}/regenerate-dna" class="inline"
            onsubmit="return confirm('DNA Opus ile yeniden üretilsin mi? (~30-60s sürer, mevcut DNA kaybolur)')">
        <button type="submit"
                class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm">
          ↻ DNA Yenile
        </button>
      </form>
      {% endif %}
      <form method="POST" action="/channels/{{ c.slug }}/delete" class="inline"
            onsubmit="return confirm('{{ c.slug }} kanalı silinsin mi? (yaml + css + output)')">
        <button type="submit" class="bg-claude-error hover:bg-claude-error text-white px-3 py-2 rounded-lg text-sm">
          Sil
        </button>
      </form>
    </div>
  </div>
</div>

{# ── Main form — Alpine root state ──────────────────────────────────────── #}
<form id="edit-save-form" method="POST" class="grid grid-cols-2 gap-8 mt-2"
      x-init="(() => {
        /* Snap palette+fonts to archetype defaults — runs on page LOAD AND
           whenever archetype changes (dropdown). On load this ensures the
           preview matches the designed template colors (zip designs), even
           if the channel's saved palette is stale from a previous archetype. */
        window.__snapArchetypeDefaults = async (val) => {
          try {
            const r = await fetch('/api/dna/defaults?archetype=' + encodeURIComponent(val));
            if (!r.ok) return;
            const d = await r.json();
            primary = d.primary;
            accent = d.accent;
            bgGrad1 = d.bg_grad_1;
            bgGrad2 = d.bg_grad_2;
            bodyBg1 = d.body_bg_1;
            bodyBg2 = d.body_bg_2;
            textMain = d.text_main;
            textMuted = d.text_muted;
            fontHeadline = d.font_headline;
            fontBody = d.font_body;
          } catch (e) { console.warn('dna defaults fetch failed:', e); }
        };
        $watch('archetype', window.__snapArchetypeDefaults);
        window.__snapArchetypeDefaults(archetype);
      })()"
      x-data='{
        primary: "{{ (c.dna.palette.primary if c.dna else c.colors.primary) }}",
        accent: "{{ (c.dna.palette.accent if c.dna else c.colors.accent) }}",
        bgGrad1: "{{ (c.dna.palette.bg_gradient[0] if c.dna else c.colors.bg_gradient[0]) }}",
        bgGrad2: "{{ (c.dna.palette.bg_gradient[1] if c.dna else c.colors.bg_gradient[1]) }}",
        bodyBg1: "{{ (c.dna.palette.body_bg[0] if c.dna else "#1a1a2a") }}",
        bodyBg2: "{{ (c.dna.palette.body_bg[1] if c.dna else "#0a0a1a") }}",
        textMain: "{{ (c.dna.palette.text_main if c.dna else "#ffffff") }}",
        textMuted: "{{ (c.dna.palette.text_muted if c.dna else "#cccccc") }}",
        headerTopColor: "{{ (c.dna.palette.header_top_color if c.dna else "") }}",
        headerBottomColor: "{{ (c.dna.palette.header_bottom_color if c.dna else "") }}",
        fontHeadline: "{{ (c.dna.fonts.headline if c.dna else "Inter") }}",
        fontBody: "{{ (c.dna.fonts.body if c.dna else "Inter") }}",
        sizeHeadlineTop: "{{ (c.dna.fonts.size_headline_top if c.dna and c.dna.fonts.size_headline_top else '') }}",
        sizeHeadlineBot: "{{ (c.dna.fonts.size_headline_bottom if c.dna and c.dna.fonts.size_headline_bottom else '') }}",
        bgImageBlur: {{ c.bg_image_blur }},
        bannerShape: "{{ (c.dna.banner_shape if c.dna else "flat") }}",
        highlightStyle: "{{ (c.dna.highlight_style if c.dna else "bg-flat") }}",
        chipStyle: "{{ (c.dna.chip_style if c.dna else "rounded") }}",
        categoryIcon: "{{ (c.dna.category_icon if c.dna else "") }}",
        archetype: "{{ (c.dna.archetype if c.dna else c.template) }}",
        rssSourceDemo: "",
        currentTab: window.location.hash.replace("#", "") || "genel"
      }'>

  {# ═══════════════════════════════════════════════════════════════════════
     LEFT COLUMN — Preview (sticky)
     ═══════════════════════════════════════════════════════════════════════ #}
  <div class="space-y-4">
    <div class="sticky top-[130px]">
      <div class="bg-white border border-claude-border rounded-xl shadow-soft">
        <div class="px-5 py-3 border-b border-claude-border/40">
          <h2 class="font-serif text-base font-semibold flex items-center gap-2">
            <span class="text-lg opacity-70">🔍</span> Önizleme
          </h2>
        </div>
        <div class="p-5">
          <div class="relative bg-black rounded-lg overflow-hidden mx-auto"
               style="width: 100%; max-width: 360px; aspect-ratio: 9/16;">
            <iframe x-bind:src="`/preview/{{ c.slug }}?archetype=${encodeURIComponent(archetype)}&primary=${encodeURIComponent(primary)}&accent=${encodeURIComponent(accent)}&font_headline=${encodeURIComponent(fontHeadline)}&font_body=${encodeURIComponent(fontBody)}&banner_shape=${encodeURIComponent(bannerShape)}&highlight_style=${encodeURIComponent(highlightStyle)}&chip_style=${encodeURIComponent(chipStyle)}&category_icon=${encodeURIComponent(categoryIcon)}&bg_grad_1=${encodeURIComponent(bgGrad1)}&bg_grad_2=${encodeURIComponent(bgGrad2)}&body_bg_1=${encodeURIComponent(bodyBg1)}&body_bg_2=${encodeURIComponent(bodyBg2)}&text_main=${encodeURIComponent(textMain)}&text_muted=${encodeURIComponent(textMuted)}&header_top_color=${encodeURIComponent(headerTopColor)}&header_bottom_color=${encodeURIComponent(headerBottomColor)}&rss_source=${encodeURIComponent(rssSourceDemo)}&size_headline_top=${encodeURIComponent(sizeHeadlineTop)}&size_headline_bot=${encodeURIComponent(sizeHeadlineBot)}`"
                    src="/preview/{{ c.slug }}"
                    scrolling="no"
                    class="absolute top-0 left-0 border-0"
                    style="width: 1080px; height: 1920px; transform: scale(0.333); transform-origin: top left;"></iframe>
          </div>
          <p class="text-xs text-claude-muted mt-2 text-center">
            Gerçek 1080×1920 short, ölçekli HTML önizleme.
          </p>
        </div>
      </div>
    </div>
  </div>

  {# ═══════════════════════════════════════════════════════════════════════
     RIGHT COLUMN — All editable cards
     ═══════════════════════════════════════════════════════════════════════ #}
  <div class="space-y-4">

    {# ── Tab bar ─────────────────────────────────────────────────────── #}
    <div class="bg-white border border-claude-border rounded-xl shadow-soft sticky top-[130px] z-30">
      <div class="flex border-b border-claude-border overflow-x-auto">
        <template x-for="tab in [
          {id: 'genel', label: 'Genel'},
          {id: 'icerik', label: 'Icerik'},
          {id: 'dna', label: 'DNA / Renkler'},
          {id: 'youtube', label: 'YouTube'},
        ]" :key="tab.id">
          <button type="button"
                  @click="currentTab = tab.id; window.location.hash = tab.id"
                  :class="currentTab === tab.id ? 'border-b-2 border-claude-accent text-claude-accent font-semibold' : 'text-claude-muted hover:text-claude-text'"
                  class="px-5 py-3 transition-colors text-sm whitespace-nowrap flex-shrink-0"
                  x-text="tab.label"></button>
        </template>
      </div>
    </div>

    {# ── TAB: Genel ──────────────────────────────────────────────────── #}
    <div x-show="currentTab === 'genel'">

    {# ── Card: Temel ─────────────────────────────────────────────────── #}
    <div x-data="{ open: true }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">⚙</span> Temel
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-4 border-t border-claude-border/40">

        {% if c.content_source != 'generator' %}
        <label class="block">
          <span class="text-xs text-claude-muted uppercase">Keywords (virgülle)</span>
          <input type="text" name="keywords" value="{{ c.keywords | join(', ') }}"
                 class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
        </label>
        {% endif %}

        <label class="block">
          <span class="text-xs text-claude-muted uppercase">Negatif anahtar kelimeler (virgülle)</span>
          <input type="text" name="negative_keywords"
                 value="{{ c.negative_keywords|join(', ') }}"
                 placeholder="wwe, wrestling, mma"
                 class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          <span class="text-[10px] text-claude-subtle block mt-1">
            Bu kelimelerden HERHANGİ biri haber başlığında geçerse RSS aşamasında atılır.
            NFL kanalında WWE/wrestling haberleri filtrelemek için kullanışlı.
          </span>
        </label>


        <div class="grid grid-cols-3 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Süre (sn)</span>
            <input type="number" name="duration_s" value="{{ c.duration_s }}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
          {% if c.content_source != 'generator' %}
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Min skor</span>
            <input type="number" step="0.1" name="min_score" value="{{ c.min_score }}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
          {% endif %}
          {% if c.content_source != 'generator' %}
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Max aday</span>
            <input type="number" name="max_candidates_per_run" value="{{ c.max_candidates_per_run }}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>

          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Max yaş (saat)</span>
            <input type="number" min="0" name="max_age_hours" value="{{ c.max_age_hours }}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
            <span class="text-[10px] text-claude-subtle block mt-1">RSS haberi bu kadar saatten eskiyse atlanır. 0 = sınır yok.</span>
          </label>
          {% endif %}
        </div>

        <label class="block">
          <input type="checkbox" name="dynamic_dna" value="1"
                 {% if c.dynamic_dna %}checked{% endif %}
                 class="mr-2">
          <span class="text-sm font-semibold text-claude-text">
            🧬 Dinamik DNA — her video için stil yenilensin
          </span>
          <span class="text-[11px] text-claude-subtle block mt-1 ml-6">
            Açıkken her video için Claude (Opus) konuya göre archetype + palette + animation seçer.
            Benzer konular cache'ten gelir (90 gün saklanır). OpenAI API key gerekir
            (Settings → OpenAI Key).
          </span>
        </label>


      </div>
    </div>

    {# ── Card: Özel müzik klasörü (closed by default) ─────────────────── #}
    <div x-data="{ open: false }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">♫</span> Özel müzik klasörü
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-4 border-t border-claude-border/40">
        <div class="bg-claude-surface border border-claude-border rounded-lg p-3 text-xs space-y-1">
          <div class="font-mono text-claude-text break-all">{{ music_info.abs_path }}</div>
          {% if music_info.exists and music_info.mp3_count > 0 %}
            <div class="text-claude-success">
              ✓ Klasör mevcut · <strong>{{ music_info.mp3_count }}</strong> mp3 dosyası — bu kanal için bunlardan rastgele seçilir.
            </div>
          {% elif music_info.exists %}
            <div class="text-claude-muted">
              Klasör mevcut ama boş. mp3 atınca aktifleşir, aksi halde varsayılan müzik kullanılır.
            </div>
          {% else %}
            <div class="text-claude-muted">
              Klasör henüz yok. Yukarıdaki yola mp3 atarsan bu kanal için özel müzik aktif olur. Aksi halde varsayılan
              <code class="text-claude-text">assets/music/&lt;mood&gt;/</code> kullanılır.
            </div>
          {% endif %}
          <div class="text-claude-subtle">
            İpucu: Mood ayrımı yapmak istersen <code class="text-claude-text">{{ c.slug }}/breaking/</code>,
            <code class="text-claude-text">{{ c.slug }}/neutral/</code>, <code class="text-claude-text">{{ c.slug }}/upbeat/</code>
            alt klasörleri oluştur. Yapmazsan dosyalar düz klasörden seçilir.
          </div>
        </div>
        <div class="flex gap-2 pt-1">
          <form method="post" action="{{ url_for('channel_edit.music_open', slug=c.slug) }}" class="inline">
            <button type="submit" class="px-3 py-1.5 text-xs bg-claude-text text-white rounded-md hover:opacity-90">
              📂 Klasörü Aç
            </button>
          </form>
          {% if not music_info.exists or music_info.mp3_count == 0 %}
            <form method="post" action="{{ url_for('channel_edit.music_init', slug=c.slug) }}" class="inline">
              <button type="submit" class="px-3 py-1.5 text-xs bg-white border border-claude-border rounded-md hover:bg-claude-surface/40">
                ➕ Klasörleri Oluştur (breaking / neutral / upbeat)
              </button>
            </form>
          {% endif %}
        </div>
      </div>
    </div>

    {# ── Card: Son çalışmalar (closed by default) ─────────────────────── #}
    <div x-data="{ open: false }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">⏱</span> Son çalışmalar
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 border-t border-claude-border/40">
        {% if runs %}
        <table class="w-full text-xs border border-claude-border rounded-lg overflow-hidden">
          <thead class="bg-claude-surface">
            <tr class="text-left">
              <th class="p-2">Tarih</th>
              <th class="p-2">Trigger</th>
              <th class="p-2">Durum</th>
              <th class="p-2">Süre</th>
              <th class="p-2"></th>
            </tr>
          </thead>
          <tbody>
            {% for r in runs %}
            <tr class="border-t border-claude-border">
              <td class="p-2 font-mono">{{ r.started_at.strftime('%d %b %H:%M') }}</td>
              <td class="p-2 text-claude-muted">{{ r.trigger }}</td>
              <td class="p-2">
                {% if r.status == 'success' %}
                  <span class="text-claude-success">✓ {{ r.status }}</span>
                {% elif r.status == 'failed' %}
                  <span class="text-claude-error">✗ {{ r.status }}</span>
                {% elif r.status == 'cancelled' %}
                  <span class="text-claude-muted">⊘ cancelled</span>
                {% elif r.status == 'running' or r.status is none %}
                  <span class="text-claude-wait">● running</span>
                {% else %}
                  <span class="text-claude-muted">{{ r.status or '—' }}</span>
                {% endif %}
              </td>
              <td class="p-2 text-claude-muted">
                {% if r.duration_seconds is not none %}
                  {{ r.duration_seconds }}s
                {% else %}—{% endif %}
              </td>
              <td class="p-2 text-right">
                {% if r.status == 'running' or r.status is none %}
                  <form method="POST" action="/runs/{{ r.id }}/cancel" class="inline"
                        onsubmit="return confirm('Run #{{ r.id }} iptal edilsin mi?')">
                    <button class="text-claude-error hover:underline">İptal</button>
                  </form>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
          <p class="text-sm text-claude-muted pt-1">Henüz run yok.</p>
        {% endif %}
      </div>
    </div>

    </div>{# end TAB: Genel #}

    {# ── TAB: YouTube ───────────────────────────────────────────────── #}
    <div x-show="currentTab === 'youtube'">

    {# ── Card: Topluluk post fikirleri ─────────────────────────────────── #}
    <div class="bg-white border border-claude-border rounded-xl shadow-soft mb-4 p-5">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-serif text-base font-semibold flex items-center gap-2">
            <span class="text-lg opacity-70">💬</span> Topluluk Sekmesi
          </h2>
          <p class="text-xs text-claude-muted mt-1">
            YouTube Community için 5 hazır post taslağı üret (poll / soru /
            nostalji / sıralama / hot-take). Kanalın DNA tonu + son
            shortlar + aktif trendler birlikte. Kopyala-yapıştır akışı.
          </p>
        </div>
        <a href="/community/{{ c.slug }}"
           class="bg-claude-accent hover:bg-claude-accent-hover text-white text-sm font-semibold px-4 py-2 rounded-lg whitespace-nowrap">
          ✨ Post fikirleri →
        </a>
      </div>
    </div>

    {# ORTAK ÇEKİRDEK — kimlik ve zamanlama. Dört formatın hepsinde AYNI parça.
       Kanal ADI bu sayfada HİÇ YOKTU: kart kanalının adını UI'den değiştirmek
       mümkün değildi. `archived` (pasife al) de yoktu. #}
    <div class="mb-4">{% include "_partials/core/identity.html.j2" %}</div>
    <div class="mb-4">{% include "_partials/core/schedule.html.j2" %}</div>

    {# ORTAK ÇEKİRDEK — YouTube. Dört formatın hepsi AYNI parçadan çizilir;
       eskiden bu blok her sayfada ayrı yazılmıştı ve dördü de eksikti. #}
    <div class="mb-4">
      {% include "_partials/core/youtube.html.j2" %}
    </div>

    {# ── Card: YouTube İstatistikleri (closed by default) ────────────── #}
    <div x-data="{ open: false }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">📊</span> YouTube İstatistikleri
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-3 border-t border-claude-border/40">
        {% if yt_history %}
          {% set latest = yt_history[0] %}
          <div class="grid grid-cols-2 gap-3 text-sm">
            <div>
              <div class="text-claude-muted uppercase text-[10px]">Abone</div>
              <div class="font-bold text-lg">{{ "{:,}".format(latest.subscribers).replace(',', '.') }}</div>
            </div>
            <div>
              <div class="text-claude-muted uppercase text-[10px]">Toplam izlenme</div>
              <div class="font-bold text-lg">{{ "{:,}".format(latest.total_views).replace(',', '.') }}</div>
            </div>
          </div>
          <div class="text-xs text-claude-muted">
            Son güncelleme: {{ latest.updated_at.strftime('%d %b %H:%M') if latest.updated_at else latest.snapshot_date }}
            · {{ yt_history|length }} günlük geçmiş
          </div>
        {% else %}
          <div class="text-xs text-claude-muted">Henüz stats çekilmedi.</div>
        {% endif %}
        <div class="text-[10px] text-claude-subtle">
          Quota bugün: {{ yt_quota_today }} unit (10000/gün limit)
        </div>
        <button form="yt-refresh-stats-form"
                formmethod="POST"
                formaction="/channels/{{ c.slug }}/youtube/refresh-stats"
                class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border px-3 py-1.5 rounded-lg text-xs">
          🔄 Şimdi yenile
        </button>
      </div>
    </div>

