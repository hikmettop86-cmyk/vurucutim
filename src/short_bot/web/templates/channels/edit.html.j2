{% extends "base.html.j2" %}
{% block title %}Vurucu TİM — {{ c.slug }}{% endblock %}
{% block content %}

{# ── Sticky action bar ──────────────────────────────────────────────────── #}
<div class="sticky top-[60px] z-10 bg-claude-bg/95 backdrop-blur border-b border-claude-border py-3 mb-6 -mx-6 px-6">
  <div class="flex justify-between items-center">
    <div>
      <a href="/channels" class="text-claude-muted hover:text-claude-text text-sm">← Kanallar</a>
      <h1 class="font-serif text-2xl font-bold mt-1">{{ c.name }}</h1>
      <div class="text-claude-muted text-xs">
        {{ c.slug }} · {{ c.language }} · {{ c.template }}
        {% if c.dna %}<span class="bg-claude-success text-white px-2 py-0.5 rounded-lg text-xs ml-2">DNA</span>{% endif %}
      </div>
    </div>
    <div class="flex gap-2">
      <button hx-post="/shorts/run-now"
              hx-vals='{"slug": "{{ c.slug }}"}'
              hx-swap="none"
              class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm">
        ▶ Şimdi üret
      </button>
      {% if c.content_source == 'generator' %}
      <button hx-post="/channels/{{ c.slug }}/generator-test"
              hx-target="#generator-test-result"
              hx-swap="innerHTML"
              class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm">
        🧪 Test örnek üret
      </button>
      {% endif %}
      {% if c.dna %}
      <form method="POST" action="/channels/{{ c.slug }}/regenerate-dna" class="inline"
            onsubmit="return confirm('DNA Opus ile yeniden üretilsin mi? (~30-60s sürer, mevcut DNA kaybolur)')">
        <button type="submit"
                class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm">
          ↻ DNA Yenile
        </button>
      </form>
      {% endif %}
      <form method="POST" action="/channels/{{ c.slug }}/delete" class="inline"
            onsubmit="return confirm('{{ c.slug }} kanalı silinsin mi? (yaml + css + output)')">
        <button type="submit" class="bg-claude-error hover:bg-red-700 text-white px-3 py-2 rounded-lg text-sm">
          Sil
        </button>
      </form>
    </div>
  </div>
</div>

{# ── Main form — Alpine root state ──────────────────────────────────────── #}
<form id="edit-save-form" method="POST" class="grid grid-cols-2 gap-8 mt-2"
      x-data='{
        primary: "{{ (c.dna.palette.primary if c.dna else c.colors.primary) }}",
        accent: "{{ (c.dna.palette.accent if c.dna else c.colors.accent) }}",
        bgGrad1: "{{ (c.dna.palette.bg_gradient[0] if c.dna else c.colors.bg_gradient[0]) }}",
        bgGrad2: "{{ (c.dna.palette.bg_gradient[1] if c.dna else c.colors.bg_gradient[1]) }}",
        bodyBg1: "{{ (c.dna.palette.body_bg[0] if c.dna else "#1a1a2a") }}",
        bodyBg2: "{{ (c.dna.palette.body_bg[1] if c.dna else "#0a0a1a") }}",
        textMain: "{{ (c.dna.palette.text_main if c.dna else "#ffffff") }}",
        textMuted: "{{ (c.dna.palette.text_muted if c.dna else "#cccccc") }}",
        headerTopColor: "{{ (c.dna.palette.header_top_color if c.dna else "") }}",
        headerBottomColor: "{{ (c.dna.palette.header_bottom_color if c.dna else "") }}",
        fontHeadline: "{{ (c.dna.fonts.headline if c.dna else "Inter") }}",
        fontBody: "{{ (c.dna.fonts.body if c.dna else "Inter") }}",
        bannerShape: "{{ (c.dna.banner_shape if c.dna else "flat") }}",
        highlightStyle: "{{ (c.dna.highlight_style if c.dna else "bg-flat") }}",
        chipStyle: "{{ (c.dna.chip_style if c.dna else "rounded") }}",
        categoryIcon: "{{ (c.dna.category_icon if c.dna else "") }}",
        archetype: "{{ (c.dna.archetype if c.dna else c.template) }}"
      }'>

  {# ═══════════════════════════════════════════════════════════════════════
     LEFT COLUMN — Preview (sticky)
     ═══════════════════════════════════════════════════════════════════════ #}
  <div class="space-y-4">
    <div class="sticky top-[130px]">
      <div class="bg-white border border-claude-border rounded-xl shadow-soft">
        <div class="px-5 py-3 border-b border-claude-border/40">
          <h2 class="font-serif text-base font-semibold flex items-center gap-2">
            <span class="text-lg opacity-70">🔍</span> Önizleme
          </h2>
        </div>
        <div class="p-5">
          <div class="relative bg-black rounded-lg overflow-hidden mx-auto"
               style="width: 100%; max-width: 360px; aspect-ratio: 9/16;">
            <iframe x-bind:src="`/preview/{{ c.slug }}?archetype=${encodeURIComponent(archetype)}&primary=${encodeURIComponent(primary)}&accent=${encodeURIComponent(accent)}&font_headline=${encodeURIComponent(fontHeadline)}&font_body=${encodeURIComponent(fontBody)}&banner_shape=${encodeURIComponent(bannerShape)}&highlight_style=${encodeURIComponent(highlightStyle)}&chip_style=${encodeURIComponent(chipStyle)}&category_icon=${encodeURIComponent(categoryIcon)}&bg_grad_1=${encodeURIComponent(bgGrad1)}&bg_grad_2=${encodeURIComponent(bgGrad2)}&body_bg_1=${encodeURIComponent(bodyBg1)}&body_bg_2=${encodeURIComponent(bodyBg2)}&text_main=${encodeURIComponent(textMain)}&text_muted=${encodeURIComponent(textMuted)}&header_top_color=${encodeURIComponent(headerTopColor)}&header_bottom_color=${encodeURIComponent(headerBottomColor)}`"
                    src="/preview/{{ c.slug }}"
                    scrolling="no"
                    class="absolute top-0 left-0 border-0"
                    style="width: 1080px; height: 1920px; transform: scale(0.333); transform-origin: top left;"></iframe>
          </div>
          <p class="text-xs text-claude-muted mt-2 text-center">
            Gerçek 1080×1920 short, ölçekli önizleme.
          </p>
        </div>
      </div>
    </div>
  </div>

  {# ═══════════════════════════════════════════════════════════════════════
     RIGHT COLUMN — All editable cards
     ═══════════════════════════════════════════════════════════════════════ #}
  <div class="space-y-4">

    {# ── Card: Temel ─────────────────────────────────────────────────── #}
    <div x-data="{ open: true }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">⚙</span> Temel
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-4 border-t border-claude-border/40">

        {% if c.content_source != 'generator' %}
        <label class="block">
          <span class="text-xs text-claude-muted uppercase">Keywords (virgülle)</span>
          <input type="text" name="keywords" value="{{ c.keywords | join(', ') }}"
                 class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
        </label>
        {% endif %}

        <label class="block"
               x-data='{
                  preset: "{{ current_cron_preset }}",
                  cron: "{{ c.schedule_cron }}",
                  dailyHour: 9,
                  weeklyDay: 1,
                  weeklyHour: 9,
                  recompute() {
                    if (this.preset === "hourly") this.cron = "0 * * * *";
                    else if (this.preset === "every_2h") this.cron = "0 */2 * * *";
                    else if (this.preset === "daily_picker") this.cron = `0 ${this.dailyHour} * * *`;
                    else if (this.preset === "weekly_picker") this.cron = `0 ${this.weeklyHour} * * ${this.weeklyDay}`;
                  }
                }'
               x-init="if (preset.startsWith(`daily_`)) { dailyHour = parseInt(preset.split(`_`)[1] || 9); preset = `daily_picker`; }
                       if (preset.startsWith(`weekly_`)) { let p = preset.split(`_`); weeklyDay = parseInt(p[1] || 1); weeklyHour = parseInt(p[2] || 9); preset = `weekly_picker`; }">
          <span class="text-xs text-claude-muted uppercase">Cron preset</span>
          <select x-model="preset" @change="recompute()"
                  class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
            <option value="hourly">Saat başı</option>
            <option value="every_2h">2 saatte bir</option>
            <option value="daily_picker">Günde bir (saat seç)</option>
            <option value="weekly_picker">Haftada bir (gün + saat seç)</option>
            <option value="custom">Özel cron</option>
          </select>
          <div x-show="preset === 'daily_picker'" class="mt-2 flex gap-2 items-center">
            <span class="text-xs text-claude-muted">Saat:</span>
            <input type="number" min="0" max="23" x-model.number="dailyHour" @change="recompute()"
                   class="bg-claude-surface border border-claude-border px-2 py-1 rounded w-20 text-sm">
            <span class="text-xs text-claude-muted">:00</span>
          </div>
          <div x-show="preset === 'weekly_picker'" class="mt-2 flex gap-2 items-center flex-wrap">
            <span class="text-xs text-claude-muted">Gün:</span>
            <select x-model.number="weeklyDay" @change="recompute()"
                    class="bg-claude-surface border border-claude-border px-2 py-1 rounded text-sm">
              <option value="1">Pazartesi</option><option value="2">Salı</option>
              <option value="3">Çarşamba</option><option value="4">Perşembe</option>
              <option value="5">Cuma</option><option value="6">Cumartesi</option>
              <option value="0">Pazar</option>
            </select>
            <span class="text-xs text-claude-muted">Saat:</span>
            <input type="number" min="0" max="23" x-model.number="weeklyHour" @change="recompute()"
                   class="bg-claude-surface border border-claude-border px-2 py-1 rounded w-20 text-sm">
            <span class="text-xs text-claude-muted">:00</span>
          </div>
          <div x-show="preset === 'custom'" class="mt-2">
            <input type="text" name="schedule_cron" x-model="cron"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full font-mono text-sm">
          </div>
          <input type="hidden" name="schedule_cron" x-model="cron" x-show="preset !== 'custom'">
          <input type="hidden" name="yt_cron_preset" x-bind:value="
                preset === 'daily_picker' ? `daily_${String(dailyHour).padStart(2,'0')}`
                : preset === 'weekly_picker' ? `weekly_${weeklyDay}_${String(weeklyHour).padStart(2,'0')}`
                : preset">
          <span class="text-xs text-claude-muted block mt-1">→ {{ cron_human }}</span>
        </label>

        <div class="grid grid-cols-3 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Süre (sn)</span>
            <input type="number" name="duration_s" value="{{ c.duration_s }}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
          {% if c.content_source != 'generator' %}
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Min skor</span>
            <input type="number" step="0.1" name="min_score" value="{{ c.min_score }}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
          {% endif %}
          {% if c.content_source != 'generator' %}
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Max aday</span>
            <input type="number" name="max_candidates_per_run" value="{{ c.max_candidates_per_run }}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
          {% endif %}
        </div>

        <label class="block">
          <span class="text-xs text-claude-muted uppercase">Handle</span>
          <input type="text" name="handle" value="{{ c.handle }}"
                 class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
        </label>

        <label class="flex items-center gap-2">
          <input type="checkbox" name="enabled" value="1" {% if c.enabled %}checked{% endif %}>
          <span>Aktif (cron'a göre otomatik üretilir)</span>
        </label>

      </div>
    </div>

    {# ── Card: Özel müzik klasörü (closed by default) ─────────────────── #}
    <div x-data="{ open: false }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">♫</span> Özel müzik klasörü
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-4 border-t border-claude-border/40">
        <div class="bg-claude-surface border border-claude-border rounded-lg p-3 text-xs space-y-1">
          <div class="font-mono text-claude-text break-all">{{ music_info.abs_path }}</div>
          {% if music_info.exists and music_info.mp3_count > 0 %}
            <div class="text-claude-success">
              ✓ Klasör mevcut · <strong>{{ music_info.mp3_count }}</strong> mp3 dosyası — bu kanal için bunlardan rastgele seçilir.
            </div>
          {% elif music_info.exists %}
            <div class="text-claude-muted">
              Klasör mevcut ama boş. mp3 atınca aktifleşir, aksi halde varsayılan müzik kullanılır.
            </div>
          {% else %}
            <div class="text-claude-muted">
              Klasör henüz yok. Yukarıdaki yola mp3 atarsan bu kanal için özel müzik aktif olur. Aksi halde varsayılan
              <code class="text-claude-text">assets/music/&lt;mood&gt;/</code> kullanılır.
            </div>
          {% endif %}
          <div class="text-claude-subtle">
            İpucu: Mood ayrımı yapmak istersen <code class="text-claude-text">{{ c.slug }}/breaking/</code>,
            <code class="text-claude-text">{{ c.slug }}/neutral/</code>, <code class="text-claude-text">{{ c.slug }}/upbeat/</code>
            alt klasörleri oluştur. Yapmazsan dosyalar düz klasörden seçilir.
          </div>
        </div>
      </div>
    </div>

    {# ── Card: YouTube bağlantısı (open by default) ───────────────────── #}
    <div x-data="{ open: true }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">▶</span> YouTube bağlantısı
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-3 border-t border-claude-border/40">
        {% if yt_connected and yt_info %}
          <div class="flex items-center gap-3">
            <span class="text-xl">▶</span>
            <div class="flex-1 text-sm">
              <div class="font-semibold">{{ yt_info.snippet.title }}</div>
              <div class="text-xs text-claude-muted">
                {{ yt_info.statistics.subscriberCount }} abone ·
                {{ yt_info.statistics.videoCount }} video ·
                <span class="text-claude-success">Bağlı</span>
              </div>
            </div>
            <div class="flex gap-2">
              <button form="yt-disconnect-form"
                      formmethod="POST"
                      formaction="/channels/{{ c.slug }}/youtube/disconnect"
                      onclick="return confirm('YouTube bağlantısı kaldırılsın mı? (token silinecek, kanal_info kalır)');"
                      class="text-xs px-3 py-1.5 rounded-lg bg-claude-error/10 ring-1 ring-claude-error/30 text-claude-error">
                Bağlantıyı kes
              </button>
              <button form="yt-reset-form"
                      formmethod="POST"
                      formaction="/channels/{{ c.slug }}/youtube/reset"
                      onclick="return confirm('TÜM YouTube dosyalarını sil? (token, kanal_info, client_secrets — geri alınamaz)');"
                      class="text-xs px-3 py-1.5 rounded-lg bg-claude-error/15 ring-1 ring-claude-error/40 text-claude-error hover:bg-claude-error/25">
                🗑 Tümünü sıfırla
              </button>
            </div>
          </div>
        {% else %}
          {% if yt_has_secrets %}
            <button form="yt-connect-form" formmethod="POST"
                    formaction="/channels/{{ c.slug }}/youtube/connect"
                    class="bg-claude-accent hover:bg-claude-accent-hover text-white px-4 py-2 rounded-lg text-sm">
              ▶ YouTube Bağla
            </button>
            <div class="text-[10px] text-claude-subtle">
              Tarayıcı Google'a yönlendirecek, izin verince bu kanal YouTube hesabınla eşleşir.
            </div>
            <button form="yt-reset-form"
                    formmethod="POST"
                    formaction="/channels/{{ c.slug }}/youtube/reset"
                    onclick="return confirm('client_secrets.json silinsin? (yeniden yüklemen gerekir)');"
                    class="text-xs px-3 py-1.5 rounded-lg bg-claude-error/15 ring-1 ring-claude-error/40 text-claude-error hover:bg-claude-error/25 mt-2">
              🗑 client_secrets.json sil
            </button>
          {% else %}
            <div class="text-xs text-claude-muted space-y-2">
              <div>
                <strong>Adım 1:</strong>
                <a href="https://console.cloud.google.com/" target="_blank" class="text-claude-accent underline">Google Cloud Console</a>
                → yeni proje → APIs: YouTube Data API v3 + YouTube Analytics API → OAuth Consent (External) →
                OAuth Client (Web type, redirect: <code>http://127.0.0.1:5005/oauth/callback</code>) → JSON indir.
              </div>
              <div>
                <strong>Adım 2:</strong> İndirdiğin <code>client_secrets.json</code>'u aşağıdaki kutuya sürükle veya seç:
              </div>
              <div class="flex items-center gap-2 mt-2">
                <input type="file" name="client_secrets" accept="application/json,.json" required
                       form="yt-upload-secrets-form"
                       class="text-xs flex-1 file:bg-claude-surface-alt file:border-0 file:px-3 file:py-1.5 file:rounded file:text-claude-text file:cursor-pointer file:mr-2">
                <button form="yt-upload-secrets-form" type="submit"
                        class="bg-claude-accent hover:bg-claude-accent-hover text-white px-3 py-1.5 rounded-lg text-xs">
                  ↑ Yükle
                </button>
              </div>
              <div class="text-[10px] text-claude-subtle">
                Dosya şuraya kaydedilecek:
                <code class="break-all">{{ yt_secrets_abs }}\client_secrets.json</code>
              </div>
            </div>
          {% endif %}
        {% endif %}

        <div class="grid grid-cols-2 gap-3 pt-3 border-t border-claude-border/40">
          <label class="flex items-center gap-2 text-xs">
            <input type="checkbox" name="yt_auto_upload" value="1"
                   {% if c.youtube and c.youtube.auto_upload %}checked{% endif %}>
            Otomatik yükle (render bitince)
          </label>
          <label class="flex items-center gap-2 text-xs">
            <input type="checkbox" name="yt_ai_content" value="1"
                   {% if (c.youtube.ai_content if c.youtube else True) %}checked{% endif %}>
            AI içerik etiketi (önerilen)
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted">Privacy</span>
            <select name="yt_privacy_status"
                    class="bg-claude-surface border border-claude-border px-2 py-1 rounded w-full text-xs mt-1">
              {% set p = (c.youtube.privacy_status if c.youtube else 'public') %}
              <option value="public"   {% if p == 'public'   %}selected{% endif %}>public</option>
              <option value="unlisted" {% if p == 'unlisted' %}selected{% endif %}>unlisted</option>
              <option value="private"  {% if p == 'private'  %}selected{% endif %}>private</option>
            </select>
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted">Min skor (auto-upload)</span>
            <input type="number" step="0.5" min="0" max="10" name="yt_min_score_for_upload"
                   value="{{ (c.youtube.min_score_for_upload if c.youtube else 8.0) }}"
                   class="bg-claude-surface border border-claude-border px-2 py-1 rounded w-full text-xs mt-1">
            <span class="text-[10px] text-claude-subtle">RSS-mode: skor ≥ bu değer ise auto-upload. Generator-mode: yok sayılır. 0 = filtre yok.</span>
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted">Category ID</span>
            <input type="text" name="yt_category_id"
                   value="{{ (c.youtube.category_id if c.youtube else '24') }}"
                   class="bg-claude-surface border border-claude-border px-2 py-1 rounded w-full text-xs mt-1">
            <span class="text-[10px] text-claude-subtle">24=Entertainment, 28=Tech, 17=Sport, 22=People</span>
          </label>
        </div>
      </div>
    </div>

    {# ── Card: CTA (closed by default) ───────────────────────────────── #}
    <div x-data="{ open: false }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">👋</span> CTA (Beğen-Abone-Paylaş)
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-4 border-t border-claude-border/40">
        <label class="flex items-center gap-2">
          <input type="checkbox" name="cta_enabled" value="1" {% if c.cta_enabled %}checked{% endif %}>
          <span>CTA göster</span>
        </label>
        <label class="block">
          <span class="text-xs text-claude-muted uppercase">CTA metni</span>
          <input type="text" name="cta_text" value="{{ c.cta_text }}"
                 class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
        </label>
        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">CTA emojiler (virgül)</span>
            <input type="text" name="cta_icons" value="{{ c.cta_icons | join(', ') }}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">CTA süre (sn)</span>
            <input type="number" name="cta_duration_s" value="{{ c.cta_duration_s }}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
        </div>
        <label class="flex items-center gap-2">
          <input type="checkbox" name="cta_show_handle" value="1" {% if c.cta_show_handle %}checked{% endif %}>
          <span>Handle'ı CTA üzerinde göster</span>
        </label>
      </div>
    </div>

    {% if c.dna %}

    {# ── Card: DNA — Renkler & Tipografi (open by default) ───────────── #}
    <div x-data="{ open: true }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">🎨</span> DNA — Renkler &amp; Tipografi
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-4 border-t border-claude-border/40">

        <label class="block">
          <span class="text-xs text-claude-muted uppercase">Archetype</span>
          <select name="dna_archetype" x-model="archetype"
                  class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
            {% for a in archetypes %}
              <option value="{{ a }}" {% if c.dna.archetype == a %}selected{% endif %}>{{ a }}</option>
            {% endfor %}
          </select>
          <span class="text-xs text-claude-muted block mt-1">Değiştirildiğinde template + CSS yeniden yazılır.</span>
        </label>

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Primary</span>
            <input type="color" name="dna_primary" x-model="primary"
                   value="{{ c.dna.palette.primary }}"
                   class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Accent</span>
            <input type="color" name="dna_accent" x-model="accent"
                   value="{{ c.dna.palette.accent }}"
                   class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
          </label>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">BG gradient 1</span>
            <input type="color" name="dna_bg_grad_1" x-model="bgGrad1"
                   value="{{ c.dna.palette.bg_gradient[0] }}"
                   class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">BG gradient 2</span>
            <input type="color" name="dna_bg_grad_2" x-model="bgGrad2"
                   value="{{ c.dna.palette.bg_gradient[1] }}"
                   class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
          </label>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Body BG 1</span>
            <input type="color" name="dna_body_bg_1" x-model="bodyBg1"
                   value="{{ c.dna.palette.body_bg[0] }}"
                   class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Body BG 2</span>
            <input type="color" name="dna_body_bg_2" x-model="bodyBg2"
                   value="{{ c.dna.palette.body_bg[1] }}"
                   class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
          </label>
        </div>

        <div class="border-t border-claude-border/50 pt-3">
          <div class="text-xs text-claude-subtle uppercase tracking-wider mb-2">Yazı renkleri</div>
          <div class="grid grid-cols-2 gap-3">
            <label class="block">
              <span class="text-xs text-claude-muted uppercase">Ana metin (body)</span>
              <input type="color" name="dna_text_main" x-model="textMain"
                     value="{{ c.dna.palette.text_main }}"
                     class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
              <span class="text-[10px] text-claude-subtle">Gövde paragrafı, ana yazı</span>
            </label>
            <label class="block">
              <span class="text-xs text-claude-muted uppercase">Sönük metin</span>
              <input type="color" name="dna_text_muted" x-model="textMuted"
                     value="{{ c.dna.palette.text_muted }}"
                     class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
              <span class="text-[10px] text-claude-subtle">Handle, alt yazı, ikincil</span>
            </label>
          </div>
          <div class="text-[10px] text-claude-subtle mt-2">
            Default: başlık üst → Accent rengi, başlık alt → Ana metin rengi.
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <label class="block">
              <span class="text-xs text-claude-muted uppercase">Başlık üst (özel)</span>
              <div class="flex gap-1 mt-1">
                <input type="color" name="dna_header_top_color" x-model="headerTopColor"
                       :disabled="!headerTopColor"
                       class="bg-claude-surface border border-claude-border rounded-lg flex-1 h-9"
                       :class="!headerTopColor && 'opacity-40'">
                <button type="button"
                        @click="headerTopColor = headerTopColor ? '' : '{{ (c.dna.palette.accent if c.dna else "#c96442") }}'"
                        class="bg-claude-surface border border-claude-border px-2 rounded-lg text-xs hover:bg-claude-surface-alt"
                        x-text="headerTopColor ? '↺' : '+ Aç'"></button>
              </div>
              <span class="text-[10px] text-claude-subtle"
                    x-text="headerTopColor ? 'Override: ' + headerTopColor : 'Default (Accent)'"></span>
            </label>
            <label class="block">
              <span class="text-xs text-claude-muted uppercase">Başlık alt (özel)</span>
              <div class="flex gap-1 mt-1">
                <input type="color" name="dna_header_bottom_color" x-model="headerBottomColor"
                       :disabled="!headerBottomColor"
                       class="bg-claude-surface border border-claude-border rounded-lg flex-1 h-9"
                       :class="!headerBottomColor && 'opacity-40'">
                <button type="button"
                        @click="headerBottomColor = headerBottomColor ? '' : '{{ (c.dna.palette.text_main if c.dna else "#ffffff") }}'"
                        class="bg-claude-surface border border-claude-border px-2 rounded-lg text-xs hover:bg-claude-surface-alt"
                        x-text="headerBottomColor ? '↺' : '+ Aç'"></button>
              </div>
              <span class="text-[10px] text-claude-subtle"
                    x-text="headerBottomColor ? 'Override: ' + headerBottomColor : 'Default (Ana metin)'"></span>
            </label>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Headline font</span>
            <select name="dna_font_headline" x-model="fontHeadline"
                    class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
              {% for f in ["Inter", "Bebas Neue", "Playfair Display", "Anton", "JetBrains Mono", "Oswald", "Impact", "Roboto", "Montserrat", "Lato", "Open Sans"] %}
                <option value="{{ f }}" {% if c.dna.fonts.headline == f %}selected{% endif %}>{{ f }}</option>
              {% endfor %}
            </select>
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Body font</span>
            <select name="dna_font_body" x-model="fontBody"
                    class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
              {% for f in ["Inter", "Roboto", "Lato", "Open Sans", "Montserrat", "Georgia"] %}
                <option value="{{ f }}" {% if c.dna.fonts.body == f %}selected{% endif %}>{{ f }}</option>
              {% endfor %}
            </select>
          </label>
        </div>

      </div>
    </div>

    {# ── Card: DNA — Stil (closed by default) ────────────────────────── #}
    <div x-data="{ open: false }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">✦</span> DNA — Stil
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-4 border-t border-claude-border/40">

        <div>
          <span class="text-xs text-claude-muted uppercase">Banner shape</span>
          <div class="flex gap-2 mt-1">
            {% for s in ["flat", "ribbon", "slanted", "sharp"] %}
              <label class="flex-1">
                <input type="radio" name="dna_banner_shape" value="{{ s }}" x-model="bannerShape"
                       {% if c.dna.banner_shape == s %}checked{% endif %} class="hidden peer">
                <div class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border peer-checked:bg-claude-accent peer-checked:text-white peer-checked:border-claude-accent px-3 py-2 rounded-lg text-center text-sm cursor-pointer">{{ s }}</div>
              </label>
            {% endfor %}
          </div>
        </div>

        <div>
          <span class="text-xs text-claude-muted uppercase">Highlight style</span>
          <div class="flex gap-2 mt-1">
            {% for s in ["bg-flat", "underline", "marker", "neon"] %}
              <label class="flex-1">
                <input type="radio" name="dna_highlight_style" value="{{ s }}" x-model="highlightStyle"
                       {% if c.dna.highlight_style == s %}checked{% endif %} class="hidden peer">
                <div class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border peer-checked:bg-claude-accent peer-checked:text-white peer-checked:border-claude-accent px-3 py-2 rounded-lg text-center text-sm cursor-pointer">{{ s }}</div>
              </label>
            {% endfor %}
          </div>
        </div>

        <div>
          <span class="text-xs text-claude-muted uppercase">Chip style</span>
          <div class="flex gap-2 mt-1">
            {% for s in ["rounded", "sharp", "pill"] %}
              <label class="flex-1">
                <input type="radio" name="dna_chip_style" value="{{ s }}" x-model="chipStyle"
                       {% if c.dna.chip_style == s %}checked{% endif %} class="hidden peer">
                <div class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border peer-checked:bg-claude-accent peer-checked:text-white peer-checked:border-claude-accent px-3 py-2 rounded-lg text-center text-sm cursor-pointer">{{ s }}</div>
              </label>
            {% endfor %}
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Category icon</span>
            <input type="text" name="dna_category_icon" x-model="categoryIcon"
                   value="{{ c.dna.category_icon }}"
                   maxlength="4" class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-2xl text-center text-claude-text">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Search query template</span>
            <input type="text" name="dna_search_query_template" value="{{ c.dna.search_query_template }}"
                   placeholder="{header_top} {header_bottom} {category}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-xs font-mono text-claude-text">
          </label>
        </div>

        <label class="block">
          <span class="text-xs text-claude-muted uppercase">UI badge (sahne tepesi)</span>
          <input type="text" name="dna_ui_badge" value="{{ c.dna.ui_badge }}"
                 maxlength="24" placeholder="boş = locale default (SON DAKİKA)"
                 class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-claude-text">
        </label>

        <details class="bg-claude-surface border border-claude-border rounded-lg p-3">
          <summary class="text-xs text-claude-muted uppercase cursor-pointer">Persona özeti (read-only)</summary>
          <p class="text-xs text-claude-muted mt-2">{{ c.dna.persona_summary }}</p>
        </details>

      </div>
    </div>

    {# ── Card: DNA — Tone & CSS (closed by default) ───────────────────── #}
    <div x-data="{ open: false }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">✎</span> DNA — Tone &amp; CSS
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-4 border-t border-claude-border/40">

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Voice</span>
            <input type="text" name="dna_voice" value="{{ c.dna.tone.voice }}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Style</span>
            <input type="text" name="dna_style" value="{{ c.dna.tone.style }}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
        </div>

        <label class="block">
          <span class="text-xs text-claude-muted uppercase">Forbidden (virgülle)</span>
          <input type="text" name="dna_forbidden" value="{{ c.dna.tone.forbidden | join(', ') }}"
                 class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
        </label>

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Sentence max words</span>
            <input type="number" name="dna_sentence_max_words" value="{{ c.dna.tone.sentence_max_words }}"
                   min="4" max="40"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Body max chars</span>
            <input type="number" name="dna_body_max_chars" value="{{ c.dna.tone.body_max_chars }}"
                   min="50" max="800"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
        </div>

        <label class="block">
          <span class="text-xs text-claude-muted uppercase">Headline style hint</span>
          <input type="text" name="dna_headline_style_hint" value="{{ c.dna.tone.headline_style_hint }}"
                 class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
        </label>

        {% if c.dna.custom_css is defined and c.dna.custom_css %}
        <label class="block">
          <span class="text-xs text-claude-muted uppercase">Custom CSS</span>
          <textarea name="dna_custom_css" rows="6"
                    class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-xs font-mono text-claude-text">{{ c.dna.custom_css }}</textarea>
        </label>
        {% endif %}

      </div>
    </div>

    {# ── Card: Generator Ayarları (closed by default, conditional) ────── #}
    {% if c.content_source == 'generator' %}
    <div x-data="{ open: false }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">🧪</span> Generator Ayarları
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-4 border-t border-claude-border/40">

        <label class="block">
          <span class="text-xs text-claude-muted uppercase">Konu (en az 10 karakter)</span>
          <textarea name="generator_topic" rows="3"
                    class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">{{ c.generator.topic }}</textarea>
        </label>

        <div class="grid grid-cols-3 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Forbidden lookback</span>
            <input type="number" name="generator_forbidden_lookback"
                   value="{{ c.generator.forbidden_lookback }}" min="0" max="500"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Max retries</span>
            <input type="number" name="generator_max_retries"
                   value="{{ c.generator.max_retries }}" min="1" max="10"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Fuzzy threshold</span>
            <input type="number" name="generator_fuzzy_threshold" step="0.05" min="0" max="1"
                   value="{{ c.generator.fuzzy_threshold if c.generator.fuzzy_threshold is not none else '' }}"
                   placeholder="boş = settings"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
        </div>

      </div>
    </div>
    {% endif %}

    {% endif %}{# end if c.dna #}

    {# ── Card: Arka plan videosu (Pexels) ───────────────────────────────── #}
    <div class="bg-claude-surface border border-claude-border rounded-lg p-4 mt-4">
      <div class="flex items-center justify-between mb-3">
        <div class="text-xs text-claude-muted uppercase tracking-wider">Arka plan videosu (Pexels)</div>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="bg_video_enabled"
                 {% if c.bg_video and c.bg_video.enabled %}checked{% endif %}>
          Etkin
        </label>
      </div>
      <div class="grid grid-cols-3 gap-3">
        <label class="text-xs">
          <span class="block text-claude-muted mb-1">Çerçeve oranı</span>
          <select name="bg_video_scale"
                  class="bg-claude-surface-alt border border-claude-border px-2 py-1 rounded w-full text-sm text-claude-text">
            <option value="0.88" {% if c.bg_video and c.bg_video.scale == 0.88 %}selected{% endif %}>0.88 (dar şerit)</option>
            <option value="0.80" {% if c.bg_video and c.bg_video.scale == 0.80 %}selected{% endif %}>0.80 (geniş şerit)</option>
          </select>
        </label>
        <label class="text-xs">
          <span class="block text-claude-muted mb-1">Bulanıklık (px)</span>
          <input type="number" name="bg_video_blur_px" min="0" max="80"
                 value="{{ (c.bg_video.blur_px if c.bg_video else 30) }}"
                 class="bg-claude-surface-alt border border-claude-border px-2 py-1 rounded w-full text-sm text-claude-text">
        </label>
        <label class="text-xs">
          <span class="block text-claude-muted mb-1">Karartma (0–1)</span>
          <input type="number" step="0.05" name="bg_video_dim" min="0" max="1"
                 value="{{ (c.bg_video.dim if c.bg_video else 0.4) }}"
                 class="bg-claude-surface-alt border border-claude-border px-2 py-1 rounded w-full text-sm text-claude-text">
        </label>
      </div>
    </div>

    <button type="submit" class="bg-claude-accent hover:bg-claude-accent-hover text-white px-4 py-2 rounded-lg font-semibold mt-2 w-full">
      Kaydet
    </button>

    {# ── Card: Son çalışmalar (closed by default) ─────────────────────── #}
    <div x-data="{ open: false }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">⏱</span> Son çalışmalar
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 border-t border-claude-border/40">
        {% if runs %}
        <table class="w-full text-xs border border-claude-border rounded-lg overflow-hidden">
          <thead class="bg-claude-surface">
            <tr class="text-left">
              <th class="p-2">Tarih</th>
              <th class="p-2">Trigger</th>
              <th class="p-2">Durum</th>
              <th class="p-2">Süre</th>
              <th class="p-2"></th>
            </tr>
          </thead>
          <tbody>
            {% for r in runs %}
            <tr class="border-t border-claude-border">
              <td class="p-2 font-mono">{{ r.started_at.strftime('%d %b %H:%M') }}</td>
              <td class="p-2 text-claude-muted">{{ r.trigger }}</td>
              <td class="p-2">
                {% if r.status == 'success' %}
                  <span class="text-claude-success">✓ {{ r.status }}</span>
                {% elif r.status == 'failed' %}
                  <span class="text-claude-error">✗ {{ r.status }}</span>
                {% elif r.status == 'cancelled' %}
                  <span class="text-claude-muted">⊘ cancelled</span>
                {% elif r.status == 'running' or r.status is none %}
                  <span class="text-yellow-600">● running</span>
                {% else %}
                  <span class="text-claude-muted">{{ r.status or '—' }}</span>
                {% endif %}
              </td>
              <td class="p-2 text-claude-muted">
                {% if r.duration_seconds is not none %}
                  {{ r.duration_seconds }}s
                {% else %}—{% endif %}
              </td>
              <td class="p-2 text-right">
                {% if r.status == 'running' or r.status is none %}
                  <form method="POST" action="/runs/{{ r.id }}/cancel" class="inline"
                        onsubmit="return confirm('Run #{{ r.id }} iptal edilsin mi?')">
                    <button class="text-claude-error hover:underline">İptal</button>
                  </form>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
          <p class="text-sm text-claude-muted pt-1">Henüz run yok.</p>
        {% endif %}
      </div>
    </div>

    {# ── Generator test result (conditional) ──────────────────────────── #}
    {% if c.content_source == 'generator' %}
    <div class="bg-white border border-claude-border rounded-xl shadow-soft mb-4 p-5">
      <h2 class="font-serif text-base font-semibold flex items-center gap-2 mb-3">
        <span class="text-lg opacity-70">🧪</span> Test Sonucu
      </h2>
      <div id="generator-test-result" class="text-sm text-claude-muted">
        "🧪 Test örnek üret" butonuna basıldığında burada görünür.
      </div>
    </div>
    {% endif %}

  </div>
</form>

{# Companion forms for YouTube actions — kept outside the channel-save form
   because HTML5 forbids nested forms. Buttons inside the save form reference
   these via form="<id>" attribute. #}
<form id="yt-disconnect-form" method="POST"
      action="/channels/{{ c.slug }}/youtube/disconnect" class="hidden"></form>
<form id="yt-connect-form" method="POST"
      action="/channels/{{ c.slug }}/youtube/connect" class="hidden"></form>
<form id="yt-upload-secrets-form" method="POST"
      action="/channels/{{ c.slug }}/youtube/upload-secrets"
      enctype="multipart/form-data" class="hidden"></form>
<form id="yt-reset-form" method="POST"
      action="/channels/{{ c.slug }}/youtube/reset" class="hidden"></form>
{% endblock %}
