        </label>

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Primary</span>
            <input type="color" name="dna_primary"
                   :value="primary"
                   @input="primary = $event.target.value"
                   @change="primary = $event.target.value"
                   class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Accent</span>
            <input type="color" name="dna_accent"
                   :value="accent"
                   @input="accent = $event.target.value"
                   @change="accent = $event.target.value"
                   class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
          </label>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">BG gradient 1</span>
            <input type="color" name="dna_bg_grad_1"
                   :value="bgGrad1"
                   @input="bgGrad1 = $event.target.value"
                   @change="bgGrad1 = $event.target.value"
                   class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">BG gradient 2</span>
            <input type="color" name="dna_bg_grad_2"
                   :value="bgGrad2"
                   @input="bgGrad2 = $event.target.value"
                   @change="bgGrad2 = $event.target.value"
                   class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
          </label>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Body BG 1</span>
            <input type="color" name="dna_body_bg_1"
                   :value="bodyBg1"
                   @input="bodyBg1 = $event.target.value"
                   @change="bodyBg1 = $event.target.value"
                   class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Body BG 2</span>
            <input type="color" name="dna_body_bg_2"
                   :value="bodyBg2"
                   @input="bodyBg2 = $event.target.value"
                   @change="bodyBg2 = $event.target.value"
                   class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
          </label>
        </div>

        <div class="border-t border-claude-border/50 pt-3">
          <div class="text-xs text-claude-subtle uppercase tracking-wider mb-2">Yazı renkleri</div>
          <div class="grid grid-cols-2 gap-3">
            <label class="block">
              <span class="text-xs text-claude-muted uppercase">Ana metin (body)</span>
              <input type="color" name="dna_text_main"
                     :value="textMain"
                     @input="textMain = $event.target.value"
                     @change="textMain = $event.target.value"
                     class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
              <span class="text-[10px] text-claude-subtle">Gövde paragrafı, ana yazı</span>
            </label>
            <label class="block">
              <span class="text-xs text-claude-muted uppercase">Sönük metin</span>
              <input type="color" name="dna_text_muted"
                     :value="textMuted"
                     @input="textMuted = $event.target.value"
                     @change="textMuted = $event.target.value"
                     class="bg-claude-surface border border-claude-border rounded-lg w-full mt-1 h-9">
              <span class="text-[10px] text-claude-subtle">Handle, alt yazı, ikincil</span>
            </label>
          </div>
          <div class="text-[10px] text-claude-subtle mt-2">
            Default: başlık üst → Accent rengi, başlık alt → Ana metin rengi.
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <label class="block">
              <span class="text-xs text-claude-muted uppercase">Başlık üst (özel)</span>
              <div class="flex gap-1 mt-1">
                <input type="color" name="dna_header_top_color"
                       :value="headerTopColor"
                       @input="headerTopColor = $event.target.value"
                       @change="headerTopColor = $event.target.value"
                       :disabled="!headerTopColor"
                       class="bg-claude-surface border border-claude-border rounded-lg flex-1 h-9"
                       :class="!headerTopColor && 'opacity-40'">
                <button type="button"
                        @click="headerTopColor = headerTopColor ? '' : '{{ (c.dna.palette.accent if c.dna else "#c96442") }}'"
                        class="bg-claude-surface border border-claude-border px-2 rounded-lg text-xs hover:bg-claude-surface-alt"
                        x-text="headerTopColor ? '↺' : '+ Aç'"></button>
              </div>
              <span class="text-[10px] text-claude-subtle"
                    x-text="headerTopColor ? 'Override: ' + headerTopColor : 'Default (Accent)'"></span>
            </label>
            <label class="block">
              <span class="text-xs text-claude-muted uppercase">Başlık alt (özel)</span>
              <div class="flex gap-1 mt-1">
                <input type="color" name="dna_header_bottom_color"
                       :value="headerBottomColor"
                       @input="headerBottomColor = $event.target.value"
                       @change="headerBottomColor = $event.target.value"
                       :disabled="!headerBottomColor"
                       class="bg-claude-surface border border-claude-border rounded-lg flex-1 h-9"
                       :class="!headerBottomColor && 'opacity-40'">
                <button type="button"
                        @click="headerBottomColor = headerBottomColor ? '' : '{{ (c.dna.palette.text_main if c.dna else "#ffffff") }}'"
                        class="bg-claude-surface border border-claude-border px-2 rounded-lg text-xs hover:bg-claude-surface-alt"
                        x-text="headerBottomColor ? '↺' : '+ Aç'"></button>
              </div>
              <span class="text-[10px] text-claude-subtle"
                    x-text="headerBottomColor ? 'Override: ' + headerBottomColor : 'Default (Ana metin)'"></span>
            </label>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Headline font</span>
            <select name="dna_font_headline" x-model="fontHeadline"
                    class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
              {% for f in ["Inter", "Bebas Neue", "Playfair Display", "Anton", "JetBrains Mono", "Oswald", "Impact", "Roboto", "Montserrat", "Lato", "Open Sans"] %}
                <option value="{{ f }}" {% if c.dna.fonts.headline == f %}selected{% endif %}>{{ f }}</option>
              {% endfor %}
            </select>
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Body font</span>
            <select name="dna_font_body" x-model="fontBody"
                    class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
              {% for f in ["Inter", "Roboto", "Lato", "Open Sans", "Montserrat", "Georgia"] %}
                <option value="{{ f }}" {% if c.dna.fonts.body == f %}selected{% endif %}>{{ f }}</option>
              {% endfor %}
            </select>
          </label>
        </div>

        <div class="grid grid-cols-2 gap-3 pt-2 border-t border-claude-border/50 mt-2">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Başlık üst (px)</span>
            <input type="number" name="dna_size_headline_top" min="24" max="300"
                   x-model="sizeHeadlineTop" placeholder="auto"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
            <span class="text-[10px] text-claude-subtle">Boş = template default (newscast 100, stadium 200, stat-hero 80, polaroid 76)</span>
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Başlık alt (px)</span>
            <input type="number" name="dna_size_headline_bot" min="18" max="200"
                   x-model="sizeHeadlineBot" placeholder="auto"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
            <span class="text-[10px] text-claude-subtle">Boş = template default (newscast 100, stadium 60, stat-hero 56, polaroid 36)</span>
          </label>
        </div>

        <div class="pt-3 border-t border-claude-border/50 mt-2">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase flex items-center justify-between">
              <span>Haber görseli bulanıklık (px)</span>
              <span x-text="bgImageBlur + ' px'" class="text-claude-accent font-mono"></span>
            </span>
            <input type="range" name="bg_image_blur" min="0" max="20" step="1"
                   x-model.number="bgImageBlur"
                   class="w-full mt-2 accent-claude-accent">
            <span class="text-[10px] text-claude-subtle">
              <strong x-text="bgImageBlur === 0 ? 'Net görsel' : (bgImageBlur < 6 ? 'Hafif blur' : (bgImageBlur < 12 ? 'Orta blur' : 'Yoğun blur'))"></strong>
              — 0 = haber sitesinden gelen orijinal görsel, 8 = eski varsayılan, 20 = ağır frosted.
            </span>
          </label>
        </div>

      </div>
    </div>

    {# ── Card: DNA — Stil (closed by default) ────────────────────────── #}
    <div x-data="{ open: false }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">✦</span> DNA — Stil
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-4 border-t border-claude-border/40">

        <div>
          <span class="text-xs text-claude-muted uppercase">Banner shape</span>
          <div class="flex gap-2 mt-1">
            {% for s in ["flat", "ribbon", "slanted", "sharp"] %}
              <label class="flex-1">
                <input type="radio" name="dna_banner_shape" value="{{ s }}" x-model="bannerShape"
                       {% if c.dna.banner_shape == s %}checked{% endif %} class="hidden peer">
                <div class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border peer-checked:bg-claude-accent peer-checked:text-white peer-checked:border-claude-accent px-3 py-2 rounded-lg text-center text-sm cursor-pointer">{{ s }}</div>
              </label>
            {% endfor %}
          </div>
        </div>

        <div>
          <span class="text-xs text-claude-muted uppercase">Highlight style</span>
          <div class="flex gap-2 mt-1">
            {% for s in ["bg-flat", "underline", "marker", "neon"] %}
              <label class="flex-1">
                <input type="radio" name="dna_highlight_style" value="{{ s }}" x-model="highlightStyle"
                       {% if c.dna.highlight_style == s %}checked{% endif %} class="hidden peer">
                <div class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border peer-checked:bg-claude-accent peer-checked:text-white peer-checked:border-claude-accent px-3 py-2 rounded-lg text-center text-sm cursor-pointer">{{ s }}</div>
              </label>
            {% endfor %}
          </div>
        </div>

        <div>
          <span class="text-xs text-claude-muted uppercase">Chip style</span>
          <div class="flex gap-2 mt-1">
            {% for s in ["rounded", "sharp", "pill"] %}
              <label class="flex-1">
                <input type="radio" name="dna_chip_style" value="{{ s }}" x-model="chipStyle"
                       {% if c.dna.chip_style == s %}checked{% endif %} class="hidden peer">
                <div class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border peer-checked:bg-claude-accent peer-checked:text-white peer-checked:border-claude-accent px-3 py-2 rounded-lg text-center text-sm cursor-pointer">{{ s }}</div>
              </label>
            {% endfor %}
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Category icon</span>
            <input type="text" name="dna_category_icon" x-model="categoryIcon"
                   value="{{ c.dna.category_icon }}"
                   maxlength="4" class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-2xl text-center text-claude-text">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Search query template</span>
            <input type="text" name="dna_search_query_template" value="{{ c.dna.search_query_template }}"
                   placeholder="{header_top} {header_bottom} {category}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-xs font-mono text-claude-text">
          </label>
        </div>

        <label class="block">
          <span class="text-xs text-claude-muted uppercase">UI badge (sahne tepesi)</span>
          <input type="text" name="dna_ui_badge" value="{{ c.dna.ui_badge }}"
                 maxlength="24" placeholder="boş = locale default (SON DAKİKA)"
                 class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-claude-text">
        </label>

        <details class="bg-claude-surface border border-claude-border rounded-lg p-3">
          <summary class="text-xs text-claude-muted uppercase cursor-pointer">Persona özeti (read-only)</summary>
          <p class="text-xs text-claude-muted mt-2">{{ c.dna.persona_summary }}</p>
        </details>

      </div>
    </div>

    {# ── Card: DNA — Tone & CSS (closed by default) ───────────────────── #}
    <div x-data="{ open: false }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">✎</span> DNA — Tone &amp; CSS
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-4 border-t border-claude-border/40">

        <div class="grid grid-cols-2 gap-3">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Voice</span>
            <input type="text" name="dna_voice" value="{{ c.dna.tone.voice }}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase">Style</span>
            <input type="text" name="dna_style" value="{{ c.dna.tone.style }}"
                   class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-sm text-claude-text">
          </label>
        </div>

        <label class="block">
          <span class="text-xs text-claude-muted uppercase">Forbidden (virgülle)</span>
          <input type="text" name="dna_forbidden" value="{{ c.dna.tone.forbidden | join(', ') }}"
