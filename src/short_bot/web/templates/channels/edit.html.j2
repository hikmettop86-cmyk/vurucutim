    {# ── Card: Seslendirme (voiced üretim — ai33/ElevenLabs) ────────────── #}
    <div class="bg-claude-surface border border-claude-border rounded-lg p-4 mt-4">
      <div class="flex items-center justify-between mb-3">
        <div class="text-xs text-claude-muted uppercase tracking-wider">Seslendirme</div>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="voice_enabled"
                 {% if c.voice and c.voice.enabled %}checked{% endif %}>
          Seslendirmeli üretim (voiced)
        </label>
      </div>
      <div class="text-xs text-claude-subtle mb-3">
        Seslendirmeli kanallarda süre sesten gelir; <code>duration_s</code> yok sayılır.
      </div>
      <div class="space-y-3">
        {% include "_partials/voice_cartesia_fields.html.j2" %}
        <div class="flex items-center gap-2" id="ai33-voice-tools">
          <button type="button" id="btn-load-voices"
                  class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border px-3 py-1 rounded text-xs whitespace-nowrap">
            🔄 ai33 seslerini yükle
          </button>
          <span id="voice-load-status" class="text-[10px]"></span>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <label class="text-xs">
            <span class="block text-claude-muted mb-1">Hız (ai33 0.5–1.5 · Cartesia 0.6–1.5)</span>
            <input type="number" step="0.1" min="0.5" max="1.5" name="voice_speed"
                   value="{{ c.voice.speed if c.voice else 1.0 }}"
                   class="bg-claude-surface-alt border border-claude-border px-2 py-1 rounded w-full text-sm text-claude-text">
          </label>
          <label class="text-xs">
            <span class="block text-claude-muted mb-1">Persona</span>
            {# textarea + |e ŞART. Bu proje .html.j2 uzantısı kullanıyor ve Flask
               autoescape'i yalnız .html/.htm/.xml'de açar — yani BURADA KAPALI.
               Persona metni tırnak içeriyor ("biz", "bizim çocuklar"); tek satırlık
               value="..." alanında ilk tırnakta attribute kırılıyor ve metin
               SESSİZCE kesiliyordu: kaydeden kullanıcı personasının yarısını
               kaybediyordu (canlı vaka, Aslan Gündem+). #}
            <textarea name="voice_persona" rows="4"
                      class="bg-claude-surface-alt border border-claude-border px-2 py-1 rounded w-full text-sm text-claude-text font-mono">{{ (c.voice.persona if c.voice else 'enerjik, meraklı anlatıcı')|e }}</textarea>
          </label>
        </div>
        <div>
          <span class="block text-claude-muted text-xs mb-1">Hedef süre (sn)</span>
          <div class="grid grid-cols-2 gap-3">
            <input type="number" min="10" max="180" name="voice_target_min"
                   value="{{ c.voice.target_duration_s[0] if c.voice else 45 }}"
                   class="bg-claude-surface-alt border border-claude-border px-2 py-1 rounded w-full text-sm text-claude-text">
            <input type="number" min="10" max="180" name="voice_target_max"
                   value="{{ c.voice.target_duration_s[1] if c.voice else 60 }}"
                   class="bg-claude-surface-alt border border-claude-border px-2 py-1 rounded w-full text-sm text-claude-text">
          </div>
        </div>
        <label class="text-xs block mt-3">
          <span class="block text-claude-muted mb-1">
            Arka plan müziği ({{ '%.2f'|format(c.voice.music_volume if c.voice else 0.12) }})
            <small class="block text-claude-muted">Anlatımın ALTINDAKİ müzik seviyesi.
              Yüksek olursa konuşmayla karışır; 0 = müziksiz.</small>
          </span>
          <input type="number" step="0.01" min="0" max="1" name="voice_music_volume"
                 value="{{ c.voice.music_volume if c.voice else 0.12 }}"
                 class="bg-claude-surface-alt border border-claude-border px-2 py-1 rounded w-full text-sm text-claude-text">
        </label>
      </div>
      <script>
      (function() {
        const btn = document.getElementById('btn-load-voices');
        if (!btn) return;
        btn.addEventListener('click', async () => {
          const status = document.getElementById('voice-load-status');
          const dl = document.getElementById('ai33-voice-list');
          status.textContent = 'Sesler yükleniyor…';
          status.className = 'text-[10px] block mt-1 text-claude-muted';
          try {
            {# Kanal dilini geçir: liste sayfalanarak çekilip O DİLE göre süzülür.
               Dilsiz çağrıda ekranda "121 ses yüklendi" yazıyordu ama içinde
               yalnız 3 Türkçe ses vardı — aranan ses hiç görünmüyordu. #}
            const r = await fetch('/api/ai33/voices?language={{ c.language }}');
            const j = await r.json();
            const voices = j.voices || [];
            if (!voices.length) {
              status.textContent = '⚠ ' + (j.error || 'Ses listesi alınamadı — API anahtarını kontrol et');
              status.className = 'text-[10px] block mt-1 text-claude-wait';
              return;
            }
            dl.innerHTML = '';
            for (const v of voices) {
              const opt = document.createElement('option');
              opt.value = v.voice_id;
              const bits = [v.name, v.language].filter(Boolean).join(' · ');
              opt.label = bits || v.voice_id;
              dl.appendChild(opt);
            }
            status.textContent = '✓ ' + voices.length + ' ses yüklendi — girdiye tıklayıp seç';
            status.className = 'text-[10px] block mt-1 text-claude-success';
          } catch (e) {
            status.textContent = '⚠ Ses listesi alınamadı — API anahtarını kontrol et';
            status.className = 'text-[10px] block mt-1 text-claude-wait';
          }
        });
      })();
      </script>
    </div>

    {# ── Card: Reel formatı (footage-sürüklü) ──────────────────────────── #}
    <div class="bg-claude-surface border border-claude-border rounded-lg p-4 mt-4">
