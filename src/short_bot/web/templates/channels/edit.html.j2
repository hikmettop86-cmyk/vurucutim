    </div>{# end TAB: YouTube #}

    {# ── TAB: DNA / Renkler ──────────────────────────────────────────── #}
    <div x-show="currentTab === 'dna'">

    {% if not c.dna %}
    {# Fallback: channel has no DNA yet — show a helpful card with action #}
    <div class="bg-white border border-claude-border rounded-xl shadow-soft mb-4 p-5 text-center">
      <h2 class="font-serif text-base font-semibold mb-2">
        <span class="opacity-70 mr-1">🧬</span> DNA henüz oluşturulmamış
      </h2>
