          <span class="text-xs text-claude-muted uppercase">Custom CSS</span>
          <textarea name="dna_custom_css" rows="6"
                    class="bg-claude-surface border border-claude-border px-3 py-2 rounded-lg w-full mt-1 text-xs font-mono text-claude-text">{{ c.dna.custom_css }}</textarea>
        </label>
        {% endif %}

      </div>
    </div>

    {% endif %}{# end if c.dna / else fallback #}

    </div>{# end TAB: DNA #}

