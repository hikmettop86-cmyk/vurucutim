          </p>
        </div>
      </div>
    </div>

    {# ── Card: Trend Boost ────────────────────────────────────────────── #}
    <div class="bg-claude-surface border border-claude-border rounded-lg p-4 mt-4">
      <div class="flex items-center justify-between mb-3">
        <div class="text-xs text-claude-muted uppercase tracking-wider">
          Trend Boost
