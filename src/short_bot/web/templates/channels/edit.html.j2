          {% if not c.reel or c.reel.hook_angle_vary %}checked{% endif %}> Hook açısı varyasyonu</label>
        <label class="flex items-center gap-2"><input type="checkbox" name="reel_accent_vary"
          {% if not c.reel or c.reel.accent_vary %}checked{% endif %}> Vurgu rengi varyasyonu</label>
        <label class="flex items-center gap-2"><input type="checkbox" name="reel_transition_vary"
          {% if not c.reel or c.reel.transition_vary %}checked{% endif %}> Geçiş varyasyonu</label>
      </div>
      <div class="mt-3 border-t border-claude-border pt-3">
        <div class="text-xs text-claude-muted uppercase mb-2">Etkileşim mekanikleri</div>
        {# Beğeni/abone çipleri KALDIRILDI (2026-07-16, kullanıcı kararı). #}
        <div class="flex flex-wrap gap-4 text-sm mb-2">
          <label class="flex items-center gap-2"><input type="checkbox" name="reel_series_enabled"
            {% if c.reel and c.reel.series_enabled %}checked{% endif %}> Seri modu</label>
          <label class="flex items-center gap-2"><input type="checkbox" name="reel_comment_question"
            {% if not c.reel or c.reel.comment_question %}checked{% endif %}> Yorum sorusu</label>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <label class="block"><span class="text-xs text-claude-muted uppercase">Seri başlığı</span>
            <input type="text" name="reel_series_title" value="{{ c.reel.series_title if c.reel else '' }}"
                   class="bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm w-full"></label>
        </div>
      </div>
    </div>

    {# ── Generator test result (conditional, shown in Icerik tab) ──────── #}
    {% if c.content_source == 'generator' %}
    <div class="bg-white border border-claude-border rounded-xl shadow-soft mb-4 p-5">
      <h2 class="font-serif text-base font-semibold flex items-center gap-2 mb-3">
        <span class="text-lg opacity-70">🧪</span> Test Sonucu
      </h2>
      <div id="generator-test-result" class="text-sm text-claude-muted">
        "🧪 Test örnek üret" butonuna basıldığında burada görünür.
      </div>
    </div>
    {% endif %}

    </div>{# end TAB: Icerik #}


    {# ── Sticky save bar — always visible at bottom of right column #}
    <div class="sticky bottom-0 bg-claude-bg/95 backdrop-blur border-t border-claude-border pt-3 pb-3 mt-4 -mx-1 px-1 z-20">
      <button type="submit" class="bg-claude-accent hover:bg-claude-accent-hover text-white px-4 py-2.5 rounded-lg font-semibold w-full shadow-soft">
        💾 Kaydet
      </button>
    </div>

  </div>
</form>

{# Companion forms for YouTube actions — kept outside the channel-save form
   because HTML5 forbids nested forms. Buttons inside the save form reference
   these via form="<id>" attribute. #}
<form id="yt-disconnect-form" method="POST"
      action="/channels/{{ c.slug }}/youtube/disconnect" class="hidden"></form>
<form id="yt-connect-form" method="POST"
      action="/channels/{{ c.slug }}/youtube/connect" class="hidden"></form>
<form id="yt-upload-secrets-form" method="POST"
      action="/channels/{{ c.slug }}/youtube/upload-secrets"
      enctype="multipart/form-data" class="hidden"></form>
<form id="yt-reset-form" method="POST"
      action="/channels/{{ c.slug }}/youtube/reset" class="hidden"></form>
<form id="yt-refresh-stats-form" method="POST"
      action="/channels/{{ c.slug }}/youtube/refresh-stats" class="hidden"></form>
{% endblock %}
