        Bu kanal için Claude (Opus) ile özel palet + font + ton + arketip seti üret.
        ~30-60 saniye sürer. Sonradan elle ince ayar yapabilirsin.
      </p>
      <form method="POST" action="/channels/{{ c.slug }}/regenerate-dna" class="inline"
            onsubmit="return confirm('DNA Opus ile üretilsin mi? ~30-60s sürer.')">
        <button type="submit"
                class="bg-claude-accent hover:bg-claude-accent-hover text-white px-5 py-2 rounded-lg text-sm font-semibold">
          ✨ DNA Oluştur
        </button>
      </form>
      <p class="text-xs text-claude-muted mt-3">
        DNA ayarlı değilken bile <strong>Genel</strong> tab'ından temel renkleri kullanabilirsin.
      </p>
    </div>
    {% else %}

    {# ── Card: DNA — Renkler & Tipografi (open by default) ───────────── #}
    <div x-data="{ open: true }" class="bg-white border border-claude-border rounded-xl shadow-soft mb-4">
      <button type="button" @click="open = !open"
              class="w-full flex items-center justify-between px-5 py-3 hover:bg-claude-surface/40 transition-colors text-left">
        <h2 class="font-serif text-base font-semibold flex items-center gap-2">
          <span class="text-lg opacity-70">🎨</span> DNA — Renkler &amp; Tipografi
        </h2>
        <span x-text="open ? '−' : '+'" class="text-claude-muted text-xl leading-none w-5 text-center"></span>
      </button>
      <div x-show="open" class="px-5 pb-5 pt-3 space-y-4 border-t border-claude-border/40">

