                             ('ES', 'ES · İspanya'), ('US', 'US · ABD'), ('FR', 'FR · Fransa'),
                             ('JP', 'JP · Japonya'), ('GB', 'GB · Birleşik Krallık'),
                             ('AT', 'AT · Avusturya'), ('MX', 'MX · Meksika')] %}
