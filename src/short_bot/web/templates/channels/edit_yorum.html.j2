{% extends "base.html.j2" %}
{% block title %}Vurucu TİM — {{ c.name }} (Gündem Yorum){% endblock %}
{% block content %}
<div class="max-w-6xl mx-auto">
  <div class="flex items-start justify-between mb-4">
    <div>
      <div class="flex items-center gap-3">
        <h1 class="font-serif text-3xl font-bold">🎙️ {{ c.name }}</h1>
        <span class="bg-claude-error text-white text-xs font-semibold px-3 py-1 rounded-full">Gündem Yorum · {{ c.voice.provider }}</span>
        {% if not c.enabled %}<span class="bg-claude-surface-alt text-claude-muted text-xs px-2 py-1 rounded">kapalı</span>{% endif %}
      </div>
      <div class="text-sm text-claude-muted mt-1">{{ c.slug }} · {{ c.language }} · bölge {{ c.trends_region or 'dilden' }} · min hacim {{ c.trends_min_volume }} · {{ c.schedule_cron }}</div>
    </div>
    <div class="flex gap-2">
      <button hx-post="/shorts/run-now" hx-vals='{"slug": "{{ c.slug }}"}' hx-swap="none"
              class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm">▶ Şimdi üret</button>
      <form method="post" action="/channels/{{ c.slug }}/compile-day" class="inline">
        <button type="submit" class="bg-claude-surface hover:bg-claude-surface-alt border border-claude-border px-3 py-2 rounded-lg text-sm">🎞️ Günün derlemesini üret</button>
      </form>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6 items-start">
    <form id="yorum-form" method="post" action="/channels/{{ c.slug }}/edit-yorum" class="space-y-4">

      {# ORTAK ÇEKİRDEK — dört formatın hepsinde AYNI parçalar.
         Gizlilik, kategori, yükleme eşiği ve AI etiketi bu sayfada HİÇ YOKTU;
         yalnız "otomatik yükle" ve credentials_from vardı. #}
      {% include "_partials/core/identity.html.j2" %}
      {% with cron_picker = false %}{% include "_partials/core/schedule.html.j2" %}{% endwith %}
      {% include "_partials/core/youtube.html.j2" %}

      <section class="bg-claude-surface border border-claude-border rounded-xl p-5 space-y-4">
        <h2 class="font-semibold text-claude-accent">Kaynak &amp; tempo</h2>
        <div class="grid grid-cols-3 gap-4">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase tracking-wide">Trends bölgesi</span>
            <select name="trends_region" class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
              {% for code, label in regions %}<option value="{{ code }}" {% if c.trends_region == code %}selected{% endif %}>{{ code }} · {{ label }}</option>{% endfor %}
            </select>
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase tracking-wide">En düşük arama hacmi</span>
            <input type="number" name="trends_min_volume" value="{{ c.trends_min_volume }}" min="100" step="100" class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase tracking-wide">Konu önceliği</span>
            <select name="trends_intent" class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
              {% for code, label in [('question', 'Soru sorulan konular önce'), ('breaking', 'Son dakika (saf olay) önce'), ('any', 'Yalnız arama hacmi')] %}
              <option value="{{ code }}" {% if (c.trends_intent or 'any') == code %}selected{% endif %}>{{ label }}</option>
              {% endfor %}
            </select>
            <span class="block text-[11px] text-claude-subtle mt-1">Kart kanalıyla aynı olayı iki kez anlatmamak için: kart "son dakika", yorum "soru" alır.</span>
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase tracking-wide">Dikey (kanalın kimliği)</span>
            <select name="trends_vertical" class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
              <option value="">— dikey yok (tüm havuz) —</option>
              {% for code, label in verticals %}
              <option value="{{ code }}" {% if c.trends_vertical == code %}selected{% endif %}>{{ label }}</option>
              {% endfor %}
            </select>
            <span class="block text-[11px] text-claude-subtle mt-1">Havuz bu dikeye süzülür; aday sayısı eşiğin altına düşerse koşu boş biter.</span>
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase tracking-wide">Marka güvenliği</span>
            <select name="brand_safety" class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
              {% for code, label in [('off','Kapalı — süzme yok'), ('normal','Normal — cinsel içerik, grafik detay, idam, uyuşturucu'), ('strict','Sıkı — beden odaklı magazin dili ve linç de elenir')] %}
              <option value="{{ code }}" {% if (c.brand_safety or 'off') == code %}selected{% endif %}>{{ label }}</option>
              {% endfor %}
            </select>
            <span class="block text-[11px] text-claude-subtle mt-1">YouTube'da para kazandırmayan konuları puanlamadan ÖNCE eler. Sıradan suç haberi elenmez.</span>
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase tracking-wide">Günde kaç video</span>
            <select name="runs_per_day" class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
              <option value="">(özel cron: {{ c.schedule_cron }})</option>
              {% for n in runs %}<option value="{{ n }}" {% if runs_now == n %}selected{% endif %}>{{ n }}</option>{% endfor %}
            </select>
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase tracking-wide">AI kapısı eşiği (min_score)</span>
            <input type="number" name="min_score" value="{{ c.min_score }}" step="0.5" min="0" max="10" class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
          </label>
        </div>
        </div>
      </section>

      <section class="bg-claude-surface border border-claude-border rounded-xl p-5 space-y-3">
        <h2 class="font-semibold text-claude-accent">Yorumcu</h2>
        <label class="block">
          <span class="text-xs text-claude-muted uppercase tracking-wide">Persona</span>
          <textarea name="voice_persona" rows="5" class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm font-mono">{{ c.voice.persona|e }}</textarea>
          <span class="text-[11px] text-claude-subtle">Sabit kurallar: kaynak adıyla olgu (≥2 kaynak) → bağlantı → denge → "bence" hükmü → soru → "neden gündemde". Parti/lider tarafı, hakaret, "şok/bomba" yasak.</span>
        </label>
        <div class="grid grid-cols-3 gap-4">
          <label class="block">
            <span class="text-xs text-claude-muted uppercase tracking-wide">Senaryo modeli</span>
            <input type="text" name="script_model" value="{{ c.script_model or '' }}" placeholder="opus" class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase tracking-wide">Hedef süre (sn)</span>
            <div class="flex gap-2 mt-1">
              <input type="number" name="voice_target_min" value="{{ c.voice.target_duration_s[0] }}" min="10" max="180" class="w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
              <input type="number" name="voice_target_max" value="{{ c.voice.target_duration_s[1] }}" min="10" max="180" class="w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
            </div>
          </label>
          <label class="block">
            <span class="text-xs text-claude-muted uppercase tracking-wide">Müzik seviyesi</span>
            <input type="number" name="voice_music_volume" value="{{ c.voice.music_volume }}" step="0.01" min="0" max="1" class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
          </label>
        </div>
      </section>

      <section class="bg-claude-surface border border-claude-border rounded-xl p-5 space-y-3">
        <h2 class="font-semibold text-claude-accent">Ses</h2>
        {% include "_partials/voice_cartesia_fields.html.j2" %}
        <label class="block w-48">
          <span class="text-xs text-claude-muted uppercase tracking-wide">Hız</span>
          <input type="number" name="voice_speed" value="{{ c.voice.speed }}" step="0.05" min="0.6" max="1.5" class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
        </label>
      </section>

      <div class="flex justify-end gap-3">
        <a href="/channels" class="px-4 py-2 rounded-lg border border-claude-border text-sm">Listeye dön</a>
        <button type="submit" class="bg-claude-accent hover:bg-claude-accent-hover text-white px-5 py-2 rounded-lg font-semibold text-sm">Kaydet</button>
      </div>
    </form>

{# YouTube aksiyon formları ana kaydet formunun DIŞINDA olmak ZORUNDA (HTML5
   iç içe form yasak). Bu sayfada HİÇ yoktu: ortak parçadaki "Yükle" / "Bağla"
   düğmeleri var olmayan bir form kimliğine işaret ediyor ve sessizce ölüyordu —
   hata yok, log yok, kullanıcı tıklıyor ve hiçbir şey olmuyordu (2026-08-22). #}
{% include "_partials/youtube_hidden_forms.html.j2" %}

    <aside class="space-y-3">
      <div class="bg-claude-surface border border-claude-border rounded-xl p-4">
        <div class="text-xs text-claude-muted uppercase tracking-wide mb-2">Son üretimler · anlatım metni</div>
        {% if not recent %}
          <div class="text-sm text-claude-muted">Henüz üretim yok. "Şimdi üret" ile ilkini dene.</div>
        {% endif %}
        {% for r in recent %}
          <div class="border-t border-claude-border/60 pt-3 mt-3 first:border-0 first:pt-0 first:mt-0">
            <a href="/shorts/{{ r.id }}" class="text-sm font-semibold hover:underline">{{ r.title }}</a>
            <div class="text-[11px] text-claude-muted">{{ r.created_at.strftime('%d.%m %H:%M') if r.created_at else '' }} · {{ r.duration_s or '?' }} sn</div>
            {% if r.narration %}
              <details class="mt-1"><summary class="text-xs text-claude-accent cursor-pointer">Anlatımı oku</summary>
                <p class="text-xs mt-1 whitespace-pre-line">{{ r.narration|e }}</p></details>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="bg-claude-surface border border-claude-border rounded-xl p-4 text-xs text-claude-muted space-y-1">
        <div><b>Günün derlemesi:</b> gece 23:30'da o günün yorum videoları (≥ 3 dk 10 sn olursa) tek uzun-form videoya birleşir; düğmeyle de üretilir.</div>
      </div>
    </aside>
  </div>
</div>
{% endblock %}
