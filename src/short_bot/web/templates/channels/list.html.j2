{% extends "base.html.j2" %}
{% block title %}short-bot — Kanallar{% endblock %}
{% block content %}
<div class="flex justify-between items-center mb-6">
  <h1 class="font-serif text-3xl font-bold">Kanallar</h1>
  <a href="/channels/new" class="bg-claude-accent hover:bg-claude-accent-hover text-white px-4 py-2 rounded-lg font-semibold text-sm">
    + Yeni Kanal
  </a>
</div>

<table class="w-full text-sm border border-claude-border rounded-lg overflow-hidden">
  <thead class="bg-claude-surface">
    <tr class="text-left">
      <th class="p-3">Slug</th>
      <th class="p-3">İsim</th>
      <th class="p-3">Dil</th>
      <th class="p-3">Archetype</th>
      <th class="p-3">Cron</th>
      <th class="p-3">DNA</th>
      <th class="p-3">Durum</th>
      <th class="p-3">Aksiyon</th>
    </tr>
  </thead>
  <tbody>
    {% for c in channels %}
      {% include "_partials/channel_row.html.j2" %}
    {% else %}
    <tr><td colspan="8" class="p-8 text-center text-claude-muted">Henüz kanal yok.</td></tr>
    {% endfor %}
  </tbody>
</table>
{% endblock %}
