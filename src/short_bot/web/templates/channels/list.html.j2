{% extends "base.html.j2" %}
{% block title %}Vurucu TİM — Kanallar{% endblock %}
{% block content %}
<div x-data="{ view: localStorage.getItem('channels_view') || 'table', search: '' }"
     x-init="$watch('view', v => localStorage.setItem('channels_view', v))">
  <div class="flex justify-between items-center mb-6">
    <h1 class="font-serif text-3xl font-bold">Kanallar</h1>
    <div class="flex items-center gap-3">
      {# View toggle #}
      <div class="flex items-center bg-claude-surface border border-claude-border rounded-lg p-0.5">
        <button @click="view = 'table'"
                :class="view === 'table' ? 'bg-white shadow-soft text-claude-text' : 'text-claude-muted'"
                class="px-3 py-1 rounded text-xs transition-colors" title="Tablo görünümü">
          ☰ Tablo
        </button>
        <button @click="view = 'card'"
                :class="view === 'card' ? 'bg-white shadow-soft text-claude-text' : 'text-claude-muted'"
                class="px-3 py-1 rounded text-xs transition-colors" title="Kart görünümü">
          ▦ Kart
        </button>
      </div>
      {# Search #}
      <input type="text" x-model="search"
             placeholder="Kanal ara..."
             class="bg-claude-surface border border-claude-border px-3 py-1.5 rounded-lg text-sm w-48">
      <a href="/channels/new" class="bg-claude-accent hover:bg-claude-accent-hover text-white px-4 py-2 rounded-lg font-semibold text-sm">
        + Yeni Kanal
      </a>
      <a href="/channels/new-curated" class="bg-claude-surface border border-claude-accent text-claude-accent hover:bg-claude-accent-soft px-4 py-2 rounded-lg font-semibold text-sm">
        💎 + Kürate Kanal
      </a>
      <a href="/channels/new-yorum" class="bg-claude-surface border border-red-600 text-red-700 hover:bg-red-50 px-4 py-2 rounded-lg font-semibold text-sm">
        🎙️ + Gündem Yorum
      </a>
    </div>
  </div>

  {# Table view #}
  <div x-show="view === 'table'">
    <table class="w-full text-sm border border-claude-border rounded-lg overflow-hidden">
      <thead class="bg-claude-surface">
        <tr class="text-left">
          <th class="p-3">Slug</th>
          <th class="p-3">İsim</th>
          <th class="p-3">Dil</th>
          <th class="p-3">Archetype</th>
          <th class="p-3">Cron</th>
          <th class="p-3">DNA</th>
          <th class="p-3">Durum</th>
          <th class="p-3">Aksiyon</th>
        </tr>
      </thead>
      <tbody>
        {% for c in channels %}
          {% include "_partials/channel_row.html.j2" %}
        {% else %}
        <tr><td colspan="8" class="p-8 text-center text-claude-muted">Henüz kanal yok.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  {# Card view #}
  <div x-show="view === 'card'" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {% for c in channels %}
      {% include "_partials/channel_card.html.j2" %}
    {% else %}
    <div class="col-span-3 bg-claude-surface border border-claude-border rounded-lg p-8 text-center text-claude-muted">
      Henüz kanal yok.
    </div>
    {% endfor %}
  </div>
</div>
{% endblock %}
