{% extends "base.html.j2" %}
{% block title %}Otomasyon — {{ channel.name }}{% endblock %}

{% macro durum(s) %}
  {%- if s == 'planned' %}<span class="text-claude-muted">planlandı</span>
  {%- elif s == 'producing' %}<span class="text-claude-accent">üretiliyor…</span>
  {%- elif s == 'produced' %}<span class="text-claude-accent">üretildi, yükleniyor</span>
  {%- elif s == 'scheduled' %}<span class="text-claude-accent font-semibold">yayına zamanlandı</span>
  {%- elif s == 'published' %}<span class="text-claude-success font-semibold">yayında</span>
  {%- elif s == 'failed' %}<span class="text-claude-error font-semibold">başarısız</span>
  {%- elif s == 'skipped' %}<span class="text-claude-error">kaçtı</span>
  {%- endif %}
{% endmacro %}

{% block content %}
<div class="max-w-5xl mx-auto p-6">
  <div class="flex items-start justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-claude-text">Otomasyon</h1>
      <p class="text-sm text-claude-muted mt-1">
        {{ channel.name }}
        {% if enabled %}
        · günde {{ ap.daily_count }} video
        · {{ '%02d'|format(ap.active_hours[0]) }}:00–{{ '%02d'|format(ap.active_hours[1]) }}:00
        · {{ tz }}
        · {{ 'YouTube zamanlar' if ap.publish_mode == 'publish_at' else 'uygulama yükler' }}
        {% endif %}
      </p>
    </div>
    {% if enabled %}
    <form method="post" action="/channels/{{ slug }}/autopilot/disable"
          onsubmit="return confirm('Otomasyon kapatılsın mı? Planlı slotlar üretilmeyecek ve kanalın normal cron''u yeniden devreye girecek.')">
      <button class="px-4 py-2 rounded-lg bg-white border border-claude-border
                     text-sm font-semibold text-claude-muted hover:text-claude-error
                     hover:border-claude-error">Kapat</button>
    </form>
    {% endif %}
  </div>

  {% with messages = get_flashed_messages() %}
    {% for m in messages %}
      <div class="mb-4 px-4 py-3 rounded-lg bg-claude-surface border border-claude-border
                  text-sm text-claude-text">{{ m }}</div>
    {% endfor %}
  {% endwith %}

  {# SESSİZ BOZULMA UYARILARI + ÇÖZÜM DÜĞMESİ.
     Otomasyon "açık" görünür ama hiçbir şey olmaz. Nedenini SÖYLEMEK yetmez —
     "Ayarlar'dan etkinleştir" demek kullanıcıyı başka sayfaya yollamaktır.
     Sorunu gösteren sayfa, çözümü de sunmalı. Düğme neyin BAŞLAYACAĞINI da söyler. #}
  {% for u in warnings %}
    <div class="mb-4 px-4 py-3 rounded-lg bg-claude-error-soft border border-claude-error/30
                flex items-start justify-between gap-4">
      <div class="flex items-start gap-2 text-sm text-claude-error min-w-0">
        <span class="font-bold flex-shrink-0">⚠</span><span>{{ u.text }}</span>
      </div>
      <form method="post" action="{{ u.action }}" class="flex-shrink-0"
            onsubmit="return confirm({{ u.confirm | tojson }})">
        <button class="px-3 py-1.5 rounded-lg bg-claude-error text-white text-xs
                       font-semibold hover:opacity-90 whitespace-nowrap">
          {{ u.label }}</button>
      </form>
    </div>
  {% endfor %}

  {% if not enabled %}
    <div class="rounded-xl border border-dashed border-claude-border bg-claude-surface
                px-6 py-10 text-center">
      <p class="text-claude-text font-medium text-lg">Otomasyon kapalı</p>
      <p class="text-sm text-claude-muted mt-3 max-w-xl mx-auto leading-relaxed">
        Bu kanal şu an <b>cron'a</b> bağlı: cron ateşlenir, video üretilir ve
        <b>üretim biter bitmez</b> yüklenir. Yani yayın saati üretim süresine bağlı
        (9 dakika sürerse 13:09, 16 dakika sürerse 13:16) ve her gün aynı dakikaya düşer.
      </p>
      <div class="mt-5 max-w-lg mx-auto text-left text-sm text-claude-muted space-y-2">
        <p>• Günde <b>N video</b>, aktif saatlere yayılmış slotlarda.</p>
        <p>• Yayın saatleri <b>insan gibi gezinir</b> (13:00 → 13:10 → 13:04 → 13:00),
          düz rastgele değil — ritim korunur, izleyici alışkanlık kurar.</p>
        <p>• Üretim yayından <b>saatler önce</b> koşar; video gizli yüklenir ve
          YouTube tam slot anında yayınlar. Uygulama o saatte açık olmak zorunda değil.</p>
        <p>• Kanalın cron'u <b>devre dışı kalır</b> (çifte üretim olmasın diye).</p>
      </div>
      <form method="post" action="/channels/{{ slug }}/autopilot/enable" class="mt-6">
        <button class="px-5 py-2.5 rounded-lg bg-claude-accent text-white
                       text-sm font-semibold hover:opacity-90">
          Otomasyonu aç</button>
      </form>
      <p class="text-xs text-claude-muted mt-3">
        Varsayılan: günde 3 video, 10:00–22:00, yayından 1 saat önce üretim.
        Her şey <a href="/channels/{{ slug }}/edit-reel"
                   class="text-claude-accent hover:underline">Ayarlar</a>'dan geri alınabilir.
      </p>
    </div>
  {% else %}
    <div class="grid grid-cols-4 gap-3 mb-6">
      {% for etiket, deger, renk in [
          ('Bugün', summary.toplam, 'text-claude-text'),
          ('Yayında', summary.published, 'text-claude-success'),
          ('Zamanlandı', summary.scheduled, 'text-claude-accent'),
          ('Başarısız', summary.failed, 'text-claude-error')] %}
      <div class="rounded-xl border border-claude-border bg-white p-4 text-center">
        <div class="text-2xl font-bold {{ renk }}">{{ deger }}</div>
        <div class="text-xs text-claude-muted mt-1">{{ etiket }}</div>
      </div>
      {% endfor %}
    </div>

    {# ── AYARLAR — BURADA, otomasyonu izlediğin yerde ─────────────────────
       Kullanıcı şikâyeti: "günde kaç video yükleneceği ayarı arayüzde yok". #}
    <details class="mb-6 rounded-xl border border-claude-border bg-white"
             {% if not days.get(today) %}open{% endif %}>
      <summary class="px-5 py-3 text-sm font-semibold text-claude-text cursor-pointer
                      select-none">Ayarlar</summary>
      <form method="post" action="/channels/{{ slug }}/autopilot/settings"
            class="px-5 pb-5 grid grid-cols-2 gap-4">
        <label class="block">
          <span class="text-xs text-claude-muted uppercase tracking-wide">Günde kaç video</span>
          <input type="number" name="daily_count" min="1" max="12"
                 value="{{ ap.daily_count }}"
                 class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
        </label>

        <label class="block">
          <span class="text-xs text-claude-muted uppercase tracking-wide">Bunun kaçı SERİ bölümü</span>
          <input type="number" name="series_per_day" min="0" max="3"
                 value="{{ ap.series_per_day }}"
                 class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
          <small class="text-claude-muted">
            <b>1 bırak.</b> Seri bölümü izleyiciye "<b>#2 yarın</b>" diye söz veriyor.
            Günde 3 bölüm üretirsen 3 bölümlük ark <b>bir günde biter</b> ve #2 aynı gün
            yayınlanır — söz yalan olur, abone takası çöker.
            Kalan slotlar konu bankasından bağımsız video üretir (seriyi ilerletmez).
          </small>
        </label>

        <label class="block">
          <span class="text-xs text-claude-muted uppercase tracking-wide">Aktif saatler</span>
          <div class="mt-1 flex items-center gap-2">
            <input type="number" name="active_lo" min="0" max="23"
                   value="{{ ap.active_hours[0] }}"
                   class="w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
            <span class="text-claude-muted">–</span>
            <input type="number" name="active_hi" min="1" max="24"
                   value="{{ ap.active_hours[1] }}"
                   class="w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
          </div>
          <small class="text-claude-muted">{{ tz }} · slotlar bu aralığa yayılır</small>
        </label>

        <label class="block">
          <span class="text-xs text-claude-muted uppercase tracking-wide">Yayından kaç saat önce üret</span>
          <input type="number" name="produce_lead_hours" min="1" max="12"
                 value="{{ ap.produce_lead_hours }}"
                 class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
          <small class="text-claude-muted">Üretim ~15 dk sürüyor; tampon bırakır.</small>
        </label>

        <label class="block">
          <span class="text-xs text-claude-muted uppercase tracking-wide">Saat sapması (dakika)</span>
          <input type="number" name="jitter_minutes" min="0" max="120"
                 value="{{ ap.jitter_minutes }}"
                 class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
          <small class="text-claude-muted">
            Yayın saati tabandan en fazla bu kadar gezinir (13:00 → 13:10 → 13:04).
            0 = her gün aynı dakika (otomasyon parmak izi).
          </small>
        </label>

        <label class="block">
          <span class="text-xs text-claude-muted uppercase tracking-wide">Yayın modu</span>
          <select name="publish_mode"
                  class="mt-1 w-full bg-white border border-claude-border rounded-lg px-3 py-2 text-sm">
            <option value="publish_at" {% if ap.publish_mode == 'publish_at' %}selected{% endif %}>
              YouTube zamanlar (publishAt)</option>
            <option value="live_upload" {% if ap.publish_mode == 'live_upload' %}selected{% endif %}>
              Uygulama slot anında yükler</option>
          </select>
          <small class="text-claude-muted">
            <b>publishAt:</b> video gizli yüklenir, YouTube tam slot anında yayınlar —
            uygulama o saatte açık olmak zorunda değil.
          </small>
        </label>

        <div class="col-span-2 flex items-center gap-3">
          <button class="px-4 py-2 rounded-lg bg-claude-accent text-white text-sm
                         font-semibold hover:opacity-90">Kaydet</button>
          <span class="text-xs text-claude-muted">
            Üretilmemiş slotlar silinip yeni ayarlarla yeniden planlanır.
            Üretilmiş/yüklenmiş slotlara dokunulmaz.
          </span>
        </div>
      </form>
    </details>

    {% for gun, baslik in [(today, 'Bugün'), (tomorrow, 'Yarın')] %}
    <h2 class="text-sm font-semibold text-claude-muted uppercase tracking-wide mb-3">
      {{ baslik }} <span class="normal-case font-normal">({{ gun }})</span></h2>
    {% if days.get(gun) %}
      <div class="space-y-2 mb-6">
      {% for s in days[gun] %}
        <div class="rounded-xl border {% if s.status in ('failed','skipped') %}border-claude-error/30{% else %}border-claude-border{% endif %}
                    bg-white p-4 flex items-center gap-4">
          <div class="w-20 font-mono text-lg font-bold text-claude-text flex-shrink-0">
            {{ s.local_time.strftime('%H:%M') if s.local_time else '—' }}</div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-0.5">
              {# SLOT TÜRÜ: seri bölümü mü, bankadan bağımsız konu mu? Günde en fazla
                 1 seri bölümü — yoksa "#2 yarın" sözü aynı gün bozulur. #}
              {% if s.kind == 'series' %}
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-claude-idle-soft
                             text-claude-idle font-semibold">📚 SERİ BÖLÜMÜ</span>
              {% else %}
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-claude-surface-alt
                             text-claude-muted">🎯 bağımsız konu</span>
              {% endif %}
            </div>
            <div class="text-sm">{{ durum(s.status) }}</div>
            {% if s.error %}
            <p class="text-xs text-claude-error mt-1">{{ s.error }}</p>
            {% endif %}
            {% if s.attempts > 1 %}
            <p class="text-xs text-claude-muted mt-1">{{ s.attempts }} deneme</p>
            {% endif %}
          </div>
          {% if s.short_id %}
          <a href="/shorts/{{ s.short_id }}"
             class="text-xs text-claude-muted hover:text-claude-accent flex-shrink-0">
            videoyu aç →</a>
          {% endif %}
        </div>
      {% endfor %}
      </div>
    {% else %}
      {# Kanal devre dışıyken "planlayıcı birkaç dakika içinde yazacak" demek YALAN:
         asla yazmayacak. Boş durum, üstteki uyarıyla ÇELİŞMEMELİ. #}
      <div class="rounded-xl border border-dashed border-claude-border
                  bg-claude-surface px-4 py-6 text-center text-sm text-claude-muted mb-6">
        {% if not channel.enabled %}
          Kanal devre dışı — slot planlanmıyor.
        {% else %}
          Slot yok — planlayıcı birkaç dakika içinde yazacak.
        {% endif %}
      </div>
    {% endif %}
    {% endfor %}
  {% endif %}
</div>
{% endblock %}
