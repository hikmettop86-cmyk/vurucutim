<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Vurucu TİM{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400;1,700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            /* Onaylanan Kokpit tasarımının paleti. Krem zemin ve terracotta
               aksan korundu; nötrler ve durum renkleri KONTRAST İÇİN
               koyulaştırıldı — eskiler uzun süre ekrana bakan biri için
               yeterince ayrışmıyordu (ölçüm yorumlarda). */
            'claude-bg': '#faf9f5',
            'claude-surface': '#f4f1e8',
            'claude-surface-alt': '#eae5d8',
            'claude-text': '#14140f',
            'claude-muted': '#55524a',   /* 8,1:1 (eski #6b6863 = 5,3:1) */
            'claude-subtle': '#726e64',  /* 5,6:1 (eski #94918a = 3,0:1) */
            'claude-accent': '#bc5533',
            'claude-accent-hover': '#a4462a',
            'claude-accent-soft': '#f7e2d8',
            'claude-border': '#e0dcce',
            'claude-border-strong': '#c6c0ac',
            /* Durum renkleri aksandan (terracotta) AYRI tutulur: aksan
               "tıklanır" demek, bunlar "bilgi" demek. Kokpit bu ayrımın
               üstüne kurulu. */
            'claude-error': '#9e271f',
            'claude-error-soft': '#f9e6e3',
            'claude-success': '#216745',
            'claude-success-soft': '#e4efe8',
            'claude-wait': '#855808',
            'claude-wait-soft': '#fbf1dc',
            'claude-idle': '#47546a',
            'claude-idle-soft': '#eceef2',
          },
          fontFamily: {
            serif: ['"Source Serif 4"', 'Georgia', 'serif'],
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
          boxShadow: {
            'soft': '0 1px 2px rgba(20,20,19,0.04), 0 1px 1px rgba(20,20,19,0.02)',
            'card': '0 1px 3px rgba(20,20,19,0.06), 0 4px 12px rgba(20,20,19,0.04)',
          }
        }
      }
    }
  </script>
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    [x-cloak] { display: none !important; }
    /* 14px'ti; uzun süre ekrana bakan operatör için 15,5px'e çıkarıldı. */
    body { font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased;
           font-size: 15.5px; line-height: 1.55; }
    /* ---- Kokpit tasarımının ÖLÇEĞİ, tüm sayfalara ----
       Utility sınıfları yazan şablonlar bunları ezer; ezmeyenler ölçeği
       otomatik alır. Böylece 25 şablonu tek tek düzenlemeden panelin
       tamamı aynı tipografiye oturuyor. */
    h1, h2, h3 { font-family: 'Source Serif 4', Georgia, serif; letter-spacing: -0.015em; }
    h1 { font-size: 34px; line-height: 1.15; }
    h2 { font-size: 22px; line-height: 1.25; }
    h3 { font-size: 17px; line-height: 1.3; }

    /* Tablo başlıkları: 12px, seyrek harf aralıklı, sessiz.
       Panelde çoğu tablo başlığı gövde metniyle aynı puntodaydı ve
       başlıkla veri birbirine karışıyordu. */
    table th {
      font-size: 12px; font-weight: 600; letter-spacing: .05em;
      text-transform: uppercase; color: #726e64;
    }
    table td { font-size: 14.5px; }

    /* Form denetimleri gövdeyle aynı ölçekte olsun — tarayıcı varsayılanı
       13px'e düşürüyor ve formlar sayfanın geri kalanından küçük kalıyordu. */
    input, select, textarea, button { font-size: inherit; font-family: inherit; }

    /* Tailwind'in en küçük iki sınıfı okunmuyordu; tabanları yükseltildi. */
    .text-xs { font-size: 13px; line-height: 1.45; }
    .text-sm { font-size: 14.5px; line-height: 1.5; }
    .nav-link { position: relative; transition: color 150ms ease; }
    .nav-link::after {
      content: '';
      position: absolute;
      left: 0; right: 0; bottom: -14px;
      height: 2px;
      background: #c96442;
      transform: scaleX(0);
      transform-origin: center;
      transition: transform 180ms ease;
    }
    .nav-link.active { color: #141413; }
    .nav-link.active::after { transform: scaleX(1); }
    .nav-link:hover::after { transform: scaleX(0.5); }
  </style>
</head>
<body class="bg-claude-bg text-claude-text min-h-screen flex flex-col">
  {% set p = request.path %}
  {# Üst çubuk. Kırpma TUZAĞI: menü kapsayıcısında overflow-x-auto vardı ve
     "Daha fazla" açılırı mutlak konumlu olduğu için görünmeden kesiliyordu —
     düğme çalışıyor ama hiçbir şey açılmıyor sanılıyordu. Kapsayıcı artık
     taşmayı kesmiyor; dar ekranda başlıklar sarıyor. #}
  <nav class="bg-white border-b border-claude-border sticky top-0 z-40">
    <div class="container mx-auto max-w-7xl px-7 h-[60px] flex items-center gap-6">

      <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
        <span class="w-8 h-8 rounded-lg bg-claude-accent text-white flex items-center justify-center
                     font-serif text-[19px] group-hover:bg-claude-accent-hover transition-colors">V</span>
        <span class="font-serif font-bold text-[17px] tracking-tight">Vurucu <span class="text-claude-accent">TİM</span></span>
      </a>

      <div class="flex items-center gap-1 flex-1 min-w-0">
        {% set nav_ana = [
          ('/', 'Kokpit', p == '/'),
          ('/shorts', 'Shorts', p.startswith('/shorts')),
          ('/channels', 'Kanallar', p.startswith('/channels')),
          ('/gundem', 'Gündem', p.startswith('/gundem')),
          ('/feeds', 'RSS', p.startswith('/feeds')),
          ('/youtube', 'YouTube', p.startswith('/youtube')),
        ] %}
        {% for yol, ad, etkin in nav_ana %}
        <a href="{{ yol }}"
           class="px-3 py-2 rounded-lg text-[14.5px] whitespace-nowrap transition-colors
                  {% if etkin %}bg-claude-surface-alt text-claude-text font-semibold
                  {% else %}text-claude-muted hover:bg-claude-surface hover:text-claude-text{% endif %}">
          {{ ad }}{% if ad == 'Shorts' and pending_review_count %}
          <b class="ml-1 font-mono tabular-nums text-claude-wait">{{ pending_review_count }}</b>
          {% endif %}
        </a>
        {% endfor %}

        <div class="relative" x-data="{ acik: false }" x-on:keydown.escape.window="acik = false">
          <button type="button" x-on:click.stop="acik = !acik" x-bind:aria-expanded="acik"
                  class="px-3 py-2 rounded-lg text-[14.5px] whitespace-nowrap transition-colors
                         text-claude-muted hover:bg-claude-surface hover:text-claude-text">
            Daha fazla <span class="text-[11px]">⌄</span>
          </button>
          <div x-show="acik" x-cloak x-on:click.outside="acik = false"
               x-transition.opacity.duration.120ms
               class="absolute top-full left-0 mt-2 z-50 w-56 p-1.5 rounded-xl bg-white border border-claude-border shadow-card">
            {% set nav_diger = [
              ('/activity', 'Akış', 'canlı üretim'),
              (None, None, None),
              ('/curated', 'Cevher', 'Reddit kürate'),
              ('/scheduler/timeline', 'Cron', 'zamanlama'),
              ('/lang-packs', 'Diller', 'dil paketleri'),
              ('/logs', 'Loglar', ''),
            ] %}
            {% for yol, ad, ipucu in nav_diger %}
              {% if yol is none %}
              <div class="h-px bg-claude-border my-1.5 mx-1"></div>
              {% else %}
              <a href="{{ yol }}"
                 class="flex items-center justify-between gap-3 px-3 py-2 rounded-lg text-[14.5px] transition-colors
                        {% if p.startswith(yol) %}bg-claude-surface-alt text-claude-text
                        {% else %}text-claude-muted hover:bg-claude-surface hover:text-claude-text{% endif %}">
                <span>{{ ad }}</span>
                {% if ipucu %}<span class="text-xs text-claude-subtle">{{ ipucu }}</span>{% endif %}
              </a>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2.5 flex-shrink-0">
        {# Cron rozeti YALNIZ sorun varken. Sağlıklıyken sıradaki üretimi
           Kokpit zaten gösteriyor; çubukta ikinci kez yazmak yer yiyordu. #}
        <span x-data="cronHealthBadge()" x-init="poll()">
          <template x-if="!loading && error">
            <a href="/scheduler/timeline"
               class="px-3 py-1.5 rounded-full text-[13px] font-medium bg-claude-error-soft text-claude-error"
               :title="error">⏱ Cron sorun</a>
          </template>
          <template x-if="!loading && !error && jobCount === 0">
            <a href="/scheduler/timeline"
               class="px-3 py-1.5 rounded-full text-[13px] font-medium bg-claude-wait-soft text-claude-wait"
               title="Hiçbir kanal cron'u kayıtlı değil">⏱ Cron boş</a>
          </template>
        </span>

        {% if system_running_count and system_running_count > 0 %}
          <a href="/activity" class="flex items-center gap-2 px-3 py-1.5 rounded-full text-[13px] font-medium bg-claude-wait-soft text-claude-wait">
            <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse"></span>
            {{ system_running_count }} çalışıyor
          </a>
        {% else %}
          <span class="flex items-center gap-2 px-3 py-1.5 rounded-full text-[13px] font-medium bg-claude-success-soft text-claude-success">
            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>Boşta
          </span>
        {% endif %}

        <a href="/settings" title="Ayarlar"
           class="w-[34px] h-[34px] rounded-lg border border-claude-border grid place-items-center transition-colors
                  {% if p.startswith('/settings') %}bg-claude-surface-alt text-claude-text
                  {% else %}text-claude-muted hover:bg-claude-surface hover:text-claude-text{% endif %}">⚙</a>

        <button hx-post="/system/restart"
                hx-confirm="Sunucu yeniden başlatılsın mı? (5 saniye sürer)"
                hx-swap="none" title="Sunucuyu yeniden başlat"
                class="w-[34px] h-[34px] rounded-lg border border-claude-border grid place-items-center
                       text-claude-muted hover:bg-claude-surface hover:text-claude-text transition-colors">↻</button>
      </div>
    </div>
  </nav>
  <script>
    document.body.addEventListener('schedule-refresh', () => {
      setTimeout(() => location.reload(), 5500);
    });
  </script>

  {# Flash toasts (auto-dismiss after 4s) #}
  <div class="fixed top-20 right-4 z-50 space-y-2 w-80" id="flash-stack">
    {% with messages = get_flashed_messages(with_categories=true) %}
      {% for category, msg in messages %}
        <div x-data="{ show: true }" x-show="show" x-init="setTimeout(() => show = false, 4000)"
             x-transition:leave="transition ease-in duration-300"
             x-transition:leave-start="opacity-100 translate-x-0"
             x-transition:leave-end="opacity-0 translate-x-4"
             class="border rounded-lg px-4 py-3 text-sm shadow-card
                    {% if category == 'error' %}bg-white border-claude-error/40 text-claude-error
                    {% elif category == 'success' %}bg-white border-claude-success/40 text-claude-success
                    {% else %}bg-white border-claude-border text-claude-text{% endif %}">
          <div class="flex items-start gap-2">
            <span>
              {% if category == 'error' %}✗{% elif category == 'success' %}✓{% else %}ℹ{% endif %}
            </span>
            <span class="flex-1">{{ msg }}</span>
            <button @click="show = false" class="text-xs opacity-60 hover:opacity-100">×</button>
          </div>
        </div>
      {% endfor %}
    {% endwith %}
  </div>

  {# Genişlik SAYFAYA bırakıldı: çoğu sayfa okunur bir ölçü ister (max-w-6xl),
     ama yoğun konsol sayfaları (ayarlar, kokpit) o ölçüde sıkışıyor. Blok
     olmadan tek çare negatif kenar boşluğuyla dışarı taşmaktı. #}
  <main class="container mx-auto px-6 py-10 {% block main_class %}max-w-6xl{% endblock %} flex-1 w-full">
    {% block content %}{% endblock %}
  </main>

  <script>
  function cronHealthBadge() {
    return {
      loading: true, error: null, jobCount: 0,
      nextRunISO: null, nextRunHuman: '',
      nextCountdown: '...',
      _intv: null,
      async poll() {
        try {
          const r = await fetch('/system/scheduler');
          const j = await r.json();
          if (!j.running) { this.error = 'Scheduler durdu'; this.loading = false; return; }
          // Filter out _reload_jobs internal
          const userJobs = (j.jobs || []).filter(x => x.id !== '_reload_jobs');
          this.jobCount = userJobs.length;
          if (userJobs.length > 0) {
            const next = userJobs
              .filter(x => x.next_run_time)
              .map(x => new Date(x.next_run_time))
              .sort((a, b) => a - b)[0];
            if (next) {
              this.nextRunISO = next.toISOString();
              this.nextRunHuman = next.toLocaleString('tr-TR');
              this._tick();
            }
          }
          this.loading = false;
          setTimeout(() => this.poll(), 30000);
        } catch (e) {
          this.error = String(e);
          this.loading = false;
          setTimeout(() => this.poll(), 30000);
        }
      },
      _tick() {
        const update = () => {
          if (!this.nextRunISO) return;
          const ms = new Date(this.nextRunISO) - new Date();
          if (ms <= 0) { this.nextCountdown = 'simdi'; return; }
          const totalMin = Math.floor(ms / 60000);
          const h = Math.floor(totalMin / 60);
          const m = totalMin % 60;
          this.nextCountdown = h > 0 ? `${h}s ${m}dk` : `${m}dk`;
        };
        update();
        if (this._intv) clearInterval(this._intv);
        this._intv = setInterval(update, 60000);
      }
    };
  }
  </script>

  <footer class="border-t border-claude-border py-5 mt-auto">
    <div class="container mx-auto max-w-6xl px-6 flex items-center justify-between text-xs text-claude-subtle">
      <span class="font-serif italic">Vurucu TİM</span>
      <span>Otomatik kısa video üretim paneli</span>
    </div>
  </footer>
</body>
</html>
