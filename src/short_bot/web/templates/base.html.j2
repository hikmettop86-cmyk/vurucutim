<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}short-bot{% endblock %}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    [x-cloak] { display: none !important; }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen">
  <nav class="bg-slate-950 border-b border-slate-800 px-6 py-3 flex items-center gap-6">
    <a href="/" class="font-bold text-red-500">&#9654; short-bot</a>
    <a href="/" class="text-slate-300 hover:text-white">Dashboard</a>
    <a href="/shorts" class="text-slate-300 hover:text-white">Shorts</a>
    <a href="/rss" class="text-slate-300 hover:text-white">RSS</a>
    <a href="/channels" class="text-slate-300 hover:text-white">Kanallar</a>
    <a href="/logs" class="text-slate-300 hover:text-white">Loglar</a>
  </nav>
  <main class="container mx-auto px-6 py-6 max-w-7xl">
    {% block content %}{% endblock %}
  </main>
</body>
</html>
