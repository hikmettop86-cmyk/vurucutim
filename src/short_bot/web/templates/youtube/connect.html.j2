{% extends "base.html.j2" %}
{% block content %}
<div class="max-w-3xl mx-auto p-6">
  <h1 class="text-2xl font-serif mb-4">YouTube Bağlantısı — {{ slug }}</h1>

  <div class="bg-yellow-50 border border-yellow-300 rounded p-4 mb-4 text-sm">
    <p class="font-semibold mb-2">⚠ Önemli: Doğru Gmail hesabıyla yetkilendir</p>
    <p>Aşağıdaki URL'yi kopyala ve <strong>{{ slug }}</strong> kanalının ait olduğu Gmail hesabının
    aktif olduğu Chrome/Edge profile veya Incognito penceresinde aç.
    Yanlış hesabın yetkilendirilmesi YouTube spam algoritması açısından risklidir.</p>
  </div>

  <label class="block">
    <span class="text-xs text-claude-muted">OAuth URL (kopyala ve istediğin browser'da aç)</span>
    <div class="flex gap-2 mt-1">
      <input id="auth-url" type="text" readonly value="{{ auth_url }}"
             class="flex-1 bg-claude-surface border border-claude-border px-2 py-2 rounded text-xs font-mono">
      <button type="button" id="btn-copy"
              class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
        📋 Kopyala
      </button>
    </div>
  </label>

  <div class="mt-6 p-4 bg-claude-surface rounded text-sm">
    <p class="font-semibold mb-2">Adım adım:</p>
    <ol class="list-decimal list-inside space-y-1">
      <li>Yukarıdaki "Kopyala" butonuna bas</li>
      <li>Doğru Gmail hesabının açık olduğu Chrome/Edge profile veya yeni bir Incognito (Ctrl+Shift+N) aç</li>
      <li>Adres çubuğuna yapıştır → Enter</li>
      <li>Google "İzin Ver" / "Allow" butonuna bas</li>
      <li>Bu pencere otomatik güncellenir, kanal bağlanır</li>
    </ol>
  </div>

  <div id="status" class="mt-4 text-sm text-claude-muted">
    ⏳ Bekleniyor... Yetkilendirme sonrası bu sayfa otomatik güncellenecek.
  </div>

  <a href="{{ url_for('channel_edit.edit', slug=slug) }}"
     class="inline-block mt-4 text-claude-muted text-sm hover:underline">
    ← Vazgeç ve geri dön
  </a>

  <script>
    (function() {
      const btn = document.getElementById('btn-copy');
      const input = document.getElementById('auth-url');
      const status = document.getElementById('status');

      btn.addEventListener('click', () => {
        input.select();
        navigator.clipboard.writeText(input.value)
          .then(() => {
            btn.textContent = '✓ Kopyalandi';
            setTimeout(() => { btn.textContent = '📋 Kopyala'; }, 2000);
          })
          .catch(() => {
            // fallback: select for manual copy
            input.select();
          });
      });

      // Poll OAuth status every 3 seconds; redirect to edit page when bound
      const slug = '{{ slug }}';
      const editUrl = '{{ url_for("channel_edit.edit", slug=slug) }}';
      let pollCount = 0;
      const maxPolls = 100;  // ~5 dakika
      const interval = setInterval(async () => {
        pollCount++;
        if (pollCount > maxPolls) {
          status.textContent = '⏱ Zaman aşımı. Manuel olarak kanal edit sayfasına dön.';
          clearInterval(interval);
          return;
        }
        try {
          const r = await fetch(`/channels/${slug}/youtube/status`);
          const j = await r.json();
          if (j.connected) {
            status.textContent = '✓ Bağlantı başarılı! Yönlendiriliyor...';
            status.className = 'mt-4 text-sm text-green-600 font-semibold';
            clearInterval(interval);
            setTimeout(() => { window.location.href = editUrl; }, 1000);
          }
        } catch (e) {
          // network glitch, ignore
        }
      }, 3000);
    })();
  </script>
</div>
{% endblock %}
