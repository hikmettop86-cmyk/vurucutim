{% extends "base.html.j2" %}
{% block content %}
<div class="space-y-6">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-2xl font-bold">Havuz — Biriken Cevherler</h1>
      <p class="text-sm text-claude-muted mt-1">
        Cron her 6 saatte bir Reddit'i tarar, kanala uygun (tona-duyarlı skor) klipleri
        buraya biriktirir. Sen bak, beğendiğini <b>Üret</b>, istemediğini <b>Ele</b>.
        Üretilen/elenen bir daha havuza girmez.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <a href="{{ url_for('curated.index') }}"
         class="text-sm px-3 py-2 rounded-lg border border-claude-border hover:bg-claude-surface-alt">← Cevher ara</a>
      <form method="post" action="{{ url_for('curated.pool_collect') }}">
        <input type="hidden" name="channel" value="{{ slug }}">
        <button type="submit"
                class="text-sm px-3 py-2 rounded-lg bg-claude-accent hover:bg-claude-accent-hover text-white">
          ⟳ Şimdi tara
        </button>
      </form>
    </div>
  </div>

  {% with messages = get_flashed_messages() %}
    {% if messages %}
    <div class="p-3 rounded-lg bg-claude-surface-alt text-sm">{{ messages|join(' · ') }}</div>
    {% endif %}
  {% endwith %}

  {% if not channels %}
  <div class="p-4 rounded-lg bg-claude-surface-alt text-sm text-claude-muted">
    Kürate kanal yok.
  </div>
  {% else %}
  <div class="flex items-center gap-2 flex-wrap">
    {% for c in channels %}
    <a href="{{ url_for('curated.pool_view', channel=c.slug) }}"
       class="text-sm px-3 py-1.5 rounded-lg border {% if c.slug == slug %}bg-claude-accent text-white border-claude-accent{% else %}border-claude-border hover:bg-claude-surface-alt{% endif %}">
      {{ c.name }}
    </a>
    {% endfor %}
    <span class="ml-2 text-xs text-claude-muted">
      bekleyen <b>{{ counts.get('pending', 0) }}</b> · üretilen {{ counts.get('produced', 0) }}
      · elenen {{ counts.get('skipped', 0) }}
    </span>
  </div>

  {% if not gems %}
  <div class="p-6 rounded-lg bg-claude-surface-alt text-sm text-claude-muted text-center">
    Bu kanalın havuzunda bekleyen cevher yok.
    <b>Şimdi tara</b>'ya bas ya da cron'un doldurmasını bekle (6 saatte bir).
  </div>
  {% else %}
  <div class="text-sm text-claude-muted">{{ gems|length }} bekleyen cevher — skor sıralı</div>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    {% for g in gems %}
    <div class="rounded-lg border border-claude-border bg-white overflow-hidden flex flex-col">
      <div class="relative bg-black aspect-[9/16] flex items-center justify-center">
        {% if g.thumb %}
        <img src="{{ g.thumb }}" alt="" loading="lazy" class="max-h-full max-w-full object-contain">
        {% else %}
        <span class="text-claude-muted text-xs">önizleme yok</span>
        {% endif %}
        <span class="absolute top-1 left-1 text-[10px] px-1.5 py-0.5 rounded bg-black/70 text-white">
          {{ g.orient }}{% if g.duration %} · {{ g.duration }}s{% endif %}
        </span>
        {% if g.score %}
        <span class="absolute top-1 right-1 text-[10px] px-1.5 py-0.5 rounded font-bold text-white {% if g.score >= 8 %}bg-claude-accent{% elif g.score >= 6 %}bg-amber-500{% else %}bg-black/50{% endif %}"
              title="Tona-duyarlı skor (1-10)">🔥 {{ g.score|round(0)|int }}</span>
        {% endif %}
      </div>
      <div class="p-2 flex flex-col gap-1 flex-1">
        <div class="text-xs font-medium line-clamp-2" title="{{ g.title }}">{{ g.title }}</div>
        <div class="text-[11px] text-claude-muted">⬆ {{ '{:,}'.format(g.ups or 0) }} · r/{{ g.sub }}</div>
        <div class="mt-auto flex items-center gap-2 pt-1">
          <a href="{{ g.permalink }}" target="_blank" rel="noopener"
             class="text-[11px] text-claude-accent hover:underline">izle ↗</a>
          <form method="post" action="{{ url_for('curated.pool_skip') }}" class="ml-auto">
            <input type="hidden" name="pool_id" value="{{ g.id }}">
            <input type="hidden" name="channel" value="{{ slug }}">
            <button type="submit"
                    class="text-[11px] text-claude-muted hover:text-red-600 px-1.5 py-1">Ele</button>
          </form>
          <form method="post" action="{{ url_for('curated.pool_produce') }}">
            <input type="hidden" name="pool_id" value="{{ g.id }}">
            <button type="submit"
                    class="text-[11px] bg-claude-accent hover:bg-claude-accent-hover text-white px-2 py-1 rounded">
              Üret
            </button>
          </form>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% endif %}
</div>
{% endblock %}
