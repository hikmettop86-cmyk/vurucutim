{% if status == "error" %}
<div class="p-3 rounded-lg bg-claude-error-soft text-claude-error text-sm">Üretim başlatılamadı: {{ error }}</div>
{% else %}
<div class="p-3 rounded-lg bg-claude-success/10 ring-1 ring-claude-success/30 text-sm text-claude-success">
  ✓ “{{ title }}” üretimi başladı (~2 dk: indir → temizle → vision → senaryo → montaj).
  Canlı ilerlemeyi <a href="/activity" class="underline font-medium">Akış'ta izle →</a>,
  bitince <a href="/shorts" class="underline font-medium">Shorts'ta</a> görünür + yüklenebilir.
</div>
{% endif %}
