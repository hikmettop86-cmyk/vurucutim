<div class="label">{{ feed.title|e }} · {{ items|length }} haber</div>
{% for row in items %}
{% set n = row.item %}
<div class="feed-card{% if row.done %} done{% endif %}"
     style="display:flex;gap:12px;border:1px solid #2a2a2a;border-radius:8px;
            padding:10px;margin-bottom:10px{% if row.done %};opacity:.55{% endif %}">
  {% if n.thumb_url %}
  <img src="{{ n.thumb_url|e }}" style="width:80px;height:80px;object-fit:cover;border-radius:6px">
  {% else %}
  <div style="width:80px;height:80px;background:#222;border-radius:6px"></div>
  {% endif %}
  <div style="flex:1">
    <div style="font-weight:700">{{ n.title|e }}</div>
    <div style="font-size:12px;opacity:.65">
      {% if n.pub_date %}{{ n.pub_date.strftime('%d.%m %H:%M') }} · {% endif %}{{ (n.source or '')|e }}
      {% if row.done %} · ✓ daha önce yapıldı{% endif %}
    </div>
    {% if n.description %}<div style="font-size:12px;opacity:.8">{{ n.description[:140]|e }}</div>{% endif %}
  </div>
  <form method="post" action="{{ url_for('feeds.produce') }}" style="align-self:center">
    <input type="hidden" name="guid" value="{{ n.guid|e }}">
    <input type="hidden" name="title" value="{{ n.title|e }}">
    <input type="hidden" name="link" value="{{ n.link|e }}">
    <input type="hidden" name="source" value="{{ (n.source or '')|e }}">
    <input type="hidden" name="thumb_url" value="{{ (n.thumb_url or '')|e }}">
    <input type="hidden" name="description" value="{{ (n.description or '')|e }}">
    {% if n.pub_date %}<input type="hidden" name="pub_date" value="{{ n.pub_date.isoformat() }}">{% endif %}
    <select name="channel_slug" required>
      {% for c in channels %}<option value="{{ c.slug }}">{{ c.name }}</option>{% endfor %}
    </select>
    <button type="submit">▶ {% if row.done %}Yine de yap{% else %}Video Yap{% endif %}</button>
  </form>
</div>
{% else %}
<p>Bu feed'de haber bulunamadı.</p>
{% endfor %}
