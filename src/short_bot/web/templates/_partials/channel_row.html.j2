<tr class="border-b border-claude-border hover:bg-claude-surface-alt" id="channel-{{ c.slug }}"
    {% if c.reel and c.reel.enabled %}style="border-left: 3px solid {{ c.reel.highlight_color }}"{% endif %}
    x-show="!search || '{{ c.slug }}'.toLowerCase().includes(search.toLowerCase()) || '{{ c.name|e }}'.toLowerCase().includes(search.toLowerCase())">
  <td class="p-3 font-mono text-xs">
    {{ c.slug }}
    {% if c.content_source == 'generator' %}
      <span title="Generator (Sonnet)" class="text-claude-accent ml-1">✨</span>
    {% else %}
      <span title="RSS" class="text-claude-muted ml-1">📰</span>
    {% endif %}
    {% if c.reel and c.reel.enabled %}
      <span title="Reel (footage'lı ilginç bilgiler)" class="ml-1">🎬</span>
    {% endif %}
  </td>
  <td class="p-3">{{ c.name }}</td>
  <td class="p-3">{{ c.language }}</td>
  <td class="p-3 text-claude-muted">
    {% if c.reel and c.reel.enabled %}
      <span class="font-semibold" style="color: {{ c.reel.highlight_color }}">🎬 Reel</span>
      <span class="text-xs">· {{ c.reel.target_duration_s[0] }}-{{ c.reel.target_duration_s[1] }}sn</span>
    {% else %}
      {{ c.template }}
    {% endif %}
  </td>
  <td class="p-3">
    <span class="font-mono text-xs text-claude-muted" title="{{ c.schedule_cron }}">
      {{ c.schedule_cron|cron_human }}
    </span>
  </td>
  <td class="p-3">
    {% if c.dna %}
      <span class="bg-claude-success text-white px-2 py-0.5 rounded-lg text-xs">DNA</span>
    {% else %}
      <span class="text-claude-muted">—</span>
    {% endif %}
  </td>
  <td class="p-3">
    <button hx-post="/channels/{{ c.slug }}/toggle"
            hx-target="#channel-{{ c.slug }}"
            hx-swap="outerHTML"
            class="px-2 py-0.5 rounded-lg text-xs
                   {% if c.enabled %}bg-claude-success text-white{% else %}bg-claude-surface-alt text-claude-muted{% endif %}">
      {{ 'AÇIK' if c.enabled else 'KAPALI' }}
    </button>
  </td>
  <td class="p-3 whitespace-nowrap">
    <button hx-post="/shorts/run-now"
            hx-vals='{"slug": "{{ c.slug }}"}'
            hx-on::after-request="if (event.detail.successful) window.location.href='/activity?channel={{ c.slug }}'"
            class="text-claude-accent hover:underline mr-2" title="Şimdi üret">▶</button>
    <a href="/channels/{{ c.slug }}/edit" class="text-claude-accent hover:underline mr-2">Düzenle</a>
    <button hx-post="/channels/{{ c.slug }}/clone"
            hx-confirm="Kanalı klonlamak istiyor musunuz?"
            class="text-claude-muted hover:text-claude-text mr-2" title="Klonla">⎘</button>
    <button hx-post="/channels/{{ c.slug }}/delete"
            hx-confirm="'{{ c.slug }}' kanalı silinsin mi? (yaml + css + output klasörü)"
            class="text-claude-error hover:underline" title="Sil">Sil</button>
  </td>
</tr>
