{# Reel formatı kalktı: eskiden `reel.enabled` olan kanallar AYRI bir karta
   (channel_card_reel.html.j2) düşüyordu. O kartta bulunup burada olmayan Seri
   ve Otomasyon bağlantıları aşağıya taşındı — tek kart, kayıp yok. #}
<div class="bg-white border border-claude-border rounded-xl shadow-soft p-5 hover:shadow-card transition-shadow"
     id="channel-card-{{ c.slug }}"
     x-show="!search || '{{ c.slug }}'.toLowerCase().includes(search.toLowerCase()) || '{{ c.name|e }}'.toLowerCase().includes(search.toLowerCase())">
  <div class="flex items-start justify-between mb-3">
    <div class="min-w-0 flex-1">
      <a href="/channels/{{ c.slug }}/edit" class="block group">
        <h3 class="font-serif font-bold text-lg text-claude-text group-hover:text-claude-accent truncate flex items-center flex-wrap gap-1">
          {{ c.name }}
          {% if c.dynamic_dna and cache_stats is defined and c.slug in cache_stats %}
            {% set st = cache_stats[c.slug] %}
            <span class="text-[10px] bg-claude-idle/40 text-claude-idle px-2 py-0.5 rounded-full"
                  title="Dinamik DNA önbelleği: {{ st.rows }} benzersiz kayıt, {{ '%.0f' % (st.hit_rate * 100) }}% yeniden kullanım">
              🧬 dyn ({{ st.rows }} önbellek, {{ '%.0f' % (st.hit_rate * 100) }}% hit)
            </span>
          {% endif %}
        </h3>
        <p class="font-mono text-xs text-claude-muted truncate">{{ c.slug }}</p>
      </a>
    </div>
    <div class="flex flex-col items-end gap-1 ml-2 flex-shrink-0">
      {% if c.dna %}
        <span class="bg-claude-success text-white px-2 py-0.5 rounded text-xs">DNA</span>
      {% endif %}
      {% if c.content_source == 'generator' %}
        <span class="text-claude-accent text-xs">✨ Generator</span>
      {% else %}
        <span class="text-claude-muted text-xs">📰 RSS</span>
      {% endif %}
    </div>
  </div>

  {# Color swatches if DNA present #}
  {% if c.dna and c.dna.palette %}
  <div class="flex gap-1 mb-3" title="DNA paleti">
    <span class="w-6 h-6 rounded" style="background: {{ c.dna.palette.primary }}"></span>
    <span class="w-6 h-6 rounded" style="background: {{ c.dna.palette.accent }}"></span>
    <span class="w-6 h-6 rounded" style="background: {{ c.dna.palette.bg_gradient[0] }}"></span>
    <span class="w-6 h-6 rounded" style="background: {{ c.dna.palette.bg_gradient[1] }}"></span>
  </div>
  {% endif %}

  {# Meta line #}
  <div class="space-y-1 text-xs text-claude-muted mb-4">
    <div class="flex items-center gap-2">
      <span class="text-base">🌐</span>
      <span class="uppercase font-semibold">{{ c.language }}</span>
      <span>·</span>
      <span>{{ c.template }}</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="text-base">⏱</span>
      <span title="{{ c.schedule_cron }}">{{ c.schedule_cron|cron_human }}</span>
    </div>
  </div>

  {# Actions #}
  <div class="flex items-center gap-2 pt-3 border-t border-claude-border">
    <button hx-post="/channels/{{ c.slug }}/toggle"
            hx-target="#channel-card-{{ c.slug }}"
            hx-swap="outerHTML"
            class="flex-1 px-2 py-1 rounded text-xs
                   {% if c.enabled %}bg-claude-success text-white hover:opacity-90{% else %}bg-claude-surface-alt text-claude-muted hover:text-claude-text{% endif %}">
      {{ '● Açık' if c.enabled else '○ Kapalı' }}
    </button>
    <button hx-post="/shorts/run-now"
            hx-vals='{"slug": "{{ c.slug }}"}'
            hx-on::after-request="if (event.detail.successful) window.location.href='/activity?channel={{ c.slug }}'"
            class="px-2 py-1 text-claude-accent hover:bg-claude-accent-soft rounded text-xs"
            title="Şimdi üret">▶</button>
    <a href="/channels/{{ c.slug }}/edit" class="px-2 py-1 text-claude-text hover:bg-claude-surface-alt rounded text-xs">
      Düzenle
    </a>
    {% if c.content_source == 'generator' %}
    <a href="/channels/{{ c.slug }}/topic-bank" class="px-2 py-1 text-claude-text hover:bg-claude-surface-alt rounded text-xs" title="Kanıtlanmış konu bankası">🎯 Konu</a>
    {% endif %}

    {# Seri ve Otomasyon bağlantıları REEL KARTINDA duruyordu; reel formatı
       kalkınca kaybolmasınlar diye buraya taşındı — ikisi de kürate ve kart
       kanalları için de anlamlı.

       İkisi de KAPALIYKEN DE görünür. Yalnız açıkken göstermek kısır döngü
       kuruyordu: açmak için sayfaya gitmen gerekiyor, sayfaya gitmek için
       açık olması. Kapalı hâllerini sayfanın kendisi anlatıyor. #}
    {% if c.reel %}
    <a href="/channels/{{ c.slug }}/series"
       class="px-2 py-1 rounded text-xs
              {% if c.reel.series_enabled %}text-claude-accent hover:bg-claude-accent-soft{% else %}text-claude-muted hover:text-claude-text hover:bg-claude-surface-alt{% endif %}"
       title="{% if c.reel.series_enabled %}Seri: bölümler + sıradaki konu{% else %}Seri modu kapalı — açmak için tıkla{% endif %}">📚 Seri</a>
    {% endif %}
    {# Otomasyon açıkken kanalın cron'u KAPANIYOR — kullanıcının "neden
       üretmiyor?" diye sorabileceği tek yer burası. #}
    <a href="/channels/{{ c.slug }}/autopilot"
       class="px-2 py-1 rounded text-xs
              {% if c.autopilot and c.autopilot.enabled %}text-claude-accent hover:bg-claude-accent-soft{% else %}text-claude-muted hover:text-claude-text hover:bg-claude-surface-alt{% endif %}"
       title="{% if c.autopilot and c.autopilot.enabled %}Otomasyon açık — bugünün slotları{% else %}Otomasyon kapalı — açmak için tıkla{% endif %}">⚙️ Otomasyon</a>
  </div>
</div>
