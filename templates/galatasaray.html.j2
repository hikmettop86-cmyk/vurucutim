<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Galatasaray</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Anton&family=Inter:wght@500;700;800&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #0a0a0a);
    color: var(--text-main, #fff);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background:
      linear-gradient(135deg, var(--body-bg-1, #1a0608) 0%, var(--body-bg-2, #050203) 100%);
    overflow: hidden;
  }
  /* Diagonal sarı-kırmızı şerit, alttan üste */
  .stage::before {
    content: ''; position: absolute;
    top: -300px; left: -200px;
    width: 2000px; height: 600px;
    background: var(--primary, #A90432);
    transform: rotate(-12deg);
    opacity: 0.95;
  }
  .stage::after {
    content: ''; position: absolute;
    top: -240px; left: -200px;
    width: 2000px; height: 30px;
    background: var(--accent, #FCB900);
    transform: rotate(-12deg);
  }

  /* "1905" damgalı watermark */
  .watermark {
    position: absolute; bottom: 200px; right: -80px;
    font-family: 'Anton', sans-serif;
    font-size: 380px;
    color: var(--accent, #FCB900);
    opacity: 0.06;
    line-height: 0.85;
    letter-spacing: -0.04em;
    z-index: 1;
    transform: rotate(-8deg);
  }

  /* 4 yıldız üst şeritte */
  .stars {
    position: absolute; top: 28px; left: 50%;
    transform: translateX(-50%);
    display: flex; gap: 12px;
    z-index: 6;
  }
  .stars .star {
    width: 24px; height: 24px;
    background: var(--accent, #FCB900);
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    filter: drop-shadow(0 2px 0 rgba(0,0,0,0.4));
  }

  /* Üst rozet ve canlı */
  .top-row {
    position: absolute; top: 70px; left: 60px; right: 60px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 5;
  }
  .stage-badge {
    background: var(--accent, #FCB900);
    color: var(--primary, #A90432);
    padding: 12px 22px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 26px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-left: 6px solid var(--primary, #A90432);
  }
  .live-tag {
    display: flex; align-items: center; gap: 12px;
    color: var(--accent, #FCB900);
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 26px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .live-tag::before {
    content: ''; width: 14px; height: 14px; border-radius: 50%;
    background: var(--accent, #FCB900);
    box-shadow: 0 0 16px var(--accent, #FCB900);
    animation: pulse 1.4s infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(0.9)} }

  /* Manşet */
  .header {
    position: absolute; top: 180px; left: 60px; right: 60px;
    z-index: 4;
  }
  .header .top {
    display: block;
    font-family: var(--font-headline, 'Anton'), sans-serif;
    font-size: var(--size-headline-top, 220px);
    line-height: 0.85;
    color: var(--accent, #FCB900);
    text-transform: uppercase;
    letter-spacing: 0.005em;
    -webkit-text-stroke: 4px var(--primary, #A90432);
    paint-order: stroke fill;
    text-shadow: 8px 8px 0 rgba(169, 4, 50, 0.5);
    text-wrap: balance;
  }
  .header .bot {
    display: block; margin-top: 22px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: var(--size-headline-bot, 56px);
    line-height: 1.05;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    text-wrap: balance;
  }
  .header .bot::before {
    content: '▶ ';
    color: var(--accent, #FCB900);
  }

  /* Foto */
  .photo {
    position: absolute;
    top: 760px; left: 60px; right: 60px;
    height: 580px;
    background: linear-gradient(135deg, var(--bg-grad-1, #25080d), var(--bg-grad-2, #0a0204));
    border: 4px solid var(--accent, #FCB900);
    box-shadow:
      0 0 0 4px var(--primary, #A90432),
      0 30px 60px rgba(169, 4, 50, 0.35);
    overflow: hidden;
    z-index: 3;
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    filter: contrast(1.08) saturate(1.1);
  }
  .photo::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, transparent 50%, rgba(0,0,0,0.7) 100%),
      linear-gradient(135deg, transparent 60%, color-mix(in srgb, var(--primary, #A90432) 25%, transparent));
    pointer-events: none;
  }
  /* Kornerde GS armaması yerine "1905" mührü */
  .photo .stamp {
    position: absolute; top: 18px; right: 18px;
    background: var(--accent, #FCB900);
    color: var(--primary, #A90432);
    font-family: 'Anton', sans-serif;
    font-size: 32px;
    padding: 4px 14px;
    letter-spacing: 0.08em;
    border: 2px solid var(--primary, #A90432);
    transform: rotate(8deg);
    z-index: 4;
    text-shadow: 1px 1px 0 rgba(0,0,0,0.1);
  }
  .photo .yellow {
    position: absolute; left: 0; bottom: 0; right: 0;
    background: var(--accent, #FCB900);
    color: var(--primary, #A90432);
    padding: 18px 28px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 34px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-top: 4px solid var(--primary, #A90432);
    display: flex; align-items: center; gap: 14px;
  }
  .photo .yellow::before {
    content: '◆'; font-size: 24px;
  }

  /* Gövde — koyu kart, sarı çerçeve */
  .body {
    position: absolute; left: 60px; right: 60px;
    top: 1410px; bottom: 190px;
    background: rgba(0,0,0,0.4);
    border-top: 4px solid var(--accent, #FCB900);
    border-bottom: 4px solid var(--accent, #FCB900);
    padding: 28px 36px;
    z-index: 4;
    display: flex; align-items: center;
  }
  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 34px; line-height: 1.4; font-weight: 500;
    color: #fff;
    text-wrap: pretty;
  }
  .body-text .hl-y {
    background: var(--accent, #FCB900); color: var(--primary, #A90432);
    padding: 0 10px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 800;
  }
  .body-text .hl-r {
    background: var(--primary, #A90432); color: var(--accent, #FCB900);
    padding: 0 10px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 800;
  }

  /* Alt motto şeridi */
  .motto-strip {
    position: absolute; left: 0; right: 0; bottom: 130px;
    background: var(--primary, #A90432);
    color: var(--accent, #FCB900);
    padding: 8px 0;
    text-align: center;
    font-family: 'Anton', sans-serif;
    font-size: 22px;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    z-index: 5;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 6px; background: rgba(252, 185, 0, 0.18);
    z-index: 6;
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--accent, #FCB900);
    box-shadow: 0 0 12px var(--accent, #FCB900);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: 'Oswald', sans-serif;
    font-size: 32px; font-weight: 700;
    color: var(--text-muted, var(--accent, #FCB900));
    letter-spacing: 0.1em;
    text-transform: uppercase;
    z-index: 6;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="watermark">1905</div>

  <div class="stars">
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
    <div class="star"></div>
  </div>

  <div class="top-row">
    {% if script.category %}<div class="stage-badge">{{ script.category }}</div>{% endif %}
    <div class="live-tag">{{ ui_breaking }}</div>
  </div>

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    <div class="stamp">EST. 1905</div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="26" data-fit-max="34" data-fit-pad="20">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="motto-strip">CİMBOM · 1905 · ASLANLAR · 4 YILDIZ</div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
