<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Manifesto</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&family=JetBrains+Mono:wght@400;700&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #ededeb);
    color: var(--text-main, #0a0a0a);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background: var(--body-bg-1, #ededeb);
    display: grid;
    grid-template-columns: 100px 1fr;
    overflow: hidden;
  }

  /* Sol dikey şerit — kategorik */
  .side-strip {
    background: var(--primary, #1f2937);
    color: var(--accent, #fde047);
    position: relative;
    display: flex; align-items: center; justify-content: center;
  }
  .side-strip .label {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: 'JetBrains Mono', monospace;
    font-size: 32px; font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--accent, #fde047);
  }
  .side-strip .num {
    position: absolute; top: 40px; left: 0; right: 0;
    text-align: center;
    color: rgba(255,255,255,0.85);
    font-family: 'JetBrains Mono', monospace;
    font-size: 28px; font-weight: 700;
  }

  /* Sağ ana içerik */
  .content {
    padding: 60px 70px 200px;
    position: relative;
  }

  /* Üst meta */
  .meta {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 36px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 24px;
    color: color-mix(in srgb, var(--text-main, #0a0a0a) 60%, transparent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .meta .live {
    color: var(--primary, #1f2937);
    font-weight: 700;
  }
  .meta-rule {
    width: 100%; height: 3px;
    background: var(--text-main, #0a0a0a);
    margin-bottom: 50px;
  }

  /* Manşet — devasa, sola yaslı */
  .header .top {
    display: block;
    font-family: var(--font-headline, 'Inter'), sans-serif;
    font-weight: 900;
    font-size: var(--size-headline-top, 200px);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--text-main, #0a0a0a);
    text-transform: uppercase;
    text-wrap: balance;
  }
  .header .top::after {
    content: '.';
    color: var(--primary, #1f2937);
  }
  .header .bot {
    display: block; margin-top: 30px;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-weight: 500;
    font-size: var(--size-headline-bot, 44px);
    line-height: 1.2;
    color: color-mix(in srgb, var(--text-main, #0a0a0a) 60%, transparent);
    max-width: 90%;
    text-wrap: balance;
  }

  /* Foto — küçük, üst sağda */
  .photo {
    position: absolute; right: 70px; top: 970px;
    width: 480px; height: 480px;
    background: linear-gradient(135deg, var(--bg-grad-1, #1f2937), var(--bg-grad-2, #0a1018));
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(10,10,10,0.16);
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    filter: grayscale(0.15) contrast(1.05);
  }
  .photo .yellow {
    position: absolute; left: 0; bottom: 0; right: 0;
    background: var(--accent, #fde047);
    color: #0a0a0a;
    padding: 16px 22px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 24px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Gövde — sol kart, foto ile yan yana */
  .body {
    position: absolute; left: 170px; top: 970px;
    width: calc(100% - 660px - 100px);
    height: 480px;
    background: var(--text-main, #0a0a0a);
    color: #fff;
    padding: 36px 36px;
    display: flex; align-items: flex-end;
  }
  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 30px; line-height: 1.4; font-weight: 500;
    color: var(--body-bg-1, #fff);
    text-wrap: pretty;
  }
  .body-text .hl-y {
    background: var(--accent, #fde047); color: #0a0a0a;
    padding: 0 8px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 700;
  }
  .body-text .hl-r {
    background: var(--primary, #1f2937); color: #fff;
    border: 1.5px solid var(--accent, #fde047);
    padding: 0 8px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 700;
  }

  /* Alt blok */
  .footer-strip {
    position: absolute; left: 100px; right: 0; bottom: 130px;
    background: var(--accent, #fde047);
    padding: 14px 36px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 22px;
    color: #0a0a0a;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    display: flex; justify-content: space-between;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 100px; right: 0; bottom: 84px;
    height: 4px; background: rgba(0,0,0,0.1);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--primary, #1f2937);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 100px; right: 0; bottom: 30px;
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 30px; font-weight: 700;
    color: var(--text-muted, #0a0a0a);
    letter-spacing: 0.06em;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="side-strip">
    <div class="num">№</div>
    <div class="label">{% if script.category %}{{ script.category }}{% else %}MANIFESTO{% endif %}</div>
  </div>

  <div class="content">
    <div class="meta">
      <span>{{ language|upper }} · {{ handle }}</span>
      <span class="live">— {{ ui_breaking }}</span>
    </div>
    <div class="meta-rule"></div>

    <div class="header">
      <span class="top">{{ script.header_top }}</span>
      <span class="bot">{{ script.header_bottom }}</span>
    </div>
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="22" data-fit-max="30" data-fit-pad="14">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="footer-strip">
    <span>{{ ui_breaking }} ↘</span>
    <span>{{ handle }}</span>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
