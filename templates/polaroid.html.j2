<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Polaroid</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Inter:wght@500;600;700&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #2a2520);
    color: var(--text-main, #f4ede0);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background:
      radial-gradient(120% 80% at 50% 0%, color-mix(in srgb, var(--bg-grad-1, #4a3a2a) 70%, transparent), transparent 65%),
      linear-gradient(180deg, var(--body-bg-1, #2a2520), var(--body-bg-2, #1a1410));
    overflow: hidden;
  }
  /* Kraft kâğıt damar */
  .stage::before {
    content: ''; position: absolute; inset: 0;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='200' height='200'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='2'/><feColorMatrix values='0 0 0 0 0.4  0 0 0 0 0.28  0 0 0 0 0.18  0 0 0 0.2 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    opacity: 0.35;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  /* Üst kategori şeridi — stencil */
  .stage-badge {
    position: absolute; top: 60px; left: 60px;
    background: var(--accent, #d4a017);
    color: #1a1410;
    padding: 12px 22px;
    font-family: 'Inter', sans-serif;
    font-size: 22px; font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transform: rotate(-2deg);
    z-index: 5;
  }
  .timecode {
    position: absolute; top: 60px; right: 60px;
    font-family: 'Inter', sans-serif;
    font-size: 22px; font-weight: 700;
    color: var(--primary, #c93838);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: flex; align-items: center; gap: 10px;
    z-index: 5;
  }
  .timecode::before {
    content: ''; width: 10px; height: 10px; border-radius: 50%;
    background: var(--primary, #c93838);
  }

  /* Polaroid foto */
  .photo {
    position: absolute;
    top: 220px; left: 100px; right: 100px;
    background: #f5efdf;
    padding: 28px 28px 110px;
    transform: rotate(-2deg);
    box-shadow:
      0 20px 50px rgba(0,0,0,0.4),
      0 6px 0 -2px rgba(0,0,0,0.6),
      inset 0 0 0 1px rgba(0,0,0,0.05);
  }
  .photo .photo-img {
    position: relative;
    width: 100%; height: 760px;
    background: linear-gradient(135deg, var(--bg-grad-1, #1a1410) 0%, var(--bg-grad-2, #0a0604) 100%);
    overflow: hidden;
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    filter: contrast(1.05) saturate(0.9);
  }
  .photo .photo-img::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.25) 0%, transparent 25%, transparent 70%, rgba(0,0,0,0.4) 100%);
    pointer-events: none;
  }
  .photo .yellow {
    position: absolute; left: 28px; right: 28px; bottom: 28px;
    font-family: 'Caveat', cursive;
    font-weight: 700;
    font-size: 56px; line-height: 1.0;
    color: #1a1410;
    text-align: center;
    transform: rotate(-1.5deg);
  }

  /* Manşet altta */
  .header-block {
    position: absolute;
    left: 80px; right: 80px;
    bottom: 460px;
    z-index: 5;
  }
  .accent-bar {
    width: 60px; height: 3px;
    background: var(--primary, #c93838);
    margin-bottom: 26px;
  }
  .header {
    font-family: var(--font-headline, 'Source Serif 4'), serif;
    color: var(--text-main, #f4ede0);
  }
  .header .top {
    display: block;
    font-size: var(--size-headline-top, 100px);
    line-height: 0.95; font-weight: 700;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .header .bot {
    display: block;
    margin-top: 14px;
    font-family: 'Caveat', cursive;
    font-size: var(--size-headline-bot, 60px);
    font-weight: 500;
    color: var(--accent, #d4a017);
    line-height: 1.1;
    text-wrap: balance;
  }

  /* Gövde */
  .body {
    position: absolute; left: 80px; right: 80px;
    top: 1480px; bottom: 200px;
  }
  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 30px; line-height: 1.5; font-weight: 400;
    color: color-mix(in srgb, var(--text-main, #f4ede0) 90%, transparent);
    text-wrap: pretty;
  }
  .body-text .hl-y {
    background: var(--accent, #d4a017); color: #1a1410;
    padding: 0 8px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 700;
  }
  .body-text .hl-r {
    background: var(--primary, #c93838); color: #fff;
    padding: 0 8px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 700;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 4px; background: rgba(244, 237, 224, 0.12);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--accent, #d4a017);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: 'Caveat', cursive;
    font-size: 40px; font-weight: 700;
    color: var(--text-muted, color-mix(in srgb, var(--accent, #d4a017) 70%, transparent));
    letter-spacing: 0.04em;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  {% if script.category %}<div class="stage-badge">{{ script.category }}</div>{% endif %}
  <div class="timecode">{{ ui_breaking }}</div>

  <div class="photo">
    <div class="photo-img">
      <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
           {% if not bg_image_url %}display: none;{% endif %}"></div>
    </div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="header-block">
    <div class="accent-bar"></div>
    <div class="header">
      <span class="top">{{ script.header_top }}</span>
      <span class="bot">— {{ script.header_bottom }}</span>
    </div>
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="24" data-fit-max="30" data-fit-pad="16">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
