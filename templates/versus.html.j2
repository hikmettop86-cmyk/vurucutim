<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — versus</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;700;800&family=Inter:wght@400;600;700;800&display=swap');
  {{ dna_css|safe }}
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1920px; overflow: hidden; background: #0a0a0a;
    font-family: 'Inter', sans-serif;
    color: var(--text-main, #fff); }

  .stage { position: relative; width: 1080px; height: 1920px;
    display: flex; flex-direction: column; }

  /* Top header */
  .header-area { padding: 48px 54px 36px; text-align: center; }
  .stage-badge {
    display: inline-block;
    background: {{ colors.primary }}; color: #fff;
    padding: 12px 36px;
    font-family: 'Oswald', sans-serif;
    font-size: 32px; font-weight: 700; letter-spacing: 6px;
    margin-bottom: 30px;
  }
  .header { font-family: 'Oswald', sans-serif; }
  .header .top {
    display: block;
    font-size: var(--size-headline-top, 84px);
    font-weight: 700;
    line-height: 1;
    color: #fff;
    letter-spacing: -1.5px;
    white-space: nowrap;
  }
  .header .vs-letters {
    color: {{ colors.accent }};
    margin: 0 16px;
  }

  /* Two halves */
  .versus-grid {
    position: relative;
    height: 1140px;
    display: flex;
  }
  .half {
    flex: 1; position: relative;
    background: linear-gradient(135deg, {{ colors.bg_gradient[0] }}, {{ colors.bg_gradient[1] }});
    overflow: hidden;
  }
  .half .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
  }
  .half-A .bg-img { background-image: url('{{ bg_image_url|default("") }}'); }
  .half::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(0,0,0,.8));
  }
  .half-info {
    position: absolute; bottom: 42px; left: 42px; right: 42px;
    font-family: 'Oswald', sans-serif;
    z-index: 2;
  }
  .half-A .half-info { text-align: left; }
  .half-B .half-info { text-align: right; }
  .half-info .brand {
    font-size: 33px; color: {{ colors.accent }}; font-weight: 700; letter-spacing: 3px;
  }
  .half-info .product {
    font-size: 66px; color: #fff; font-weight: 700; line-height: 1;
    margin-top: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .half-info .score {
    font-size: 78px; font-weight: 700; color: #fff; margin-top: 24px;
  }
  .half-info .score .num { color: {{ colors.accent }}; }

  /* VS badge center */
  .vs-badge {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 180px; height: 180px; border-radius: 50%;
    background: {{ colors.accent }}; color: #0a0a0a;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Oswald', sans-serif;
    font-size: 66px; font-weight: 800;
    box-shadow: 0 0 0 12px #0a0a0a, 0 24px 72px rgba(0,0,0,.5);
    z-index: 3;
  }

  /* Metric bars (rendered from body_paragraph parsed) */
  .metrics {
    padding: 42px 54px;
    display: grid; gap: 24px;
  }
  .metric-row {
    display: grid;
    grid-template-columns: 96px 1fr 180px 1fr 96px;
    align-items: center; gap: 18px;
  }
  .metric-row .a-val, .metric-row .b-val {
    font-family: 'Oswald', sans-serif;
    font-size: 36px; font-weight: 700; color: #fff;
  }
  .metric-row .b-val { text-align: right; }
  .metric-row .bar {
    height: 18px; background: #222; position: relative;
  }
  .metric-row .bar-a-fill, .metric-row .bar-b-fill {
    position: absolute; top: 0; bottom: 0;
  }
  .metric-row .bar-a-fill {
    right: 0; background: {{ colors.accent }};
  }
  .metric-row .bar-b-fill {
    left: 0; background: {{ colors.primary }};
  }
  .metric-row .label {
    font-family: 'Oswald', sans-serif;
    font-size: 30px; font-weight: 700; color: #888;
    text-align: center; letter-spacing: 3px;
  }

  .progress {
    position: absolute; left: 0; right: 0; bottom: 110px; height: 6px;
    background: rgba(255,255,255,.18);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: {{ colors.accent }};
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 50px;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 30px; font-weight: 600; letter-spacing: 1.5px;
    color: var(--text-muted, rgba(255,255,255,.7));
  }

  .source-credit {
    position: absolute;
    bottom: 18px; left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,.6); color: rgba(255,255,255,.85);
    font-size: 14px; font-weight: 500; letter-spacing: 0.5px;
    padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">
  <div class="header-area">
    {% if script.category %}<div class="stage-badge">{{ script.category }}</div>{% endif %}
    <div class="header">
      <span class="top">{{ script.header_top }} <span class="vs-letters">VS</span> {{ script.header_bottom }}</span>
    </div>
  </div>

  <div class="versus-grid">
    <div class="half half-A">
      <div class="bg-img"></div>
      <div class="half-info">
        <div class="brand">A</div>
        <div class="product">{{ script.header_top }}</div>
        {% if script.photo_overlay and '/' in script.photo_overlay %}
          {% set scores = script.photo_overlay.split('/') %}
          <div class="score"><span class="num">{{ scores[0]|trim }}</span></div>
        {% endif %}
      </div>
    </div>
    <div class="vs-badge">VS</div>
    <div class="half half-B">
      <div class="bg-img"></div>
      <div class="half-info">
        <div class="brand">B</div>
        <div class="product">{{ script.header_bottom }}</div>
        {% if script.photo_overlay and '/' in script.photo_overlay %}
          {% set scores = script.photo_overlay.split('/') %}
          <div class="score"><span class="num">{{ scores[1]|trim }}</span></div>
        {% endif %}
      </div>
    </div>
  </div>

  {# body_paragraph format: "KAMERA: 92 vs 78 | PIL: 71 vs 88 | EKRAN: 88 vs 95" #}
  <div class="metrics">
    {% for row in script.body_paragraph.split('|')[:4] %}
      {% if ':' in row and 'vs' in row %}
        {% set parts = row.split(':') %}
        {% set label = parts[0]|trim %}
        {% set values = parts[1].split('vs') %}
        {% set a_val = values[0]|trim %}
        {% set b_val = values[1]|trim %}
        {% set a_num = a_val|int %}
        {% set b_num = b_val|int %}
        <div class="metric-row">
          <div class="a-val">{{ a_val }}</div>
          <div class="bar"><div class="bar-a-fill" style="width: {{ a_num }}%;"></div></div>
          <div class="label">{{ label }}</div>
          <div class="bar"><div class="bar-b-fill" style="width: {{ b_num }}%;"></div></div>
          <div class="b-val">{{ b_val }}</div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>

  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}
</div>
{% include "_auto_fit.js.j2" %}
</body>
</html>
