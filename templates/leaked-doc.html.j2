<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — leaked-doc</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Inter:wght@400;600;700&family=Courier+Prime:wght@400;700&display=swap');
  {{ dna_css|safe }}
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1920px; overflow: hidden; background: #0a0a0a;
    font-family: 'Inter', sans-serif;
    color: var(--text-main, #fff); }

  .stage { position: relative; width: 1080px; height: 1920px; }

  .top-strip {
    background: {{ colors.primary }};
    color: #fff;
    padding: 18px 0;
    text-align: center;
    font-family: 'Oswald', sans-serif;
    font-size: 33px; font-weight: 700;
    letter-spacing: 12px;
  }

  .header { padding: 60px 60px 0; }
  .header .top {
    display: block;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: var(--size-headline-top, 90px);
    line-height: 1;
    color: #fff;
    letter-spacing: -1.5px;
  }
  .header .bot {
    display: block;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: var(--size-headline-bot, 90px);
    line-height: 1;
    color: {{ colors.primary }};
    letter-spacing: -1.5px;
    margin-top: 6px;
  }

  /* Document */
  .doc {
    margin: 54px 60px 0;
    background: #f4f1e8;
    color: #222;
    padding: 42px 42px 54px;
    transform: rotate(-1.2deg);
    box-shadow: 0 24px 96px rgba(0,0,0,.6), inset 0 0 180px rgba(0,0,0,.08);
    font-family: 'Courier Prime', Courier, monospace;
    font-size: 31px; line-height: 1.6;
    position: relative;
    min-height: 660px;
  }
  .doc-header {
    font-weight: 700; font-size: 33px;
    margin-bottom: 18px;
    border-bottom: 3px solid #222;
    padding-bottom: 12px;
  }
  .doc-body {
    display: -webkit-box;
    -webkit-line-clamp: 9;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .doc-body strong { font-weight: 700; }
  .doc-body .redacted {
    background: #222; color: #222; user-select: none;
    padding: 0 4px;
  }
  .doc-stamp {
    position: absolute;
    top: 40%; left: 50%;
    transform: translate(-50%, -50%) rotate(-12deg);
    border: 12px solid {{ colors.primary }};
    color: {{ colors.primary }};
    padding: 12px 42px;
    font-family: 'Oswald', sans-serif;
    font-size: 72px; font-weight: 700; letter-spacing: 6px;
    opacity: .85;
  }

  /* Bottom commentary */
  .commentary {
    position: absolute; bottom: 220px; left: 0; right: 0;
    padding: 36px 66px;
    background: linear-gradient(180deg, transparent 0%, #0a0a0a 30%);
  }
  .photo-overlay {
    font-family: 'Oswald', sans-serif;
    font-size: 39px; color: {{ colors.accent }};
    letter-spacing: 3px;
    margin-bottom: 12px;
  }
  .body-text {
    font-size: 42px; line-height: 1.4;
    color: #fff;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .body-text .hl-r { background: {{ colors.primary }}; color: #fff;
    padding: 0 8px; font-weight: 700; }
  .body-text .hl-y { background: {{ colors.accent }}; color: #0a0a0a;
    padding: 0 8px; font-weight: 700; }

  .progress {
    position: absolute; left: 0; right: 0; bottom: 110px; height: 6px;
    background: rgba(255,255,255,.18);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: {{ colors.primary }};
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 50px;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 30px; font-weight: 600; letter-spacing: 1.5px;
    color: var(--text-muted, rgba(255,255,255,.7));
  }

  .source-credit {
    position: absolute;
    bottom: 18px; left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,.6); color: rgba(255,255,255,.85);
    font-size: 14px; font-weight: 500; letter-spacing: 0.5px;
    padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">
  <div class="top-strip">◆ SIZDIRILDI ◆ GİZLİ ◆ SIZDIRILDI ◆</div>
  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="doc">
    <div class="doc-header">{{ script.category|default('T.C. DAHILI NOT') }}</div>
    <div class="doc-body">{{ body_html|safe }}</div>
    <div class="doc-stamp">GİZLİ</div>
  </div>

  <div class="commentary">
    {% if script.photo_overlay %}<div class="photo-overlay">{{ script.photo_overlay }}</div>{% endif %}
    <div class="body-text">{{ body_html|safe }}</div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>

  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}
</div>
{% include "_auto_fit.js.j2" %}
</body>
</html>
