<!doctype html><html><head><meta charset="utf-8"><style>
@import url('{{ font_import }}');
*{margin:0;padding:0;box-sizing:border-box}
html,body{width:1080px;height:1920px;overflow:hidden;background:transparent;
  font-family:'{{ font }}','Segoe UI',Arial,sans-serif;color:#fff}
#flash{position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none}
/* kesme geçiş efekti katmanları — tür seed'e göre (flash/glitch/rgbsplit/lightleak) */
#rgbsplit{position:absolute;inset:0;pointer-events:none;opacity:0;mix-blend-mode:screen;
  background:linear-gradient(90deg,rgba(255,0,64,.55),rgba(255,0,64,0) 14%),
    linear-gradient(270deg,rgba(0,170,255,.55),rgba(0,170,255,0) 14%)}
#lightleak{position:absolute;inset:0;pointer-events:none;opacity:0;mix-blend-mode:screen;
  background:radial-gradient(120% 62% at 82% 14%,rgba(255,178,64,.9),rgba(255,86,0,.28) 42%,rgba(0,0,0,0) 72%)}
#glitch{position:absolute;inset:0;pointer-events:none;opacity:0;mix-blend-mode:screen;
  background:repeating-linear-gradient(0deg,rgba(255,0,90,.35) 0 2px,rgba(0,0,0,0) 2px 5px,
    rgba(0,205,255,.35) 5px 7px,rgba(0,0,0,0) 7px 12px)}
#bar{position:absolute;top:0;left:0;height:12px;width:0%;background:{{ hot_color }};box-shadow:0 0 20px rgba(0,0,0,.4)}
.big{position:absolute;top:300px;left:60px;right:60px;text-align:center;font-size:104px;font-weight:900;
  line-height:1.05;letter-spacing:-2px;display:none;-webkit-text-stroke:3px #000;paint-order:stroke fill;text-shadow:0 8px 30px rgba(0,0,0,.9)}
.big.on{display:block}
.card{position:absolute;top:200px;left:50%;transform:translateX(-50%) rotate(-3deg);background:{{ highlight_color }};color:{{ chip_text }};
  font-weight:900;font-size:54px;padding:16px 40px;border-radius:14px;text-transform:uppercase;white-space:nowrap;display:none;
  box-shadow:0 14px 40px rgba(0,0,0,.55);border:4px solid rgba(0,0,0,.35)}
.card.on{display:block}
/* belirteç katmanı — nesnenin (x,y) konumuna 6 tür; renk {{ arrow_color }}, siyah kontur/gölge */
#markers{position:absolute;inset:0;pointer-events:none}
#markers .mk{position:absolute}
.mk-arrow{width:0;height:0;border-left:46px solid transparent;border-right:46px solid transparent;
  border-top:74px solid {{ arrow_color }};transform:translate(-50%,-112%);
  filter:drop-shadow(0 0 3px #000) drop-shadow(0 6px 8px rgba(0,0,0,.75));
  animation:mk-arrow-bob .9s ease-in-out infinite alternate}
@keyframes mk-arrow-bob{0%{transform:translate(-50%,-120%)}100%{transform:translate(-50%,-100%)}}
.mk-ring{width:190px;height:190px;border:16px solid {{ arrow_color }};border-radius:50%;
  transform:translate(-50%,-50%);box-shadow:0 0 0 5px rgba(0,0,0,.6),inset 0 0 0 5px rgba(0,0,0,.6),0 8px 24px rgba(0,0,0,.5);
  animation:mk-ring-pulse 1.1s ease-in-out infinite}
@keyframes mk-ring-pulse{0%,100%{transform:translate(-50%,-50%) scale(1);opacity:.95}50%{transform:translate(-50%,-50%) scale(1.12);opacity:.72}}
.mk-pulse{width:46px;height:46px;border-radius:50%;background:{{ arrow_color }};
  transform:translate(-50%,-50%);box-shadow:0 0 0 6px rgba(0,0,0,.4),0 0 26px 10px {{ arrow_color }};
  animation:mk-pulse-dot 1.05s ease-out infinite}
@keyframes mk-pulse-dot{0%{transform:translate(-50%,-50%) scale(.7);opacity:1}100%{transform:translate(-50%,-50%) scale(1.9);opacity:0}}
.mk-box{width:230px;height:230px;border:14px solid {{ arrow_color }};border-radius:18px;
  transform:translate(-50%,-50%);box-shadow:0 0 0 5px rgba(0,0,0,.6),inset 0 0 0 5px rgba(0,0,0,.6);
  animation:mk-box-pop .45s cubic-bezier(.2,1.4,.4,1) both}
@keyframes mk-box-pop{0%{transform:translate(-50%,-50%) scale(.55);opacity:0}100%{transform:translate(-50%,-50%) scale(1);opacity:1}}
.mk-spot{width:360px;height:360px;border-radius:50%;transform:translate(-50%,-50%);
  border:6px solid {{ arrow_color }};box-shadow:0 0 0 3000px rgba(0,0,0,.42),inset 0 0 60px 20px rgba(0,0,0,.4);
  animation:mk-spot-in .4s ease-out both}
@keyframes mk-spot-in{0%{opacity:0}100%{opacity:1}}
.mk-under{width:210px;height:18px;background:{{ arrow_color }};border-radius:9px;
  transform:translate(-50%,34px);box-shadow:0 0 0 4px rgba(0,0,0,.55),0 6px 16px rgba(0,0,0,.6);
  animation:mk-under-grow .4s ease-out both}
@keyframes mk-under-grow{0%{transform:translate(-50%,34px) scaleX(0)}100%{transform:translate(-50%,34px) scaleX(1)}}
#scrim{position:absolute;left:0;right:0;bottom:0;height:640px;background:linear-gradient(0deg,rgba(0,0,0,.6),rgba(0,0,0,0))}
.cap{position:absolute;left:0;right:0;bottom:300px;padding:0 60px;text-align:center;font-size:82px;font-weight:900;
  line-height:1.15;letter-spacing:-1px;-webkit-text-stroke:3px #000;paint-order:stroke fill;text-shadow:0 6px 26px rgba(0,0,0,.95)}
.cap .w{display:none;margin:0 12px;color:#fff}
.cap .w.vis{display:inline}
.cap .w.hot{color:{{ hot_color }};display:inline-block;transform:scale(1.09)}
#handle{position:absolute;bottom:150px;left:0;right:0;text-align:center;font-size:44px;font-weight:800;text-shadow:0 3px 12px rgba(0,0,0,.9);opacity:.9}
#cta{position:absolute;bottom:250px;left:50%;transform:translateX(-50%);
  background:{{ highlight_color }};color:{{ chip_text }};font-weight:900;font-size:56px;
  padding:20px 46px;border-radius:16px;white-space:nowrap;display:none;
  box-shadow:0 16px 50px rgba(0,0,0,.6);border:4px solid rgba(0,0,0,.35)}
#cta.on{display:block}
/* layout varyantları — marka aynı, konum/hiza farklı */
.stage.lower_left .cap{text-align:left;left:60px;right:220px;bottom:360px}
.stage.lower_left .big{text-align:left;left:60px;right:120px}
.stage.lower_left .card{left:60px;transform:rotate(-3deg)}
.stage.top_heavy .cap{bottom:auto;top:1180px}
.stage.top_heavy .big{top:180px;font-size:118px}
.stage.top_heavy .card{top:120px}
</style></head><body>
<div class="stage {{ layout | default('classic') }}">
<div id="scrim"></div><div id="bar"></div>
<div id="markers"></div>
<div class="big" id="hook">{{ hook }}</div>
<div class="big" id="close">{{ close }}</div>
{% for c in cards %}<div class="card" data-s="{{ c.start }}" data-e="{{ c.end }}">{{ c.text }}</div>
{% endfor %}
<div class="cap">{% for w in words %}<span class="w" data-s="{{ w.start }}" data-e="{{ w.end }}" data-seg="{{ w.seg }}">{{ w.word }}</span>
{% endfor %}</div>
<div id="handle">{{ handle }}</div>
{% if cta_text %}<div id="cta">🔔 {{ cta_text }}</div>{% endif %}
<div id="rgbsplit"></div><div id="lightleak"></div><div id="glitch"></div>
<div id="flash"></div>
</div>
<script>
const LEAD=0.08,CHUNK=3,DUR={{ duration_s }},LAST={{ last_seg }},CTA_S=2.5;
const CUTS={{ cuts }};
const ARROWSEGS={{ arrow_segs }};   // legacy: belirteçler artık MARKERS'tan gelir
const MARKERS={{ markers }};
const MK={};for(const m of MARKERS){MK[m.seg]=m;}
const MCLS={arrow:'mk-arrow',ring:'mk-ring',pulse:'mk-pulse',box:'mk-box',spotlight:'mk-spot',underline:'mk-under'};
const CUT_EFFECT='{{ cut_effect }}';   // kesme efekti türü (flash|glitch|rgbsplit|lightleak|none)
const W=[...document.querySelectorAll('.cap .w')],CARDS=[...document.querySelectorAll('.card')];
const HOOK=document.getElementById('hook'),CLOSE=document.getElementById('close'),BAR=document.getElementById('bar');
const FLASH=document.getElementById('flash'),MLAYER=document.getElementById('markers');
const RGB=document.getElementById('rgbsplit'),LEAK=document.getElementById('lightleak'),GLITCH=document.getElementById('glitch');
const CTA=document.getElementById('cta');
let ch=-1,ps=null,ic=0,mkSeg=-999;
for(const w of W){const sg=+w.dataset.seg;if(sg!==ps||ic===CHUNK){ch++;ic=0;ps=sg;}w.dataset.chunk=ch;ic++;}
window.__seek=function(tms){
  const t=tms/1000,lead=t+LEAD;let seg=0,chk=-1;
  for(const w of W){if(lead>=+w.dataset.s){seg=+w.dataset.seg;chk=+w.dataset.chunk;}}
  const capOn=seg>0&&seg<LAST;
  for(const w of W){const vis=capOn&&+w.dataset.chunk===chk;w.classList.toggle('vis',vis);w.classList.toggle('hot',vis&&lead>=+w.dataset.s&&t<+w.dataset.e);}
  HOOK.classList.toggle('on',seg===0);CLOSE.classList.toggle('on',seg===LAST);
  for(const c of CARDS){const s=+c.dataset.s,e=+c.dataset.e;c.classList.toggle('on',t>=s&&t<e);}
  BAR.style.width=Math.min(100,(t/DUR)*100)+'%';
  const m=MK[seg];
  if(m){if(seg!==mkSeg){MLAYER.innerHTML='<div class="mk '+(MCLS[m.type]||'mk-arrow')+'" style="left:'+(m.x*1080)+'px;top:'+(m.y*1920)+'px"></div>';mkSeg=seg;}}
  else if(mkSeg!==-999){MLAYER.innerHTML='';mkSeg=-999;}
  let op=0;if(CUT_EFFECT!=='none'){for(const ct of CUTS){const dt=t-ct;if(dt>=0&&dt<0.12)op=Math.max(op,1-dt/0.12);}}
  // seçilen efekti kesme yakınlığı (op) ile uygula; op seek-driven → deterministik
  FLASH.style.opacity=(CUT_EFFECT==='flash')?op*0.85:0;
  RGB.style.opacity=(CUT_EFFECT==='rgbsplit')?op:0;
  RGB.style.transform=(CUT_EFFECT==='rgbsplit'&&op>0)?('translateX('+(op*12)+'px)'):'';
  LEAK.style.opacity=(CUT_EFFECT==='lightleak')?op*0.9:0;
  GLITCH.style.opacity=(CUT_EFFECT==='glitch')?op:0;
  GLITCH.style.transform=(CUT_EFFECT==='glitch'&&op>0)?('translateX('+(((Math.floor(t*90)%2)?1:-1)*op*9)+'px)'):'';
  if(CTA){CTA.classList.toggle('on', t >= DUR - CTA_S);}
};
window.__seek(0);
</script></body></html>
