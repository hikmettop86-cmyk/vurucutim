{# lang ŞART: .card'ın `text-transform:uppercase`'i DİLE DUYARLIDIR. lang yokken
   tarayıcı 'i' → 'I' yapar (Unicode varsayılanı); lang="tr" ile 'i' → 'İ' yapar.
   Türkçede bunlar AYRI harflerdir — "BILINMEYEN" yazan bir kart yanlış yazılmıştır. #}
<!doctype html><html lang="{{ lang | default('tr') }}"><head><meta charset="utf-8"><style>
@import url('{{ font_import }}');
*{margin:0;padding:0;box-sizing:border-box}
html,body{width:1080px;height:1920px;overflow:hidden;background:transparent;
  font-family:'{{ font }}','Segoe UI',Arial,sans-serif;color:#fff}
#flash{position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none}
/* kesme geçiş efekti katmanları — tür seed'e göre (flash/glitch/rgbsplit/lightleak) */
#rgbsplit{position:absolute;inset:0;pointer-events:none;opacity:0;mix-blend-mode:screen;
  background:linear-gradient(90deg,rgba(255,0,64,.55),rgba(255,0,64,0) 14%),
    linear-gradient(270deg,rgba(0,170,255,.55),rgba(0,170,255,0) 14%)}
#lightleak{position:absolute;inset:0;pointer-events:none;opacity:0;mix-blend-mode:screen;
  background:radial-gradient(120% 62% at 82% 14%,rgba(255,178,64,.9),rgba(255,86,0,.28) 42%,rgba(0,0,0,0) 72%)}
#glitch{position:absolute;inset:0;pointer-events:none;opacity:0;mix-blend-mode:screen;
  background:repeating-linear-gradient(0deg,rgba(255,0,90,.35) 0 2px,rgba(0,0,0,0) 2px 5px,
    rgba(0,205,255,.35) 5px 7px,rgba(0,0,0,0) 7px 12px)}
/* top:0 OYNATICININ üst barının (geri/arama) altında kalıyordu → hiç görünmüyordu. */
#bar{position:absolute;top:96px;left:0;height:12px;width:0%;background:{{ hot_color }};box-shadow:0 0 20px rgba(0,0,0,.4)}
.big{position:absolute;top:300px;left:60px;right:60px;text-align:center;font-size:104px;font-weight:900;
  line-height:1.05;letter-spacing:-2px;display:none;-webkit-text-stroke:3px #000;paint-order:stroke fill;text-shadow:0 8px 30px rgba(0,0,0,.9)}
.big.on{display:block}
/* KARE SIFIR = FEED'İN KÜÇÜK RESMİ. Video orada ~300px genişliğinde görünür: 104
   puntoluk bir hook CÜMLESİ (140 karaktere kadar, sığdırma ile 57 puntoya inebilen)
   o boyutta OKUNMAZ. Manşet 3-6 kelimedir ve 140 puntoyla okunur — küçük resimde
   ~39px'e denk gelir. Hook cümlesi kaybolmaz: altyazı olarak akmaya devam eder. */
.big.cover{font-size:140px;letter-spacing:-3px}
/* BÖLÜM ROZETİ (feed kimliği). Faceless kanalda FORMAT YÜZDÜR: izleyici seni
   yüzünden değil, feed'de tanıdığı biçimden hatırlar — ve tanımadığına abone olmaz.
   Numara ayrıca serinin GERÇEK olduğunu kanıtlar: 47. bölüm varsa 48. de gelecektir,
   yani abonelik somut bir şey satın alır.
   Manşetin ÜSTÜNDE (top 300 → rozet 210-270): küçük resimde de görünür.
   Manşet varken rozet manşeti aşağı itmez — ikisi de mutlak konumlu. */
#badge{position:absolute;top:206px;left:60px;right:60px;text-align:center;
  font-size:46px;font-weight:900;letter-spacing:4px;color:{{ hot_color }};
  -webkit-text-stroke:2px #000;paint-order:stroke fill;
  text-shadow:0 4px 16px rgba(0,0,0,.9);display:none;white-space:nowrap;
  overflow:hidden}
#badge.on{display:block}
.stage.lower_left #badge{text-align:left}
/* top_heavy'de başlık 180'e çıkıyor → rozet 118'e (ilerleme çubuğu 96-108'in altı) */
.stage.top_heavy #badge{top:118px}
.card{position:absolute;top:200px;left:50%;transform:translateX(-50%) rotate(-3deg);background:{{ highlight_color }};color:{{ chip_text }};
  font-weight:900;font-size:54px;padding:16px 40px;border-radius:14px;text-transform:uppercase;white-space:nowrap;display:none;
  box-shadow:0 14px 40px rgba(0,0,0,.55);border:4px solid rgba(0,0,0,.35)}
.card.on{display:block}
/* sayı vurgusu — "240 parça", "%90", "24 milyon" söylenirken BÜYÜK pop.
   Ölçek seek-güdümlü (duvar-saati DEĞİL) → deterministik, animations=disabled uyumlu. */
/* Konum: ÜST-ORTA (chip'in altı, karaoke bloğunun ÇOK üstü) — altyazıyla
   çakışmamalı (gerçek hata: sayı karaoke metninin üstüne binip okunmuyordu). */
#numpop{position:absolute;left:50%;top:700px;transform:translateX(-50%);
  font-weight:900;font-size:150px;line-height:1;color:{{ hot_color }};
  -webkit-text-stroke:4px #000;paint-order:stroke fill;
  text-shadow:0 8px 30px rgba(0,0,0,.75);opacity:0;pointer-events:none;white-space:nowrap}
#numpop.on{opacity:1}
/* belirteç katmanı — nesnenin (x,y) konumuna 6 tür; renk {{ arrow_color }}, siyah kontur/gölge */
#markers{position:absolute;inset:0;pointer-events:none}
#markers .mk{position:absolute}
.mk-arrow{width:0;height:0;border-left:46px solid transparent;border-right:46px solid transparent;
  border-top:74px solid {{ arrow_color }};transform:translate(-50%,-112%);
  filter:drop-shadow(0 0 3px #000) drop-shadow(0 6px 8px rgba(0,0,0,.75));
  animation:mk-arrow-bob .9s ease-in-out infinite alternate}
@keyframes mk-arrow-bob{0%{transform:translate(-50%,-120%)}100%{transform:translate(-50%,-100%)}}
.mk-ring{width:190px;height:190px;border:16px solid {{ arrow_color }};border-radius:50%;
  transform:translate(-50%,-50%);box-shadow:0 0 0 5px rgba(0,0,0,.6),inset 0 0 0 5px rgba(0,0,0,.6),0 8px 24px rgba(0,0,0,.5);
  animation:mk-ring-pulse 1.1s ease-in-out infinite}
@keyframes mk-ring-pulse{0%,100%{transform:translate(-50%,-50%) scale(1);opacity:.95}50%{transform:translate(-50%,-50%) scale(1.12);opacity:.72}}
.mk-pulse{width:46px;height:46px;border-radius:50%;background:{{ arrow_color }};
  transform:translate(-50%,-50%);box-shadow:0 0 0 6px rgba(0,0,0,.4),0 0 26px 10px {{ arrow_color }};
  animation:mk-pulse-dot 1.05s ease-out infinite}
@keyframes mk-pulse-dot{0%{transform:translate(-50%,-50%) scale(.7);opacity:1}100%{transform:translate(-50%,-50%) scale(1.9);opacity:0}}
.mk-box{width:230px;height:230px;border:14px solid {{ arrow_color }};border-radius:18px;
  transform:translate(-50%,-50%);box-shadow:0 0 0 5px rgba(0,0,0,.6),inset 0 0 0 5px rgba(0,0,0,.6);
  animation:mk-box-pop .45s cubic-bezier(.2,1.4,.4,1) both}
@keyframes mk-box-pop{0%{transform:translate(-50%,-50%) scale(.55);opacity:0}100%{transform:translate(-50%,-50%) scale(1);opacity:1}}
.mk-spot{width:360px;height:360px;border-radius:50%;transform:translate(-50%,-50%);
  border:6px solid {{ arrow_color }};box-shadow:0 0 0 3000px rgba(0,0,0,.42),inset 0 0 60px 20px rgba(0,0,0,.4);
  animation:mk-spot-in .4s ease-out both}
@keyframes mk-spot-in{0%{opacity:0}100%{opacity:1}}
.mk-under{width:210px;height:18px;background:{{ arrow_color }};border-radius:9px;
  transform:translate(-50%,34px);box-shadow:0 0 0 4px rgba(0,0,0,.55),0 6px 16px rgba(0,0,0,.6);
  animation:mk-under-grow .4s ease-out both}
@keyframes mk-under-grow{0%{transform:translate(-50%,34px) scaleX(0)}100%{transform:translate(-50%,34px) scaleX(1)}}
/* ——— YOUTUBE SHORTS GÜVENLİ BÖLGESİ ———
   Video 1080x1920 üretilse de OYNATICI onun üstüne kendi arayüzünü çizer. Gerçek
   telefondan ölçüldü (Shorts, 917x2048 ekran → video y 136-1803 arasına oturuyor):
     • kanal adı satırı .... video y 1421-1502
     • video başlığı ....... video y 1525-1588
     • "Yapay zeka" rozeti . video y 1611-1680
     • görüntülenme satırı . video y 1697-1767
     • üst bar (geri/arama)  video y    0-  62
     • sağ eylem rayı ...... video x > 919, y 1121-1732
   Yani ALT %26 ve ÜST 62px OYNATICINIndir, bizim değil.

   GERÇEK HATA: altyazılar (bottom:300 → y 1440-1620), ABONE ÇİPİ (bottom:250 →
   y 1620-1690) ve handle (y 1730-1790) tam bu bandın içindeydi — izleyici abone
   çağrısını HİÇ GÖRMÜYORDU. İlerleme çubuğu da üst barın altında kalıyordu.

   KURAL: içerik y 90 ile 1440 ARASINDA kalmalı. Aşağıdaki yerleşim buna göre:
     üst bar↓  bar 96 | kart 200 | hook 300-1020 | numpop 700-850
               ALTYAZI 1180-1380 | ↑oynatıcı UI
     (beğeni/abone çipleri 2026-07-16'da kaldırıldı — y 760-1160 bandı boş) */
/* Karartma altyazının YENİ yerini de kapsamalı: altyazı 1180'e çıktı, 640px'lik
   scrim ancak 1280'den başlıyordu → üst satır okunaksız kalırdı. */
#scrim{position:absolute;left:0;right:0;bottom:0;height:820px;background:linear-gradient(0deg,rgba(0,0,0,.6),rgba(0,0,0,0))}
.cap{position:absolute;left:0;right:0;bottom:540px;padding:0 60px;text-align:center;font-size:82px;font-weight:900;
  line-height:1.15;letter-spacing:-1px;-webkit-text-stroke:3px #000;paint-order:stroke fill;text-shadow:0 6px 26px rgba(0,0,0,.95)}
.cap .w{display:none;margin:0 12px;color:#fff}
/* yalnız otomatik sığdırma ölçümü için: gizli kelimenin genişliği ölçülemez */
.cap.measure .w{display:inline}
.cap .w.vis{display:inline}
.cap .w.hot{color:{{ hot_color }};display:inline-block;transform:scale(1.09)}
/* Handle ALTTA kalır. Oynatıcının kanal/başlık satırının altında kalıyor ve çoğu
   zaman görünmüyor — ama izleyici için önemli değil (YouTube zaten kanal adını
   gösteriyor); üst-sağa taşımak kadrajın temiz köşesini harcıyordu. */
#handle{position:absolute;bottom:150px;left:0;right:0;text-align:center;font-size:44px;
  font-weight:800;text-shadow:0 3px 12px rgba(0,0,0,.9);opacity:.9}
/* BEĞENİ/ABONE ÇİPİ YOK (2026-07-16, kullanıcı kararı): "kullanıcı gerçekten
   içinden gelirse abone veya beğenme yapar". y 760-1020 bandı boşaldı. */
/* AÇIK SORU ÇİPİ (merak mimarisi): hook'un açtığı soru asılı kalır, reveal
   anında 'cevaplandı'ya döner. Eski cta bandında (y ~1055-1120, boşalmıştı). */
#qchip{position:absolute;bottom:810px;left:50%;transform:translateX(-50%);
  background:rgba(0,0,0,.72);color:#fff;font-weight:800;font-size:34px;
  padding:10px 26px;border-radius:999px;white-space:nowrap;display:none;
  max-width:960px;overflow:hidden;border:3px solid {{ highlight_color }}}
#qchip.on{display:block}
#qchip.done{background:{{ highlight_color }};color:{{ chip_text }};
  border-color:rgba(0,0,0,.4)}
/* layout varyantları — marka aynı, konum/hiza farklı */
.stage.lower_left .cap{text-align:left;left:60px;right:220px;bottom:540px}
.stage.lower_left .big{text-align:left;left:60px;right:120px}
.stage.lower_left .card{left:60px;transform:rotate(-3deg)}
.stage.top_heavy .cap{bottom:auto;top:1180px}
.stage.top_heavy .big{top:180px;font-size:118px}
.stage.top_heavy .card{top:120px}
</style></head><body>
<div class="stage {{ layout | default('classic') }}">
<div id="scrim"></div><div id="bar"></div>
<div id="markers"></div>
<div id="numpop"></div>
{% if badge %}<div id="badge">{{ badge }}</div>{% endif %}
<div class="big{% if cover_title %} cover{% endif %}" id="hook">{{ cover_title or hook }}</div>
<div class="big" id="close">{{ close }}</div>
{% for c in cards %}<div class="card" data-s="{{ c.start }}" data-e="{{ c.end }}">{{ c.text }}</div>
{% endfor %}
<div class="cap">{% for w in words %}<span class="w" data-s="{{ w.start }}" data-e="{{ w.end }}" data-seg="{{ w.seg }}">{{ w.word }}</span>
{% endfor %}</div>
<div id="handle">{{ handle }}</div>
{% if question_text %}<div id="qchip">🤔 {{ question_text }}</div>{% endif %}
<div id="rgbsplit"></div><div id="lightleak"></div><div id="glitch"></div>
<div id="flash"></div>
</div>
<script>
const LEAD=0.08,CHUNK_MAX=3,DUR={{ duration_s }},LAST={{ last_seg }};
const QREVEAL={{ reveal_at }};
const QCHIP=document.getElementById('qchip');
// Öbek başına kelime sayısı SABİT DEĞİL: fitCap() sığana kadar 3→2→1 düşürür.
let CHUNK=CHUNK_MAX;
/* MANŞET VARSA hook segmentinde ALTYAZI DA AKAR: kartta artık cümle değil 3-6
   kelimelik manşet var, konuşulan hook cümlesini izleyicinin okuyabilmesi lazım.
   Manşet yoksa eski davranış: kartta tam hook cümlesi, altyazı kapalı. */
const HAS_COVER={{ 'true' if cover_title else 'false' }};
const CUTS={{ cuts }};
const ARROWSEGS={{ arrow_segs }};   // legacy: belirteçler artık MARKERS'tan gelir
const MARKERS={{ markers }};
// Belirteç ZAMAN PENCERESİNE bağlıdır (t0..t1), segmente DEĞİL: konum o alt-kesimde
// gösterilen KLİPTEN ölçüldü. Segmente bağlarsak marker, aynı segmentin diğer
// kliplerinin üstünde de çizilir ve BOŞLUĞU işaretler (gerçek hata).
function activeMarker(t){for(const m of MARKERS){if(t>=m.t0&&t<m.t1)return m;}return null;}
// KESİNTİ ANLARI (bkz. reel_interrupt): videoda 3-5 kare. Orada geçiş efekti TAM
// GÜÇTE ve UZUN patlar, altyazı bloğu bir darbe alır — ve montaj aynı karede vuruş
// sesi + görüntü punch'ı çalar. Diğer kesimlerde efekt KISIK (CUT_FX_MAX): kontrast
// olmadan vurgu olmaz. Eskiden her kesim aynı güçte patlıyordu → hiçbiri vurgu değildi.
const INTR={{ interrupts }};
const CUT_FX_S=0.12,CUT_FX_MAX=0.55;   // sıradan kesim: kısa, kısık
const INTR_FX_S=0.26;                  // kesinti: uzun, tam güçlü
const CAP_PUNCH_S=0.30,CAP_PUNCH=0.05; // altyazı darbesi (ölçek)
const HOOK_POP=0.06,HOOK_POP_S=0.15;   // açılış patlaması (bkz. __seek'teki not)
function fxOp(t){
  if(CUT_EFFECT==='none')return 0;
  let op=0;
  for(const ct of CUTS){const dt=t-ct;if(dt>=0&&dt<CUT_FX_S)op=Math.max(op,(1-dt/CUT_FX_S)*CUT_FX_MAX);}
  for(const it of INTR){const dt=t-it;if(dt>=0&&dt<INTR_FX_S)op=Math.max(op,1-dt/INTR_FX_S);}
  return op;
}
function capPunch(t){
  let k=0;
  for(const it of INTR){const dt=t-it;if(dt>=0&&dt<CAP_PUNCH_S)k=Math.max(k,1-dt/CAP_PUNCH_S);}
  return k;
}
const NUMS={{ nums }};
const NP=document.getElementById('numpop');
const MCLS={arrow:'mk-arrow',ring:'mk-ring',pulse:'mk-pulse',box:'mk-box',spotlight:'mk-spot',underline:'mk-under'};
const CUT_EFFECT='{{ cut_effect }}';   // kesme efekti türü (flash|glitch|rgbsplit|lightleak|none)
const W=[...document.querySelectorAll('.cap .w')],CARDS=[...document.querySelectorAll('.card')];
const CAPB=document.querySelector('.cap');
const BADGE=document.getElementById('badge');
const HOOK=document.getElementById('hook'),CLOSE=document.getElementById('close'),BAR=document.getElementById('bar');

// ——— OTOMATİK SIĞDIRMA ———
// Türkçe kelimeler uzayabiliyor ("düşündüğümüzden" 15 harf). Kutudan geniş bir satırı
// CSS kaydıramaz — sessizce TAŞIRIR. Gerçek hata (short 758): hook kartının kelimeleri
// sağdan ve soldan kesildi. Kelimeyi ortadan kırmak (break-word) Türkçede okunmaz hâle
// getirir; çözüm PUNTOYU KÜÇÜLTMEK. Yükleme anında bir kez çalışır → tüm kareler aynı
// puntoyu görür (deterministik, kare-dedup bozulmaz).
const SAFE_X = 60;      // kadraj kenarından bırakılacak pay (px)

// TAŞMAYI scrollWidth İLE ÖLÇMEK YETMİYOR: metin ORTALI olduğunda satır kutudan iki
// yana EŞİT taşar ve scrollWidth yalnız SAĞ taşmayı sayar — 960px kutuda 1086px'lik
// bir satır için scrollWidth hâlâ 960 döner (ölçüldü). O yüzden satırların GERÇEK
// mürekkep sınırlarına bakıyoruz: hiçbir satır kadrajın SAFE_X payına girmemeli.
function lineOverflow(el){
  const rg=document.createRange(); rg.selectNodeContents(el);
  let worst=0;
  for(const r of rg.getClientRects()){
    if(r.width<=0) continue;
    worst=Math.max(worst, SAFE_X-r.left, r.right-(1080-SAFE_X));
  }
  return worst;   // >0 → taşıyor
}
// Bir metin bloğunun kaç satıra yayıldığı (scrollHeight / satır yüksekliği).
function _blockLines(el){
  const lh=parseFloat(getComputedStyle(el).lineHeight);
  return lh>0 ? Math.round(el.scrollHeight/lh) : 1;
}
function fitBox(el,{minScale=0.55,maxH=0,maxLines=0}={}){
  if(!el) return;
  // Hook/close normalde display:none — GİZLİ ELEMANIN ÖLÇÜSÜ SIFIRDIR, ölçmek için
  // geçici olarak göster, sonra sınıflara geri bırak.
  const prev=el.style.display;
  el.style.display='block';
  el.style.fontSize='';   // stil sayfasındaki puntoya dön → fit ÇAĞRI SAYISINDAN bağımsız
  const base=parseFloat(getComputedStyle(el).fontSize);
  const floor=base*minScale;
  let size=base;
  // 2px'lik adımlar: gözle fark edilmez, en kötü ihtimalle ~23 tur.
  // maxLines: taşma/yükseklik SINIRLARINA EK bir kısıt. maxH tek başına yetmiyordu —
  // 720px ~6 satıra izin verir, kapanış kartı 5-7 satırlık bir metin duvarı oluyordu
  // (short 802/803). floor korunur: taban puntoya dayanınca satır sınırı AŞILABİLİR
  // (okunabilirliği satır sayısına feda etme — altyazıdaki fitCap ile aynı ilke).
  while(size>floor && (lineOverflow(el)>0 || (maxH && el.scrollHeight>maxH)
        || (maxLines && _blockLines(el)>maxLines))){
    size-=2; el.style.fontSize=size+'px';
  }
  el.style.display=prev;
}
// ——— ALTYAZI SIĞDIRMASI ———
// TAŞMA TEK BAŞINA YETMİYOR. Altyazı her an EN FAZLA 3 kelime (bir "öbek") gösterir.
// Dar bir kutuda (lower_left: 800px — sağdaki YouTube eylem rayından kaçmak için)
// metin TAŞMAZ, SARAR. Sarma taşma olmadığı için lineOverflow onu GÖREMEZ ve sığdırma
// hiç devreye girmez.
// GERÇEK SONUÇ (bölüm #1, lower_left): "Bir kilogramlık bir" — üç kelime, ÜÇ SATIR.
//
// SINIR 2 SATIR, ve bu keyfî değil GEOMETRİK: altyazı bottom:540'tan yukarı büyür.
// 3 satır (82px×1.15×3 ≈ 283px) → üst kenar y≈1097. Abone çipi y 1080-1160'ta.
// Yani üç satırlık altyazı ÇİPİN ÜSTÜNE BİNER. İki satır → üst kenar y≈1191, temiz.
const MAX_CAP_LINES = 2;
// Kapanış kartı (loop callback cümlesi) en fazla bu kadar satır. Ölçüldü: 4 satır
// Almanca'da 84px (okunur), Türkçe kısa kapanışlara dokunmuyor; 3 fazla agresif
// (70px), 5 neredeyse etkisiz.
const CLOSE_MAX_LINES = 4;
// Bir öbeğin kaç SATIRA yayıldığı: görünür kelimelerin farklı 'top' değerlerini say.
// (Range.getClientRects burada işe yaramaz — aynı satırdaki her span ayrı rect verir.)
function _chunkLines(cap){
  const ws=[...cap.querySelectorAll('.w')];
  const obekler=[...new Set(ws.map(w=>w.dataset.chunk))];
  let enKotu=1;
  for(const c of obekler){
    for(const w of ws) w.classList.toggle('vis', w.dataset.chunk===c);
    const satirlar=new Set();
    for(const w of ws){
      if(w.classList.contains('vis')) satirlar.add(Math.round(w.getBoundingClientRect().top));
    }
    enKotu=Math.max(enKotu, satirlar.size);
  }
  for(const w of ws) w.classList.remove('vis');   // ölçüm izini temizle
  return enKotu;
}
// Kelimeleri öbeklere böl. Öbek segment sınırında da kırılır (cümle karışmasın).
function _rechunk(n){
  let ch=-1, ps=null, ic=0;
  for(const w of W){
    const sg=+w.dataset.seg;
    if(sg!==ps||ic===n){ch++;ic=0;ps=sg;}
    w.dataset.chunk=ch; ic++;
  }
}
// Verilen öbek boyutuyla GEÇERLİ en büyük punto (taşma yok + <=2 satır). Sığmazsa 0.
function _capFit(cap, base, floor){
  for(let size=base; size>=floor; size-=2){
    cap.style.fontSize=size+'px';
    cap.classList.add('measure');          // taşma: tüm kelimeler görünürken en kötü durum
    const tasma=lineOverflow(cap)>0;
    cap.classList.remove('measure');
    if(!tasma && _chunkLines(cap)<=MAX_CAP_LINES) return size;
  }
  return 0;
}
// SIĞDIRMA SIRASI: önce KELİME SAYISINI feda et, fontu değil.
// Eski kod tersini yapıyordu — öbeği 3'te sabit tutup fontu küçültüyordu. Almanca
// bileşik kelimelerde ("jahrzehntelang") bu çöküyor.
// ÖLÇÜLDÜ (short 801, lower_left, Almanca): 3 kelime → font TABANA (48px) indi ve
// YİNE 3 satır sardı; yani sığdırma başarısız oldu, üstelik 3. satır abone çipine
// biniyor. 2 kelime → 82px, 2 satır. Punto %71 büyüyor.
// 1 kelimeye inmek HİÇBİR ŞEY kazandırmıyor (yine 82px; sınırlayıcı kısıt "en uzun
// TEK kelime bir satıra sığmalı" ve 2 kelimeli öbek zaten 2 satır kullanabiliyor)
// — bağlamı bedavaya harcar. Bu yüzden taban 1 değil, "sığan en büyük öbek".
// Türkçe regresyon yok: kelimeler kısa, 3 kelime %85 eşiğini geçiyor (74-78px).
function fitCap(){
  const cap=document.querySelector('.cap'); if(!cap) return;
  cap.style.fontSize='';                       // idempotent: stil sayfasındaki puntoya dön
  const base=parseFloat(getComputedStyle(cap).fontSize);
  const floor=base*0.6, iyi=base*0.85;         // %85 altına düşmektense kelime bırak
  let enIyi={n:1, px:0};
  for(let n=CHUNK_MAX; n>=1; n--){
    _rechunk(n);
    const px=_capFit(cap, base, floor);
    if(px>enIyi.px) enIyi={n, px};
    if(px>=iyi) break;   // yeterince büyük punto → DUR, kalan kelimeleri koru
  }
  CHUNK=enIyi.n; _rechunk(CHUNK);
  cap.style.fontSize=(enIyi.px||floor)+'px';
}
window.__fit=function(){
  // Hook/close ekranın üst yarısında; altyazı bloğuna sarkmasın diye yükseklik sınırı.
  // maxH 720: hook/kapanış kartı top:300'den başlar → en fazla y=1020'ye iner,
  // yani abone çipinin (1080) üstünde kalır. 820 olsaydı çipe binerdi.
  // KAPANIŞ ayrıca maxLines=4: kapanış bir CÜMLE (loop callback), kelime atılamaz —
  // ama 5-7 satırlık metin duvarı göz yoruyordu (short 802/803). 4 satır sınırı
  // fontu makul küçültür (Almanca 104→84px), kısa metinler dokunulmadan kalır.
  // Hook'a UYGULANMADI: hook kare-sıfır (küçük resim) ve büyük punto tercih eder.
  fitBox(HOOK,{maxH:720}); fitBox(CLOSE,{maxH:720,maxLines:CLOSE_MAX_LINES}); fitCap();
  // Rozet tek satır (nowrap) — taşarsa overflow:hidden onu SESSİZCE keserdi ve
  // numarası uçan bir rozet işlevini kaybeder. Sığdırma puntoyu küçültür.
  if(BADGE) fitBox(BADGE,{minScale:0.7});
};
const FLASH=document.getElementById('flash'),MLAYER=document.getElementById('markers');
const RGB=document.getElementById('rgbsplit'),LEAK=document.getElementById('lightleak'),GLITCH=document.getElementById('glitch');
let mkSeg='';   // mkSeg: aktif belirtecin kimliği (t0:type)
// İlk öbekleme: __fit() çağrılmasa bile (test/önizleme) altyazı çalışsın.
// fitCap() sığdırma sırasında bunu yeniden hesaplar.
_rechunk(CHUNK);
window.__seek=function(tms){
  const t=tms/1000,lead=t+LEAD;let seg=0,chk=-1;
  for(const w of W){if(lead>=+w.dataset.s){seg=+w.dataset.seg;chk=+w.dataset.chunk;}}
  const capOn=(HAS_COVER?seg>=0:seg>0)&&seg<LAST;
  // Sayı vurgusu hook'ta ASLA: orada zaten büyük başlık bloğu var, sayı üstüne biner.
  const numOn=seg>0&&seg<LAST;
  for(const w of W){const vis=capOn&&+w.dataset.chunk===chk;w.classList.toggle('vis',vis);w.classList.toggle('hot',vis&&lead>=+w.dataset.s&&t<+w.dataset.e);}
  HOOK.classList.toggle('on',seg===0);CLOSE.classList.toggle('on',seg===LAST);
  /* Rozet HOOK segmentinde durur — yani KARE SIFIRDA. Feed'in küçük resmi orasıdır
     ve tanınma orada olur. Gövdede kalsaydı altyazıyla dikkat için yarışırdı. */
  if(BADGE)BADGE.classList.toggle('on',seg===0);
  if(QCHIP){
    // 1.2sn'de belirir (hook pop'u ezmesin), reveal+2.5sn'de kaybolur.
    QCHIP.classList.toggle('on', t>=1.2 && t<QREVEAL+2.5);
    QCHIP.classList.toggle('done', QREVEAL>0 && t>=QREVEAL);   // ✓ cevaplandı
  }
  for(const c of CARDS){const s=+c.dataset.s,e=+c.dataset.e;c.classList.toggle('on',t>=s&&t<e);}
  /* Çubuğu 0.25% adıma yuvarla (2.7px): ardışık kareler AYNILAŞIR → renderer
     screenshot yerine kopyalayabilir (kare-dedup, 3-4x hızlı). Görsel fark yok. */
  BAR.style.width=(Math.round(Math.min(100,(t/DUR)*100)*4)/4)+'%';
  const m=activeMarker(t);
  const mkey=m?(m.t0+':'+m.type):'';
  if(mkey!==mkSeg){
    MLAYER.innerHTML=m?('<div class="mk '+(MCLS[m.type]||'mk-arrow')+'" style="left:'+(m.x*1080)+'px;top:'+(m.y*1920)+'px"></div>'):'';
    mkSeg=mkey;
  }
  const op=fxOp(t);
  // ALTYAZI DARBESİ: kesinti karesinde blok bir tık büyür. Ses vuruşuyla AYNI KAREDE
  // olduğu için izleyici ikisini tek bir "olay" olarak algılar — kurgunun içeriğe
  // kilitlendiği yer burası.
  if(CAPB){const k=capPunch(t);CAPB.style.transform=k>0?('scale('+(1+CAP_PUNCH*k).toFixed(4)+')'):'';}
  // seçilen efekti kesme yakınlığı (op) ile uygula; op seek-driven → deterministik
  FLASH.style.opacity=(CUT_EFFECT==='flash')?op*0.85:0;
  RGB.style.opacity=(CUT_EFFECT==='rgbsplit')?op:0;
  RGB.style.transform=(CUT_EFFECT==='rgbsplit'&&op>0)?('translateX('+(op*12)+'px)'):'';
  LEAK.style.opacity=(CUT_EFFECT==='lightleak')?op*0.9:0;
  GLITCH.style.opacity=(CUT_EFFECT==='glitch')?op:0;
  GLITCH.style.transform=(CUT_EFFECT==='glitch'&&op>0)?('translateX('+(((Math.floor(t*90)%2)?1:-1)*op*9)+'px)'):'';
  /* Sayı vurgusu: kelime söylenirken büyük pop (0.25sn scale .6→1.1, sonra 1.0).
     HOOK/CLOSE segmentinde GÖSTERİLMEZ — oralarda zaten büyük başlık bloğu var,
     sayı onun üstüne biner (gerçek hata: hook metniyle çakıştı). */
  if(NP){
    let cur=null;
    if(numOn){for(const n of NUMS){if(t>=+n.s && t<+n.e+0.35){cur=n;break;}}}
    if(cur){
      const dt=t-(+cur.s);
      const k=dt<0.25?(0.6+2.0*dt):(dt<0.35?(1.1-1.0*(dt-0.25)):1.0);
      NP.textContent=cur.text;
      NP.className='on';
      NP.style.transform='translateX(-50%) scale('+k.toFixed(3)+')';
    } else {NP.className='';NP.textContent='';NP.style.transform='translateX(-50%)';}
  }
  /* Hook pop: ilk 0.15sn'de metin patlayarak girer (açılış kalıp kırıcı).
     ÖLÇEK 1.15 DEĞİL 1.06 — GİZLİ TAŞMA HATASIYDI: kare sıfır feed'in küçük resmidir
     ve başlık orada TAM okunmalı. Otomatik sığdırma metni en fazla 960px'e (SAFE_X
     payı) oturtuyor; 1.15 ölçek onu 1104px'e çıkarıp 1080px'lik kadrajdan TAŞIRIYORDU
     — yani tam da en kritik karede yazının kenarları kesiliyordu. 1.06 → 1018px. */
  if(seg===0&&t<HOOK_POP_S){HOOK.style.transform='scale('+(1+HOOK_POP*(1-t/HOOK_POP_S)).toFixed(4)+')';}
  else{HOOK.style.transform='scale(1)';}
};
/* Görünür DURUM imzası: renderer aynı imzalı ardışık kareyi yeniden çekmez,
   öncekini kopyalar (screenshot ~137ms, kopya ~1ms). İmza görünen HER şeyi
   kapsamalı — aksi hâlde kare kaybı olur. */
window.__sig=function(){
  let vis=-1,hot=-1,i=0;
  for(const w of W){
    if(w.classList.contains('vis')&&vis<0)vis=+w.dataset.chunk;
    if(w.classList.contains('hot'))hot=i;
    i++;
  }
  let s=vis+'|'+hot+'|'+mkSeg+'|'+MLAYER.innerHTML.length+'|';
  s+=(HOOK.classList.contains('on')?1:0)+''+(CLOSE.classList.contains('on')?1:0)+'|';
  s+=(BADGE&&BADGE.classList.contains('on')?1:0)+'|';
  s+=(QCHIP?QCHIP.className:'')+'|';
  for(const c of CARDS)s+=(c.classList.contains('on')?1:0);
  s+='|'+BAR.style.width+'|';
  s+=[FLASH,RGB,LEAK,GLITCH].map(e=>(e.style.opacity||'0')+':'+(e.style.transform||'')).join(',');
  /* sayı pop + hook pop imzaya DAHİL — aksi hâlde dedup bu kareleri kaçırır */
  s+='|'+(NP?(NP.textContent+':'+(NP.style.transform||'')):'');
  s+='|'+(HOOK.style.transform||'');
  /* altyazı darbesi imzaya DAHİL — aksi hâlde kare-dedup darbeyi düz kare sanıp atlar */
  s+='|'+(CAPB?(CAPB.style.transform||''):'');
  return s;
};
window.__seek(0);
</script></body></html>
