<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Orduspor Kartları</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=Oswald:wght@500;700&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  
  html, body { 
    width: 1080px; 
    height: 1920px; 
    overflow: hidden;
    font-family: var(--font-body, 'Inter', sans-serif);
    color: var(--text-main, #ffffff);
    background: linear-gradient(135deg, #2A052E 0%, #4A0E4E 100%);
  }

  .stage { 
    position: relative; 
    width: 1080px; 
    height: 1920px; 
    display: flex; 
    flex-direction: column; 
    padding: 72px 80px;
    background: linear-gradient(180deg, rgba(42, 5, 46, 0.96) 0%, rgba(74, 14, 78, 0.98) 100%);
  }

  /* Apple Museum Gallery / Editorial framing */
  .stage-badge {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 10px 24px;
    border-radius: 9999px;
    font-family: var(--font-headline, 'Oswald', sans-serif);
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--accent, #ffffff);
    margin-bottom: 24px;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 36px;
  }

  .header .top {
    font-family: var(--font-headline, 'Oswald', sans-serif);
    font-size: 48px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.5px;
    text-transform: uppercase;
    color: var(--text-main, #ffffff);
  }

  .header .bot {
    font-family: var(--font-headline, 'Oswald', sans-serif);
    font-size: 80px;
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -1px;
    text-transform: uppercase;
    color: var(--accent, #ffffff);
  }

  /* Photography-first museum tile container */
  .photo {
    position: relative;
    width: 100%;
    height: 640px;
    border-radius: 18px;
    overflow: hidden;
    background: #1d1d1f;
    box-shadow: 0px 12px 40px rgba(0, 0, 0, 0.45);
    margin-bottom: 40px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .bg-img {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-size: cover;
    background-position: center;
    filter: brightness(0.9);
  }

  .photo::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(42, 5, 46, 0.9), transparent);
  }

  .yellow {
    position: absolute;
    bottom: 28px;
    left: 32px;
    right: 32px;
    z-index: 2;
    font-family: var(--font-headline, 'Oswald', sans-serif);
    font-size: 32px;
    font-weight: 500;
    line-height: 1.2;
    color: #ffffff;
    text-shadow: 0 2px 8px rgba(0,0,0,0.6);
  }

  /* Body container strictly bounded to prevent overflow */
  .body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 18px;
    padding: 36px 40px;
    margin-bottom: 96px;
    overflow: hidden;
  }

  .body-text {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 36px;
    font-weight: 400;
    line-height: 1.44;
    letter-spacing: -0.3px;
    color: var(--text-main, #ffffff);
    width: 100%;
    word-break: break-word;
  }

  /* Highlights matching the Apple Action Blue / VurucuTim contrast philosophy */
  .body-text .hl-r {
    background: var(--primary, #4a0e4e);
    color: #ffffff;
    padding: 2px 10px;
    border-radius: 4px;
    font-weight: 600;
  }

  .body-text .hl-y {
    background: var(--accent, #ffffff);
    color: #2A052E;
    padding: 2px 10px;
    border-radius: 4px;
    font-weight: 600;
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 84px;
    height: 6px;
    background: rgba(255, 255, 255, 0.15);
    z-index: 11;
  }

  .progress::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background: var(--accent, #ffffff);
    animation: fill {{ duration_s }}s linear forwards;
  }

  @keyframes fill {
    from { width: 0; }
    to { width: 100%; }
  }

  .handle {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 30px;
    text-align: center;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: var(--text-muted, rgba(255, 255, 255, 0.7));
  }

  .source-credit {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.4);
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 14px;
    padding: 3px 12px;
    border-radius: 9999px;
    z-index: 50;
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
</style>
</head>
<body>
<div class="stage">

  {% if script.category %}<div class="stage-badge">{{ script.category }}</div>{% endif %}

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="24" data-fit-max="38" data-fit-pad="10">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>