<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Comic</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bangers&family=Bungee&family=Inter:wght@600;700;800&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #fffcef);
    color: var(--text-main, #0a0a0a);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background: var(--body-bg-1, #fffcef);
    overflow: hidden;
    border: 12px solid #0a0a0a;
    padding: 18px;
    display: grid;
    grid-template-rows: 180px 740px 1fr;
    gap: 18px;
  }
  /* Halftone overlay */
  .stage::before {
    content: ''; position: absolute; inset: 18px;
    background-image: radial-gradient(rgba(10,10,10,0.12) 1.5px, transparent 2px);
    background-size: 18px 18px;
    mix-blend-mode: multiply;
    opacity: 0.35;
    pointer-events: none;
    z-index: 1;
  }

  /* Panel — üst, başlık */
  .panel {
    background: #fff;
    border: 6px solid #0a0a0a;
    position: relative;
    z-index: 2;
    overflow: hidden;
  }
  .panel-header {
    background: var(--primary, #e63946);
    padding: 24px 36px;
    position: relative;
    display: flex; align-items: center; justify-content: space-between;
  }
  .panel-header .live {
    font-family: 'Bangers', cursive;
    font-size: 56px;
    color: #fff;
    letter-spacing: 0.06em;
    text-shadow: 4px 4px 0 #0a0a0a;
    transform: rotate(-3deg);
  }
  .panel-header .cat {
    background: var(--accent, #ffd166);
    color: #0a0a0a;
    border: 4px solid #0a0a0a;
    padding: 8px 18px;
    font-family: 'Bangers', cursive;
    font-size: 32px;
    letter-spacing: 0.08em;
    transform: rotate(2deg);
    box-shadow: 4px 4px 0 #0a0a0a;
  }

  .panel-headline {
    padding: 28px 36px;
    background:
      repeating-linear-gradient(45deg,
        rgba(0,0,0,0.04) 0 8px, transparent 8px 16px),
      #fff;
  }
  .panel-headline .top {
    display: block;
    font-family: 'Bangers', cursive;
    font-size: var(--size-headline-top, 140px);
    line-height: 0.88;
    letter-spacing: 0.02em;
    color: #0a0a0a;
    -webkit-text-stroke: 3px #0a0a0a;
    paint-order: stroke fill;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .panel-headline .bot {
    display: block; margin-top: 12px;
    font-family: 'Bangers', cursive;
    font-size: var(--size-headline-bot, 48px);
    line-height: 1.1;
    color: var(--primary, #e63946);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* Panel — foto */
  .panel-photo {
    position: relative;
    background: linear-gradient(135deg, var(--bg-grad-1, #1a3a6e), var(--bg-grad-2, #0a1a3a));
    overflow: hidden;
  }
  .panel-photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    filter: contrast(1.2) saturate(1.1);
  }
  .panel-photo::after {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.18) 1px, transparent 1.5px);
    background-size: 8px 8px;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  /* Speech bubble — POW! */
  .pow {
    position: absolute;
    left: 30px; top: 30px;
    background: var(--accent, #ffd166);
    color: #0a0a0a;
    font-family: 'Bungee', sans-serif;
    font-size: 56px;
    padding: 18px 34px;
    border: 6px solid #0a0a0a;
    box-shadow: 8px 8px 0 #0a0a0a;
    transform: rotate(-8deg);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    clip-path: polygon(
      10% 0%, 30% 5%, 50% 0%, 70% 6%, 90% 0%,
      100% 25%, 95% 50%, 100% 75%,
      90% 100%, 70% 95%, 50% 100%, 30% 96%, 10% 100%,
      0% 75%, 5% 50%, 0% 25%
    );
    z-index: 5;
  }

  /* Foto altı caption — komik karton şerit */
  .panel-photo .yellow {
    position: absolute; left: 0; bottom: 0; right: 0;
    background: var(--accent, #ffd166);
    border-top: 6px solid #0a0a0a;
    color: #0a0a0a;
    padding: 16px 24px;
    font-family: 'Bangers', cursive;
    font-size: 38px;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
    z-index: 4;
  }

  /* Panel — gövde, action lines */
  .panel-body {
    background: #fff;
    padding: 28px 34px;
    position: relative;
    z-index: 2;
    border: 6px solid #0a0a0a;
    display: flex; align-items: center;
  }
  .panel-body::before {
    content: ''; position: absolute; inset: 0;
    background-image:
      repeating-conic-gradient(from 0deg at 0% 100%,
        transparent 0deg 4deg,
        rgba(0,0,0,0.05) 4deg 6deg);
    pointer-events: none;
  }
  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 32px; line-height: 1.35; font-weight: 600;
    color: var(--text-main, #0a0a0a);
    text-wrap: pretty;
    position: relative; z-index: 1;
  }
  .body-text .hl-y {
    background: var(--accent, #ffd166); color: #0a0a0a;
    padding: 2px 8px;
    border: 3px solid #0a0a0a;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 800;
  }
  .body-text .hl-r {
    background: var(--primary, #e63946); color: #fff;
    padding: 2px 8px;
    border: 3px solid #0a0a0a;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 800;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 18px; right: 18px; bottom: 80px;
    height: 6px; background: #0a0a0a;
    border: 3px solid #0a0a0a;
    z-index: 6;
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--accent, #ffd166);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 22px;
    text-align: center;
    font-family: 'Bangers', cursive;
    font-size: 38px;
    color: #0a0a0a;
    letter-spacing: 0.08em;
    z-index: 6;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="panel">
    <div class="panel-header">
      <div class="live">{{ ui_breaking }}!</div>
      {% if script.category %}<div class="cat">{{ script.category }}</div>{% endif %}
    </div>
    <div class="panel-headline">
      <span class="top">{{ script.header_top }}</span>
      <span class="bot">{{ script.header_bottom }}</span>
    </div>
  </div>

  <div class="panel panel-photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    <div class="pow">POW!</div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="panel-body">
    <div class="body-text" data-fit-min="24" data-fit-max="32" data-fit-pad="14">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
