<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — newscast-magazine</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Lora:wght@400;500;700&display=swap');
  {{ dna_css|safe }}
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1920px; overflow: hidden;
    background: linear-gradient(180deg, {{ colors.bg_gradient[0] }}, {{ colors.bg_gradient[1] }});
    font-family: 'Lora', Georgia, serif;
    color: var(--text-main, {{ colors.text_main|default('#0a1733') }}); }

  .stage { position: relative; width: 1080px; height: 1920px;
    display: flex; flex-direction: column; padding: 100px 80px 200px; }

  .stage-badge {
    position: absolute; top: 50px; right: 60px;
    background: {{ colors.accent }}; color: #fff;
    font-family: 'Playfair Display', serif;
    font-size: 22px; font-weight: 700; letter-spacing: 3px;
    padding: 8px 18px;
  }

  .category {
    font-family: 'Playfair Display', serif;
    font-size: 28px; font-weight: 700;
    letter-spacing: 6px;
    text-transform: uppercase;
    color: {{ colors.accent }};
    margin-bottom: 40px;
  }

  .header {
    margin-bottom: 50px;
  }
  .header .top {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: var(--size-headline-top, 132px);
    font-weight: 900;
    line-height: 0.98;
    letter-spacing: -2px;
    color: var(--text-main, {{ colors.text_main|default('#0a1733') }});
  }
  .header .bot {
    display: block;
    margin-top: 20px;
    font-family: 'Playfair Display', serif;
    font-size: var(--size-headline-bot, 68px);
    font-weight: 700;
    font-style: italic;
    color: var(--text-muted, {{ colors.text_muted|default('#5a6478') }});
    line-height: 1.05;
  }

  .divider {
    width: 120px; height: 4px;
    background: {{ colors.accent }};
    margin-bottom: 40px;
  }

  .body-text {
    font-family: 'Lora', Georgia, serif;
    font-size: 44px;
    line-height: 1.5;
    font-weight: 400;
    color: var(--text-main, {{ colors.text_main|default('#0a1733') }});
    display: -webkit-box;
    -webkit-line-clamp: 11;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 88%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 0%, #000 88%, transparent 100%);
  }
  .body-text .hl-r { background: {{ colors.primary }}; color: #fff;
    padding: 0 8px; font-style: italic; font-weight: 700; }
  .body-text .hl-y { background: {{ colors.accent }}; color: #fff;
    padding: 0 8px; font-style: italic; font-weight: 700; }

  .photo-overlay {
    position: absolute; bottom: 250px; left: 80px;
    font-family: 'Playfair Display', serif;
    font-size: 24px; font-weight: 700;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: {{ colors.primary }};
    border-top: 2px solid {{ colors.primary }};
    padding-top: 12px;
  }

  .progress {
    position: absolute; left: 0; right: 0; bottom: 110px; height: 4px;
    background: rgba(0,0,0,.08);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: {{ colors.accent }};
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 50px;
    text-align: center;
    font-family: 'Playfair Display', serif;
    font-size: 32px; font-weight: 700; letter-spacing: 2px;
    color: var(--text-muted, {{ colors.text_muted|default('#5a6478') }});
  }

  .source-credit {
    position: absolute;
    bottom: 16px; left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,.6); color: rgba(255,255,255,.85);
    font-size: 14px; font-weight: 500; letter-spacing: 0.5px;
    padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">
  <div class="stage-badge">{{ ui_breaking }}</div>
  {% if script.category %}<div class="category">{{ script.category }}</div>{% endif %}

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="divider"></div>

  <div class="body-text" data-fit-min="32" data-fit-max="48" data-fit-pad="20">{{ body_html|safe }}</div>

  {% if script.photo_overlay %}
  <div class="photo-overlay">{{ script.photo_overlay }}</div>
  {% endif %}

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>

  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}
</div>
{% include "_auto_fit.js.j2" %}
</body>
</html>
