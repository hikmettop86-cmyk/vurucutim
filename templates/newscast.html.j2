<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap');
  {{ dna_css|safe }}
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1920px; overflow: hidden; background: #000;
    font-family: 'Inter', -apple-system, sans-serif; color: var(--text-main, #fff); }

  .stage { position: relative; width: 1080px; height: 1920px;
    display: flex; flex-direction: column; }

  /* STAGE-LEVEL BADGE (top-right corner) */
  .stage-badge {
    position: absolute; top: 14px; right: 14px;
    background: #000; color: {{ colors.accent }};
    font-size: 20px; font-weight: 800; letter-spacing: 1px;
    padding: 5px 12px; border-radius: 5px;
    z-index: 10;
  }

  /* HEADER (top banner) */
  .header {
    background: linear-gradient(90deg, {{ colors.primary }}, {{ colors.primary_light }});
    padding: 78px 60px 44px;
    text-align: center;
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: 0.5px;
    box-shadow: 0 10px 0 rgba(0,0,0,.4);
    position: relative;
  }
  .header .top { display: block; white-space: nowrap;
    font-size: var(--size-headline-top, 100px); }
  .header .bot { display: block; margin-top: 8px; white-space: nowrap;
    font-size: var(--size-headline-bot, 100px); }

  /* PHOTO band */
  .photo {
    position: relative;
    height: 640px;
    background: linear-gradient(135deg, {{ colors.bg_gradient[0] }}, {{ colors.bg_gradient[1] }});
    overflow: hidden;
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-image: url('{{ bg_image_url|default("") }}');
    background-size: cover; background-position: center;
    {% if not bg_image_url %}display: none;{% endif %}
  }
  .photo .vignette { position: absolute; inset: 0;
    background: radial-gradient(ellipse at center, transparent 30%, rgba(0,0,0,.55) 100%); }
  .photo .corner {
    position: absolute; top: 30px; left: 30px;
    background: rgba(0,0,0,.78); color: #fff;
    font-size: 30px; padding: 10px 18px; border-radius: 8px;
    font-weight: 700; letter-spacing: 1px;
  }
  .photo .yellow {
    position: absolute; bottom: 40px; left: 0; right: 0;
    background: linear-gradient(90deg, {{ colors.accent }}, #ffcc00);
    color: #000; padding: 28px 50px;
    font-weight: 900; font-size: 64px; line-height: 1.05;
    text-align: center;
    transform: skewY(-1.5deg);
    box-shadow: 0 8px 0 rgba(0,0,0,.4);
  }

  /* BODY paragraph — TWO LAYERS:
       .body       outer flex container (allocates remaining stage height)
       .body-text  inner text element (auto-fit script measures this; its
                   parent .body is the height-constraint container)
     The split is essential: auto-fit needs container.clientHeight ≠ text.scrollHeight
     so the shrink loop can actually detect overflow. Single-element layout
     (body acts as both container AND text) breaks because flex:1 forces
     scrollHeight=clientHeight even when content would fit. */
  .body {
    background: linear-gradient(180deg, var(--body-bg-1, #1a1a2a), var(--body-bg-2, #0a0a1a));
    flex: 1;
    min-height: 0;
    margin-bottom: 240px;
    padding: 50px 60px 30px;
    color: var(--text-main, #fff);
    overflow: hidden;
    display: flex;
    align-items: flex-start;
  }
  .body-text {
    width: 100%;
    font-size: 48px;
    line-height: 1.42;
    font-weight: 600;
    display: -webkit-box;
    -webkit-line-clamp: 9;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* ALT SOLMA MASKESİ KALDIRILDI: koşulsuzdu. Ölçüldü (fenerbahce
       #1830, gerçek metin): .body-text scrollHeight = clientHeight = 436,
       yani 9 satırlık sınırda 5 satır — TAŞMA YOK. Maske yine de son %8'i
       siliyordu ve yayınlanan karede son satırın alt yarısı kesik çıkıyordu
       ("...durumu iyi." yarıdan kesikti). Gerçekten taşan metni zaten
       -webkit-line-clamp kesiyor ve kendi üç noktasını koyuyor. */
  }
  .body .hl-r { background: {{ colors.primary }}; color: #fff;
    padding: 2px 14px; border-radius: 6px; font-weight: 700; }
  .body .hl-y { background: {{ colors.accent }}; color: #000;
    padding: 2px 14px; border-radius: 6px; font-weight: 700; }

  /* PROGRESS bar */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px; height: 8px;
    background: rgba(255,255,255,.18);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: linear-gradient(90deg, {{ colors.accent }}, {{ colors.primary }});
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  /* HANDLE */
  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center; color: var(--text-muted, #fff);
    font-size: 34px; font-weight: 600;
  }

  /* Begeni/abone ogeleri KALDIRILDI (2026-07-16, kullanici karari):
     CTA kapanis karti + kalici BEGEN/ABONE kose cipleri. */

  /* SOURCE CREDIT */
  .source-credit {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.6);
    color: rgba(255, 255, 255, 0.85);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.5px;
    padding: 3px 10px;
    border-radius: 3px;
    z-index: 50;
    white-space: nowrap;
    font-family: inherit;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">
  <div class="stage-badge">{{ ui_breaking }}</div>
  <div class="header">
    {# Width-fit data attrs: shrinks 100px font down to fit the 1080px-wide
       header column (with 60px L/R padding from .header CSS rule). Without
       these, 20+-char headers like "VERGİ ARTIŞI GÜNDEMDE YOK" overflow the
       frame. Short text stays at 100px; long text scales down to 50px floor. #}
    <span class="top" data-fit-min="50" data-fit-max="100" data-fit-width="120">{{ script.header_top }}</span>
    <span class="bot" data-fit-min="50" data-fit-max="100" data-fit-width="120">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img"></div>
    <div class="vignette"></div>
    <div class="corner">{{ script.category }}</div>
    <div class="yellow">{{ script.photo_overlay }}</div>
  </div>

  <div class="body"><div class="body-text" data-fit-min="36" data-fit-max="60" data-fit-pad="20">{{ body_html|safe }}</div></div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>

  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}
</div>
{% include "_auto_fit.js.j2" %}
</body>
</html>
