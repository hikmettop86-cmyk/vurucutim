<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Memphis</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@500;700;800;900&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #f5f0e1);
    color: var(--text-main, #0a0a0a);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background: var(--body-bg-1, #f5f0e1);
    overflow: hidden;
  }

  /* Dekoratif şekiller — arka plan */
  .deco { position: absolute; pointer-events: none; }
  .deco.d1 {
    top: -80px; left: -60px; width: 320px; height: 320px;
    background: var(--primary, #ff3d6e);
    border-radius: 50%;
  }
  .deco.d2 {
    top: 380px; right: -100px; width: 280px; height: 280px;
    background: var(--accent, #00c4ff);
    transform: rotate(45deg);
  }
  .deco.d3 {
    bottom: 320px; left: -60px; width: 200px; height: 200px;
    background: transparent;
    border: 12px solid #0a0a0a;
  }
  .deco.d4 {
    bottom: 460px; right: 40px; width: 140px; height: 140px;
    background:
      radial-gradient(circle, #0a0a0a 25%, transparent 26%) 0 0 / 24px 24px;
  }
  .deco.zigzag {
    top: 1340px; left: -20px; right: -20px; height: 30px;
    background:
      linear-gradient(135deg, #0a0a0a 25%, transparent 25%) -15px 0,
      linear-gradient(225deg, #0a0a0a 25%, transparent 25%) -15px 0;
    background-size: 30px 30px;
  }

  /* Üst rozet + zaman */
  .top-row {
    position: absolute; top: 60px; left: 80px; right: 80px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 5;
  }
  .stage-badge {
    background: var(--accent, #00c4ff);
    color: #0a0a0a;
    padding: 12px 22px;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-weight: 900; font-size: 24px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    border: 4px solid #0a0a0a;
    box-shadow: 6px 6px 0 #0a0a0a;
    transform: rotate(-2deg);
  }
  .live-pin {
    background: #0a0a0a;
    color: #fff;
    padding: 10px 20px;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-weight: 800; font-size: 22px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transform: rotate(2deg);
  }

  /* Manşet — çıkıntılı, sticker hissi */
  .header {
    position: absolute;
    top: 220px; left: 60px; right: 60px;
    z-index: 4;
  }
  .header .top {
    display: inline-block;
    font-family: var(--font-headline, 'Anton'), sans-serif;
    font-size: var(--size-headline-top, 220px);
    line-height: 0.86;
    color: #0a0a0a;
    text-transform: uppercase;
    letter-spacing: 0.005em;
    background: var(--accent, #00c4ff);
    padding: 0 18px;
    border: 6px solid #0a0a0a;
    box-shadow: 12px 12px 0 var(--primary, #ff3d6e);
    transform: rotate(-1.5deg);
    text-wrap: balance;
  }
  .header .bot {
    display: inline-block;
    margin-top: 30px;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-weight: 700;
    font-size: var(--size-headline-bot, 50px);
    line-height: 1.1;
    color: #0a0a0a;
    background: #fff;
    padding: 8px 18px;
    border: 4px solid #0a0a0a;
    transform: rotate(1deg);
    box-shadow: 6px 6px 0 #0a0a0a;
    text-wrap: balance;
  }

  /* Foto */
  .photo {
    position: absolute;
    top: 780px; left: 100px; right: 100px;
    height: 540px;
    background: linear-gradient(135deg, var(--bg-grad-1, #2a3a5e), var(--bg-grad-2, #11182f));
    border: 6px solid #0a0a0a;
    transform: rotate(1.5deg);
    box-shadow: 12px 12px 0 #0a0a0a;
    overflow: hidden;
    z-index: 3;
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
  }
  .photo .yellow {
    position: absolute; left: -20px; bottom: 30px;
    background: var(--primary, #ff3d6e);
    color: #fff;
    padding: 14px 28px;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-weight: 900;
    font-size: 32px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 4px solid #0a0a0a;
    transform: rotate(-3deg);
    box-shadow: 6px 6px 0 #0a0a0a;
  }

  /* Gövde */
  .body {
    position: absolute; left: 80px; right: 80px;
    top: 1410px; bottom: 200px;
    background: #fff;
    border: 5px solid #0a0a0a;
    padding: 28px 34px;
    transform: rotate(-0.8deg);
    box-shadow: 10px 10px 0 var(--accent, #00c4ff);
  }
  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 32px; line-height: 1.4; font-weight: 600;
    color: var(--text-main, #0a0a0a);
    text-wrap: pretty;
  }
  .body-text .hl-y {
    background: var(--accent, #00c4ff); color: #0a0a0a;
    padding: 0 8px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 800;
  }
  .body-text .hl-r {
    background: var(--primary, #ff3d6e); color: #fff;
    padding: 0 8px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 800;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 8px; background: rgba(10,10,10,0.16);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--primary, #ff3d6e);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 30px; font-weight: 800;
    color: var(--text-muted, #0a0a0a);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="deco d1"></div>
  <div class="deco d2"></div>
  <div class="deco d3"></div>
  <div class="deco d4"></div>
  <div class="deco zigzag"></div>

  <div class="top-row">
    {% if script.category %}<div class="stage-badge">{{ script.category }}</div>{% endif %}
    <div class="live-pin">{{ ui_breaking }}</div>
  </div>

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <br/>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="24" data-fit-max="32" data-fit-pad="16">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
