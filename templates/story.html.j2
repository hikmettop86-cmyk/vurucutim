<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Story</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700;800;900&family=Inter:wght@400;500;600;700&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #ff3d6e);
    color: var(--text-main, #fff);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background:
      radial-gradient(80% 50% at 100% 0%, color-mix(in srgb, var(--accent, #ffd93d) 60%, transparent), transparent 60%),
      radial-gradient(70% 50% at 0% 100%, color-mix(in srgb, var(--primary, #ff3d6e) 70%, transparent), transparent 60%),
      linear-gradient(160deg, var(--body-bg-1, #ff3d6e) 0%, var(--body-bg-2, #c81e5a) 100%);
    overflow: hidden;
  }
  /* Glitter */
  .stage::before {
    content: ''; position: absolute; inset: 0;
    background-image:
      radial-gradient(rgba(255,255,255,0.32) 1px, transparent 2px),
      radial-gradient(rgba(255,255,255,0.18) 0.5px, transparent 1px);
    background-size: 90px 90px, 30px 30px;
    background-position: 0 0, 45px 45px;
    pointer-events: none;
  }

  /* Stories progress dots */
  .story-pips {
    position: absolute; top: 30px; left: 60px; right: 60px;
    display: flex; gap: 8px;
    z-index: 6;
  }
  .story-pips .pip {
    flex: 1; height: 5px;
    background: rgba(255,255,255,0.3); border-radius: 999px;
  }
  .story-pips .pip.active {
    background: #fff;
  }

  /* Üst meta */
  .top-meta {
    position: absolute; top: 70px; left: 60px; right: 60px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 5;
  }
  .avatar-row {
    display: flex; align-items: center; gap: 14px;
    color: #fff;
  }
  .avatar {
    width: 56px; height: 56px; border-radius: 50%;
    background: linear-gradient(135deg, var(--accent, #ffd93d), var(--primary, #ff3d6e));
    border: 3px solid #fff;
    box-shadow: 0 0 0 2px var(--primary, #ff3d6e);
    flex-shrink: 0;
  }
  .avatar-info { display: flex; flex-direction: column; }
  .avatar-name {
    font-family: var(--font-headline, 'Montserrat'), sans-serif;
    font-weight: 800; font-size: 24px;
  }
  .avatar-time {
    font-size: 18px; opacity: 0.8;
  }
  .stage-badge {
    background: rgba(0,0,0,0.32);
    backdrop-filter: blur(14px);
    color: #fff;
    border: 1.5px solid rgba(255,255,255,0.25);
    padding: 10px 20px; border-radius: 999px;
    font-family: var(--font-headline, 'Montserrat'), sans-serif;
    font-weight: 700; font-size: 20px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Foto kartı */
  .photo {
    position: absolute;
    top: 200px; left: 60px; right: 60px;
    height: 940px;
    border-radius: 28px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--bg-grad-1, #2a0a3a) 0%, var(--bg-grad-2, #0a1428) 100%);
    box-shadow: 0 40px 80px rgba(0,0,0,0.4);
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
  }
  .photo::before {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(0,0,0,0.2) 0%, transparent 25%, transparent 65%, rgba(0,0,0,0.65) 100%);
    pointer-events: none;
  }
  /* Sticker — büyük emoji-tarzı badge */
  .photo .sticker {
    position: absolute; top: 30px; right: 30px;
    background: var(--accent, #ffd93d);
    color: #1a1410;
    font-family: var(--font-headline, 'Montserrat'), sans-serif;
    font-weight: 900;
    font-size: 30px;
    padding: 12px 22px;
    border-radius: 18px;
    transform: rotate(8deg);
    box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  /* Foto altı manşet */
  .photo .headline {
    position: absolute; left: 36px; right: 36px; bottom: 36px;
    z-index: 2;
  }
  .photo .headline .top {
    display: block;
    font-family: var(--font-headline, 'Montserrat'), sans-serif;
    font-weight: 900;
    font-size: var(--size-headline-top, 110px);
    line-height: 0.88;
    letter-spacing: -0.025em;
    color: #fff;
    text-transform: uppercase;
    text-shadow: 0 4px 30px rgba(0,0,0,0.4);
    text-wrap: balance;
  }
  .photo .headline .bot {
    display: block; margin-top: 12px;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-weight: 600;
    font-size: var(--size-headline-bot, 40px);
    line-height: 1.15;
    color: rgba(255,255,255,0.92);
    text-wrap: balance;
  }
  /* Sarı bant overlay */
  .photo .yellow {
    position: absolute; left: 36px; top: 36px;
    background: var(--accent, #ffd93d);
    color: #1a1410;
    padding: 10px 20px; border-radius: 999px;
    font-family: var(--font-headline, 'Montserrat'), sans-serif;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    z-index: 3;
    box-shadow: 0 6px 16px rgba(0,0,0,0.25);
  }

  /* Beyaz alt kart */
  .content-card {
    position: absolute;
    left: 60px; right: 60px;
    top: 1180px; bottom: 180px;
    background: #fff;
    color: #1a1a1a;
    border-radius: 28px;
    padding: 36px 42px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.2);
    display: flex; align-items: center;
  }
  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 32px; line-height: 1.4; font-weight: 500;
    color: #1a1a1a;
    text-wrap: pretty;
  }
  .body-text .hl-y {
    background: var(--accent, #ffd93d); color: #1a1410;
    padding: 0 10px; border-radius: 999px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 700;
  }
  .body-text .hl-r {
    background: var(--primary, #ff3d6e); color: #fff;
    padding: 0 10px; border-radius: 999px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 700;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 5px; background: rgba(255,255,255,0.22);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: #fff;
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 30px; font-weight: 700;
    color: #fff;
    letter-spacing: 0.04em;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="story-pips">
    <div class="pip"></div>
    <div class="pip active"></div>
    <div class="pip"></div>
    <div class="pip"></div>
  </div>

  <div class="top-meta">
    <div class="avatar-row">
      <div class="avatar"></div>
      <div class="avatar-info">
        <div class="avatar-name">{{ handle }}</div>
        <div class="avatar-time">{{ ui_breaking }} · az önce</div>
      </div>
    </div>
    {% if script.category %}<div class="stage-badge">{{ script.category }}</div>{% endif %}
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
    <div class="sticker">{{ ui_breaking }}!</div>
    <div class="headline">
      <span class="top">{{ script.header_top }}</span>
      <span class="bot">{{ script.header_bottom }}</span>
    </div>
  </div>

  <div class="content-card">
    <div class="body-text" data-fit-min="24" data-fit-max="32" data-fit-pad="16">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
