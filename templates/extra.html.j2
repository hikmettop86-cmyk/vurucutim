<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Extra</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Oswald:wght@600;700&family=Inter:wght@500;700&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #f0e6c8);
    color: var(--text-main, #1a0a0a);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background:
      radial-gradient(circle at 20% 80%, color-mix(in srgb, var(--accent, #f0c800) 35%, transparent), transparent 60%),
      linear-gradient(140deg, var(--body-bg-1, #f0e6c8), var(--body-bg-2, #d6cba8));
    overflow: hidden;
  }
  /* Eski kâğıt grunge */
  .stage::before {
    content: ''; position: absolute; inset: 0;
    background-image:
      radial-gradient(rgba(80,40,20,0.08) 1px, transparent 1.5px),
      radial-gradient(rgba(80,40,20,0.04) 0.5px, transparent 1px);
    background-size: 18px 18px, 5px 5px;
    background-position: 0 0, 9px 9px;
    mix-blend-mode: multiply;
    opacity: 0.7;
    pointer-events: none;
  }

  /* "EXTRA!" şerit + kategori */
  .top-strip {
    background: var(--primary, #c02020);
    color: #fff;
    padding: 18px 50px;
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-headline, 'Bebas Neue'), sans-serif;
    font-size: 38px;
    letter-spacing: 0.16em;
    border-bottom: 4px solid #1a0a0a;
    position: relative;
  }
  .top-strip::before, .top-strip::after {
    content: ''; position: absolute; bottom: -16px;
    width: 0; height: 0;
    border-left: 16px solid transparent; border-right: 16px solid transparent;
    border-top: 16px solid #1a0a0a;
  }
  .top-strip::before { left: 50px; }
  .top-strip::after { right: 50px; }

  /* Manşet — alt çizgili, sallanan */
  .header {
    padding: 70px 50px 30px;
    text-align: center;
  }
  .header .top {
    display: block;
    font-family: var(--font-headline, 'Bebas Neue'), sans-serif;
    font-size: var(--size-headline-top, 220px);
    line-height: 0.85;
    color: #1a0a0a;
    letter-spacing: 0.005em;
    text-decoration: underline;
    text-decoration-thickness: 8px;
    text-underline-offset: 8px;
    text-decoration-color: var(--primary, #c02020);
    transform: rotate(-1.2deg);
    text-wrap: balance;
  }
  .header .bot {
    display: block;
    margin-top: 26px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: var(--size-headline-bot, 56px);
    line-height: 1.0;
    color: #1a0a0a;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    transform: rotate(0.4deg);
    text-wrap: balance;
  }

  /* Foto — yırtık kenar polaroid */
  .photo {
    position: relative;
    margin: 40px auto 0;
    width: 920px; height: 520px;
    background: #1a0a0a;
    padding: 16px 16px 60px;
    transform: rotate(-1.5deg);
    box-shadow: 0 16px 0 -8px rgba(26,10,10,0.4), 0 30px 60px rgba(26,10,10,0.3);
  }
  .photo .photo-img {
    position: relative; width: 100%; height: 100%;
    background:
      linear-gradient(135deg, var(--bg-grad-1, #3a1a1a) 0%, var(--bg-grad-2, #1a0a0a) 100%);
    overflow: hidden;
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    filter: saturate(0.7) contrast(1.15) sepia(0.15);
  }
  .photo .photo-img::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(120% 100% at 50% 50%, transparent 50%, rgba(0,0,0,0.5) 100%);
    pointer-events: none;
  }
  .photo .yellow {
    position: absolute; left: 30px; right: 30px; bottom: 10px;
    color: #1a0a0a;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 30px;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Gövde */
  .body {
    position: absolute; left: 50px; right: 50px;
    top: 1500px; bottom: 180px;
    padding: 24px;
    background: var(--accent, #f0c800);
    border: 4px solid #1a0a0a;
    transform: rotate(0.8deg);
    box-shadow: 8px 10px 0 #1a0a0a;
  }
  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 32px; line-height: 1.35; font-weight: 600;
    color: #1a0a0a;
    text-wrap: pretty;
  }
  .body-text .hl-y {
    background: #1a0a0a; color: var(--accent, #f0c800);
    padding: 0 8px; font-weight: 700;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
  }
  .body-text .hl-r {
    background: var(--primary, #c02020); color: #fff;
    padding: 0 8px; font-weight: 700;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 8px; background: rgba(26,10,10,0.18);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--primary, #c02020);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: 'Oswald', sans-serif;
    font-size: 34px; font-weight: 700;
    color: #1a0a0a;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="top-strip">
    <span>{{ ui_breaking }}</span>
    {% if script.category %}<span>{{ script.category }}</span>{% endif %}
    <span>★ ★ ★</span>
  </div>

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="photo-img">
      <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
           {% if not bg_image_url %}display: none;{% endif %}"></div>
    </div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="24" data-fit-max="32" data-fit-pad="16">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
