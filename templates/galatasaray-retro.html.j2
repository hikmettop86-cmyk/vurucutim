<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — GS Retro</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Oswald:wght@500;700&family=Inter:wght@500;700&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #f0deaa);
    color: var(--text-main, #2a1208);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background:
      radial-gradient(80% 60% at 50% 50%,
        color-mix(in srgb, var(--accent, #FCB900) 100%, white 6%) 0%,
        var(--body-bg-1, #f0deaa) 60%,
        var(--body-bg-2, #d4be7e) 100%);
    overflow: hidden;
  }
  /* Vintage paper noise */
  .stage::before {
    content: ''; position: absolute; inset: 0;
    background-image:
      radial-gradient(rgba(80,40,20,0.12) 1px, transparent 1.5px),
      radial-gradient(rgba(80,40,20,0.05) 0.4px, transparent 1px);
    background-size: 20px 20px, 5px 5px;
    background-position: 0 0, 10px 10px;
    mix-blend-mode: multiply;
    opacity: 0.7;
    pointer-events: none;
  }
  /* Eski leke ve aşınma */
  .stage::after {
    content: ''; position: absolute; inset: 0;
    background:
      radial-gradient(40% 25% at 10% 5%, rgba(120,80,30,0.18), transparent 70%),
      radial-gradient(40% 25% at 95% 90%, rgba(120,80,30,0.18), transparent 70%);
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  /* Üst seal — vintage damga */
  .seal {
    position: absolute; top: 60px; left: 50%;
    transform: translateX(-50%);
    width: 140px; height: 140px;
    border-radius: 50%;
    border: 4px double var(--primary, #A90432);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    color: var(--primary, #A90432);
    font-family: 'Alfa Slab One', serif;
    z-index: 5;
    opacity: 0.9;
    transform: translateX(-50%) rotate(-8deg);
  }
  .seal .yr { font-size: 38px; line-height: 1; }
  .seal .lbl {
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.3em;
    margin-top: 6px;
  }

  /* Üst kategori */
  .stage-badge {
    position: absolute; top: 100px; left: 50px;
    background: var(--primary, #A90432);
    color: var(--accent, #FCB900);
    padding: 10px 22px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 24px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transform: rotate(-2deg);
    box-shadow: 4px 4px 0 #2a1208;
    z-index: 5;
  }
  .live-tag {
    position: absolute; top: 100px; right: 50px;
    color: var(--primary, #A90432);
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 24px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: flex; align-items: center; gap: 10px;
    transform: rotate(2deg);
    z-index: 5;
  }
  .live-tag::before {
    content: '★';
    color: var(--accent, #FCB900);
    font-size: 28px;
    -webkit-text-stroke: 2px var(--primary, #A90432);
  }

  /* Manşet — slab serif */
  .header {
    position: absolute; top: 280px; left: 40px; right: 40px;
    text-align: center;
    z-index: 4;
  }
  .header .top {
    display: block;
    font-family: 'Alfa Slab One', serif;
    font-size: var(--size-headline-top, 200px);
    line-height: 0.92;
    color: var(--primary, #A90432);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    text-shadow: 8px 8px 0 var(--accent, #FCB900), 12px 12px 0 #2a1208;
    text-wrap: balance;
    transform: rotate(-0.8deg);
  }
  .header .bot {
    display: block; margin-top: 28px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: var(--size-headline-bot, 50px);
    line-height: 1.05;
    color: #2a1208;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }
  .header .bot::before, .header .bot::after {
    content: ' ✦ ';
    color: var(--primary, #A90432);
  }

  /* Foto — retro çerçeve */
  .photo {
    position: absolute;
    top: 820px; left: 70px; right: 70px;
    height: 540px;
    background: #2a1208;
    padding: 28px 28px 80px;
    transform: rotate(-1deg);
    box-shadow:
      0 0 0 6px var(--accent, #FCB900),
      0 0 0 12px var(--primary, #A90432),
      0 20px 60px rgba(42, 18, 8, 0.4);
    z-index: 3;
  }
  .photo .photo-img {
    position: relative; width: 100%; height: 100%;
    background: linear-gradient(135deg, var(--bg-grad-1, #25080d), var(--bg-grad-2, #0a0204));
    overflow: hidden;
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    filter: sepia(0.25) saturate(0.85) contrast(1.05);
  }
  .photo .photo-img::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(135deg, rgba(120,80,30,0.18), transparent 30%, transparent 70%, rgba(120,80,30,0.18));
    pointer-events: none;
  }
  .photo .yellow {
    position: absolute; left: 28px; right: 28px; bottom: 18px;
    color: var(--accent, #FCB900);
    font-family: 'Alfa Slab One', serif;
    font-size: 38px;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Gövde */
  .body {
    position: absolute; left: 60px; right: 60px;
    top: 1500px; bottom: 200px;
    padding: 24px 30px;
    background: rgba(42, 18, 8, 0.06);
    border-top: 3px solid var(--primary, #A90432);
    border-bottom: 3px solid var(--primary, #A90432);
    z-index: 4;
  }
  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 30px; line-height: 1.45; font-weight: 500;
    color: #2a1208;
    text-align: center;
    text-wrap: pretty;
  }
  .body-text .hl-y {
    background: var(--accent, #FCB900); color: var(--primary, #A90432);
    padding: 0 10px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 800;
    border-bottom: 2px solid #2a1208;
  }
  .body-text .hl-r {
    background: var(--primary, #A90432); color: var(--accent, #FCB900);
    padding: 0 10px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 800;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 6px; background: rgba(42,18,8,0.15);
    z-index: 6;
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--primary, #A90432);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: 'Oswald', sans-serif;
    font-size: 30px; font-weight: 700;
    color: var(--primary, #A90432);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    z-index: 6;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="seal">
    <span class="yr">1905</span>
    <span class="lbl">CİMBOM</span>
  </div>

  {% if script.category %}<div class="stage-badge">{{ script.category }}</div>{% endif %}
  <div class="live-tag">{{ ui_breaking }}</div>

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="photo-img">
      <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
           {% if not bg_image_url %}display: none;{% endif %}"></div>
    </div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="22" data-fit-max="30" data-fit-pad="18">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
