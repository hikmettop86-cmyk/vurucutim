<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Amerika Gündemi</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: 'Inter', -apple-system, sans-serif;
    color: var(--text-main, #F8FAFC);
    background: linear-gradient(180deg, var(--body-bg-1, #0F172A), var(--body-bg-2, #1E293B));
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    display: flex; flex-direction: column;
    background: linear-gradient(180deg, #0F172A 0%, #1E293B 100%);
  }

  /* KATEGORİ / ROZET */
  .stage-badge {
    position: absolute; top: 32px; right: 48px;
    background: #dc2626; color: #fff;
    font-size: 22px; font-weight: 800; letter-spacing: 1.5px;
    padding: 8px 20px; border-radius: 6px;
    z-index: 20; text-transform: uppercase;
    box-shadow: 0 4px 12px rgba(220, 38, 38, 0.4);
  }

  /* BAŞLIK (HEADER) KARTI */
  .header {
    background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
    padding: 70px 50px 45px 50px;
    text-align: left;
    position: relative;
    box-shadow: 0 12px 30px rgba(0,0,0,0.4);
    z-index: 10;
  }
  .header .top {
    display: block;
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: var(--size-headline-top, 64px);
    line-height: 1.1;
    letter-spacing: -0.5px;
    color: #fff;
    text-transform: uppercase;
  }
  .header .bot {
    display: block;
    margin-top: 12px;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: var(--size-headline-bot, 48px);
    line-height: 1.2;
    color: #f59e0b;
    text-transform: uppercase;
  }

  /* FOTOĞRAF ALANI */
  .photo {
    position: relative;
    height: 540px;
    background: linear-gradient(135deg, #1e293b, #0f172a);
    overflow: hidden;
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    {% if not bg_image_url %}display: none;{% endif %}
  }
  .photo .vignette {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at center, transparent 20%, rgba(15,23,42,0.85) 100%);
  }
  .photo .yellow {
    position: absolute; bottom: 30px; left: 48px; right: 48px;
    background: rgba(15, 23, 42, 0.88);
    border-left: 6px solid #f59e0b;
    color: #fff; padding: 22px 30px;
    font-weight: 700; font-size: 38px; line-height: 1.25;
    backdrop-filter: blur(8px);
    border-radius: 0 12px 12px 0;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
  }

  /* GÖVDE (BODY) ALANI */
  .body {
    flex: 1;
    min-height: 0;
    margin: 30px 48px 140px 48px;
    padding: 35px 40px;
    background: rgba(30, 41, 59, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    backdrop-filter: blur(12px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }
  .body-text {
    width: 100%;
    font-size: 40px;
    line-height: 1.5;
    font-weight: 400;
    color: #F1F5F9;
  }
  
  /* VURGULAR (HIGHLIGHTS) */
  .body .hl-r {
    background: rgba(220, 38, 38, 0.25);
    color: #fca5a5;
    padding: 2px 10px;
    border-radius: 4px;
    font-weight: 600;
    border-bottom: 2px solid #dc2626;
  }
  .body .hl-y {
    background: rgba(245, 158, 11, 0.25);
    color: #fcd34d;
    padding: 2px 10px;
    border-radius: 4px;
    font-weight: 600;
    border-bottom: 2px solid #f59e0b;
  }

  /* İLERLEME ÇUBUĞU */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px; height: 6px;
    background: rgba(255,255,255,.12);
    z-index: 10;
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: linear-gradient(90deg, #f59e0b, #dc2626);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  /* KANAL KİMLİĞİ (HANDLE) */
  .handle {
    position: absolute; left: 0; right: 0; bottom: 28px;
    text-align: center; color: var(--text-muted, #94A3B8);
    font-size: 30px; font-weight: 600;
    letter-spacing: 0.5px;
    z-index: 10;
  }

  /* KAYNAK KREDİSİ */
  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,.6); color: rgba(255,255,255,.85);
    font-size: 14px; padding: 3px 12px; border-radius: 4px;
    z-index: 50; white-space: nowrap;
    border: 1px solid rgba(255,255,255,0.05);
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  {% if script.category %}<div class="stage-badge">{{ script.category }}</div>{% endif %}

  <div class="header">
    <span class="top" data-fit-min="38" data-fit-max="64" data-fit-width="80">{{ script.header_top }}</span>
    <span class="bot" data-fit-min="32" data-fit-max="48" data-fit-width="80">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');"></div>
    <div class="vignette"></div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="24" data-fit-max="40" data-fit-pad="24">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>