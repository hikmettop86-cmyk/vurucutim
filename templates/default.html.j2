<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="utf-8">
<title>Short</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap');
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1920px; overflow: hidden; background: #000;
    font-family: 'Inter', -apple-system, sans-serif; color: #fff; }

  .stage { position: relative; width: 1080px; height: 1920px; }

  /* STAGE-LEVEL BADGE (top-right corner) */
  .stage-badge {
    position: absolute; top: 14px; right: 14px;
    background: #000; color: {{ colors.accent }};
    font-size: 20px; font-weight: 800; letter-spacing: 1px;
    padding: 5px 12px; border-radius: 5px;
    z-index: 10;
  }

  /* HEADER (top banner) */
  .header {
    background: linear-gradient(90deg, {{ colors.primary }}, {{ colors.primary_light }});
    padding: 78px 60px 44px;
    text-align: center;
    font-weight: 900;
    font-size: 100px;
    line-height: 1.02;
    letter-spacing: 0.5px;
    box-shadow: 0 10px 0 rgba(0,0,0,.4);
    position: relative;
  }
  .header .top { display: block; }
  .header .bot { display: block; margin-top: 8px; }

  /* PHOTO band */
  .photo {
    position: relative;
    height: 640px;
    background: linear-gradient(135deg, {{ colors.bg_gradient[0] }}, {{ colors.bg_gradient[1] }});
    overflow: hidden;
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-image: url('{{ bg_image_url|default("") }}');
    background-size: cover; background-position: center;
    {% if not bg_image_url %}display: none;{% endif %}
  }
  .photo .vignette { position: absolute; inset: 0;
    background: radial-gradient(ellipse at center, transparent 30%, rgba(0,0,0,.55) 100%); }
  .photo .corner {
    position: absolute; top: 30px; left: 30px;
    background: rgba(0,0,0,.78); color: #fff;
    font-size: 30px; padding: 10px 18px; border-radius: 8px;
    font-weight: 700; letter-spacing: 1px;
  }
  .photo .yellow {
    position: absolute; bottom: 40px; left: 0; right: 0;
    background: linear-gradient(90deg, {{ colors.accent }}, #ffcc00);
    color: #000; padding: 28px 50px;
    font-weight: 900; font-size: 64px; line-height: 1.05;
    text-align: center;
    transform: skewY(-1.5deg);
    box-shadow: 0 8px 0 rgba(0,0,0,.4);
  }

  /* BODY paragraph */
  .body {
    background: linear-gradient(180deg, #1a1a2a, #0a0a1a);
    padding: 50px 60px 260px;
    font-size: 48px;
    line-height: 1.42;
    font-weight: 600;
    color: #fff;
    /* Prevent overflow: clamp to ~9 lines (fits in available vertical space) */
    display: -webkit-box;
    -webkit-line-clamp: 9;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .body .hl-r { background: {{ colors.primary }}; color: #fff;
    padding: 2px 14px; border-radius: 6px; font-weight: 700; }
  .body .hl-y { background: {{ colors.accent }}; color: #000;
    padding: 2px 14px; border-radius: 6px; font-weight: 700; }

  /* PROGRESS bar */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px; height: 8px;
    background: rgba(255,255,255,.18);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: linear-gradient(90deg, {{ colors.accent }}, {{ colors.primary }});
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  /* HANDLE */
  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center; color: #fff; opacity: .9;
    font-size: 34px; font-weight: 600;
  }

  /* CTA overlay (last cta_duration_s seconds) */
  {% if cta.enabled %}
  /* Pre-flash: full-screen white flash 150ms before CTA */
  .preflash {
    position: absolute; inset: 0;
    background: #fff;
    opacity: 0;
    pointer-events: none;
    z-index: 50;
    animation: flash 0.18s ease-out {{ duration_s - cta.duration_s - 0.15 }}s forwards;
  }
  @keyframes flash {
    0% { opacity: 0; }
    40% { opacity: 0.9; }
    100% { opacity: 0; }
  }

  /* CTA wrapper */
  .cta {
    position: absolute; left: 0; right: 0; bottom: 0; top: 0;
    background: radial-gradient(ellipse at center, rgba(20,20,20,.92), rgba(0,0,0,.98));
    padding: 0 60px;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    animation:
      cta-fade-in 0.25s ease-out {{ duration_s - cta.duration_s }}s forwards;
  }
  @keyframes cta-fade-in {
    to { opacity: 1; }
  }

  {% if cta.show_handle %}
  .cta .handle-line {
    font-size: 64px; font-weight: 900;
    color: {{ colors.accent }};
    letter-spacing: 1px;
    margin-bottom: 50px;
    text-shadow:
      0 0 18px rgba(255,234,59,.7),
      0 0 36px rgba(255,234,59,.4);
    opacity: 0; transform: translateY(-30px);
    animation: handle-drop 0.45s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.05 }}s forwards;
  }
  @keyframes handle-drop {
    to { opacity: 1; transform: translateY(0); }
  }
  {% endif %}

  /* Big YouTube-style SUBSCRIBE button */
  .cta .sub-btn {
    background: linear-gradient(180deg, #ff2d2d, #c81e1e);
    color: #fff;
    font-size: 88px; font-weight: 900;
    padding: 40px 70px;
    border-radius: 100px;
    box-shadow:
      0 12px 0 rgba(0,0,0,.5),
      0 20px 60px rgba(255,45,45,.6);
    display: inline-flex;
    align-items: center;
    gap: 28px;
    letter-spacing: 1px;
    margin-bottom: 60px;
    transform: scale(0);
    animation:
      sub-pop 0.5s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.15 }}s forwards,
      sub-press 0.4s ease-in-out {{ duration_s - cta.duration_s + 0.55 }}s;
  }
  @keyframes sub-pop {
    to { transform: scale(1); }
  }
  @keyframes sub-press {
    0%, 100% { transform: scale(1); box-shadow: 0 12px 0 rgba(0,0,0,.5), 0 20px 60px rgba(255,45,45,.6); }
    50% { transform: scale(0.92); box-shadow: 0 4px 0 rgba(0,0,0,.5), 0 8px 30px rgba(255,45,45,.6); }
  }
  .cta .sub-btn .bell { font-size: 96px; }

  /* Pointer hand below button — bouncing */
  .cta .pointer {
    font-size: 100px;
    margin-bottom: 50px;
    opacity: 0;
    animation:
      pointer-in 0.3s ease-out {{ duration_s - cta.duration_s + 0.7 }}s forwards,
      bounce 0.6s ease-in-out {{ duration_s - cta.duration_s + 1.0 }}s infinite;
  }
  @keyframes pointer-in {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  /* Three icons row at bottom — stagger pop-in */
  .cta .icons-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 50px;
    margin-top: 30px;
  }
  .cta .icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    transform: scale(0);
    opacity: 0;
  }
  .cta .icon-item .ic { font-size: 110px; }
  .cta .icon-item .lbl { font-size: 36px; font-weight: 800; color: #fff; letter-spacing: 1px; }
  .cta .icon-item:nth-child(1) {
    animation: icon-pop 0.4s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.25 }}s forwards;
  }
  .cta .icon-item:nth-child(2) {
    animation: icon-pop 0.4s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.4 }}s forwards;
  }
  .cta .icon-item:nth-child(3) {
    animation: icon-pop 0.4s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.55 }}s forwards;
  }
  @keyframes icon-pop {
    to { opacity: 1; transform: scale(1); }
  }

  /* Body dim during CTA so it stays focused */
  .body { animation: dim 0.3s ease-in {{ duration_s - cta.duration_s }}s forwards; }
  @keyframes dim { to { opacity: 0.05; } }

  /* 4-corner "ABONE OL!" badges — meme-style begging, looping flash */
  .corner-cta {
    position: absolute;
    background: linear-gradient(135deg, #ff3b3b, #c81e1e);
    color: #fff;
    font-size: 38px;
    font-weight: 900;
    padding: 14px 24px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 12px;
    letter-spacing: 1px;
    box-shadow: 0 6px 0 rgba(0,0,0,.55), 0 0 28px rgba(255,59,59,.5);
    opacity: 0;
    z-index: 45;
    text-shadow: 0 2px 0 rgba(0,0,0,.4);
  }
  .corner-cta .arrow { font-size: 46px; }
  .corner-cta.tl { top: 60px;    left:  60px;  transform: translate(-40px,-40px) rotate(-6deg) scale(.8); }
  .corner-cta.tr { top: 60px;    right: 60px;  transform: translate( 40px,-40px) rotate( 6deg) scale(.8); }
  .corner-cta.bl { bottom: 90px; left:  60px;  transform: translate(-40px, 40px) rotate( 6deg) scale(.8); }
  .corner-cta.br { bottom: 90px; right: 60px;  transform: translate( 40px, 40px) rotate(-6deg) scale(.8); }

  @keyframes corner-tl-in { to { opacity: 1; transform: translate(0,0) rotate(-6deg) scale(1); } }
  @keyframes corner-tr-in { to { opacity: 1; transform: translate(0,0) rotate( 6deg) scale(1); } }
  @keyframes corner-bl-in { to { opacity: 1; transform: translate(0,0) rotate( 6deg) scale(1); } }
  @keyframes corner-br-in { to { opacity: 1; transform: translate(0,0) rotate(-6deg) scale(1); } }

  /* Looping pulse — each corner has different delay so they "chase" */
  @keyframes corner-pulse-tl {
    0%, 70%, 100% { filter: brightness(1); transform: rotate(-6deg) scale(1); }
    35% { filter: brightness(1.4); transform: rotate(-6deg) scale(1.12); }
  }
  @keyframes corner-pulse-tr {
    0%, 70%, 100% { filter: brightness(1); transform: rotate( 6deg) scale(1); }
    35% { filter: brightness(1.4); transform: rotate( 6deg) scale(1.12); }
  }
  @keyframes corner-pulse-bl {
    0%, 70%, 100% { filter: brightness(1); transform: rotate( 6deg) scale(1); }
    35% { filter: brightness(1.4); transform: rotate( 6deg) scale(1.12); }
  }
  @keyframes corner-pulse-br {
    0%, 70%, 100% { filter: brightness(1); transform: rotate(-6deg) scale(1); }
    35% { filter: brightness(1.4); transform: rotate(-6deg) scale(1.12); }
  }

  .corner-cta.tl {
    animation:
      corner-tl-in 0.35s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.10 }}s forwards,
      corner-pulse-tl 1.2s ease-in-out {{ duration_s - cta.duration_s + 0.45 }}s infinite;
  }
  .corner-cta.tr {
    animation:
      corner-tr-in 0.35s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.20 }}s forwards,
      corner-pulse-tr 1.2s ease-in-out {{ duration_s - cta.duration_s + 0.75 }}s infinite;
  }
  .corner-cta.bl {
    animation:
      corner-bl-in 0.35s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.30 }}s forwards,
      corner-pulse-bl 1.2s ease-in-out {{ duration_s - cta.duration_s + 1.05 }}s infinite;
  }
  .corner-cta.br {
    animation:
      corner-br-in 0.35s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.40 }}s forwards,
      corner-pulse-br 1.2s ease-in-out {{ duration_s - cta.duration_s + 1.35 }}s infinite;
  }
  {% endif %}
</style>
</head>
<body>
<div class="stage">
  <div class="stage-badge">SON DAKİKA</div>
  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img"></div>
    <div class="vignette"></div>
    <div class="corner">{{ script.category }}</div>
    <div class="yellow">{{ script.photo_overlay }}</div>
  </div>

  <div class="body">{{ body_html|safe }}</div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>

  {% if cta.enabled %}
  <div class="preflash"></div>
  <div class="cta">
    <div class="corner-cta tl"><span class="arrow">↘</span><span>ABONE OL!</span></div>
    <div class="corner-cta tr"><span>ABONE OL!</span><span class="arrow">↙</span></div>
    <div class="corner-cta bl"><span class="arrow">↗</span><span>ABONE OL!</span></div>
    <div class="corner-cta br"><span>ABONE OL!</span><span class="arrow">↖</span></div>
    {% if cta.show_handle %}<div class="handle-line">{{ handle }}</div>{% endif %}
    <div class="sub-btn">
      <span class="bell">🔔</span>
      <span>ABONE OL</span>
    </div>
    <div class="pointer">👆</div>
    <div class="icons-row">
      {% set icon_labels = ["BEĞEN", "ABONE", "PAYLAŞ"] %}
      {% for icon in cta.icons %}
      <div class="icon-item">
        <span class="ic">{{ icon }}</span>
        <span class="lbl">{{ icon_labels[loop.index0] if loop.index0 < icon_labels|length else "" }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</div>
</body>
</html>
