<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Flaş · Yorum</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&family=Barlow:wght@500;600;700&display=swap');

  {{ dna_css|safe }}

  /* FLAŞ · YORUM — flas.html.j2'nin seslendirmeli ikizi (voiced.py arketip kademesi:
     <template>-narrator). Kart kimliği aynen durur; beyaz KJ satırı konuşulan beat'in
     on_screen kartına göre değişir (stadium-narrator deseni), karaoke YOK. İlerleme
     çubuğu ve şerit animasyonları sesin gerçek süresine (narration.duration_s) bağlı. */
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Barlow'), 'Segoe UI', Arial, sans-serif;
    background: var(--body-bg-1, #141414);
    color: var(--text-main, #fff);
  }
  .stage {
    position: relative; width: 1080px; height: 1920px; overflow: hidden;
    background: linear-gradient(180deg, var(--body-bg-1, #141414) 0%, var(--body-bg-2, #0e0e0e) 100%);
  }

  /* Üst: kırmızı logo bandı (gazete) + CANLI (TV) */
  .topbar {
    position: absolute; top: 0; left: 0; right: 0; height: 120px; z-index: 6;
    background: var(--primary, #d0021b);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 48px;
  }
  .topbar .logo {
    display: flex; align-items: center; gap: 18px;
    font-family: var(--font-headline, 'Oswald'), 'Arial Narrow', sans-serif;
    font-weight: 700; font-size: 64px; line-height: 1; letter-spacing: 0.02em;
    text-transform: uppercase; color: #fff;
  }
  .topbar .logo .tag {
    padding: 6px 14px; background: #fff; color: var(--primary, #d0021b);
    font-size: 26px; letter-spacing: 0.1em;
  }
  .topbar .live {
    display: flex; align-items: center; gap: 14px;
    font-family: var(--font-headline, 'Oswald'), 'Arial Narrow', sans-serif;
    font-weight: 600; font-size: 34px; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .topbar .live::before {
    content: ''; width: 14px; height: 14px; border-radius: 50%; background: #fff;
    animation: blink 1.4s infinite;
  }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.25} }

  /* Sarı FLAŞ şeridi — sola akar */
  .flash {
    position: absolute; top: 120px; left: 0; right: 0; height: 64px; z-index: 6;
    background: var(--accent, #ffe600); color: #111;
    display: flex; align-items: center; overflow: hidden; white-space: nowrap;
    font-family: var(--font-headline, 'Oswald'), 'Arial Narrow', sans-serif;
    font-weight: 700; font-size: 36px; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .flash .strip { display: inline-flex; gap: 0; animation: marquee {{ duration_s * 4 }}s linear infinite; }
  .flash .strip span { padding: 0 28px; }
  .flash .strip span::after { content: '·'; margin-left: 56px; }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* Fotoğraf: tam genişlik, alta eriyen */
  .photo {
    position: absolute; top: 184px; left: 0; right: 0; height: 760px; z-index: 1;
    background: linear-gradient(160deg, var(--bg-grad-1, #3a3a3a), var(--bg-grad-2, #141414));
    overflow: hidden;
  }
  .photo .bg-img { position: absolute; inset: 0; background-size: cover; background-position: center; }
  .photo::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(20,20,20,0) 42%, var(--body-bg-1, #141414) 100%);
  }
  .cat-chip {
    position: absolute; left: 48px; top: 212px; z-index: 5;
    display: flex; align-items: stretch;
    font-family: var(--font-headline, 'Oswald'), 'Arial Narrow', sans-serif;
    font-weight: 700; font-size: 28px; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .cat-chip .cat { padding: 8px 16px; background: var(--primary, #d0021b); color: #fff; }
  .cat-chip .lang { padding: 8px 16px; background: rgba(0,0,0,0.6); color: #fff; }

  /* Manşet: fotoğrafın alt kenarına biner */
  .header {
    position: absolute; top: 640px; left: 48px; right: 48px; z-index: 4;
    display: flex; flex-direction: column; align-items: flex-start; gap: 0;
  }
  .header .top {
    display: block;
    font-family: var(--font-headline, 'Oswald'), 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: var(--size-headline-top, 168px);
    line-height: 0.92; letter-spacing: 0.005em; text-transform: uppercase;
    color: #fff; text-shadow: 0 4px 24px rgba(0,0,0,0.7);
    text-wrap: balance;
  }
  .header .bot {
    display: inline-block; margin-top: 6px;
    padding: 6px 22px 10px;
    background: var(--primary, #d0021b); color: #fff;
    font-family: var(--font-headline, 'Oswald'), 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: var(--size-headline-bot, 84px);
    line-height: 1.02; letter-spacing: 0.01em; text-transform: uppercase;
    text-wrap: balance;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
  }
  /* Beyaz KJ alt satırı (TV) — photo_overlay buraya; sınıf adı overflow sözleşmesi için .yellow */
  .header .kj { position: relative; align-self: stretch; margin-top: 22px; min-height: 74px; }
  .header .yellow {
    display: block; position: absolute; left: 0; right: 0; top: 0; opacity: 0;
    transition: opacity 0.25s ease;
    padding: 14px 24px;
    background: #fff; color: #111;
    font-family: var(--font-headline, 'Oswald'), 'Arial Narrow', sans-serif;
    font-weight: 600; font-size: 42px; line-height: 1.1; letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .header .yellow.on { opacity: 1; }

  /* Gövde */
  .body {
    position: absolute; left: 48px; right: 48px;
    top: 1070px; bottom: 200px; z-index: 4;
    overflow: hidden;
  }
  .body-text {
    font-family: var(--font-body, 'Barlow'), 'Segoe UI', Arial, sans-serif;
    font-size: 40px; line-height: 1.38; font-weight: 500;
    color: var(--text-main, #ececec);
    text-wrap: pretty;
    /* Güvenlik ağı: auto-fit min'e inse bile ticker'a taşmasın (bkz. NFL v0.8.4 dersi). */
    display: -webkit-box;
    -webkit-line-clamp: 8;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 96%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 0%, #000 96%, transparent 100%);
  }
  /* Vurgular: DNA highlight_style'ı (bg-flat vb.) EZİLİR — arketipin TV dili
     sabit: sarı yazı + kırmızı alt çizgi / kırmızı zemin + beyaz yazı. Seçici
     DNA'nın ".body .hl-*" kuralından daha özgül tutuldu. */
  .stage .body .body-text .hl-y {
    background: none; color: var(--accent, #ffe600); font-weight: 700;
    padding: 0; border-radius: 0; text-decoration: none; text-shadow: none;
    border-bottom: 6px solid var(--primary, #d0021b);
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
  }
  .stage .body .body-text .hl-r {
    background: var(--primary, #d0021b); color: #fff; font-weight: 700;
    padding: 0 10px; border-radius: 0; text-decoration: none; text-shadow: none;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
  }

  /* SIRADA ticker: koşudaki diğer trendler */
  .ticker {
    position: absolute; left: 0; right: 0; bottom: 104px; height: 64px; z-index: 6;
    display: flex; align-items: stretch; background: #fff; color: #111; overflow: hidden;
  }
  .ticker .label {
    position: relative; z-index: 2;
    flex: none; display: flex; align-items: center; padding: 0 24px;
    background: var(--primary, #d0021b); color: #fff;
    font-family: var(--font-headline, 'Oswald'), 'Arial Narrow', sans-serif;
    font-weight: 700; font-size: 30px; letter-spacing: 0.1em; text-transform: uppercase;
  }
  .ticker .rail { flex: 1; overflow: hidden; display: flex; align-items: stretch; }
  .ticker .strip {
    display: flex; align-items: center; white-space: nowrap;
    font-weight: 600; font-size: 28px; text-transform: uppercase;
    animation: marquee {{ duration_s * 3 }}s linear infinite;
  }
  .ticker .strip span { padding: 0 24px; }
  .ticker .strip span + span::before {
    content: '●'; color: var(--primary, #d0021b); margin-right: 48px; font-size: 20px;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px; height: 6px; z-index: 6;
    background: rgba(255,255,255,0.12);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: var(--progress, 0%);
    background: var(--accent, #ffe600);
  }
  .handle {
    position: absolute; left: 48px; bottom: 30px; z-index: 6;
    font-family: var(--font-headline, 'Oswald'), 'Arial Narrow', sans-serif;
    font-size: 26px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-muted, #9a9a9a);
  }
  .source-credit {
    position: absolute; right: 48px; bottom: 30px; z-index: 6;
    font-size: 22px; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--text-muted, #9a9a9a); white-space: nowrap;
  }
</style>
</head>
<body>
{% set ticker_label = {'tr': 'Sırada', 'en': 'Next', 'de': 'Weiter', 'es': 'Sigue', 'fr': 'Ensuite', 'ja': '次'}.get(language, 'Next') %}
{% set live_label = {'tr': 'Canlı', 'en': 'Live', 'de': 'Live', 'es': 'En vivo', 'fr': 'En direct', 'ja': 'ライブ'}.get(language, 'Live') %}
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="topbar">
    <div class="logo"><span>{{ handle|replace('@', '') }}</span><span class="tag">{{ language|upper }}</span></div>
    <div class="live">{{ live_label }}</div>
  </div>

  <div class="flash"><div class="strip">
    {% for _ in range(8) %}<span>{{ ui_breaking }}</span>{% endfor %}
  </div></div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
  </div>
  {% if script.category %}
  <div class="cat-chip"><span class="cat">{{ script.category }}</span></div>
  {% endif %}

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
    {# Beyaz KJ satırı = o an konuşulan beat'in ekran kartı. 40 sn boyunca hiç
       değişmeyen bir ekran durgun kalırdı; ilk beat başlayana dek photo_overlay. #}
    <div class="kj">
      <span class="yellow card on" data-s="0" data-e="{{ narration.beats[0].start_s if narration.beats else narration.duration_s }}">{{ script.photo_overlay }}</span>
      {% for b in narration.beats %}
      <span class="yellow card" data-s="{{ b.start_s }}" data-e="{{ b.end_s }}">{{ b.on_screen }}</span>
      {% endfor %}
    </div>
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="28" data-fit-max="40" data-fit-pad="16">
      {{ body_html|safe }}
    </div>
  </div>

  {% if ticker_items %}
  <div class="ticker">
    <div class="label">{{ ticker_label }}</div>
    <div class="rail"><div class="strip">
      {% for t in ticker_items %}<span>{{ t }}</span>{% endfor %}
      {% for t in ticker_items %}<span>{{ t }}</span>{% endfor %}
    </div></div>
  </div>
  {% endif %}

  <div class="progress" id="__progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
<script>
// renderer.py, narration varsa her kare için __seek(t_ms) çağırır. Karaoke yok:
// yalnız beat KJ kartı ve ilerleme çubuğu zamanlanır. Son beat bitince son kart
// kalır (boş KJ satırı görünmesin).
const CARDS = Array.from(document.querySelectorAll('.kj .card'));
const PROGRESS = document.getElementById('__progress');
const DURATION_S = {{ narration.duration_s }};
window.__seek = function (tMs) {
  const t = tMs / 1000;
  let active = null;
  for (const c of CARDS) {
    const s = parseFloat(c.dataset.s), e = parseFloat(c.dataset.e);
    if (t >= s && t < e) active = c;
  }
  if (!active && CARDS.length) active = t >= parseFloat(CARDS[CARDS.length - 1].dataset.s) ? CARDS[CARDS.length - 1] : CARDS[0];
  for (const c of CARDS) c.classList.toggle('on', c === active);
  PROGRESS.style.setProperty('--progress', Math.min(100, (t / DURATION_S) * 100) + '%');
};
window.__seek(0);
</script>
</body>
</html>
