<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Eilmeldung</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fira+Sans+Condensed:wght@600;700&family=Fira+Sans:wght@400;500;600;700&display=swap');

  {{ dna_css|safe }}

  /* EILMELDUNG — Alman haber grameri.
     Kaynaklar: öffentlich-rechtlich ciddiyet (koyu mavi kopfleiste, "Stand:"
     damgası, abartısız tipografi) + özel kanal aciliyeti (kırmızı EILMELDUNG
     bandı) + Alman TV'sinin BAUCHBINDE'si (iki tonlu alt kuşak).

     TÜRK 'flas' ARKETİBİNDEN BİLİNÇLİ FARKLAR:
       * Kırmızı+sarı DEĞİL mavi+kırmızı. Sarı manşet şeridi Türk TV kodudur;
         Alman izleyicide karşılığı yok.
       * Manşet ŞERİDİ akmaz. Alman haber estetiğinde sürekli kayan yazı
         "Boulevard" (tabloid) işaretidir; ciddiyet duruşta.
       * Ticker ayracı '+++' — Alman ajans/teletext geleneği (dpa, n-tv).
       * hyphens:auto ZORUNLU: Almanca bileşik adlar ("Lebensmittelsicherheits-
         behörde") tek satıra sığmaz; tirelemesiz ya kutudan taşar ya da
         otomatik küçültme fontu okunmaz boyuta indirir. Chromium tireleme
         sözlüğünü yalnız lang="de" varken yükler. */
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Fira Sans'), 'Segoe UI', Arial, sans-serif;
    background: var(--body-bg-1, #10141a);
    color: var(--text-main, #fff);
  }
  .stage {
    position: relative; width: 1080px; height: 1920px; overflow: hidden;
    background: linear-gradient(180deg, var(--body-bg-1, #10141a) 0%, var(--body-bg-2, #0a0d12) 100%);
  }

  /* Kopfleiste: kanal + "Stand:" damgası (Alman haberinde tarihsiz kart eksik görünür) */
  .topbar {
    position: absolute; top: 0; left: 0; right: 0; height: 112px; z-index: 6;
    background: var(--primary, #0b3b73);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 48px;
  }
  /* Uzun kanal adı damgayı EZMEMELİ. "DEUTSCHLANDKOMPAKT" 18 karakter ve
     58px'de damgayla çakışıyordu (ilk üretimde görüldü). Ad esner ve gerekirse
     kırpılır; damga sabit kalır — tarih okunmayan bir haber kartı Alman
     izleyicide güven kaybıdır. */
  .topbar .logo {
    display: flex; align-items: center; gap: 14px;
    flex: 1 1 auto; min-width: 0; overflow: hidden; white-space: nowrap;
    font-family: var(--font-headline, 'Fira Sans Condensed'), 'Arial Narrow', sans-serif;
    font-weight: 700; font-size: 50px; line-height: 1; letter-spacing: 0.01em;
    text-transform: uppercase; color: #fff;
  }
  .topbar .logo > span:first-child { overflow: hidden; text-overflow: clip; }
  .topbar .logo .tag {
    flex: none;
    padding: 5px 11px; background: #fff; color: var(--primary, #0b3b73);
    font-size: 22px; letter-spacing: 0.08em;
  }
  .topbar .stand {
    flex: none; margin-left: 22px;
    font-family: var(--font-body, 'Fira Sans'), Arial, sans-serif;
    font-weight: 500; font-size: 25px; letter-spacing: 0.02em;
    color: rgba(255,255,255,0.86); white-space: nowrap;
  }

  /* Kırmızı Eilmeldung bandı — kaymaz, durur */
  .flash {
    position: absolute; top: 112px; left: 0; right: 0; height: 66px; z-index: 6;
    background: var(--accent, #e2001a); color: #fff;
    display: flex; align-items: stretch; overflow: hidden;
  }
  .flash .word {
    display: flex; align-items: center; padding: 0 26px;
    background: #fff; color: var(--accent, #e2001a);
    font-family: var(--font-headline, 'Fira Sans Condensed'), 'Arial Narrow', sans-serif;
    font-weight: 700; font-size: 36px; letter-spacing: 0.1em; text-transform: uppercase;
    white-space: nowrap;
  }
  .flash .pulse { flex: 1; position: relative; }
  .flash .pulse::after {
    content: ''; position: absolute; top: 0; bottom: 0; width: 220px;
    background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.35) 50%, rgba(255,255,255,0) 100%);
    animation: sweep {{ duration_s * 1.6 }}s linear infinite;
  }
  @keyframes sweep { from { left: -220px; } to { left: 100%; } }

  /* Fotoğraf: tam genişlik, alta eriyen */
  .photo {
    position: absolute; top: 178px; left: 0; right: 0; height: 752px; z-index: 1;
    background: linear-gradient(160deg, var(--bg-grad-1, #1d2632), var(--bg-grad-2, #10141a));
    overflow: hidden;
  }
  .photo .bg-img { position: absolute; inset: 0; background-size: cover; background-position: center; }
  .photo::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(16,20,26,0) 44%, var(--body-bg-1, #10141a) 100%);
  }
  .cat-chip {
    position: absolute; left: 48px; top: 206px; z-index: 5;
    display: flex; align-items: stretch;
    font-family: var(--font-headline, 'Fira Sans Condensed'), 'Arial Narrow', sans-serif;
    font-weight: 700; font-size: 27px; letter-spacing: 0.09em; text-transform: uppercase;
  }
  .cat-chip .cat { padding: 8px 16px; background: var(--primary, #0b3b73); color: #fff; }

  /* Manşet */
  .header {
    position: absolute; top: 636px; left: 48px; right: 48px; z-index: 4;
    display: flex; flex-direction: column; align-items: flex-start; gap: 0;
  }
  .header .top {
    display: block;
    font-family: var(--font-headline, 'Fira Sans Condensed'), 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: var(--size-headline-top, 156px);
    line-height: 0.94; letter-spacing: 0.002em;
    color: #fff; text-shadow: 0 4px 24px rgba(0,0,0,0.72);
    text-wrap: balance;
    hyphens: auto; -webkit-hyphens: auto; overflow-wrap: break-word;
  }
  .header .bot {
    display: inline-block; margin-top: 8px;
    padding: 6px 20px 10px;
    background: var(--accent, #e2001a); color: #fff;
    font-family: var(--font-headline, 'Fira Sans Condensed'), 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: var(--size-headline-bot, 80px);
    line-height: 1.04; letter-spacing: 0.005em;
    text-wrap: balance;
    hyphens: auto; -webkit-hyphens: auto; overflow-wrap: break-word;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
  }
  /* BAUCHBINDE (Alman TV alt kuşağı): mavi sol blok + beyaz gövde.
     Sınıf adı .yellow — overflow sözleşmesi böyle ölçüyor; KONUM adı, renk adı değil. */
  .header .yellow {
    display: flex; align-items: stretch; margin-top: 22px; align-self: stretch;
    background: #fff; color: #14171c;
    font-family: var(--font-headline, 'Fira Sans Condensed'), 'Arial Narrow', sans-serif;
    font-weight: 600; font-size: 40px; line-height: 1.14; letter-spacing: 0.005em;
    padding: 13px 22px;
    border-left: 16px solid var(--primary, #0b3b73);
    hyphens: auto; -webkit-hyphens: auto; overflow-wrap: break-word;
  }

  /* Gövde */
  .body {
    position: absolute; left: 48px; right: 48px;
    top: 1066px; bottom: 200px; z-index: 4;
    overflow: hidden;
  }
  .body-text {
    font-family: var(--font-body, 'Fira Sans'), 'Segoe UI', Arial, sans-serif;
    font-size: 40px; line-height: 1.4; font-weight: 400;
    color: var(--text-main, #e8ebef);
    text-wrap: pretty;
    hyphens: auto; -webkit-hyphens: auto; overflow-wrap: break-word;
    /* Güvenlik ağı: otomatik küçültme min'e inse bile ticker'a taşmasın. */
    display: -webkit-box;
    -webkit-line-clamp: 8;
    -webkit-box-orient: vertical;
    overflow: hidden;
    /* ALT SOLMA MASKESİ KALDIRILDI: koşulsuzdu. Ölçüldü (fenerbahce
       #1830, gerçek metin): .body-text scrollHeight = clientHeight = 436,
       yani 9 satırlık sınırda 5 satır — TAŞMA YOK. Maske yine de son %8'i
       siliyordu ve yayınlanan karede son satırın alt yarısı kesik çıkıyordu
       ("...durumu iyi." yarıdan kesikti). Gerçekten taşan metni zaten
       -webkit-line-clamp kesiyor ve kendi üç noktasını koyuyor. */
  }
  /* Vurgular: arketibin dili sabit — mavi altı çizili / kırmızı zemin. */
  .stage .body .body-text .hl-y {
    background: none; color: #fff; font-weight: 700;
    padding: 0; border-radius: 0; text-decoration: none; text-shadow: none;
    border-bottom: 6px solid var(--primary, #0b3b73);
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
  }
  .stage .body .body-text .hl-r {
    background: var(--accent, #e2001a); color: #fff; font-weight: 700;
    padding: 0 10px; border-radius: 0; text-decoration: none; text-shadow: none;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
  }

  /* Ticker: '+++' ayracı Alman ajans/teletext geleneği */
  .ticker {
    position: absolute; left: 0; right: 0; bottom: 104px; height: 62px; z-index: 6;
    display: flex; align-items: stretch; background: #fff; color: #14171c; overflow: hidden;
  }
  .ticker .label {
    position: relative; z-index: 2;
    flex: none; display: flex; align-items: center; padding: 0 22px;
    background: var(--primary, #0b3b73); color: #fff;
    font-family: var(--font-headline, 'Fira Sans Condensed'), 'Arial Narrow', sans-serif;
    font-weight: 700; font-size: 29px; letter-spacing: 0.09em; text-transform: uppercase;
  }
  .ticker .rail { flex: 1; overflow: hidden; display: flex; align-items: stretch; }
  .ticker .strip {
    display: flex; align-items: center; white-space: nowrap;
    font-weight: 500; font-size: 28px;
    animation: marquee {{ duration_s * 3 }}s linear infinite;
  }
  .ticker .strip span { padding: 0 20px; }
  .ticker .strip span + span::before {
    content: '+++'; color: var(--accent, #e2001a); margin-right: 34px;
    font-weight: 700; letter-spacing: 0.06em;
  }
  @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px; height: 6px; z-index: 6;
    background: rgba(255,255,255,0.12);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--accent, #e2001a);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }
  .handle {
    position: absolute; left: 48px; bottom: 30px; z-index: 6;
    font-family: var(--font-headline, 'Fira Sans Condensed'), 'Arial Narrow', sans-serif;
    font-size: 26px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--text-muted, #97a1ad);
  }
  .source-credit {
    position: absolute; right: 48px; bottom: 30px; z-index: 6;
    font-size: 22px; letter-spacing: 0.04em;
    color: var(--text-muted, #97a1ad); white-space: nowrap;
  }
</style>
</head>
<body>
{% set ticker_label = {'de': 'Weiter', 'tr': 'Sırada', 'en': 'Next'}.get(language, 'Weiter') %}
{% set stand_label = {'de': 'Stand', 'tr': 'Durum', 'en': 'As of'}.get(language, 'Stand') %}
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="topbar">
    <div class="logo"><span>{{ handle|replace('@', '') }}</span><span class="tag">{{ language|upper }}</span></div>
    {# Alman haber damgası: 20.08.2026, 14:32 Uhr #}
    <div class="stand">{{ stand_label }}: {{ now.strftime('%d.%m.%Y') }}, {{ now.strftime('%H:%M') }}{% if language == 'de' %} Uhr{% endif %}</div>
  </div>

  <div class="flash">
    <div class="word">{{ ui_breaking }}</div>
    <div class="pulse"></div>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
  </div>
  {% if script.category %}
  <div class="cat-chip"><span class="cat">{{ script.category }}</span></div>
  {% endif %}

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
    {% if script.photo_overlay %}<span class="yellow">{{ script.photo_overlay }}</span>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="28" data-fit-max="40" data-fit-pad="16">
      {{ body_html|safe }}
    </div>
  </div>

  {% if ticker_items %}
  <div class="ticker">
    <div class="label">{{ ticker_label }}</div>
    <div class="rail"><div class="strip">
      {% for t in ticker_items %}<span>{{ t }}</span>{% endfor %}
      {% for t in ticker_items %}<span>{{ t }}</span>{% endfor %}
    </div></div>
  </div>
  {% endif %}

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

<script>
// MANŞET ESNEK, GÖVDE SABİTTİ: manşet iki satıra çıkınca Bauchbinde gövdenin
// üstüne biniyordu. Almanca bileşik adlar ("CDU-BÜRGERMEISTER SPENDET AN AfD")
// sarmayı Türkçeden çok daha sık tetikliyor, o yüzden burada ölçüp gövdeyi
// manşetin ALTINA taşıyoruz. Otomatik küçültmeden ÖNCE çalışmalı: kutu
// küçüldükten sonra ölçülen yazı boyutu yanlış olur.
(function () {
  var header = document.querySelector('.header');
  var body = document.querySelector('.body');
  if (!header || !body) return;
  var alt = Math.round(header.getBoundingClientRect().bottom) + 26;
  var taban = parseInt(getComputedStyle(body).top, 10) || 1066;
  if (alt > taban) body.style.top = alt + 'px';
})();
</script>
{% include "_auto_fit.js.j2" %}
</body>
</html>
