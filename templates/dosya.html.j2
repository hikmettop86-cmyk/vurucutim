<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short Ã¢â‚¬â€ Dosya</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@400;700;900&family=Lora:wght@400;500;700&family=Courier+Prime:wght@400;700&display=swap');
* { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --primary: #a52a2a;
  --accent: #1a1a1a;
  --bg-grad-1: #f4ecd8;
  --bg-grad-2: #e8dec0;
  --body-bg-1: #f4ecd8;
  --body-bg-2: #ddd0a8;
  --text-main: #1a1a1a;
  --text-muted: #5a4a30;
  --font-headline: 'Source Serif 4', serif;
  --font-body: 'Lora', serif;
  --font-mono: 'Courier Prime', monospace;
}
html, body {
  width: 1080px; height: 1920px; overflow: hidden;
  background: linear-gradient(180deg, var(--bg-grad-1), var(--bg-grad-2));
  font-family: var(--font-body);
  color: var(--text-main);
}
.stage {
  position: relative;
  width: 1080px; height: 1920px;
  display: flex; flex-direction: column;
  box-shadow: inset 0 0 0 4px var(--accent);
}

/* STAGE BADGE Ã¢â‚¬â€ rounded chip, rust-red on sepia, top-right */
.stage-badge {
  position: absolute; top: 24px; right: 24px;
  background: var(--primary); color: var(--bg-grad-1);
  font-family: var(--font-headline);
  font-size: 20px; font-weight: 700; letter-spacing: 1px;
  padding: 5px 14px; border-radius: 6px;
  z-index: 10;
}

/* HEADER */
.header { padding: 80px 60px 30px; text-align: left; }
.header .top {
  display: block;
  font-size: 48px;
  color: var(--primary);
  font-family: var(--font-headline);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 14px;
}
.header .bot {
  display: block;
  font-size: 80px;
  color: var(--accent);
  font-family: var(--font-headline);
  font-weight: 900;
  line-height: 1.1;
}

/* PHOTO Ã¢â‚¬â€ sepia desaturated, thin black border */
.photo {
  margin: 24px 60px;
  height: 540px;
  position: relative;
  background: linear-gradient(135deg, #c8b890, #b8a878);
  overflow: hidden;
  border: 2px solid var(--accent);
}
.photo .bg-img {
  position: absolute; inset: 0;
  background-image: url('{{ bg_image_url|default("") }}');
  background-size: cover; background-position: center;
  {% if not bg_image_url %}display: none;{% endif %}
  filter: sepia(0.6) contrast(1.1) brightness(0.95);
}

/* DOSSIER STAMP Ã¢â‚¬â€ slanted red stamp top-right of photo */
.photo .dossier-stamp {
  position: absolute;
  top: 18px; right: 18px;
  transform: rotate(-10deg);
  background: rgba(165,42,42,0.9);
  color: #fff;
  font-family: var(--font-headline);
  font-size: 36px;
  font-weight: 900;
  padding: 8px 18px;
  border: 3px solid var(--primary);
  letter-spacing: 3px;
  z-index: 5;
}

/* BODY Ã¢â‚¬â€ Lora serif, dark ink on sepia */
.body {
  flex: 1; min-height: 0; margin-bottom: 240px;
  padding: 30px 60px;
  font-size: 38px;
  line-height: 1.55;
  font-family: var(--font-body);
  font-weight: 400;
  color: var(--accent);
  display: -webkit-box;
  -webkit-line-clamp: 8;
  -webkit-box-orient: vertical;
  overflow: hidden;
  -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 86%, transparent 100%);
          mask-image: linear-gradient(180deg, #000 0%, #000 86%, transparent 100%);
}
.body .hl-r { background: var(--primary); color: #fff; padding: 2px 14px; border-radius: 0; font-weight: 700; }
.body .hl-y { color: var(--primary); text-decoration: underline; text-decoration-thickness: 4px; font-weight: 700; }

/* PROGRESS bar Ã¢â‚¬â€ dark track for sepia bg */
.progress {
  position: absolute; left: 0; right: 0; bottom: 84px; height: 8px;
  background: rgba(0,0,0,.2);
}
.progress::after {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, var(--primary), var(--accent));
  animation: fill {{ duration_s }}s linear forwards;
}
@keyframes fill { from { width: 0; } to { width: 100%; } }

/* HANDLE Ã¢â‚¬â€ dark text for visibility on sepia bg */
.handle {
  position: absolute; left: 0; right: 0; bottom: 30px;
  text-align: center; color: var(--text-main); opacity: 0.7;
  font-size: 34px; font-weight: 600;
  font-family: var(--font-body);
}

/* CTA overlay (last cta_duration_s seconds) */
{% if cta.enabled %}
/* Pre-flash: full-screen white flash 150ms before CTA */
.preflash {
  position: absolute; inset: 0;
  background: #fff;
  opacity: 0;
  pointer-events: none;
  z-index: 50;
  animation: flash 0.18s ease-out {{ duration_s - cta.duration_s - 0.15 }}s forwards;
}
@keyframes flash {
  0% { opacity: 0; }
  40% { opacity: 0.9; }
  100% { opacity: 0; }
}

/* CTA wrapper */
.cta {
  position: absolute; left: 0; right: 0; bottom: 0; top: 0;
  background: radial-gradient(ellipse at center, rgba(20,20,20,.92), rgba(0,0,0,.98));
  padding: 0 60px;
  text-align: center;
  opacity: 0;
  pointer-events: none;
  z-index: 40;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation:
    cta-fade-in 0.25s ease-out {{ duration_s - cta.duration_s }}s forwards;
}
@keyframes cta-fade-in {
  to { opacity: 1; }
}

{% if cta.show_handle %}
.cta .handle-line {
  font-size: 64px; font-weight: 900;
  color: var(--primary);
  letter-spacing: 1px;
  margin-bottom: 50px;
  text-shadow:
    0 0 18px rgba(165,42,42,.7),
    0 0 36px rgba(165,42,42,.4);
  opacity: 0; transform: translateY(-30px);
  animation: handle-drop 0.45s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.05 }}s forwards;
}
@keyframes handle-drop {
  to { opacity: 1; transform: translateY(0); }
}
{% endif %}

/* Big YouTube-style SUBSCRIBE button */
.cta .sub-btn {
  background: linear-gradient(180deg, #ff2d2d, #c81e1e);
  color: #fff;
  font-size: 88px; font-weight: 900;
  padding: 40px 70px;
  border-radius: 100px;
  box-shadow:
    0 12px 0 rgba(0,0,0,.5),
    0 20px 60px rgba(255,45,45,.6);
  display: inline-flex;
  align-items: center;
  gap: 28px;
  letter-spacing: 1px;
  margin-bottom: 60px;
  transform: scale(0);
  animation:
    sub-pop 0.5s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.15 }}s forwards,
    sub-press 0.4s ease-in-out {{ duration_s - cta.duration_s + 0.55 }}s;
}
@keyframes sub-pop {
  to { transform: scale(1); }
}
@keyframes sub-press {
  0%, 100% { transform: scale(1); box-shadow: 0 12px 0 rgba(0,0,0,.5), 0 20px 60px rgba(255,45,45,.6); }
  50% { transform: scale(0.92); box-shadow: 0 4px 0 rgba(0,0,0,.5), 0 8px 30px rgba(255,45,45,.6); }
}
.cta .sub-btn .bell { font-size: 96px; }

/* Pointer hand below button Ã¢â‚¬â€ bouncing */
.cta .pointer {
  font-size: 100px;
  margin-bottom: 50px;
  opacity: 0;
  animation:
    pointer-in 0.3s ease-out {{ duration_s - cta.duration_s + 0.7 }}s forwards,
    bounce 0.6s ease-in-out {{ duration_s - cta.duration_s + 1.0 }}s infinite;
}
@keyframes pointer-in {
  from { opacity: 0; transform: translateY(-20px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15px); }
}

/* Three icons row at bottom Ã¢â‚¬â€ stagger pop-in */
.cta .icons-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 50px;
  margin-top: 30px;
}
.cta .icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  transform: scale(0);
  opacity: 0;
}
.cta .icon-item .ic { font-size: 110px; }
.cta .icon-item .lbl { font-size: 36px; font-weight: 800; color: #fff; letter-spacing: 1px; }
.cta .icon-item:nth-child(1) {
  animation: icon-pop 0.4s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.25 }}s forwards;
}
.cta .icon-item:nth-child(2) {
  animation: icon-pop 0.4s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.4 }}s forwards;
}
.cta .icon-item:nth-child(3) {
  animation: icon-pop 0.4s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.55 }}s forwards;
}
@keyframes icon-pop {
  to { opacity: 1; transform: scale(1); }
}

/* Body dim during CTA so it stays focused */
.body { animation: dim 0.3s ease-in {{ duration_s - cta.duration_s }}s forwards; }
@keyframes dim { to { opacity: 0.05; } }
{% endif %}

/* Persistent corner chips Ã¢â‚¬â€ visible THROUGHOUT video (YouTube-red works on sepia) */
.persistent {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 900;
  font-size: 36px;
  letter-spacing: 1px;
  padding: 14px 22px;
  border-radius: 12px;
  color: #fff;
  box-shadow: 0 5px 0 rgba(0,0,0,.5), 0 0 20px rgba(0,0,0,.3);
  z-index: 35;
  text-shadow: 0 2px 0 rgba(0,0,0,.4);
}
.persistent .ic { font-size: 44px; }

/* BEÃ„ÂEN Ã¢â‚¬â€ bottom-left, dark chip with red accent */
.persistent.like {
  bottom: 112px; left: 24px;
  background: linear-gradient(135deg, rgba(0,0,0,.88), rgba(40,0,0,.92));
  border: 3px solid #ff3b3b;
  animation: like-beat 1.5s ease-in-out infinite;
}
@keyframes like-beat {
  0%, 100% { transform: scale(1); }
  20% { transform: scale(1.12); }
  40% { transform: scale(0.98); }
  60% { transform: scale(1.08); }
}

/* ABONE OL Ã¢â‚¬â€ bottom-right, red gradient chip */
.persistent.sub {
  bottom: 112px; right: 24px;
  background: linear-gradient(135deg, #ff2d2d, #c81e1e);
  border: 3px solid #ffea3b;
  animation: sub-glow 1.5s ease-in-out infinite;
}
@keyframes sub-glow {
  0%, 100% { transform: scale(1); box-shadow: 0 5px 0 rgba(0,0,0,.5), 0 0 20px rgba(255,45,45,.4); }
  50% { transform: scale(1.08); box-shadow: 0 5px 0 rgba(0,0,0,.5), 0 0 36px rgba(255,234,59,.7); }
}

/* Hide persistent chips during the final CTA fullscreen overlay */
{% if cta.enabled %}
.persistent {
  animation-fill-mode: both;
}
.persistent.like { animation: like-beat 1.5s ease-in-out infinite, fade-out 0.3s ease-in {{ duration_s - cta.duration_s }}s forwards; }
.persistent.sub  { animation: sub-glow  1.5s ease-in-out infinite, fade-out 0.3s ease-in {{ duration_s - cta.duration_s }}s forwards; }
@keyframes fade-out { to { opacity: 0; } }
{% endif %}
  /* SOURCE CREDIT */
  .source-credit {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.6);
    color: rgba(255, 255, 255, 0.85);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.5px;
    padding: 3px 10px;
    border-radius: 3px;
    z-index: 50;
    white-space: nowrap;
    font-family: inherit;
  }

  /* DNA OVERRIDE Ã¢â‚¬â€ runtime palette/font from channel DNA */
  {{ dna_css|safe }}
</style>
</head>
<body>
<div class="stage">
  <div class="stage-badge">{{ ui_breaking }}</div>
  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img"></div>
    <div class="dossier-stamp">{{ script.photo_overlay }}</div>
  </div>

  <div class="body">{{ body_html|safe }}</div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>

  <!-- Persistent corner chips (visible throughout video, fade out only when end CTA opens) -->
  {% if cta.enabled %}
  <div class="persistent like"><span class="ic">Ã¢ÂÂ¤Ã¯Â¸Â</span><span>{{ ui_like }}</span></div>
  <div class="persistent sub"><span class="ic">ÄŸÅ¸â€â€</span><span>{{ ui_subscribe }}</span></div>
  {% endif %}

  {% if cta.enabled %}
  <div class="preflash"></div>
  <div class="cta">
    {% if cta.show_handle %}<div class="handle-line">{{ handle }}</div>{% endif %}
    <div class="sub-btn">
      <span class="bell">ÄŸÅ¸â€â€</span>
      <span>{{ ui_subscribe }}</span>
    </div>
    <div class="pointer">ÄŸÅ¸â€˜â€ </div>
    <div class="icons-row">
      {% set icon_labels = [ui_like, ui_subscribe, ui_share] %}
      {% for icon in cta.icons %}
      <div class="icon-item">
        <span class="ic">{{ icon }}</span>
        <span class="lbl">{{ icon_labels[loop.index0] if loop.index0 < icon_labels|length else "" }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}
</div>
</body>
</html>
