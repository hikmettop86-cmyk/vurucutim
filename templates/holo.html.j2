<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Holo</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Anton&family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@500;600;700&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #050208);
    color: var(--text-main, #fff);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background:
      conic-gradient(from 220deg at 30% 30%,
        color-mix(in srgb, var(--primary, #ff00aa) 50%, transparent),
        color-mix(in srgb, var(--accent, #00f0ff) 50%, transparent),
        color-mix(in srgb, var(--primary, #ff00aa) 40%, transparent),
        var(--body-bg-2, #1a0220)),
      var(--body-bg-1, #050208);
    overflow: hidden;
  }
  /* Holografik tarama */
  .stage::before {
    content: ''; position: absolute; inset: 0;
    background:
      repeating-linear-gradient(0deg, rgba(255,255,255,0.04) 0 1px, transparent 1px 4px);
    pointer-events: none;
  }
  /* Soft blob */
  .stage::after {
    content: ''; position: absolute; inset: 0;
    background:
      radial-gradient(40% 25% at 70% 70%, color-mix(in srgb, var(--accent, #00f0ff) 30%, transparent), transparent);
    filter: blur(40px);
    pointer-events: none;
  }

  /* Kategori chip + handle telemetri */
  .top-bar {
    position: absolute; top: 60px; left: 60px; right: 60px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 5;
  }
  .stage-badge {
    background: rgba(255,255,255,0.08);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255,255,255,0.18);
    color: #fff;
    padding: 12px 24px; border-radius: 999px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 22px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  .breaking-mini {
    display: flex; align-items: center; gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 20px; font-weight: 700;
    color: var(--primary, #ff00aa);
    letter-spacing: 0.15em;
  }
  .breaking-mini::before {
    content: ''; width: 10px; height: 10px;
    background: var(--primary, #ff00aa);
    box-shadow: 0 0 14px var(--primary, #ff00aa);
    animation: pulse 1.4s infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1}50%{opacity:0.35} }

  /* Manşet — chrome efektli, ortalı */
  .header {
    position: absolute; top: 200px; left: 60px; right: 60px;
    text-align: center;
    z-index: 4;
  }
  .header .top {
    display: block;
    font-family: var(--font-headline, 'Anton'), sans-serif;
    font-size: var(--size-headline-top, 220px);
    line-height: 0.86; font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    background: linear-gradient(180deg, #fff 0%, color-mix(in srgb, var(--accent, #00f0ff) 50%, white) 50%, #cdd 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 4px 30px color-mix(in srgb, var(--accent, #00f0ff) 50%, transparent);
    text-wrap: balance;
  }
  .header .bot {
    display: block;
    margin-top: 12px;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: var(--size-headline-bot, 50px);
    font-weight: 600;
    color: rgba(255,255,255,0.92);
    letter-spacing: 0.005em;
    text-wrap: balance;
  }

  /* Foto kartı — split lozenge */
  .photo {
    position: absolute;
    top: 800px; left: 60px; right: 60px;
    height: 600px;
    background: linear-gradient(135deg, var(--bg-grad-1, #2a0a4a) 0%, var(--bg-grad-2, #0a0118) 100%);
    overflow: hidden;
    clip-path: polygon(0 8%, 100% 0%, 100% 92%, 0% 100%);
    border: 1.5px solid color-mix(in srgb, var(--accent, #00f0ff) 60%, transparent);
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    filter: saturate(1.2) contrast(1.1);
  }
  .photo::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--primary, #ff00aa) 18%, transparent),
      color-mix(in srgb, var(--accent, #00f0ff) 18%, transparent));
    mix-blend-mode: color-dodge;
    pointer-events: none;
  }
  .photo .yellow {
    position: absolute; left: 32px; bottom: 64px;
    background: var(--accent, #00f0ff);
    color: #000;
    padding: 12px 24px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 30px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    box-shadow: 6px 6px 0 var(--primary, #ff00aa);
    z-index: 2;
  }

  /* Gövde — alt kart */
  .body {
    position: absolute; left: 60px; right: 60px;
    top: 1450px; bottom: 180px;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(24px);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 24px;
    padding: 32px 36px;
    display: flex; align-items: center;
  }
  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 38px; line-height: 1.4; font-weight: 500;
    color: var(--text-main, #fff);
    text-wrap: pretty;
  }
  .body-text .hl-y {
    background: var(--accent, #00f0ff); color: #000;
    padding: 0 12px; border-radius: 4px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 700;
  }
  .body-text .hl-r {
    background: var(--primary, #ff00aa); color: #fff;
    padding: 0 12px; border-radius: 4px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 700;
    box-shadow: 0 0 22px color-mix(in srgb, var(--primary, #ff00aa) 60%, transparent);
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 4px; background: rgba(255,255,255,0.08);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: linear-gradient(90deg, var(--primary, #ff00aa), var(--accent, #00f0ff));
    box-shadow: 0 0 12px var(--accent, #00f0ff);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: 'JetBrains Mono', monospace;
    font-size: 28px; font-weight: 600;
    color: rgba(255,255,255,0.85);
    letter-spacing: 0.1em;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="top-bar">
    {% if script.category %}<div class="stage-badge">{{ script.category }}</div>{% endif %}
    <div class="breaking-mini">{{ ui_breaking }}</div>
  </div>

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="28" data-fit-max="38" data-fit-pad="20">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
