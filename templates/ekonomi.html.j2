<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Ekonomi</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&family=JetBrains+Mono:wght@400;700&display=swap');
{{ dna_css|safe }}
* { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --primary: #0a1f2e;
  --accent: #00c853;
  --secondary: #d50000;
  --gold: #ffd700;
  --bg-grad-1: #0f2238;
  --bg-grad-2: #050d18;
  --body-bg-1: #0f2238;
  --body-bg-2: #050d18;
  --text-main: #ffffff;
  --text-muted: #00c853;
  --font-headline: 'Inter', sans-serif;
  --font-body: 'Inter', sans-serif;
  --font-numerals: 'JetBrains Mono', monospace;
}
html, body {
  width: 1080px; height: 1920px; overflow: hidden;
  background: linear-gradient(180deg, var(--bg-grad-1), var(--bg-grad-2));
  font-family: var(--font-body); color: var(--text-main);
}
.stage {
  position: relative; width: 1080px; height: 1920px;
  display: flex; flex-direction: column;
}

/* TICKER BAR — decorative market data strip above everything */
.ticker {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 38px;
  background: rgba(0,0,0,0.6);
  display: flex;
  align-items: center;
  padding: 0 16px;
  font-family: var(--font-numerals);
  font-size: 18px;
  color: var(--accent);
  letter-spacing: 1px;
  z-index: 11;
  gap: 18px;
  border-bottom: 1px solid rgba(0,200,83,0.3);
}
.ticker .down { color: var(--secondary); }

/* STAGE BADGE — sharp-corner, offset down to clear ticker */
.stage-badge {
  position: absolute;
  top: 50px; right: 24px;
  background: var(--accent); color: var(--primary);
  font-size: 20px; font-weight: 700; letter-spacing: 1px;
  padding: 5px 12px;
  border-radius: 0;
  z-index: 10;
}

/* HEADER */
.header {
  padding: 78px 60px 38px;
  text-align: left;
}
.header .top {
  display: block;
  font-family: var(--font-numerals);
  font-size: 60px;
  color: var(--accent);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2px;
  margin-bottom: 14px;
}
.header .bot {
  display: block;
  font-size: 90px;
  font-weight: 900;
  color: var(--text-main);
  line-height: 1.02;
  font-family: var(--font-headline);
}

/* PHOTO */
.photo {
  position: relative;
  height: 580px;
  background: linear-gradient(135deg, var(--bg-grad-1), var(--bg-grad-2));
  overflow: hidden;
}
.photo .bg-img {
  position: absolute; inset: 0;
  background-image: url('{{ bg_image_url|default("") }}');
  background-size: cover; background-position: center;
  {% if not bg_image_url %}display: none;{% endif %}
}
.photo .vignette {
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at center, transparent 30%, rgba(0,0,0,.55) 100%);
}

/* Large numeric callout — bottom-center of photo */
.photo .ticker-num {
  position: absolute;
  bottom: 24px; left: 0; right: 0;
  text-align: center;
  font-family: var(--font-numerals);
  font-size: 88px;
  font-weight: 700;
  color: var(--gold);
  background: rgba(0,0,0,0.78);
  padding: 18px 30px;
  line-height: 1.05;
}

/* BODY */
.body {
  flex: 1;
  min-height: 0;
  margin-bottom: 240px;
  padding: 40px 60px 30px;
  font-size: 42px;
  line-height: 1.45;
  font-family: var(--font-body);
  font-weight: 600;
  color: var(--text-main);
  display: -webkit-box;
  -webkit-line-clamp: 9;
  -webkit-box-orient: vertical;
  overflow: hidden;
  -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 86%, transparent 100%);
          mask-image: linear-gradient(180deg, #000 0%, #000 86%, transparent 100%);
  border-bottom: 3px solid;
  border-image: linear-gradient(90deg, var(--secondary), var(--accent)) 1;
}
.body .hl-r { background: var(--primary); color: #fff;
  padding: 2px 14px; border-radius: 6px; font-weight: 700; }
.body .hl-y { background: var(--accent); color: #000;
  padding: 2px 14px; border-radius: 6px; font-weight: 700; }

/* PROGRESS bar */
.progress {
  position: absolute; left: 0; right: 0; bottom: 84px; height: 8px;
  background: rgba(255,255,255,.18);
}
.progress::after {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, var(--accent), var(--primary));
  animation: fill {{ duration_s }}s linear forwards;
}
@keyframes fill { from { width: 0; } to { width: 100%; } }

/* HANDLE */
.handle {
  position: absolute; left: 0; right: 0; bottom: 30px;
  text-align: center; color: #fff; opacity: .9;
  font-size: 34px; font-weight: 600;
}

/* CTA overlay (last cta_duration_s seconds) */
{% if cta.enabled %}
/* Pre-flash: full-screen white flash 150ms before CTA */
.preflash {
  position: absolute; inset: 0;
  background: #fff;
  opacity: 0;
  pointer-events: none;
  z-index: 50;
  animation: flash 0.18s ease-out {{ duration_s - cta.duration_s - 0.15 }}s forwards;
}
@keyframes flash {
  0% { opacity: 0; }
  40% { opacity: 0.9; }
  100% { opacity: 0; }
}

/* CTA wrapper */
.cta {
  position: absolute; left: 0; right: 0; bottom: 0; top: 0;
  background: radial-gradient(ellipse at center, rgba(20,20,20,.92), rgba(0,0,0,.98));
  padding: 0 60px;
  text-align: center;
  opacity: 0;
  pointer-events: none;
  z-index: 40;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation:
    cta-fade-in 0.25s ease-out {{ duration_s - cta.duration_s }}s forwards;
}
@keyframes cta-fade-in {
  to { opacity: 1; }
}

{% if cta.show_handle %}
.cta .handle-line {
  font-size: 64px; font-weight: 900;
  color: var(--accent);
  letter-spacing: 1px;
  margin-bottom: 50px;
  text-shadow:
    0 0 18px rgba(255,234,59,.7),
    0 0 36px rgba(255,234,59,.4);
  opacity: 0; transform: translateY(-30px);
  animation: handle-drop 0.45s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.05 }}s forwards;
}
@keyframes handle-drop {
  to { opacity: 1; transform: translateY(0); }
}
{% endif %}

/* Big YouTube-style SUBSCRIBE button */
.cta .sub-btn {
  background: linear-gradient(180deg, #ff2d2d, #c81e1e);
  color: #fff;
  font-size: 88px; font-weight: 900;
  padding: 40px 70px;
  border-radius: 100px;
  box-shadow:
    0 12px 0 rgba(0,0,0,.5),
    0 20px 60px rgba(255,45,45,.6);
  display: inline-flex;
  align-items: center;
  gap: 28px;
  letter-spacing: 1px;
  margin-bottom: 60px;
  transform: scale(0);
  animation:
    sub-pop 0.5s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.15 }}s forwards,
    sub-press 0.4s ease-in-out {{ duration_s - cta.duration_s + 0.55 }}s;
}
@keyframes sub-pop {
  to { transform: scale(1); }
}
@keyframes sub-press {
  0%, 100% { transform: scale(1); box-shadow: 0 12px 0 rgba(0,0,0,.5), 0 20px 60px rgba(255,45,45,.6); }
  50% { transform: scale(0.92); box-shadow: 0 4px 0 rgba(0,0,0,.5), 0 8px 30px rgba(255,45,45,.6); }
}
.cta .sub-btn .bell { font-size: 96px; }

/* Pointer hand below button — bouncing */
.cta .pointer {
  font-size: 100px;
  margin-bottom: 50px;
  opacity: 0;
  animation:
    pointer-in 0.3s ease-out {{ duration_s - cta.duration_s + 0.7 }}s forwards,
    bounce 0.6s ease-in-out {{ duration_s - cta.duration_s + 1.0 }}s infinite;
}
@keyframes pointer-in {
  from { opacity: 0; transform: translateY(-20px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15px); }
}

/* Three icons row at bottom — stagger pop-in */
.cta .icons-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 50px;
  margin-top: 30px;
}
.cta .icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  transform: scale(0);
  opacity: 0;
}
.cta .icon-item .ic { font-size: 110px; }
.cta .icon-item .lbl { font-size: 36px; font-weight: 800; color: #fff; letter-spacing: 1px; }
.cta .icon-item:nth-child(1) {
  animation: icon-pop 0.4s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.25 }}s forwards;
}
.cta .icon-item:nth-child(2) {
  animation: icon-pop 0.4s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.4 }}s forwards;
}
.cta .icon-item:nth-child(3) {
  animation: icon-pop 0.4s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.55 }}s forwards;
}
@keyframes icon-pop {
  to { opacity: 1; transform: scale(1); }
}

/* Body dim during CTA so it stays focused */
.body { animation: dim 0.3s ease-in {{ duration_s - cta.duration_s }}s forwards; }
@keyframes dim { to { opacity: 0.05; } }
{% endif %}

/* Persistent corner chips — visible THROUGHOUT video */
.persistent {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 900;
  font-size: 36px;
  letter-spacing: 1px;
  padding: 14px 22px;
  border-radius: 12px;
  color: #fff;
  box-shadow: 0 5px 0 rgba(0,0,0,.5), 0 0 20px rgba(0,0,0,.3);
  z-index: 35;
  text-shadow: 0 2px 0 rgba(0,0,0,.4);
}
.persistent .ic { font-size: 44px; }

/* BEĞEN — bottom-left, dark chip with red accent */
.persistent.like {
  bottom: 112px; left: 24px;
  background: linear-gradient(135deg, rgba(0,0,0,.88), rgba(40,0,0,.92));
  border: 3px solid #ff3b3b;
  animation: like-beat 1.5s ease-in-out infinite;
}
@keyframes like-beat {
  0%, 100% { transform: scale(1); }
  20% { transform: scale(1.12); }
  40% { transform: scale(0.98); }
  60% { transform: scale(1.08); }
}

/* ABONE OL — bottom-right, red gradient chip */
.persistent.sub {
  bottom: 112px; right: 24px;
  background: linear-gradient(135deg, #ff2d2d, #c81e1e);
  border: 3px solid #ffea3b;
  animation: sub-glow 1.5s ease-in-out infinite;
}
@keyframes sub-glow {
  0%, 100% { transform: scale(1); box-shadow: 0 5px 0 rgba(0,0,0,.5), 0 0 20px rgba(255,45,45,.4); }
  50% { transform: scale(1.08); box-shadow: 0 5px 0 rgba(0,0,0,.5), 0 0 36px rgba(255,234,59,.7); }
}

/* Hide persistent chips during the final CTA fullscreen overlay */
{% if cta.enabled %}
.persistent {
  animation-fill-mode: both;
}
.persistent.like { animation: like-beat 1.5s ease-in-out infinite, fade-out 0.3s ease-in {{ duration_s - cta.duration_s }}s forwards; }
.persistent.sub  { animation: sub-glow  1.5s ease-in-out infinite, fade-out 0.3s ease-in {{ duration_s - cta.duration_s }}s forwards; }
@keyframes fade-out { to { opacity: 0; } }
{% endif %}
</style>
</head>
<body>
<div class="stage">
  <div class="ticker">USD/TRY ▲ %2.5 · BIST <span class="down">▼ %0.8</span> · EUR/TRY ▲ %1.7 · ALTIN ▲ %0.4</div>
  <div class="stage-badge">{{ ui_breaking }}</div>
  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img"></div>
    <div class="vignette"></div>
    <div class="ticker-num">{{ script.photo_overlay }}</div>
  </div>

  <div class="body">{{ body_html|safe }}</div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>

  <!-- Persistent corner chips (visible throughout video, fade out only when end CTA opens) -->
  <div class="persistent like"><span class="ic">❤️</span><span>{{ ui_like }}</span></div>
  <div class="persistent sub"><span class="ic">🔔</span><span>{{ ui_subscribe }}</span></div>

  {% if cta.enabled %}
  <div class="preflash"></div>
  <div class="cta">
    {% if cta.show_handle %}<div class="handle-line">{{ handle }}</div>{% endif %}
    <div class="sub-btn">
      <span class="bell">🔔</span>
      <span>{{ ui_subscribe }}</span>
    </div>
    <div class="pointer">👆</div>
    <div class="icons-row">
      {% set icon_labels = [ui_like, ui_subscribe, ui_share] %}
      {% for icon in cta.icons %}
      <div class="icon-item">
        <span class="ic">{{ icon }}</span>
        <span class="lbl">{{ icon_labels[loop.index0] if loop.index0 < icon_labels|length else "" }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</div>
</body>
</html>
