<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Broadsheet</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,900;1,500&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Inter:wght@500;600;700&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Source Serif 4'), serif;
    background: var(--body-bg-1, #faf6ec);
    color: var(--text-main, #1a1410);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background:
      radial-gradient(150% 80% at 50% 0%, color-mix(in srgb, var(--accent, #d4a017) 12%, transparent) 0%, transparent 55%),
      var(--body-bg-1, #faf6ec);
  }
  /* Kâğıt damarı dokusu */
  .stage::before {
    content: ''; position: absolute; inset: 0;
    background-image:
      repeating-linear-gradient(0deg,
        rgba(120, 90, 40, 0.025) 0 1px, transparent 1px 4px),
      radial-gradient(rgba(120, 90, 40, 0.06) 1px, transparent 1px);
    background-size: 100% 4px, 14px 14px;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  /* Üst marka şeridi */
  .nameplate {
    position: relative; padding: 38px 70px 18px;
    border-bottom: 6px double var(--text-main, #1a1410);
  }
  .nameplate .topline {
    display: flex; justify-content: space-between;
    font-family: 'Inter', sans-serif;
    font-size: 18px; text-transform: uppercase;
    letter-spacing: 0.22em; font-weight: 600;
    color: var(--text-muted, #66594a);
  }
  .nameplate .topline .live {
    color: var(--primary, #b3261e);
    display: flex; align-items: center; gap: 10px;
  }
  .nameplate .topline .live::before {
    content: ''; width: 12px; height: 12px; border-radius: 50%;
    background: var(--primary, #b3261e);
  }

  /* Manşet */
  .header {
    padding: 50px 70px 30px;
    text-align: center;
    border-bottom: 1px solid var(--text-main, #1a1410);
  }
  .header .top {
    display: block;
    font-family: var(--font-headline, 'Playfair Display'), serif;
    font-size: var(--size-headline-top, 140px);
    line-height: 0.92; font-weight: 900;
    letter-spacing: -0.025em;
    color: var(--text-main, #1a1410);
    text-wrap: balance;
  }
  .header .bot {
    display: block;
    margin-top: 24px;
    font-family: var(--font-headline, 'Playfair Display'), serif;
    font-style: italic;
    font-weight: 500;
    font-size: var(--size-headline-bot, 56px);
    line-height: 1.15;
    color: color-mix(in srgb, var(--text-main, #1a1410) 65%, transparent);
    text-wrap: balance;
  }

  /* Foto */
  .photo {
    position: relative; margin: 32px 70px 0;
    height: 560px;
    background: linear-gradient(135deg, var(--bg-grad-1, #2a3a5e), var(--bg-grad-2, #11182f));
    box-shadow: 0 12px 0 -4px var(--text-main, #1a1410), 0 22px 50px rgba(26, 20, 16, 0.18);
    overflow: hidden;
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    filter: contrast(1.05) saturate(0.95);
  }
  /* foto altı caption (sarı bant yerine küçük italik) */
  .photo .yellow {
    position: absolute; left: 0; bottom: 0; right: 0;
    background: var(--accent, #d4a017);
    color: #1a1410;
    padding: 14px 26px;
    font-family: 'Inter', sans-serif;
    font-weight: 700;
    font-size: 30px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-top: 4px solid var(--text-main, #1a1410);
  }

  /* Gövde — 2 sütun */
  .body {
    position: absolute; left: 70px; right: 70px;
    bottom: 200px; top: 1430px;
    columns: 2; column-gap: 50px; column-rule: 1px solid color-mix(in srgb, var(--text-main, #1a1410) 25%, transparent);
  }
  .body-text {
    font-family: var(--font-body, 'Source Serif 4'), serif;
    font-size: 30px; line-height: 1.5;
    color: var(--text-main, #1a1410);
    text-align: justify; hyphens: auto;
  }
  .body-text::first-letter {
    font-family: var(--font-headline, 'Playfair Display'), serif;
    font-size: 80px;
    float: left; line-height: 0.85;
    padding-right: 10px; padding-top: 4px;
    color: var(--primary, #b3261e);
    font-weight: 900;
  }
  .body-text .hl-y { background: var(--accent, #d4a017); color: #1a1410; padding: 0 6px; font-weight: 600; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .body-text .hl-r { background: var(--primary, #b3261e); color: #fff; padding: 0 6px; font-weight: 600; box-decoration-break: clone; -webkit-box-decoration-break: clone; }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 5px; background: rgba(26, 20, 16, 0.12);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--primary, #b3261e);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 30px; font-weight: 600;
    color: var(--text-muted, #66594a);
    letter-spacing: 0.06em;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="nameplate">
    <div class="topline">
      <span>{% if script.category %}{{ script.category }}{% endif %} · {{ handle }}</span>
      <span class="live">{{ ui_breaking }}</span>
    </div>
  </div>

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="22" data-fit-max="30" data-fit-pad="20">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
