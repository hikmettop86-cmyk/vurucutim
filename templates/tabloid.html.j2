<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Tabloid</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@600;700&family=Inter:wght@500;700&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #ffd400);
    color: var(--text-main, #0a0a0a);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background:
      radial-gradient(circle at 20% 30%, color-mix(in srgb, var(--accent, #ffd400) 100%, white 18%) 0%, var(--body-bg-1, #ffd400) 50%, var(--body-bg-2, #f5b800) 100%);
    overflow: hidden;
  }
  /* Halftone */
  .stage::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(0,0,0,0.18) 1.5px, transparent 1.5px);
    background-size: 22px 22px;
    background-position: 0 0;
    mix-blend-mode: multiply;
    opacity: 0.4;
    pointer-events: none;
  }
  /* Köşe kıvrımı */
  .stage::after {
    content: ''; position: absolute; bottom: 0; right: 0;
    width: 220px; height: 220px;
    background: linear-gradient(135deg, transparent 50%, rgba(0,0,0,0.18) 50%);
    pointer-events: none;
  }

  /* Üst rozet */
  .stage-badge {
    position: absolute; top: 50px; left: 50%;
    transform: translateX(-50%) rotate(-3deg);
    padding: 14px 36px;
    background: var(--primary, #c81e1e);
    color: #fff;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 32px; letter-spacing: 0.2em;
    text-transform: uppercase;
    border: 4px solid #0a0a0a;
    box-shadow: 8px 8px 0 #0a0a0a;
    z-index: 5;
  }

  /* Manşet — devasa, kırmızı, yamuk */
  .header {
    position: absolute; top: 200px; left: 40px; right: 40px;
    text-align: center;
    z-index: 4;
  }
  .header .top {
    display: block;
    font-family: var(--font-headline, 'Anton'), sans-serif;
    font-size: var(--size-headline-top, 240px);
    line-height: 0.88;
    color: var(--primary, #c81e1e);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    -webkit-text-stroke: 6px #0a0a0a;
    paint-order: stroke fill;
    transform: rotate(-1.5deg);
    text-wrap: balance;
    text-shadow: 10px 10px 0 rgba(10,10,10,0.18);
  }
  .header .bot {
    display: block;
    margin-top: 18px;
    font-family: 'Oswald', sans-serif;
    font-size: var(--size-headline-bot, 60px);
    font-weight: 700;
    color: #0a0a0a;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    transform: rotate(0.5deg);
    text-wrap: balance;
  }

  /* Foto — kâğıt kesim efekti, eğik */
  .photo {
    position: absolute;
    top: 850px; left: 80px; right: 80px;
    height: 540px;
    background:
      linear-gradient(135deg, var(--bg-grad-1, #3a1a1a) 0%, var(--bg-grad-2, #1a0a0a) 100%);
    border: 6px solid #0a0a0a;
    transform: rotate(2deg);
    overflow: hidden;
    box-shadow: 12px 14px 0 #0a0a0a;
    z-index: 3;
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    filter: saturate(0.85) contrast(1.1);
  }
  .photo .yellow {
    position: absolute; left: -20px; bottom: 28px;
    max-width: 90%;
    background: var(--accent, #ffd400);
    color: #0a0a0a;
    padding: 16px 36px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 52px; line-height: 1.0;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    border: 4px solid #0a0a0a;
    transform: rotate(-3deg);
    box-shadow: 6px 6px 0 #0a0a0a;
  }

  /* Gövde — siyah çerçevede */
  .body {
    position: absolute; left: 60px; right: 60px;
    top: 1450px; bottom: 180px;
    background: var(--text-main, #0a0a0a);
    color: var(--body-bg-1, #fff);
    border: 4px solid #0a0a0a;
    padding: 36px 44px;
    transform: rotate(-0.8deg);
    box-shadow: 8px 8px 0 var(--primary, #c81e1e);
  }
  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 40px; line-height: 1.35; font-weight: 600;
    color: var(--body-bg-1, #fff);
    text-wrap: pretty;
  }
  .body-text .hl-y {
    background: var(--accent, #ffd400); color: #0a0a0a;
    padding: 2px 14px; box-shadow: 4px 4px 0 var(--primary, #c81e1e);
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 700;
  }
  .body-text .hl-r {
    background: var(--primary, #c81e1e); color: #fff;
    padding: 2px 14px; box-shadow: 4px 4px 0 var(--accent, #ffd400);
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 700;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 8px; background: rgba(0,0,0,0.2);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--primary, #c81e1e);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: 'Oswald', sans-serif;
    font-size: 34px; font-weight: 700;
    color: var(--text-muted, #0a0a0a);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  {% if script.category %}<div class="stage-badge">{{ script.category }}</div>{% endif %}

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="30" data-fit-max="40" data-fit-pad="20">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
