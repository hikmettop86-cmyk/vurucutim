<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — newscast-ticker</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Inter:wght@400;600;700;800;900&display=swap');
  {{ dna_css|safe }}
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1920px; overflow: hidden;
    background: #000;
    font-family: 'Inter', sans-serif;
    color: var(--text-main, #fff); }

  .stage { position: relative; width: 1080px; height: 1920px; }

  /* PHOTO area — top 70% of frame */
  .photo {
    position: absolute; top: 0; left: 0; right: 0;
    height: 1280px;
    background: linear-gradient(135deg, {{ colors.bg_gradient[0] }}, {{ colors.bg_gradient[1] }});
    overflow: hidden;
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-image: url('{{ bg_image_url|default("") }}');
    background-size: cover; background-position: center;
    {% if not bg_image_url %}display: none;{% endif %}
  }
  .photo::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 30%, rgba(0,0,0,.6) 100%);
  }

  .stage-badge {
    position: absolute; top: 30px; right: 30px;
    background: {{ colors.primary }}; color: #fff;
    font-family: 'Oswald', sans-serif;
    font-size: 26px; font-weight: 700; letter-spacing: 3px;
    padding: 10px 18px;
    z-index: 5;
  }

  .category {
    position: absolute; top: 38px; left: 30px;
    background: rgba(0,0,0,.7); color: {{ colors.accent }};
    font-family: 'Oswald', sans-serif;
    font-size: 22px; font-weight: 700; letter-spacing: 2px;
    padding: 8px 16px;
    z-index: 5;
  }

  /* PHOTO OVERLAY — center on photo */
  .photo-overlay {
    position: absolute; bottom: 80px; left: 50%;
    transform: translateX(-50%);
    background: {{ colors.accent }}; color: #000;
    font-family: 'Oswald', sans-serif;
    font-size: 42px; font-weight: 700; letter-spacing: 2px;
    padding: 14px 28px;
    z-index: 6;
    max-width: 900px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* TICKER STRIPE — bottom 30% */
  .ticker {
    position: absolute;
    top: 1280px; left: 0; right: 0; bottom: 140px;
    background: linear-gradient(180deg, {{ colors.primary }}, {{ colors.primary_light }});
    padding: 30px 50px;
    display: flex; flex-direction: column;
    justify-content: center;
  }
  .ticker-prefix {
    font-family: 'Oswald', sans-serif;
    font-size: 28px; font-weight: 700;
    letter-spacing: 3px;
    color: {{ colors.accent }};
    margin-bottom: 8px;
  }
  .ticker .header {
    font-family: 'Oswald', sans-serif;
    color: #fff;
  }
  .ticker .header .top {
    display: block;
    font-size: var(--size-headline-top, 80px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 1px;
    white-space: nowrap;
  }
  .ticker .header .bot {
    display: block;
    margin-top: 8px;
    font-size: var(--size-headline-bot, 48px);
    font-weight: 500;
    letter-spacing: 1px;
    color: {{ colors.accent }};
  }

  .body-text {
    font-size: 32px;
    font-weight: 500;
    line-height: 1.35;
    margin-top: 12px;
    color: rgba(255,255,255,.92);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .progress {
    position: absolute; left: 0; right: 0; bottom: 110px; height: 4px;
    background: rgba(255,255,255,.18);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: {{ colors.accent }};
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 50px;
    text-align: center;
    font-family: 'Oswald', sans-serif;
    font-size: 32px; font-weight: 500; letter-spacing: 3px;
    color: var(--text-muted, #ccc);
  }

  .source-credit {
    position: absolute;
    bottom: 16px; left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,.6); color: rgba(255,255,255,.85);
    font-size: 14px; font-weight: 500; letter-spacing: 0.5px;
    padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">
  <div class="photo">
    <div class="bg-img"></div>
    {% if script.photo_overlay %}<div class="photo-overlay">{{ script.photo_overlay }}</div>{% endif %}
  </div>
  {% if script.category %}<div class="category">{{ script.category }}</div>{% endif %}
  <div class="stage-badge">{{ ui_breaking }}</div>

  <div class="ticker">
    <div class="ticker-prefix">{{ ui_breaking }} —</div>
    <div class="header">
      <span class="top" data-fit-width="40" data-fit-min="48" data-fit-max="80">{{ script.header_top }}</span>
      <span class="bot">{{ script.header_bottom }}</span>
    </div>
    <div class="body-text">{{ body_html|safe }}</div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>

  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}
</div>
{% include "_auto_fit.js.j2" %}
</body>
</html>
