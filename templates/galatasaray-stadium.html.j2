<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — GS Stadium</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@500;700&family=Inter:wght@500;700&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #0a0204);
    color: var(--text-main, #fff);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background:
      repeating-linear-gradient(135deg,
        var(--accent, #FCB900) 0 60px,
        var(--primary, #A90432) 60px 120px);
    overflow: hidden;
  }
  /* Üst koyu overlay */
  .stage::before {
    content: ''; position: absolute;
    top: 0; left: 0; right: 0;
    height: 65%;
    background:
      radial-gradient(120% 80% at 50% 30%, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.85) 70%, #050203 100%);
    pointer-events: none;
  }
  /* Alt koyu band */
  .stage::after {
    content: ''; position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 40%;
    background: linear-gradient(180deg, transparent, rgba(0,0,0,0.92) 50%, #0a0204 100%);
    pointer-events: none;
  }

  /* Sahne kalabalık silüet — alt orta */
  .crowd {
    position: absolute; left: 0; right: 0; bottom: 360px;
    height: 200px;
    z-index: 2;
    opacity: 0.7;
  }

  /* Üst meta */
  .top-bar {
    position: absolute; top: 60px; left: 60px; right: 60px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 5;
  }
  .stage-badge {
    background: var(--accent, #FCB900);
    color: var(--primary, #A90432);
    padding: 12px 28px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 28px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    box-shadow: 6px 6px 0 rgba(0,0,0,0.4);
    transform: skewX(-12deg);
  }
  .stage-badge > span { display: inline-block; transform: skewX(12deg); }
  .live-tag {
    display: flex; align-items: center; gap: 12px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 26px;
    color: var(--accent, #FCB900);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0,0,0,0.5);
  }
  .live-tag::before {
    content: ''; width: 12px; height: 12px; border-radius: 50%;
    background: var(--accent, #FCB900);
    box-shadow: 0 0 12px var(--accent, #FCB900);
  }

  /* TRİBÜN şeritli başlık */
  .tribune {
    position: absolute; top: 170px; left: 0; right: 0;
    text-align: center;
    color: var(--accent, #FCB900);
    font-family: 'Anton', sans-serif;
    font-size: 36px;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    z-index: 4;
    text-shadow: 0 2px 8px rgba(0,0,0,0.6);
  }
  .tribune::before, .tribune::after {
    content: '◆';
    color: var(--primary, #A90432);
    margin: 0 18px;
    font-size: 22px;
    vertical-align: middle;
  }

  /* Manşet */
  .header {
    position: absolute; top: 280px; left: 50px; right: 50px;
    text-align: center;
    z-index: 4;
  }
  .header .top {
    display: block;
    font-family: var(--font-headline, 'Anton'), sans-serif;
    font-size: var(--size-headline-top, 220px);
    line-height: 0.85;
    color: var(--accent, #FCB900);
    text-transform: uppercase;
    letter-spacing: 0.005em;
    -webkit-text-stroke: 4px var(--primary, #A90432);
    paint-order: stroke fill;
    text-shadow: 8px 8px 0 rgba(0,0,0,0.5);
    text-wrap: balance;
  }
  .header .bot {
    display: block; margin-top: 20px;
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: var(--size-headline-bot, 52px);
    line-height: 1.05;
    color: #fff;
    text-transform: uppercase;
    text-shadow: 0 2px 12px rgba(0,0,0,0.6);
    text-wrap: balance;
  }

  /* Foto — yatay bant, alt orta */
  .photo {
    position: absolute;
    bottom: 380px; left: 30px; right: 30px;
    height: 360px;
    background: linear-gradient(135deg, var(--bg-grad-1, #25080d), var(--bg-grad-2, #0a0204));
    border-top: 6px solid var(--accent, #FCB900);
    border-bottom: 6px solid var(--accent, #FCB900);
    overflow: hidden;
    z-index: 3;
    transform: perspective(800px) rotateX(8deg);
    transform-origin: center top;
    box-shadow: 0 30px 60px rgba(0,0,0,0.6);
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
  }
  .photo::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(180deg, transparent 50%, rgba(0,0,0,0.5) 100%),
      linear-gradient(90deg, rgba(0,0,0,0.4), transparent 25%, transparent 75%, rgba(0,0,0,0.4));
    pointer-events: none;
  }
  .photo .yellow {
    position: absolute; left: 0; right: 0; bottom: 0;
    background: var(--primary, #A90432);
    color: var(--accent, #FCB900);
    padding: 12px 28px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 30px;
    text-align: center;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-top: 3px solid var(--accent, #FCB900);
  }

  /* Gövde */
  .body {
    position: absolute; left: 60px; right: 60px;
    bottom: 200px;
    z-index: 4;
  }
  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 30px; line-height: 1.4; font-weight: 500;
    color: #fff;
    text-shadow: 0 2px 8px rgba(0,0,0,0.7);
    text-align: center;
    text-wrap: pretty;
  }
  .body-text .hl-y {
    background: var(--accent, #FCB900); color: var(--primary, #A90432);
    padding: 0 10px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    text-shadow: none; font-weight: 800;
  }
  .body-text .hl-r {
    background: var(--primary, #A90432); color: var(--accent, #FCB900);
    padding: 0 10px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 800;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 6px; background: rgba(252,185,0,0.15);
    z-index: 6;
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--accent, #FCB900);
    box-shadow: 0 0 14px var(--accent, #FCB900);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: 'Oswald', sans-serif;
    font-size: 32px; font-weight: 700;
    color: var(--accent, #FCB900);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    z-index: 6;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <svg class="crowd" viewBox="0 0 1080 200" preserveAspectRatio="xMidYMax meet">
    <g fill="#0a0204">
      <ellipse cx="60" cy="120" rx="22" ry="32"/><rect x="32" y="140" width="56" height="60" rx="6"/>
      <ellipse cx="160" cy="100" rx="22" ry="32"/><rect x="132" y="120" width="56" height="80" rx="6"/>
      <ellipse cx="260" cy="115" rx="22" ry="32"/><rect x="232" y="135" width="56" height="65" rx="6"/>
      <ellipse cx="360" cy="95"  rx="22" ry="32"/><rect x="332" y="115" width="56" height="85" rx="6"/>
      <ellipse cx="460" cy="125" rx="22" ry="32"/><rect x="432" y="145" width="56" height="55" rx="6"/>
      <ellipse cx="560" cy="100" rx="22" ry="32"/><rect x="532" y="120" width="56" height="80" rx="6"/>
      <ellipse cx="660" cy="115" rx="22" ry="32"/><rect x="632" y="135" width="56" height="65" rx="6"/>
      <ellipse cx="760" cy="95"  rx="22" ry="32"/><rect x="732" y="115" width="56" height="85" rx="6"/>
      <ellipse cx="860" cy="125" rx="22" ry="32"/><rect x="832" y="145" width="56" height="55" rx="6"/>
      <ellipse cx="960" cy="105" rx="22" ry="32"/><rect x="932" y="125" width="56" height="75" rx="6"/>
      <ellipse cx="1020" cy="120" rx="22" ry="32"/><rect x="992" y="140" width="56" height="60" rx="6"/>
    </g>
  </svg>

  <div class="top-bar">
    {% if script.category %}<div class="stage-badge"><span>{{ script.category }}</span></div>{% endif %}
    <div class="live-tag">{{ ui_breaking }}</div>
  </div>

  <div class="tribune">TRİBÜN AÇIK · CİMBOM</div>

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="22" data-fit-max="30" data-fit-pad="16">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
