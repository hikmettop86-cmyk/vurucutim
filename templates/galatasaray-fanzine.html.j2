<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — GS Fanzine</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@600;700&family=Inter:wght@500;700&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #FCB900);
    color: var(--text-main, #0a0a0a);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--accent, #FCB900) 100%, white 15%) 0%, var(--body-bg-1, #FCB900) 50%, var(--body-bg-2, #e8a800) 100%);
    overflow: hidden;
  }
  /* Halftone */
  .stage::before {
    content: ''; position: absolute; inset: 0;
    background-image: radial-gradient(rgba(169, 4, 50, 0.18) 1.8px, transparent 2px);
    background-size: 22px 22px;
    mix-blend-mode: multiply;
    opacity: 0.5;
    pointer-events: none;
  }
  /* Çapraz kırmızı şerit */
  .stage::after {
    content: ''; position: absolute;
    top: 280px; left: -100px; right: -100px;
    height: 140px;
    background: var(--primary, #A90432);
    transform: rotate(-4deg);
    z-index: 2;
    box-shadow: 0 6px 0 #0a0a0a;
  }

  /* Üst kategori rozet */
  .stage-badge {
    position: absolute; top: 80px; left: 50%;
    transform: translateX(-50%) rotate(-2deg);
    background: var(--primary, #A90432);
    color: var(--accent, #FCB900);
    padding: 12px 32px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 30px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    border: 4px solid #0a0a0a;
    box-shadow: 8px 8px 0 #0a0a0a;
    z-index: 4;
  }

  /* Şerit üstündeki başlık */
  .stripe-title {
    position: absolute; top: 290px; left: 0; right: 0;
    color: var(--accent, #FCB900);
    font-family: 'Anton', sans-serif;
    font-size: 90px;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
    transform: rotate(-4deg);
    z-index: 3;
    text-shadow: 4px 4px 0 #0a0a0a;
  }

  /* Manşet — devasa scream */
  .header {
    position: absolute; top: 480px; left: 30px; right: 30px;
    text-align: center;
    z-index: 5;
  }
  .header .top {
    display: block;
    font-family: var(--font-headline, 'Anton'), sans-serif;
    font-size: var(--size-headline-top, 250px);
    line-height: 0.85;
    color: var(--primary, #A90432);
    text-transform: uppercase;
    letter-spacing: -0.005em;
    -webkit-text-stroke: 6px #0a0a0a;
    paint-order: stroke fill;
    transform: rotate(-1.5deg);
    text-shadow: 12px 12px 0 rgba(10,10,10,0.18);
    text-wrap: balance;
  }
  .header .bot {
    display: block; margin-top: 24px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: var(--size-headline-bot, 56px);
    line-height: 1.0;
    color: #0a0a0a;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    transform: rotate(0.4deg);
    text-wrap: balance;
  }

  /* Foto — gazete kesiği */
  .photo {
    position: absolute;
    top: 940px; left: 80px; right: 80px;
    height: 480px;
    background: linear-gradient(135deg, var(--bg-grad-1, #25080d), var(--bg-grad-2, #0a0204));
    border: 6px solid #0a0a0a;
    transform: rotate(2.5deg);
    overflow: hidden;
    box-shadow: 12px 14px 0 #0a0a0a;
    z-index: 3;
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
    filter: contrast(1.1);
  }
  .photo .yellow {
    position: absolute; left: -20px; bottom: 28px;
    background: var(--accent, #FCB900);
    color: var(--primary, #A90432);
    padding: 16px 36px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 44px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    border: 4px solid #0a0a0a;
    transform: rotate(-3deg);
    box-shadow: 6px 6px 0 #0a0a0a;
  }

  /* Gövde — siyah box */
  .body {
    position: absolute; left: 60px; right: 60px;
    top: 1460px; bottom: 200px;
    background: #0a0a0a;
    color: var(--accent, #FCB900);
    border: 4px solid #0a0a0a;
    padding: 32px 40px;
    transform: rotate(-0.8deg);
    box-shadow: 10px 10px 0 var(--primary, #A90432);
    z-index: 4;
  }
  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 32px; line-height: 1.35; font-weight: 600;
    color: var(--accent, #FCB900);
    text-wrap: pretty;
  }
  .body-text .hl-y {
    background: var(--accent, #FCB900); color: #0a0a0a;
    padding: 0 10px; box-shadow: 4px 4px 0 var(--primary, #A90432);
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 800;
  }
  .body-text .hl-r {
    background: var(--primary, #A90432); color: var(--accent, #FCB900);
    padding: 0 10px; box-shadow: 4px 4px 0 var(--accent, #FCB900);
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 800;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 8px; background: rgba(10,10,10,0.18);
    z-index: 6;
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--primary, #A90432);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: 'Oswald', sans-serif;
    font-size: 34px; font-weight: 700;
    color: var(--primary, #A90432);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    z-index: 6;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  {% if script.category %}<div class="stage-badge">{{ script.category }}</div>{% endif %}
  <div class="stripe-title">{{ ui_breaking }}</div>

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="24" data-fit-max="32" data-fit-pad="18">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
