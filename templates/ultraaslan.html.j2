<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — UltraAslan Haber Kartı</title>
<style>
  /* 1. Google Fonts import (Oswald ve Inter) */
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@500;700&display=swap');

  /* 2. DNA override (zorunlu) */
  {{ dna_css|safe }}

  /* 3. Reset + viewport (zorunlu) */
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { 
    width: 1080px; 
    height: 1920px; 
    overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    color: var(--text-main, #ffffff);
    background: linear-gradient(135deg, #0a0a0a 0%, var(--bg-grad-1, #8B0000) 100%);
  }

  .stage { 
    position: relative; 
    width: 1080px; 
    height: 1920px;
    display: flex; 
    flex-direction: column; 
    padding: 80px 60px;
    justify-content: space-between;
  }

  /* Miro design-analysis tarzı katmanlar ve geometriler */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 10;
  }

  .stage-badge {
    background-color: var(--accent, #fdb912);
    color: var(--primary, #a50000);
    font-family: var(--font-headline, 'Oswald'), sans-serif;
    font-size: 24px;
    font-weight: 700;
    padding: 10px 24px;
    border-radius: 9999px; /* Miro pill shape signature */
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .brand-logo-pill {
    background-color: #050038;
    color: var(--accent, #fdb912);
    font-family: var(--font-headline, 'Oswald'), sans-serif;
    font-size: 20px;
    font-weight: 700;
    padding: 8px 20px;
    border-radius: 9999px;
    border: 2px solid var(--accent, #fdb912);
  }

  /* Header / Manşet Bölümü */
  .header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 20px;
    z-index: 10;
  }

  .header .top {
    font-family: var(--font-headline, 'Oswald'), sans-serif;
    font-size: 68px;
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--text-main, #ffffff);
    letter-spacing: -1px;
    text-shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
  }

  .header .bot {
    font-family: var(--font-headline, 'Oswald'), sans-serif;
    font-size: 52px;
    font-weight: 500;
    line-height: 1.15;
    text-transform: uppercase;
    color: var(--accent, #fdb912);
    letter-spacing: -0.5px;
  }

  /* Fotoğraf & Mockup Alanı (Miro Board style rounded cards) */
  .photo {
    position: relative;
    width: 100%;
    height: 520px;
    border-radius: 28px; /* Miro xxk/feature card radius */
    overflow: hidden;
    border: 2px solid rgba(253, 185, 18, 0.3);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    background-color: #1c1c1e;
    z-index: 10;
  }

  .bg-img {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-size: cover;
    background-position: center;
    filter: brightness(0.9);
  }

  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(10, 10, 10, 0.85) 100%);
  }

  .yellow-overlay-chip {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    background-color: var(--accent, #fdb912);
    color: #050038;
    font-family: var(--font-headline, 'Oswald'), sans-serif;
    font-size: 26px;
    font-weight: 700;
    padding: 14px 24px;
    border-radius: 16px;
    z-index: 2;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    text-transform: uppercase;
  }

  /* Gövde Alanı (Miro-design card container) */
  .body {
    flex: 1;
    min-height: 0;
    max-height: 480px;
    margin: 20px 0;
    background: rgba(28, 28, 30, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 28px;
    padding: 36px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    z-index: 10;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    color: var(--text-main, #ffffff);
    line-height: 1.5;
    width: 100%;
  }

  /* Highlight stilleri (Miro pastel sticky note vibe) */
  .body .hl-r { 
    background-color: var(--primary, #a50000); 
    color: #ffffff; 
    padding: 4px 10px; 
    border-radius: 6px; 
    font-weight: 600;
  }
  
  .body .hl-y { 
    background-color: var(--accent, #fdb912); 
    color: #050038; 
    padding: 4px 10px; 
    border-radius: 6px; 
    font-weight: 600;
  }

  /* Footer & Progress Öğeleri */
  .progress { 
    position: absolute; 
    left: 0; 
    right: 0; 
    bottom: 90px; 
    height: 8px; 
    background: rgba(255, 255, 255, 0.15); 
    z-index: 11; 
  }
  
  .progress::after { 
    content: ''; 
    position: absolute; 
    left: 0; 
    top: 0; 
    bottom: 0; 
    background: var(--accent, #fdb912);
    animation: fill {{ duration_s }}s linear forwards; 
  }
  
  @keyframes fill { 
    from { width: 0; } 
    to { width: 100%; } 
  }

  .handle { 
    position: absolute; 
    left: 0; 
    right: 0; 
    bottom: 35px;
    text-align: center; 
    font-family: var(--font-headline, 'Oswald'), sans-serif;
    font-size: 28px; 
    font-weight: 700;
    letter-spacing: 1px;
    color: var(--text-muted, #a5a8b5);
    z-index: 11;
    text-transform: uppercase;
  }

  .source-credit { 
    position: absolute; 
    bottom: 8px; 
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.7); 
    color: rgba(255, 255, 255, 0.85);
    font-size: 13px; 
    padding: 4px 12px; 
    border-radius: 6px;
    z-index: 50; 
    white-space: nowrap; 
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="top-bar">
    {% if script.category %}
    <div class="stage-badge">{{ script.category }}</div>
    {% else %}
    <div class="stage-badge">{{ ui_breaking }}</div>
    {% endif %}
    <div class="brand-logo-pill">ultrAslan</div>
  </div>

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}
    <div class="yellow-overlay-chip">{{ script.photo_overlay }}</div>
    {% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="24" data-fit-max="38" data-fit-pad="16">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>