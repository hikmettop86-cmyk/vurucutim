<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Orduspor Kart Haber Kartı</title>
<style>
  /* 1. Google Fonts import */
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@500;700&display=swap');

  /* 2. DNA override (zorunlu) */
  {{ dna_css|safe }}

  /* 3. Reset + viewport (zorunlu) */
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px;
    height: 1920px;
    overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    color: var(--text-main, #ffffff);
    background: linear-gradient(180deg, #2A0835 0%, #12021A 100%);
  }

  /* Nike-inspired design system tokens fallback */
  :root {
    --primary-color: var(--primary, #4a0e4e);
    --accent-color: var(--accent, #ffffff);
    --bg-dark-1: var(--body-bg-1, #2A0835);
    --bg-dark-2: var(--body-bg-2, #12021A);
    --font-head: var(--font-headline, 'Oswald'), sans-serif;
    --font-txt: var(--font-body, 'Inter'), sans-serif;
  }

  .stage {
    position: relative;
    width: 1080px;
    height: 1920px;
    display: flex;
    flex-direction: column;
    padding: 64px 60px 110px 60px;
    overflow: hidden;
  }

  /* Category Chip / Badge (Nike pill style) */
  .stage-badge {
    align-self: flex-start;
    background: var(--accent-color);
    color: var(--primary-color);
    font-family: var(--font-head);
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 10px 28px;
    border-radius: 9999px;
    margin-bottom: 32px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    z-index: 10;
  }

  /* Editorial Campaign Header */
  .header {
    display: flex;
    flex-direction: column;
    margin-bottom: 40px;
    z-index: 10;
  }

  .header .top {
    font-family: var(--font-head);
    font-size: 82px;
    font-weight: 700;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--accent-color);
    letter-spacing: -1px;
    margin-bottom: 8px;
    text-shadow: 0 4px 20px rgba(0,0,0,0.5);
  }

  .header .bot {
    font-family: var(--font-head);
    font-size: 52px;
    font-weight: 500;
    line-height: 1.1;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0px;
  }

  /* Cinematic Photo Card (Nike zero-radius full-bleed stage) */
  .photo {
    position: relative;
    width: 100%;
    height: 600px;
    background-color: #1a0522;
    border-radius: 0px;
    overflow: hidden;
    margin-bottom: 48px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .bg-img {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-size: cover;
    background-position: center;
    filter: brightness(0.9) contrast(1.05);
  }

  .photo::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 50%;
    background: linear-gradient(180deg, transparent 0%, rgba(18, 2, 26, 0.8) 100%);
  }

  .yellow {
    position: absolute;
    bottom: 24px;
    left: 24px;
    background: var(--accent-color);
    color: var(--primary-color);
    font-family: var(--font-head);
    font-size: 26px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 12px 24px;
    border-radius: 9999px;
    z-index: 5;
    max-width: 90%;
    box-shadow: 0 8px 25px rgba(0,0,0,0.4);
  }

  /* Strict Body Layout: flex-1 + min-height: 0 + overflow: hidden for auto-fit safety */
  .body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
    border-left: 4px solid var(--accent-color);
    padding: 32px 36px;
    margin-bottom: 20px;
  }

  .body-text {
    width: 100%;
    font-family: var(--font-txt);
    font-size: 36px;
    font-weight: 400;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.92);
    word-break: break-word;
  }

  /* Highlights styling adhering to Nike palette (pure black/white & semantic contrast) */
  .body .hl-r {
    background: #d30005;
    color: #ffffff;
    padding: 2px 10px;
    font-weight: 600;
    border-radius: 4px;
  }

  .body .hl-y {
    background: #ffffff;
    color: #111111;
    padding: 2px 10px;
    font-weight: 600;
    border-radius: 4px;
  }

  /* Progress Bar & Chrome Footer */
  .progress {
    position: absolute;
    left: 0; right: 0; bottom: 84px;
    height: 6px;
    background: rgba(255, 255, 255, 0.15);
    z-index: 11;
  }

  .progress::after {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    background: var(--accent-color);
    animation: fill {{ duration_s }}s linear forwards;
  }

  @keyframes fill {
    from { width: 0; }
    to { width: 100%; }
  }

  .handle {
    position: absolute;
    left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
  }

  .source-credit {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.6);
    color: rgba(255, 255, 255, 0.85);
    font-size: 14px;
    padding: 3px 12px;
    border-radius: 9999px;
    z-index: 50;
    white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage">

  {% if script.category %}<div class="stage-badge">{{ script.category }}</div>{% endif %}

  <div class="header">
    <span class="top" data-fit-width="40" data-fit-min="48" data-fit-max="82">{{ script.header_top }}</span>
    <span class="bot" data-fit-width="40" data-fit-min="36" data-fit-max="52">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="24" data-fit-max="38" data-fit-pad="10">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>