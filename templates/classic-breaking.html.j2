<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — classic-breaking</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Inter:wght@400;500;600;700;800&display=swap');
  {{ dna_css|safe }}
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1920px; overflow: hidden;
    background: #1a1a1a;
    font-family: 'Inter', sans-serif;
    color: var(--text-main, #fff); }

  .stage { position: relative; width: 1080px; height: 1920px;
    display: flex; flex-direction: column; }

  /* Red header */
  .header-area {
    background: linear-gradient(180deg, {{ colors.primary }} 0%, {{ colors.primary }}aa 100%);
    padding: 42px 54px 54px;
    position: relative;
  }
  .stage-badge {
    position: absolute; top: 36px; right: 36px;
    display: inline-flex; align-items: center; gap: 12px;
    background: {{ colors.accent }}; color: #0a0a0a;
    padding: 12px 27px; border-radius: 999px;
    font-family: 'Oswald', sans-serif;
    font-size: 30px; font-weight: 800; letter-spacing: 3px;
  }
  .stage-badge .dot {
    width: 18px; height: 18px; border-radius: 50%; background: {{ colors.primary }};
  }
  .header { font-family: 'Oswald', sans-serif; margin-top: 60px; }
  .header .top {
    display: block;
    font-size: var(--size-headline-top, 90px);
    font-weight: 700;
    line-height: 1.05;
    color: {{ colors.accent }};
    text-shadow: 0 6px 0 rgba(0,0,0,.3);
    letter-spacing: -0.9px;
  }
  .header .bot {
    display: block;
    margin-top: 6px;
    font-size: var(--size-headline-bot, 90px);
    font-weight: 700;
    line-height: 1.05;
    color: {{ colors.accent }};
    text-shadow: 0 6px 0 rgba(0,0,0,.3);
  }

  /* Photo area */
  .photo {
    position: relative;
    height: 600px;
    overflow: hidden;
    background: linear-gradient(135deg, {{ colors.bg_gradient[0] }}, {{ colors.bg_gradient[1] }});
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-image: url('{{ bg_image_url|default("") }}');
    background-size: cover; background-position: center;
    {% if not bg_image_url %}display: none;{% endif %}
  }
  .photo .corner {
    position: absolute; top: 24px; left: 36px;
    font-size: 33px; color: #fff; font-weight: 600;
    text-shadow: 0 3px 6px rgba(0,0,0,.8);
  }

  /* Yellow band */
  .yellow-band {
    background: {{ colors.accent }};
    color: #0a0a0a;
    padding: 30px 0;
    text-align: center;
    font-family: 'Oswald', sans-serif;
    font-size: 54px; font-weight: 700;
    letter-spacing: 1.5px;
    border-top: 6px solid #0a0a0a;
    border-bottom: 6px solid #0a0a0a;
    box-shadow: 0 12px 0 rgba(0,0,0,.3);
  }

  /* Body */
  .body {
    flex: 1; min-height: 0;
    padding: 60px 54px 240px;
    overflow: hidden;
  }
  .body-text {
    font-size: 48px;
    line-height: 1.4;
    font-weight: 500;
    color: #fff;
    display: -webkit-box;
    -webkit-line-clamp: 7;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .body-text .hl-r { background: {{ colors.primary }}; color: #fff;
    padding: 0 12px; font-weight: 800; }
  .body-text .hl-y { background: {{ colors.accent }}; color: #0a0a0a;
    padding: 0 12px; font-weight: 800; }

  .progress {
    position: absolute; left: 0; right: 0; bottom: 110px; height: 6px;
    background: rgba(255,255,255,.18);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: {{ colors.accent }};
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    background: #0a0a0a;
    padding: 30px 0;
    font-family: 'Oswald', sans-serif;
    color: #fff;
  }
  .handle-inner {
    display: inline-block;
    border: 4px solid rgba(255,255,255,.4);
    border-radius: 999px;
    padding: 15px 48px;
    font-size: 36px; font-weight: 600;
    letter-spacing: 1.5px;
  }

  .source-credit {
    position: absolute;
    bottom: 18px; left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,.6); color: rgba(255,255,255,.85);
    font-size: 14px; font-weight: 500; letter-spacing: 0.5px;
    padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">
  <div class="header-area">
    {% if script.category %}<div class="stage-badge"><span class="dot"></span>{{ script.category }}</div>{% endif %}
    <div class="header">
      <span class="top">{{ script.header_top }}</span>
      <span class="bot">{{ script.header_bottom }}</span>
    </div>
  </div>

  <div class="photo">
    <div class="bg-img"></div>
    {% if script.photo_overlay %}<div class="corner">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  {% if script.photo_overlay %}<div class="yellow-band">{{ script.photo_overlay }}</div>{% endif %}

  <div class="body"><div class="body-text">{{ body_html|safe }}</div></div>

  <div class="progress"></div>
  <div class="handle"><span class="handle-inner">{{ handle }}</span></div>

  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}
</div>
{% include "_auto_fit.js.j2" %}
</body>
</html>
