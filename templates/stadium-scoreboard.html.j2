<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — stadium-scoreboard</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Inter:wght@400;600;700;800;900&display=swap');
  {{ dna_css|safe }}
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1920px; overflow: hidden;
    background: linear-gradient(180deg, {{ colors.bg_gradient[0] }}, {{ colors.bg_gradient[1] }});
    font-family: 'Inter', sans-serif;
    color: var(--text-main, #fff8e7); }

  .stage { position: relative; width: 1080px; height: 1920px;
    display: flex; flex-direction: column; }

  .stage-badge {
    position: absolute; top: 30px; right: 30px;
    background: {{ colors.accent }}; color: {{ colors.primary }};
    font-family: 'Oswald', sans-serif;
    font-size: 22px; font-weight: 700; letter-spacing: 2px;
    padding: 6px 14px;
    z-index: 10;
  }

  .category {
    text-align: center;
    padding-top: 60px;
    font-family: 'Oswald', sans-serif;
    font-size: 30px; font-weight: 500;
    color: {{ colors.accent }};
    letter-spacing: 6px;
    text-transform: uppercase;
  }

  /* SCOREBOARD — two teams + score */
  .scoreboard {
    margin-top: 80px;
    padding: 0 50px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 30px;
  }
  .team {
    text-align: center;
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    line-height: 0.95;
    color: var(--text-main, #fff8e7);
    text-shadow: 4px 4px 0 #000;
  }
  .team-top {
    font-size: var(--size-headline-top, 90px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .team-bot {
    font-size: var(--size-headline-bot, 90px);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .vs-score {
    font-family: 'Oswald', sans-serif;
    font-size: 220px; font-weight: 700;
    line-height: 0.9;
    color: {{ colors.accent }};
    text-shadow: 6px 6px 0 #000;
    -webkit-text-stroke: 2px #000;
    white-space: nowrap;
  }

  /* MOMENT / minute / context — small banner under scoreboard */
  .moment {
    margin-top: 60px;
    text-align: center;
    background: {{ colors.accent }};
    color: {{ colors.primary }};
    font-family: 'Oswald', sans-serif;
    font-size: 52px; font-weight: 700;
    padding: 18px 30px;
    margin-left: 50px; margin-right: 50px;
    letter-spacing: 2px;
    transform: skewX(-8deg);
    box-shadow: 0 8px 0 #000;
  }
  .moment > span { display: inline-block; transform: skewX(8deg); }

  /* BODY paragraph */
  .body {
    flex: 1;
    min-height: 0;
    margin-top: 60px;
    margin-bottom: 180px;
    padding: 0 60px;
    overflow: hidden;
    display: flex; align-items: center;
  }
  .body-text {
    width: 100%;
    font-size: 44px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--text-main, #fff8e7);
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 88%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 0%, #000 88%, transparent 100%);
  }
  .body-text .hl-r { background: {{ colors.primary }}; color: #fff;
    padding: 2px 10px; font-weight: 700; }
  .body-text .hl-y { background: {{ colors.accent }}; color: {{ colors.primary }};
    padding: 2px 10px; font-weight: 700; }

  .progress {
    position: absolute; left: 0; right: 0; bottom: 110px; height: 6px;
    background: rgba(255,255,255,.18);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: {{ colors.accent }};
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 50px;
    text-align: center;
    font-family: 'Oswald', sans-serif;
    font-size: 32px; font-weight: 500; letter-spacing: 4px;
    color: {{ colors.accent }};
  }

  .source-credit {
    position: absolute;
    bottom: 16px; left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,.6); color: rgba(255,255,255,.85);
    font-size: 14px; font-weight: 500; letter-spacing: 0.5px;
    padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">
  <div class="stage-badge">{{ ui_breaking }}</div>
  {% if script.category %}<div class="category">{{ script.category }}</div>{% endif %}

  <div class="scoreboard">
    <div class="team">
      <div class="team-top" data-fit-width="20" data-fit-min="50" data-fit-max="90">{{ script.header_top }}</div>
    </div>
    <div class="vs-score">{{ script.photo_overlay or 'VS' }}</div>
    <div class="team">
      <div class="team-bot" data-fit-width="20" data-fit-min="50" data-fit-max="90">{{ script.header_bottom }}</div>
    </div>
  </div>

  <div class="body"><div class="body-text" data-fit-min="32" data-fit-max="48" data-fit-pad="20">{{ body_html|safe }}</div></div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>

  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}
</div>
{% include "_auto_fit.js.j2" %}
</body>
</html>
