<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Broadcast</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@600;700;800&family=JetBrains+Mono:wght@500;700&family=Inter:wght@500;700&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #0a1428);
    color: var(--text-main, #fff);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background:
      linear-gradient(180deg, var(--body-bg-1, #0a1428) 0%, var(--body-bg-2, #050a1a) 100%);
    overflow: hidden;
  }
  /* Subtle radial center */
  .stage::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(60% 40% at 50% 30%, color-mix(in srgb, var(--primary, #ed1c2e) 12%, transparent), transparent 70%);
    pointer-events: none;
  }

  /* Üst skor bar */
  .scorebar {
    position: relative;
    background: linear-gradient(180deg, var(--primary, #ed1c2e), color-mix(in srgb, var(--primary, #ed1c2e) 60%, black));
    color: #fff;
    padding: 22px 60px;
    display: flex; justify-content: space-between; align-items: center;
    border-bottom: 4px solid var(--accent, #ffea1c);
    box-shadow: 0 4px 0 0 rgba(0,0,0,0.4), inset 0 1px 0 0 rgba(255,255,255,0.2);
    z-index: 5;
  }
  .scorebar .logo {
    font-family: var(--font-headline, 'Roboto Condensed'), sans-serif;
    font-weight: 800;
    font-size: 36px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    display: flex; align-items: center; gap: 14px;
  }
  .scorebar .logo::before {
    content: ''; width: 28px; height: 28px;
    background: var(--accent, #ffea1c);
    transform: skewX(-15deg);
  }
  .scorebar .live {
    display: flex; align-items: center; gap: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 24px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .scorebar .live::before {
    content: '●';
    color: var(--accent, #ffea1c);
    animation: blink 1.4s infinite;
    font-size: 28px;
  }
  @keyframes blink { 0%,100%{opacity:1}50%{opacity:0.3} }

  /* Categori chip */
  .cat-chip {
    position: absolute;
    top: 130px; left: 60px;
    background: var(--accent, #ffea1c);
    color: #0a1428;
    padding: 10px 22px;
    font-family: var(--font-headline, 'Roboto Condensed'), sans-serif;
    font-weight: 800;
    font-size: 24px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: skewX(-15deg);
    z-index: 5;
  }
  .cat-chip > span { display: inline-block; transform: skewX(15deg); }

  /* Manşet — alttan başlayarak yukarı */
  .header {
    position: absolute;
    top: 230px; left: 60px; right: 60px;
    z-index: 4;
  }
  .header .top {
    display: block;
    font-family: var(--font-headline, 'Roboto Condensed'), sans-serif;
    font-size: var(--size-headline-top, 180px);
    line-height: 0.88;
    font-weight: 800;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: -0.005em;
    text-shadow: 0 4px 24px rgba(0,0,0,0.7);
    text-wrap: balance;
  }
  .header .top::before {
    content: '';
    display: inline-block;
    width: 18px; height: 18px;
    background: var(--accent, #ffea1c);
    transform: translateY(-20px) skewX(-15deg);
    margin-right: 14px;
  }
  .header .bot {
    display: block; margin-top: 18px;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-weight: 500;
    font-size: var(--size-headline-bot, 44px);
    line-height: 1.15;
    color: rgba(255,255,255,0.85);
    text-wrap: balance;
  }

  /* Foto */
  .photo {
    position: absolute;
    top: 720px; left: 60px; right: 60px;
    height: 580px;
    background: linear-gradient(135deg, var(--bg-grad-1, #2a3a5e), var(--bg-grad-2, #0a1428));
    border: 3px solid color-mix(in srgb, var(--accent, #ffea1c) 50%, transparent);
    overflow: hidden;
    clip-path: polygon(0 0, calc(100% - 60px) 0, 100% 60px, 100% 100%, 60px 100%, 0 calc(100% - 60px));
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
  }
  .photo::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(0,0,0,0.75) 100%);
    pointer-events: none;
  }
  .photo .yellow {
    position: absolute; left: 0; bottom: 0; right: 60px;
    background: var(--accent, #ffea1c);
    color: #0a1428;
    padding: 18px 36px;
    font-family: var(--font-headline, 'Roboto Condensed'), sans-serif;
    font-weight: 800;
    font-size: 36px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    clip-path: polygon(0 0, calc(100% - 30px) 0, 100% 100%, 0 100%);
  }

  /* Skor + body */
  .body-section {
    position: absolute; left: 60px; right: 60px;
    top: 1360px; bottom: 200px;
  }
  .stat-row {
    display: flex; gap: 0;
    margin-bottom: 22px;
  }
  .stat-pill {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    padding: 8px 16px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    font-size: 18px;
    color: var(--accent, #ffea1c);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border-radius: 2px;
  }
  .stat-pill + .stat-pill { margin-left: 10px; }

  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 34px; line-height: 1.42; font-weight: 500;
    color: var(--text-main, rgba(255,255,255,0.95));
    text-wrap: pretty;
  }
  .body-text .hl-y {
    background: var(--accent, #ffea1c); color: #0a1428;
    padding: 0 10px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 700;
  }
  .body-text .hl-r {
    background: var(--primary, #ed1c2e); color: #fff;
    padding: 0 10px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 700;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 5px; background: rgba(255,255,255,0.1);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--accent, #ffea1c);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: var(--font-headline, 'Roboto Condensed'), sans-serif;
    font-size: 30px; font-weight: 700;
    color: var(--text-muted, rgba(255,255,255,0.75));
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="scorebar">
    <div class="logo">{{ handle }}</div>
    <div class="live">{{ ui_breaking }}</div>
  </div>

  {% if script.category %}<div class="cat-chip"><span>{{ script.category }}</span></div>{% endif %}

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="body-section">
    <div class="stat-row">
      <div class="stat-pill">{{ language|upper }} · LIVE</div>
      <div class="stat-pill">00:{{ "%02d"|format(duration_s) }}</div>
    </div>
    <div class="body-text" data-fit-min="26" data-fit-max="34" data-fit-pad="20">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
