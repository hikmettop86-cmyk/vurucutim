<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — Minimal</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: var(--body-bg-1, #fafaf7);
    color: var(--text-main, #0a0a0a);
  }

  .stage {
    position: relative; width: 1080px; height: 1920px;
    background: linear-gradient(180deg, var(--body-bg-1, #fafaf7) 0%, var(--body-bg-2, #ecebe5) 100%);
    padding: 90px 90px 140px;
    display: flex; flex-direction: column;
  }

  /* Üst meta — tek ince çizgi */
  .meta {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: 28px;
    border-bottom: 1px solid color-mix(in srgb, var(--text-main, #0a0a0a) 18%, transparent);
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 22px;
    color: color-mix(in srgb, var(--text-main, #0a0a0a) 55%, transparent);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .meta .live {
    display: flex; align-items: center; gap: 12px;
    color: var(--primary, #b00020);
    font-weight: 600;
  }
  .meta .live::before {
    content: ''; width: 8px; height: 8px; border-radius: 50%;
    background: var(--primary, #b00020);
  }

  /* Manşet */
  .header {
    margin-top: 80px;
    font-family: var(--font-headline, 'Inter'), sans-serif;
    color: var(--text-main, #0a0a0a);
  }
  .header .top {
    display: block;
    font-size: var(--size-headline-top, 130px);
    line-height: 0.92; font-weight: 700;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .header .bot {
    display: block;
    margin-top: 30px;
    font-size: var(--size-headline-bot, 42px);
    line-height: 1.25; font-weight: 400;
    letter-spacing: -0.005em;
    color: color-mix(in srgb, var(--text-main, #0a0a0a) 55%, transparent);
    max-width: 92%;
    text-wrap: balance;
  }

  /* Foto */
  .photo {
    position: relative;
    margin-top: 80px;
    height: 600px;
    border-radius: 6px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--bg-grad-1, #d4d2c8) 0%, var(--bg-grad-2, #b9b6a7) 100%);
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-size: cover; background-position: center;
  }
  .photo .yellow {
    position: absolute; left: 32px; bottom: 32px;
    background: var(--accent, #ffea1c);
    color: #0a0a0a;
    padding: 10px 22px;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-weight: 700;
    font-size: 28px;
    letter-spacing: 0.02em;
    border-radius: 6px;
  }

  /* Tek çizgi vurgu */
  .accent-row {
    display: flex; align-items: center; gap: 22px;
    margin-top: 48px;
  }
  .accent-row .dot {
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--primary, #b00020);
    flex-shrink: 0;
  }
  .accent-row .label {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 22px; font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-main, #0a0a0a) 75%, transparent);
  }
  .accent-row .rule {
    flex: 1; height: 1px;
    background: color-mix(in srgb, var(--text-main, #0a0a0a) 18%, transparent);
  }

  /* Gövde */
  .body {
    flex: 1; margin-top: 30px;
    display: flex; align-items: flex-start;
  }
  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 36px; line-height: 1.5; font-weight: 400;
    color: var(--text-main, #0a0a0a);
    text-wrap: pretty;
    max-width: 92%;
  }
  .body-text .hl-y {
    background: var(--accent, #ffea1c); color: #0a0a0a;
    padding: 0 8px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 600;
  }
  .body-text .hl-r {
    background: var(--primary, #b00020); color: #fff;
    padding: 0 8px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 600;
  }

  /* Standart öğeler */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 2px; background: color-mix(in srgb, var(--text-main, #0a0a0a) 10%, transparent);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--text-main, #0a0a0a);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 28px; font-weight: 500;
    color: var(--text-muted, color-mix(in srgb, var(--text-main, #0a0a0a) 55%, transparent));
    letter-spacing: 0.06em;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.7); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="meta">
    <span>{% if script.category %}{{ script.category }}{% endif %} · {{ handle }}</span>
    <span class="live">{{ ui_breaking }}</span>
  </div>

  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}');
         {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}<div class="yellow">{{ script.photo_overlay }}</div>{% endif %}
  </div>

  <div class="accent-row">
    <span class="dot"></span>
    <span class="label">Özet</span>
    <span class="rule"></span>
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="26" data-fit-max="36" data-fit-pad="20">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
