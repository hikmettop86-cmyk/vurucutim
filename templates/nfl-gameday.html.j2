<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — NFL Gameday</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@500;600;700&family=Inter:wght@500;600;800&display=swap');

  {{ dna_css|safe }}

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body {
    width: 1080px; height: 1920px; overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    background: linear-gradient(180deg, var(--body-bg-1, #0a1f3c), var(--body-bg-2, #04101f));
    color: var(--text-main, #fff);
  }

  /* ===== STADYUM SAHASI ZEMİNİ ===== */
  .stage {
    position: relative; width: 1080px; height: 1920px;
    overflow: hidden;
    background:
      /* gece maçı spot ışığı — üstten parıltı */
      radial-gradient(140% 60% at 50% -5%,
        rgba(255,255,255,0.18) 0%, rgba(255,255,255,0.04) 35%, transparent 60%),
      /* saha koyu gradyanı */
      linear-gradient(180deg, var(--body-bg-1, #0a1f3c) 0%, var(--body-bg-2, #04101f) 100%);
  }
  /* Yard çizgileri — ince beyaz yatay şeritler (5-yard hissi) */
  .stage::before {
    content: ''; position: absolute; inset: 0; z-index: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg,
        rgba(255,255,255,0.07) 0 4px,
        transparent 4px 132px),
      repeating-linear-gradient(90deg,
        rgba(255,255,255,0.04) 0 3px,
        transparent 3px 270px);
  }
  /* Saha kenar çizgileri (sideline) + orta vurgu */
  .stage::after {
    content: ''; position: absolute; inset: 0; z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg,
        transparent 0 44px, rgba(255,255,255,0.10) 44px 48px,
        transparent 48px calc(100% - 48px),
        rgba(255,255,255,0.10) calc(100% - 48px) calc(100% - 44px), transparent calc(100% - 44px)),
      radial-gradient(60% 24% at 50% 50%, rgba(255,255,255,0.05), transparent 70%);
  }

  /* ===== END ZONE BANTLARI (üst + alt kalın renk blokları) ===== */
  .endzone {
    position: absolute; left: 0; right: 0; z-index: 1;
    pointer-events: none;
    height: 64px;
  }
  .endzone.top {
    top: 0;
    background: linear-gradient(90deg, var(--primary, #013369), var(--accent, #D50A0A));
    box-shadow: 0 6px 18px rgba(0,0,0,0.5);
    border-bottom: 4px solid rgba(255,255,255,0.65);
  }
  .endzone.bottom {
    bottom: 0;
    background: linear-gradient(90deg, var(--accent, #D50A0A), var(--primary, #013369));
    box-shadow: 0 -6px 18px rgba(0,0,0,0.5);
    border-top: 4px solid rgba(255,255,255,0.65);
  }
  /* end zone diyagonal hash deseni */
  .endzone::after {
    content: ''; position: absolute; inset: 0;
    background: repeating-linear-gradient(45deg,
      rgba(0,0,0,0.18) 0 14px, transparent 14px 28px);
  }

  /* ===== ÜST META BARI ===== */
  .top-bar {
    position: absolute; top: 92px; left: 56px; right: 56px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 5;
  }
  .stage-badge {
    background: var(--accent, #D50A0A);
    color: var(--text-main, #fff);
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 28px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 12px 30px 12px 34px;
    clip-path: polygon(14px 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
    box-shadow: 5px 5px 0 rgba(0,0,0,0.45);
  }
  .live-tag {
    display: flex; align-items: center; gap: 12px;
    font-family: 'Oswald', sans-serif;
    font-weight: 700; font-size: 26px;
    color: var(--accent, #D50A0A);
    letter-spacing: 0.16em; text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0,0,0,0.6);
  }
  .live-tag::before {
    content: ''; width: 13px; height: 13px; border-radius: 50%;
    background: var(--accent, #D50A0A);
    box-shadow: 0 0 14px var(--accent, #D50A0A);
  }

  /* ===== SKOR BARI / MANŞET (header) ===== */
  .header {
    position: absolute; top: 178px; left: 40px; right: 40px;
    text-align: center;
    z-index: 4;
    background: linear-gradient(180deg,
      var(--primary, #013369),
      color-mix(in srgb, var(--primary, #013369) 70%, #000));
    padding: 30px 36px 26px;
    border-bottom: 8px solid var(--accent, #D50A0A);
    border-top: 3px solid rgba(255,255,255,0.35);
    box-shadow: 0 22px 50px rgba(0,0,0,0.55), inset 0 0 0 2px rgba(255,255,255,0.06);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 18px), calc(100% - 26px) 100%, 26px 100%, 0 calc(100% - 18px));
  }
  .header .top {
    display: block;
    font-family: var(--font-headline, 'Anton'), sans-serif;
    font-size: var(--size-headline-top, 150px);
    line-height: 0.86;
    color: var(--text-main, #fff);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    text-shadow: 5px 5px 0 rgba(0,0,0,0.55), 0 0 26px rgba(0,0,0,0.4);
    text-wrap: balance;
    white-space: nowrap;
  }
  .header .bot {
    display: block; margin-top: 16px;
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: var(--size-headline-bot, 50px);
    line-height: 1.06;
    color: var(--accent, #D50A0A);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-shadow: 0 2px 10px rgba(0,0,0,0.7);
    text-wrap: balance;
  }

  /* ===== FOTO BANDI ===== */
  .photo {
    position: absolute;
    top: 560px; left: 40px; right: 40px;
    height: 620px;
    background: linear-gradient(135deg, var(--bg-grad-1, #0a2a52), var(--bg-grad-2, #04101f));
    border-top: 6px solid var(--accent, #D50A0A);
    border-bottom: 6px solid var(--primary, #013369);
    overflow: hidden;
    z-index: 3;
    box-shadow: 0 26px 56px rgba(0,0,0,0.6);
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-image: url('{{ bg_image_url|default("") }}');
    background-size: cover; background-position: center;
    {% if not bg_image_url %}display: none;{% endif %}
  }
  /* gradient fallback (foto yoksa) — saha çizgili koyu zemin */
  .photo::before {
    content: ''; position: absolute; inset: 0;
    background:
      repeating-linear-gradient(0deg,
        rgba(255,255,255,0.06) 0 3px, transparent 3px 90px),
      radial-gradient(80% 60% at 50% 20%, rgba(255,255,255,0.12), transparent 60%);
    z-index: 0;
  }
  .photo::after {
    content: ''; position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(180deg, transparent 45%, rgba(0,0,0,0.55) 100%),
      linear-gradient(90deg, rgba(0,0,0,0.35), transparent 22%, transparent 78%, rgba(0,0,0,0.35));
    pointer-events: none;
  }
  /* AKSİYON TAG — kırmızı eğik bant (class "yellow") */
  .yellow {
    position: absolute; left: -8px; right: -8px; bottom: 28px;
    background: var(--accent, #D50A0A);
    color: var(--text-main, #fff);
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    font-size: 38px;
    text-align: center;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 16px 30px;
    transform: skewX(-9deg);
    box-shadow: 0 10px 0 rgba(0,0,0,0.45), 0 18px 36px rgba(0,0,0,0.5);
    border-top: 3px solid rgba(255,255,255,0.45);
    z-index: 2;
  }
  .yellow > span { display: inline-block; transform: skewX(9deg); }

  /* ===== GÖVDE ===== */
  .body {
    position: absolute; left: 60px; right: 60px;
    top: 1240px; bottom: 220px;
    display: grid; place-items: center;
    z-index: 4;
  }
  .body-text {
    width: 100%;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 44px; line-height: 1.36; font-weight: 600;
    color: var(--text-main, #fff);
    text-shadow: 0 2px 10px rgba(0,0,0,0.7);
    text-align: center;
    text-wrap: pretty;
  }
  .body-text .hl-r {
    background: var(--accent, #D50A0A); color: var(--text-main, #fff);
    padding: 0 12px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 800; text-shadow: none;
  }
  .body-text .hl-y {
    background: var(--primary, #013369); color: var(--text-main, #fff);
    padding: 0 12px;
    box-decoration-break: clone; -webkit-box-decoration-break: clone;
    font-weight: 800; text-shadow: none;
  }

  /* ===== STANDART ALT ÖĞELER ===== */
  .progress {
    position: absolute; left: 0; right: 0; bottom: 84px;
    height: 8px; background: rgba(255,255,255,0.16);
    z-index: 6;
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: var(--accent, #D50A0A);
    box-shadow: 0 0 16px var(--accent, #D50A0A);
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    font-family: 'Oswald', sans-serif;
    font-size: 32px; font-weight: 700;
    color: var(--text-muted, rgba(255,255,255,0.85));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    z-index: 6;
  }

  .source-credit {
    position: absolute; bottom: 6px; left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.65); color: rgba(255,255,255,0.9);
    font-size: 14px; padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap; font-family: inherit;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">

  <div class="endzone top"></div>
  <div class="endzone bottom"></div>

  <div class="top-bar">
    {% if script.category %}<div class="stage-badge">{{ ui_breaking }}</div>{% endif %}
    <div class="live-tag">{{ script.category|default('GAMEDAY') }}</div>
  </div>

  <div class="header">
    <span class="top" data-fit-width="40" data-fit-min="60" data-fit-max="150">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img"></div>
    {% if script.photo_overlay %}<div class="yellow"><span>{{ script.photo_overlay }}</span></div>{% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="36" data-fit-max="48" data-fit-pad="20">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  {% if rss_source %}<div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>{% endif %}
</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>
