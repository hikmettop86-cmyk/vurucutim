<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short â€” Tech Haber</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap');
* { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --primary: #0066cc;
  --accent: #1d1d1f;
  --bg-grad-1: #ffffff;
  --bg-grad-2: #f5f5f7;
  --body-bg-1: #ffffff;
  --body-bg-2: #f5f5f7;
  --text-main: #1d1d1f;
  --text-muted: #6e6e73;
  --font-headline: 'Inter', sans-serif;
  --font-body: 'Inter', sans-serif;
}
html, body {
  width: 1080px; height: 1920px; overflow: hidden;
  background: linear-gradient(180deg, var(--bg-grad-1), var(--bg-grad-2));
  font-family: var(--font-body);
  color: var(--text-main);
}
.stage {
  position: relative; width: 1080px; height: 1920px;
  display: flex; flex-direction: column;
}

/* STAGE BADGE â€” pastel-blue pill, top-right */
.stage-badge {
  position: absolute; top: 24px; right: 24px;
  background: rgba(0,102,204,0.15);
  color: var(--primary);
  font-size: 20px; font-weight: 600;
  letter-spacing: 1px;
  padding: 8px 18px;
  border-radius: 999px;
  z-index: 10;
}

/* HEADER */
.header { padding: 96px 60px 48px; text-align: left; }
.header .top {
  display: block;
  font-size: 36px;
  color: var(--primary);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 3px;
  margin-bottom: 18px;
}
.header .bot {
  display: block;
  font-size: 96px;
  color: var(--accent);
  font-weight: 800;
  line-height: 1.05;
}

/* PHOTO â€” rounded corners, subtle shadow */
.photo {
  margin: 24px 60px;
  height: 760px;
  position: relative;
  background: linear-gradient(135deg, #e8eaee, #d6d9de);
  overflow: hidden;
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.08);
}
.photo .bg-img {
  position: absolute; inset: 0;
  background-image: url('{{ bg_image_url|default("") }}');
  background-size: cover; background-position: center;
  {% if not bg_image_url %}display: none;{% endif %}
}
.photo .tech-tag {
  position: absolute;
  top: 28px; left: 28px;
  background: rgba(0,102,204,0.92);
  color: #fff;
  font-size: 26px;
  padding: 8px 18px;
  border-radius: 999px;
  font-weight: 600;
  letter-spacing: 1px;
}

/* BODY â€” dark text on light bg */
.body {
  flex: 1; min-height: 0; margin-bottom: 240px;
  padding: 36px 60px 30px;
  font-size: 38px;
  line-height: 1.55;
  font-weight: 400;
  color: var(--accent);
  display: -webkit-box;
  -webkit-line-clamp: 8;
  -webkit-box-orient: vertical;
  overflow: hidden;
  -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 86%, transparent 100%);
          mask-image: linear-gradient(180deg, #000 0%, #000 86%, transparent 100%);
}
.body .hl-r { background: var(--primary); color: #fff; padding: 2px 14px; border-radius: 6px; font-weight: 600; }
.body .hl-y { background: #ffeb3b; color: var(--accent); padding: 2px 14px; border-radius: 6px; font-weight: 600; }

/* PROGRESS bar â€” darker track for white bg */
.progress {
  position: absolute; left: 0; right: 0; bottom: 84px; height: 8px;
  background: rgba(0,0,0,.12);
}
.progress::after {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, var(--primary), var(--accent));
  animation: fill {{ duration_s }}s linear forwards;
}
@keyframes fill { from { width: 0; } to { width: 100%; } }

/* HANDLE â€” dark text for visibility on white bg */
.handle {
  position: absolute; left: 0; right: 0; bottom: 30px;
  text-align: center; color: var(--text-muted); opacity: 0.9;
  font-size: 34px; font-weight: 600;
}

/* CTA overlay (last cta_duration_s seconds) â€” intentionally dark for emphasis */
{% if cta.enabled %}
/* Pre-flash: full-screen white flash 150ms before CTA */
.preflash {
  position: absolute; inset: 0;
  background: #fff;
  opacity: 0;
  pointer-events: none;
  z-index: 50;
  animation: flash 0.18s ease-out {{ duration_s - cta.duration_s - 0.15 }}s forwards;
}
@keyframes flash {
  0% { opacity: 0; }
  40% { opacity: 0.9; }
  100% { opacity: 0; }
}

/* CTA wrapper â€” dark overlay even on light archetypes, for visual focus */
.cta {
  position: absolute; left: 0; right: 0; bottom: 0; top: 0;
  background: radial-gradient(ellipse at center, rgba(20,20,20,.92), rgba(0,0,0,.98));
  padding: 0 60px;
  text-align: center;
  opacity: 0;
  pointer-events: none;
  z-index: 40;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation:
    cta-fade-in 0.25s ease-out {{ duration_s - cta.duration_s }}s forwards;
}
@keyframes cta-fade-in {
  to { opacity: 1; }
}

{% if cta.show_handle %}
.cta .handle-line {
  font-size: 64px; font-weight: 900;
  color: var(--primary);
  letter-spacing: 1px;
  margin-bottom: 50px;
  text-shadow:
    0 0 18px rgba(0,102,204,.7),
    0 0 36px rgba(0,102,204,.4);
  opacity: 0; transform: translateY(-30px);
  animation: handle-drop 0.45s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.05 }}s forwards;
}
@keyframes handle-drop {
  to { opacity: 1; transform: translateY(0); }
}
{% endif %}

/* Big YouTube-style SUBSCRIBE button */
.cta .sub-btn {
  background: linear-gradient(180deg, #ff2d2d, #c81e1e);
  color: #fff;
  font-size: 88px; font-weight: 900;
  padding: 40px 70px;
  border-radius: 100px;
  box-shadow:
    0 12px 0 rgba(0,0,0,.5),
    0 20px 60px rgba(255,45,45,.6);
  display: inline-flex;
  align-items: center;
  gap: 28px;
  letter-spacing: 1px;
  margin-bottom: 60px;
  transform: scale(0);
  animation:
    sub-pop 0.5s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.15 }}s forwards,
    sub-press 0.4s ease-in-out {{ duration_s - cta.duration_s + 0.55 }}s;
}
@keyframes sub-pop {
  to { transform: scale(1); }
}
@keyframes sub-press {
  0%, 100% { transform: scale(1); box-shadow: 0 12px 0 rgba(0,0,0,.5), 0 20px 60px rgba(255,45,45,.6); }
  50% { transform: scale(0.92); box-shadow: 0 4px 0 rgba(0,0,0,.5), 0 8px 30px rgba(255,45,45,.6); }
}
.cta .sub-btn .bell { font-size: 96px; }

/* Pointer hand below button â€” bouncing */
.cta .pointer {
  font-size: 100px;
  margin-bottom: 50px;
  opacity: 0;
  animation:
    pointer-in 0.3s ease-out {{ duration_s - cta.duration_s + 0.7 }}s forwards,
    bounce 0.6s ease-in-out {{ duration_s - cta.duration_s + 1.0 }}s infinite;
}
@keyframes pointer-in {
  from { opacity: 0; transform: translateY(-20px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15px); }
}

/* Three icons row at bottom â€” stagger pop-in */
.cta .icons-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 50px;
  margin-top: 30px;
}
.cta .icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  transform: scale(0);
  opacity: 0;
}
.cta .icon-item .ic { font-size: 110px; }
.cta .icon-item .lbl { font-size: 36px; font-weight: 800; color: #fff; letter-spacing: 1px; }
.cta .icon-item:nth-child(1) {
  animation: icon-pop 0.4s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.25 }}s forwards;
}
.cta .icon-item:nth-child(2) {
  animation: icon-pop 0.4s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.4 }}s forwards;
}
.cta .icon-item:nth-child(3) {
  animation: icon-pop 0.4s cubic-bezier(.34,1.56,.64,1) {{ duration_s - cta.duration_s + 0.55 }}s forwards;
}
@keyframes icon-pop {
  to { opacity: 1; transform: scale(1); }
}

/* Body dim during CTA so it stays focused */
.body { animation: dim 0.3s ease-in {{ duration_s - cta.duration_s }}s forwards; }
@keyframes dim { to { opacity: 0.05; } }
{% endif %}

/* Persistent corner chips â€” visible THROUGHOUT video */
.persistent {
  position: absolute;
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 900;
  font-size: 36px;
  letter-spacing: 1px;
  padding: 14px 22px;
  border-radius: 12px;
  color: #fff;
  box-shadow: 0 5px 0 rgba(0,0,0,.5), 0 0 20px rgba(0,0,0,.3);
  z-index: 35;
  text-shadow: 0 2px 0 rgba(0,0,0,.4);
}
.persistent .ic { font-size: 44px; }

/* BEÄEN â€” bottom-left, dark chip with red accent (YouTube-red works on white) */
.persistent.like {
  bottom: 112px; left: 24px;
  background: linear-gradient(135deg, rgba(0,0,0,.88), rgba(40,0,0,.92));
  border: 3px solid #ff3b3b;
  animation: like-beat 1.5s ease-in-out infinite;
}
@keyframes like-beat {
  0%, 100% { transform: scale(1); }
  20% { transform: scale(1.12); }
  40% { transform: scale(0.98); }
  60% { transform: scale(1.08); }
}

/* ABONE OL â€” bottom-right, red gradient chip (YouTube-red works on white) */
.persistent.sub {
  bottom: 112px; right: 24px;
  background: linear-gradient(135deg, #ff2d2d, #c81e1e);
  border: 3px solid #ffea3b;
  animation: sub-glow 1.5s ease-in-out infinite;
}
@keyframes sub-glow {
  0%, 100% { transform: scale(1); box-shadow: 0 5px 0 rgba(0,0,0,.5), 0 0 20px rgba(255,45,45,.4); }
  50% { transform: scale(1.08); box-shadow: 0 5px 0 rgba(0,0,0,.5), 0 0 36px rgba(255,234,59,.7); }
}

/* Hide persistent chips during the final CTA fullscreen overlay */
{% if cta.enabled %}
.persistent {
  animation-fill-mode: both;
}
.persistent.like { animation: like-beat 1.5s ease-in-out infinite, fade-out 0.3s ease-in {{ duration_s - cta.duration_s }}s forwards; }
.persistent.sub  { animation: sub-glow  1.5s ease-in-out infinite, fade-out 0.3s ease-in {{ duration_s - cta.duration_s }}s forwards; }
@keyframes fade-out { to { opacity: 0; } }
{% endif %}
  /* SOURCE CREDIT */
  .source-credit {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.6);
    color: rgba(255, 255, 255, 0.85);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.5px;
    padding: 3px 10px;
    border-radius: 3px;
    z-index: 50;
    white-space: nowrap;
    font-family: inherit;
  }

  /* DNA OVERRIDE â€” runtime palette/font from channel DNA */
  {{ dna_css|safe }}
</style>
</head>
<body>
<div class="stage">
  <div class="stage-badge">{{ ui_breaking }}</div>
  <div class="header">
    <span class="top">{{ script.header_top }}</span>
    <span class="bot">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img"></div>
    <div class="tech-tag">{{ script.photo_overlay }}</div>
  </div>

  <div class="body">{{ body_html|safe }}</div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>

  <!-- Persistent corner chips (visible throughout video, fade out only when end CTA opens) -->
  <div class="persistent like"><span class="ic">â¤ï¸</span><span>{{ ui_like }}</span></div>
  <div class="persistent sub"><span class="ic">ğŸ””</span><span>{{ ui_subscribe }}</span></div>

  {% if cta.enabled %}
  <div class="preflash"></div>
  <div class="cta">
    {% if cta.show_handle %}<div class="handle-line">{{ handle }}</div>{% endif %}
    <div class="sub-btn">
      <span class="bell">ğŸ””</span>
      <span>{{ ui_subscribe }}</span>
    </div>
    <div class="pointer">ğŸ‘†</div>
    <div class="icons-row">
      {% set icon_labels = [ui_like, ui_subscribe, ui_share] %}
      {% for icon in cta.icons %}
      <div class="icon-item">
        <span class="ic">{{ icon }}</span>
        <span class="lbl">{{ icon_labels[loop.index0] if loop.index0 < icon_labels|length else "" }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}
</div>
</body>
</html>
