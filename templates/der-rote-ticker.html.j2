<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>DER ROTE TICKER — Bayern News Card</title>
<style>
  /* 1. Google Fonts import (Oswald for headlines, Inter for body, JetBrains Mono for code) */
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@500;700&family=JetBrains+Mono:wght@400;500&display=swap');

  /* 2. DNA override (zorunlu) */
  {{ dna_css|safe }}

  /* Fallback DNA variables if not provided */
  :root {
    --primary: {{ colors.primary|default('#dc052d') }};
    --accent: {{ colors.accent|default('#0066b2') }};
    --text-main: #ffffff;
    --text-muted: rgba(255, 255, 255, 0.75);
    --bg-grad-1: #140205;
    --bg-grad-2: #050B14;
    --font-headline: 'Oswald', sans-serif;
    --font-body: 'Inter', sans-serif;
  }

  /* 3. Reset + viewport (zorunlu) */
  * { box-sizing: border-box; margin: 0; padding: 0; hyphens: auto; -webkit-hyphens: auto; word-break: break-word; }
  html, body {
    width: 1080px;
    height: 1920px;
    overflow: hidden;
    font-family: var(--font-body, 'Inter'), sans-serif;
    color: var(--text-main, #ffffff);
    background: linear-gradient(135deg, var(--bg-grad-1, #140205), var(--bg-grad-2, #050B14));
  }

  .stage {
    position: relative;
    width: 1080px;
    height: 1920px;
    display: flex;
    flex-direction: column;
    padding: 64px 54px;
    overflow: hidden;
  }

  /* Atmospheric Mistral-style mountain/sunset ambient glow layer */
  .stage::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 960px;
    background: radial-gradient(circle at 80% 10%, rgba(220, 5, 45, 0.25) 0%, rgba(0, 102, 178, 0.15) 45%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Category / Top Badge */
  .stage-badge {
    position: relative;
    z-index: 2;
    align-self: flex-start;
    background-color: var(--primary, #dc052d);
    color: #ffffff;
    font-family: var(--font-headline, 'Oswald'), sans-serif;
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    padding: 8px 24px;
    border-radius: 6px;
    margin-bottom: 24px;
    box-shadow: 0 4px 16px rgba(220, 5, 45, 0.4);
  }

  /* Brand Name Header (Zorunlu Boşluklu Kuralı) */
  .brand-banner {
    position: relative;
    z-index: 2;
    font-family: var(--font-headline, 'Oswald'), sans-serif;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: 4px;
    color: var(--text-muted, rgba(255,255,255,0.85));
    margin-bottom: 16px;
    text-transform: uppercase;
  }

  /* Header / Manşet Bölümü */
  .header {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 32px;
  }

  .header .top {
    font-family: var(--font-headline, 'Oswald'), sans-serif;
    font-size: 68px;
    font-weight: 700;
    line-height: 1.05;
    text-transform: uppercase;
    color: #ffffff;
    letter-spacing: -0.5px;
  }

  .header .bot {
    font-family: var(--font-headline, 'Oswald'), sans-serif;
    font-size: 52px;
    font-weight: 500;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--accent, #0066b2);
    letter-spacing: -0.5px;
  }

  /* Photo / Media Slot Card (Editorial 12px rounded, Mistral geometry) */
  .photo {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 520px;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 12px 24px -4px rgba(0, 0, 0, 0.4);
    margin-bottom: 36px;
    display: flex;
    align-items: flex-end;
  }

  .bg-img {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-size: cover;
    background-position: center;
    filter: saturate(1.1) contrast(1.05);
  }

  /* Photo overlay gradient for readability */
  .photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, rgba(20, 2, 5, 0.85) 100%);
    pointer-events: none;
  }

  .photo .yellow {
    position: relative;
    z-index: 3;
    padding: 24px 28px;
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.35;
    text-shadow: 0 2px 4px rgba(0,0,0,0.6);
  }

  /* Body Paragraf Kutusu (Dolu görünüm ve taşma önleme için flex strict kuralı) */
  .body {
    position: relative;
    z-index: 2;
    flex: 1;
    min-height: 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin-bottom: 120px; /* Leave space for bottom handle/progress */
    overflow: hidden;
    backdrop-filter: blur(8px);
  }

  .body-text {
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-weight: 400;
    line-height: 1.55;
    color: #f3f3f3;
  }

  /* Highlights (Mistral style crisp inline badges / colored spans) */
  .body-text .hl-r {
    background-color: var(--primary, #dc052d);
    color: #ffffff;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
  }

  .body-text .hl-y {
    background-color: var(--accent, #0066b2);
    color: #ffffff;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
  }

  /* Mistral Signature Sunset Stripe Band (Zorunlu Marka İmzası) */
  .sunset-stripe {
    position: absolute;
    bottom: 76px;
    left: 0;
    right: 0;
    height: 8px;
    background: linear-gradient(90deg, #dc052d 0%, #ff5722 35%, #ffb83e 70%, #fff8e0 100%);
    z-index: 10;
  }

  /* Progress Bar */
  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 64px;
    height: 4px;
    background: rgba(255, 255, 255, 0.15);
    z-index: 11;
  }

  .progress::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    background: var(--accent, #0066b2);
    animation: fill {{ duration_s }}s linear forwards;
  }

  @keyframes fill {
    from { width: 0; }
    to { width: 100%; }
  }

  /* Handle (Zorunlu) */
  .handle {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    text-align: center;
    font-family: var(--font-headline, 'Oswald'), sans-serif;
    font-size: 26px;
    font-weight: 500;
    letter-spacing: 2px;
    color: var(--text-muted, rgba(255, 255, 255, 0.7));
    z-index: 12;
    text-transform: uppercase;
  }

  /* Source Credit */
  .source-credit {
    position: absolute;
    bottom: 12px;
    right: 54px;
    background: rgba(0, 0, 0, 0.6);
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-body, 'Inter'), sans-serif;
    font-size: 13px;
    padding: 4px 12px;
    border-radius: 4px;
    z-index: 50;
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
</style>
</head>
<body>
<div class="stage">

  {% if script.category %}
  <div class="stage-badge">{{ script.category }}</div>
  {% endif %}

  <div class="brand-banner">DER ROTE TICKER</div>

  <div class="header">
    <span class="top" data-fit-width="20" data-fit-min="38" data-fit-max="68">{{ script.header_top }}</span>
    <span class="bot" data-fit-width="20" data-fit-min="30" data-fit-max="52">{{ script.header_bottom }}</span>
  </div>

  <div class="photo">
    <div class="bg-img" style="background-image: url('{{ bg_image_url|default("") }}'); {% if not bg_image_url %}display: none;{% endif %}"></div>
    {% if script.photo_overlay %}
    <div class="yellow">{{ script.photo_overlay }}</div>
    {% endif %}
  </div>

  <div class="body">
    <div class="body-text" data-fit-min="26" data-fit-max="40" data-fit-pad="16">
      {{ body_html|safe }}
    </div>
  </div>

  <div class="sunset-stripe"></div>
  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>
  
  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}

</div>

{% include "_auto_fit.js.j2" %}
</body>
</html>