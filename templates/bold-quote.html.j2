<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — bold-quote</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600;700&family=Georgia&display=swap');
  {{ dna_css|safe }}
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1920px; overflow: hidden; background: #0F0F0F;
    font-family: 'Inter', sans-serif;
    color: var(--text-main, #fff); }

  .stage { position: relative; width: 1080px; height: 1920px; }

  /* Top row */
  .top-row {
    padding: 48px 54px 0;
    display: flex; justify-content: space-between; align-items: center;
  }
  .category {
    background: #fff; color: #0a0a0a;
    padding: 12px 30px;
    font-family: 'Oswald', sans-serif;
    font-size: 30px; font-weight: 800; letter-spacing: 3px;
  }
  .stage-badge {
    display: inline-flex; align-items: center; gap: 12px;
    background: {{ colors.primary }}; color: #fff;
    padding: 12px 27px; border-radius: 999px;
    font-family: 'Oswald', sans-serif;
    font-size: 30px; font-weight: 800; letter-spacing: 3px;
  }
  .stage-badge .dot { width: 18px; height: 18px; border-radius: 50%; background: #fff; }

  /* Photo — top 45% */
  .photo {
    position: relative;
    height: 870px;
    margin-top: 36px;
    overflow: hidden;
    background: linear-gradient(135deg, {{ colors.bg_gradient[0] }}, {{ colors.bg_gradient[1] }});
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-image: url('{{ bg_image_url|default("") }}');
    background-size: cover; background-position: center;
    {% if not bg_image_url %}display: none;{% endif %}
  }

  /* Yellow quote card overlapping */
  .quote-card {
    margin: -150px 54px 0;
    background: {{ colors.accent }};
    padding: 54px 54px 66px;
    position: relative;
    box-shadow: 0 24px 72px rgba(0,0,0,.5);
    z-index: 2;
  }
  .quote-mark {
    position: absolute; top: -66px; left: 42px;
    font-family: Georgia, serif;
    font-size: 300px;
    color: #0a0a0a;
    line-height: 1; font-weight: 900;
  }
  .quote-text {
    margin: 42px 0 0;
    font-family: 'Oswald', sans-serif;
    font-weight: 600;
    font-size: 66px;
    line-height: 1.15;
    color: #0a0a0a;
    letter-spacing: -0.9px;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .attribution {
    margin-top: 42px;
    padding-top: 30px;
    border-top: 4.5px dashed rgba(0,0,0,.4);
    font-size: 33px; color: #0a0a0a;
    font-weight: 700; letter-spacing: 1.5px;
  }

  /* Context paragraph */
  .body {
    padding: 54px 66px 240px;
  }
  .body-text {
    font-size: 42px; line-height: 1.4;
    color: rgba(255,255,255,.7);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .body-text .hl-r { background: {{ colors.primary }}; color: #fff;
    padding: 0 8px; font-weight: 700; }
  .body-text .hl-y { background: {{ colors.accent }}; color: #0a0a0a;
    padding: 0 8px; font-weight: 700; }

  .progress {
    position: absolute; left: 0; right: 0; bottom: 110px; height: 6px;
    background: rgba(255,255,255,.18);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: {{ colors.accent }};
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    background: {{ colors.primary }};
    padding: 30px 0;
    font-family: 'Oswald', sans-serif;
    color: #fff;
  }
  .handle-inner {
    display: inline-block;
    border: 4px solid rgba(255,255,255,.4);
    border-radius: 999px;
    padding: 15px 48px;
    font-size: 36px; font-weight: 600; letter-spacing: 1.5px;
  }

  .source-credit {
    position: absolute;
    bottom: 18px; left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,.6); color: rgba(255,255,255,.85);
    font-size: 14px; font-weight: 500; letter-spacing: 0.5px;
    padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">
  <div class="top-row">
    {% if script.category %}<div class="category">{{ script.category }}</div>{% endif %}
    <div class="stage-badge"><span class="dot"></span>{{ ui_breaking }}</div>
  </div>

  <div class="photo"><div class="bg-img"></div></div>

  <div class="quote-card">
    <div class="quote-mark">"</div>
    <p class="quote-text" data-fit-min="36" data-fit-max="66" data-fit-pad="20">{{ body_html|safe }}</p>
    <div class="attribution">— {{ script.header_top }}{% if script.header_bottom %} · {{ script.header_bottom }}{% endif %}</div>
  </div>

  {% if script.photo_overlay %}
  <div class="body"><div class="body-text">{{ script.photo_overlay }}</div></div>
  {% endif %}

  <div class="progress"></div>
  <div class="handle"><span class="handle-inner">{{ handle }}</span></div>

  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}
</div>
{% include "_auto_fit.js.j2" %}
</body>
</html>
