<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — countdown</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;600;700;800&display=swap');
  {{ dna_css|safe }}
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1920px; overflow: hidden; background: #101418;
    font-family: 'Inter', sans-serif;
    color: var(--text-main, #fff); }

  .stage { position: relative; width: 1080px; height: 1920px;
    display: flex; flex-direction: column; }

  .top-band {
    padding: 54px 54px 42px;
    background: linear-gradient(180deg, {{ colors.bg_gradient[0] }} 0%, transparent 100%);
  }
  .top-band-row {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 36px;
  }
  .badge-top {
    display: inline-flex; align-items: center; gap: 12px;
    background: #fff; color: #0a0a0a;
    padding: 12px 27px; border-radius: 999px;
    font-family: 'Oswald', sans-serif;
    font-size: 30px; font-weight: 800; letter-spacing: 3px;
  }
  .badge-top .dot {
    width: 18px; height: 18px; border-radius: 50%;
    background: {{ colors.primary }};
  }
  .swipe-hint { font-size: 30px; opacity: .5; font-family: monospace; letter-spacing: 1.5px; }

  .header { font-family: 'Oswald', sans-serif; }
  .header .top {
    display: block;
    font-size: var(--size-headline-top, 78px);
    font-weight: 700;
    line-height: 1.05;
    color: #fff;
  }
  .header .top .hl-r {
    background: {{ colors.primary }}; color: #fff;
    padding: 0 12px; font-weight: 700;
  }
  .header .bot {
    display: block;
    margin-top: 6px;
    font-size: var(--size-headline-bot, 78px);
    font-weight: 700;
    line-height: 1.05;
    color: #fff;
  }

  /* List */
  .list {
    padding: 24px 54px 0;
    display: flex; flex-direction: column; gap: 18px;
  }
  .list-item {
    display: flex; align-items: center; gap: 30px;
    padding: 30px 36px;
    background: rgba(255,255,255,.04);
    border: 3px solid rgba(255,255,255,.08);
    color: #fff;
    opacity: 0.45;
  }
  .list-item.current {
    background: {{ colors.accent }};
    color: #0a0a0a;
    border: 6px solid {{ colors.accent }};
    opacity: 1;
  }
  .list-item.locked { opacity: 1; }
  .list-item .rank {
    font-family: 'Oswald', sans-serif;
    font-size: 84px; font-weight: 700;
    width: 96px; text-align: center;
    line-height: 1;
    color: #fff;
  }
  .list-item.current .rank { color: {{ colors.primary }}; }
  .list-item.locked .rank { color: #444; }
  .list-item .name {
    flex: 1;
    font-family: 'Oswald', sans-serif;
    font-size: 51px; font-weight: 600;
    line-height: 1.05;
  }
  .list-item .val {
    font-family: 'Oswald', sans-serif;
    font-size: 48px; font-weight: 700;
    color: {{ colors.accent }};
  }
  .list-item.current .val { color: {{ colors.primary }}; }
  .list-item.locked .val { color: #444; }

  /* Progress dots */
  .pagination {
    position: absolute; bottom: 276px; left: 0; right: 0;
    display: flex; justify-content: center; gap: 18px;
    z-index: 10;
  }
  .dot {
    width: 18px; height: 12px; border-radius: 6px;
    background: rgba(255,255,255,.2);
  }
  .dot.active { width: 54px; background: {{ colors.accent }}; }

  .progress {
    position: absolute; left: 0; right: 0; bottom: 110px; height: 6px;
    background: rgba(255,255,255,.18);
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: {{ colors.accent }};
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 50px;
    text-align: center;
    background: {{ colors.primary }};
    padding: 30px 0;
    font-family: 'Inter', sans-serif;
    font-size: 30px; font-weight: 700; letter-spacing: 1.5px;
    color: #fff;
  }

  .source-credit {
    position: absolute;
    bottom: 18px; left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,.6); color: rgba(255,255,255,.85);
    font-size: 14px; font-weight: 500; letter-spacing: 0.5px;
    padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">
  <div class="top-band">
    <div class="top-band-row">
      <div class="badge-top"><span class="dot"></span>{{ script.category|default('TOP 5') }}</div>
      <div class="swipe-hint">← KAYDIR</div>
    </div>
    <div class="header">
      <span class="top">{{ script.header_top }}</span>
      <span class="bot">{{ script.header_bottom }}</span>
    </div>
  </div>

  {# body_paragraph format: "5. ITEM_A | €100M, 4. ITEM_B | €135M, ..." parsed as list of "RANK. NAME | VALUE" #}
  <div class="list">
    {% set lines = script.body_paragraph.split('|') if '|' in script.body_paragraph else script.body_paragraph.split(',') %}
    {% set items = [] %}
    {% for ln in lines %}
      {% set parts = ln.strip().split('—') if '—' in ln else (ln.strip().split('->') if '->' in ln else [ln.strip(), '']) %}
      {% set _ = items.append(parts) %}
    {% endfor %}
    {% set count = items|length %}
    {% for parts in items[:5] %}
      {% set current = loop.index == 2 %}
      {% set locked = loop.last %}
      <div class="list-item {% if current %}current{% elif locked %}locked{% endif %}">
        <div class="rank">{{ count - loop.index0 }}</div>
        <div class="name">{{ parts[0] }}</div>
        <div class="val">{{ parts[1] if parts|length > 1 else '' }}</div>
      </div>
    {% endfor %}
  </div>

  <div class="pagination">
    <span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot active"></span><span class="dot"></span>
  </div>

  <div class="progress"></div>
  <div class="handle">{{ handle }}</div>

  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}
</div>
{% include "_auto_fit.js.j2" %}
</body>
</html>
