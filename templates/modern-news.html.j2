<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>Short — modern-news</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Georgia&family=Oswald:wght@500;700&family=Inter:wght@400;500;600;700&display=swap');
  {{ dna_css|safe }}
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1920px; overflow: hidden;
    background: {{ colors.bg_gradient[0] }};
    font-family: 'Georgia', serif;
    color: var(--text-main, #0a0a0a); }

  .stage { position: relative; width: 1080px; height: 1920px; }

  /* Masthead */
  .masthead {
    padding: 48px 60px 36px;
    border-bottom: 3px solid #ddd;
    display: flex; justify-content: space-between; align-items: center;
  }
  .brand {
    font-family: Georgia, serif;
    font-size: 48px; font-weight: 700;
    color: var(--text-main, #0a0a0a);
    letter-spacing: -1.5px;
  }
  .brand .dot { color: {{ colors.primary }}; margin-right: 8px; }
  .brand .tld { font-weight: 400; }
  .date {
    font-family: monospace;
    font-size: 30px; color: #888;
    letter-spacing: 1.5px;
  }

  /* Category + Headline */
  .header-area {
    padding: 60px 60px 0;
  }
  .category {
    font-family: 'Oswald', sans-serif;
    font-size: 30px; font-weight: 700;
    color: {{ colors.primary }};
    letter-spacing: 6px;
    margin-bottom: 30px;
  }
  .header {
    font-family: Georgia, serif;
  }
  .header .top {
    display: block;
    font-size: var(--size-headline-top, 84px);
    line-height: 1.1;
    color: var(--text-main, #0a0a0a);
    font-weight: 700;
    letter-spacing: -1.5px;
  }
  .header .top em {
    color: {{ colors.primary }};
    font-style: normal;
    background: linear-gradient(180deg, transparent 60%, {{ colors.accent }} 60%);
  }
  .header .bot {
    display: block;
    margin-top: 12px;
    font-family: 'Inter', sans-serif;
    font-size: var(--size-headline-bot, 36px);
    color: var(--text-muted, #666);
    font-weight: 400; font-style: italic;
    line-height: 1.3;
  }

  /* Photo */
  .photo {
    position: relative;
    height: 570px;
    margin: 54px 60px 0;
    background: linear-gradient(135deg, {{ colors.bg_gradient[0] }}, {{ colors.bg_gradient[1] }});
    overflow: hidden;
  }
  .photo .bg-img {
    position: absolute; inset: 0;
    background-image: url('{{ bg_image_url|default("") }}');
    background-size: cover; background-position: center;
    {% if not bg_image_url %}display: none;{% endif %}
  }
  .photo-caption {
    padding: 18px 60px 0;
    font-size: 30px;
    color: #888;
    font-style: italic;
  }
  .photo-caption .source { color: var(--text-main, #0a0a0a); }

  /* Spot / body */
  .body {
    padding: 42px 60px 240px;
  }
  .body-text {
    font-family: Georgia, serif;
    font-size: 48px; line-height: 1.5;
    color: #222;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .body-text .hl-r { background: {{ colors.primary }}; color: #fff;
    padding: 0 12px; font-weight: 700; }
  .body-text .hl-y { background: {{ colors.accent }}; color: #0a0a0a;
    padding: 0 12px; font-weight: 700; }

  .progress {
    position: absolute; left: 0; right: 0; bottom: 110px; height: 6px;
    background: rgba(0,0,0,.08);
    z-index: 2;
  }
  .progress::after {
    content: ''; position: absolute; left: 0; top: 0; bottom: 0;
    background: {{ colors.primary }};
    animation: fill {{ duration_s }}s linear forwards;
  }
  @keyframes fill { from { width: 0; } to { width: 100%; } }

  .handle {
    position: absolute; left: 0; right: 0; bottom: 30px;
    text-align: center;
    background: #0a0a0a;
    padding: 30px 0;
    color: #fff;
    z-index: 2;
  }
  .handle-inner {
    display: inline-block;
    border: 4px solid rgba(255,255,255,.4);
    border-radius: 999px;
    padding: 15px 48px;
    font-family: 'Inter', sans-serif;
    font-size: 36px; font-weight: 600; letter-spacing: 1.5px;
  }

  .source-credit {
    position: absolute;
    bottom: 18px; left: 50%; transform: translateX(-50%);
    background: rgba(0,0,0,.6); color: rgba(255,255,255,.85);
    font-size: 14px; font-weight: 500; letter-spacing: 0.5px;
    padding: 3px 10px; border-radius: 3px;
    z-index: 50; white-space: nowrap;
  }
</style>
</head>
<body>
<div class="stage dna-anim-{{ animation_style|default('none') }}">
  <div class="masthead">
    <div class="brand"><span class="dot">●</span>{{ handle|replace('@','') }}<span class="tld">.tr</span></div>
    <div class="date">{{ ui_breaking }}</div>
  </div>

  <div class="header-area">
    {% if script.category %}<div class="category">{{ script.category }}</div>{% endif %}
    <div class="header">
      <span class="top">{{ script.header_top }}</span>
      {% if script.header_bottom %}<span class="bot">{{ script.header_bottom }}</span>{% endif %}
    </div>
  </div>

  <div class="photo"><div class="bg-img"></div></div>
  {% if script.photo_overlay %}
  <div class="photo-caption">{{ script.photo_overlay }}</div>
  {% endif %}

  <div class="body"><div class="body-text">{{ body_html|safe }}</div></div>

  <div class="progress"></div>
  <div class="handle"><span class="handle-inner">{{ handle }}</span></div>

  {% if rss_source %}
  <div class="source-credit">{{ ui_source }}: {{ rss_source }}</div>
  {% endif %}
</div>
{% include "_auto_fit.js.j2" %}
</body>
</html>
