__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
build/
dist/

# project artifacts
output/*
!output/.gitkeep
data/*.sqlite
data/cache/*
!data/cache/.gitkeep
data/locks/*
!data/locks/.gitkeep
logs/*
!logs/.gitkeep
!logs/runs/
logs/runs/*
!logs/runs/.gitkeep

# brainstorm/spec working files
.superpowers/

# scratch / one-off renders
tmp/

# Secrets (Pexels API key, etc.) — never commit
data/secrets.yaml

# User settings (template is config/settings.yaml.example)
config/settings.yaml

# Per-user channel configs (kullanici kendi yapsin; example.yaml tracked)
config/channels/*.yaml
!config/channels/example.yaml

# Panel logs (root)
panel_stdout.log
panel_stderr.log

# Generated CSS
templates/css/*.css
!templates/css/.gitkeep

# Debug / one-off scripts
debug_*.py
test_secrets.json
backfill_*.py

# WAL / SHM sidecar files from SQLite
data/*.sqlite-shm
data/*.sqlite-wal

# Internal planning artifacts (not for public repo)
docs/superpowers/

# Misc temp/debug
*.html
!electron/wizard/*.html
test_output.log

# YouTube credentials — NEVER commit (token.json, client_secrets.json contain secrets)
data/youtube_credentials/

# Tests not distributed
tests/

# Electron build artifacts
electron/node_modules/
electron/dist/
electron/cache/
!electron/build/

# Git worktrees (project-local, isolated dev branches)
.worktrees/
